{% comment %}
  Addon Product / Variant Card Item (matches Complete Your Setup keycap card style)
{% endcomment %}

{%- assign item_variant = variant -%}
{%- if variant.variants -%}
  {%- assign item_variant = variant.selected_or_first_available_variant | default: variant.variants.first -%}
{%- endif -%}

{%- assign is_available = item_variant.available -%}
{%- assign item_title = item_variant.product.title | default: item_variant.title -%}
{%- comment -%} 每个商品卡片的唯一标识，点击时写入地址栏 {%- endcomment -%}
{%- assign card_anchor = 'p-' | append: item_variant.id -%}
{%- assign variant_subtitle = '' -%}
{%- if item_variant.title != 'Default Title' and item_variant.title != blank -%}
  {%- assign variant_subtitle = item_variant.title -%}
{%- endif -%}

{%- assign card_image = '' -%}
{%- if item_variant.featured_image -%}
  {%- assign card_image = item_variant.featured_image | image_url: width: 360 -%}
{%- elsif item_variant.image -%}
  {%- assign card_image = item_variant.image | image_url: width: 360 -%}
{%- elsif item_variant.product.featured_image -%}
  {%- assign card_image = item_variant.product.featured_image | image_url: width: 360 -%}
{%- elsif item_variant.product.images.first -%}
  {%- assign card_image = item_variant.product.images.first | image_url: width: 360 -%}
{%- endif -%}

<div
  class="bundle-keycap-card bundle-addon-card {% if is_available %}available{% else %}sold-out{% endif %}"
  id="bundle-card-{{ card_anchor }}"
  data-bundle-anchor="{{ card_anchor }}"
  data-variant-id="{{ item_variant.id }}"
  data-product-title="{{ item_variant.product.title | escape }}"
  data-variant-title="{{ item_variant.title | escape }}"
  role="button"
  tabindex="{% if is_available %}0{% else %}-1{% endif %}"
  aria-pressed="false"
  aria-label="{{ item_title | escape }}{% if variant_subtitle != blank %} ({{ variant_subtitle | escape }}){% endif %} - {{ item_variant.price | money }}"
>
  <input
    type="checkbox"
    class="bundle-product-checkbox bundle-addon-checkbox"
    id="bundle-addon-{{ item_variant.id }}"
    data-bundle-product="{{ item_variant.id }}"
    {% unless is_available %}disabled{% endunless %}
    tabindex="-1"
    aria-hidden="true"
    style="display: none;"
  >

  <div class="bundle-keycap-card__media">
    {% if card_image != blank %}
      <img
        src="{{ card_image }}"
        alt="{{ item_variant.product.title | escape }} - {{ item_variant.title | escape }}"
        loading="lazy"
        width="200"
        height="200"
        draggable="false"
      >
    {% else %}
      <div class="bundle-keycap-card__no-img">No Image</div>
    {% endif %}

    <div class="bundle-keycap-card__badge" aria-hidden="true">
      <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M13.5 4.5L6.5 11.5L3 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>

    {% unless is_available %}
      <div class="bundle-keycap-card__soldout-tag">Sold Out</div>
    {% endunless %}
  </div>

  <div class="bundle-keycap-card__info">
    <div class="bundle-keycap-card__title" title="{{ item_title | escape }}">
      {{ item_title }}
    </div>
    {% if variant_subtitle != blank %}
      <div class="bundle-keycap-card__variant" title="{{ variant_subtitle | escape }}">
        {{ variant_subtitle }}
      </div>
    {% endif %}
    {%- assign p_type = item_variant.product.type | downcase -%}
    {%- assign p_title = item_title | downcase -%}
    {%- assign is_kc = false -%}
    {%- if p_type contains 'keycap' or p_title contains 'keycap' or p_title contains 'keyset' or item_variant.product.tags contains 'keycaps' or item_variant.product.tags contains 'Keycaps' -%}
      {%- unless p_title contains 'puller' or p_title contains 'installation' or p_title contains '人工安装' or p_title contains '安装服务' -%}
        {%- assign is_kc = true -%}
      {%- endunless -%}
    {%- endif -%}
    <div class="bundle-keycap-card__price">
      {%- if is_kc -%}
        {%- assign kc_orig_price = item_variant.price -%}
        {%- assign kc_disc_price = item_variant.price | times: 0.9 | round -%}
        <span class="bundle-keycap-card__price--original">{{ kc_orig_price | money }}</span>
        <span class="bundle-keycap-card__price--discount">{{ kc_disc_price | money }}</span>
      {%- else -%}
        {{ item_variant.price | money }}
      {%- endif -%}
    </div>
  </div>
</div>
