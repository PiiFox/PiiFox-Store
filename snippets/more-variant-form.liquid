    function initBundleSelection() {
      function syncItemState(item, isChecked) {
        if (!item) return;
        if (isChecked) {
          item.classList.add('is-selected');
        } else {
          item.classList.remove('is-selected');
        }
      }

      function autoCheckItem(target) {
        if (!target) return;
        const item = target.closest('.bundle-product-item');
        if (!item || item.classList.contains('sold-out')) return;

        const checkbox = item.querySelector('.bundle-product-checkbox');
        if (!checkbox || checkbox.disabled || checkbox.checked) return;

        checkbox.checked = true;
        syncItemState(item, true);
        item._clickCount = 0;
        if (item._clickTimer) clearTimeout(item._clickTimer);
        checkbox.dispatchEvent(new Event('change', { bubbles: true }));
      }

      // Initial state sync
      document.querySelectorAll('.bundle-product-checkbox').forEach(cb => {
        const item = cb.closest('.bundle-product-item');
        if (item) {
          syncItemState(item, cb.checked);
        }
      });

      // Click handling on .bundle-product-item:
      // - 未勾选时：需在卡片方块内（空白、图片、标题、价格）连续点击 3 次（每次间隔不超过 1.5 秒）才打勾
      // - 已勾选时：只有刚好点击复选框小方块才可以取消打勾
      // - 数量调节按钮（+ / -）：点击自动打勾
      document.addEventListener('click', function (e) {
        const item = e.target.closest('.bundle-product-item');
        if (!item || item.classList.contains('sold-out')) return;

        const checkbox = item.querySelector('.bundle-product-checkbox');
        if (!checkbox || checkbox.disabled) return;

        // 若点击的是数量调节按钮（+-号），自动打勾，不触发卡片3次点击逻辑
        const qtyAdjustBtn = e.target.closest('.js-qty__adjust');
        if (qtyAdjustBtn && item.contains(qtyAdjustBtn)) {
          autoCheckItem(qtyAdjustBtn);
          return;
        }

        // 若点击的是数量调节组件的其他区域（如输入框本身或库存提示），不改变勾选状态
        if (e.target.closest('.bundle-product-qty') || e.target.closest('.js-qty__wrapper')) {
          return;
        }

        const isCheckboxTarget = e.target === checkbox || !!e.target.closest('.bundle-product-checked') || !!e.target.closest('.bundle-product-checkbox');

        // 1. 单击对准左侧复选框：直接打勾或取消打勾
        if (isCheckboxTarget) {
          const willBeChecked = !checkbox.checked;
          checkbox.checked = willBeChecked;
          syncItemState(item, willBeChecked);
          item._clickCount = 0;
          if (item._clickTimer) clearTimeout(item._clickTimer);
          checkbox.dispatchEvent(new Event('change', { bubbles: true }));
          return;
        }

        // 2. 点击卡片方块内其他区域（图片、标题、价格、空白处）
        const isCurrentlySelected = item.classList.contains('is-selected') || checkbox.checked;

        if (isCurrentlySelected) {
          // 已勾选时，点击卡片其他区域保持勾选状态，不取消
          e.preventDefault();
        } else {
          // 未勾选时，卡片其他区域需要连续点击 3 次才打勾（每次间隔不超过 1.5 秒）
          e.preventDefault();

          item._clickCount = (item._clickCount || 0) + 1;
          if (item._clickTimer) clearTimeout(item._clickTimer);

          if (item._clickCount >= 3) {
            item._clickCount = 0;
            checkbox.checked = true;
            syncItemState(item, true);
            checkbox.dispatchEvent(new Event('change', { bubbles: true }));
          } else {
            item._clickTimer = setTimeout(function () {
              item._clickCount = 0;
            }, 1500);
          }
        }
      });

      // 手动输入数量时（input 事件，如键盘输入 2）自动打勾
      document.addEventListener('input', function (e) {
        if (e.target && e.target.closest && e.target.closest('.bundle-product-item .js-qty__num')) {
          autoCheckItem(e.target);
        }
      });

      // 监听复选框及数量框 change 事件以同步状态
      document.addEventListener('change', function (e) {
        if (!e.target) return;
        if (e.target.classList.contains('bundle-product-checkbox')) {
          const item = e.target.closest('.bundle-product-item');
          if (item) {
            syncItemState(item, e.target.checked);
          }
        } else if (e.target.closest && e.target.closest('.bundle-product-item .js-qty__num')) {
          autoCheckItem(e.target);
        }
      });
    }

    function initAddToCart() {
      const addBtn = document.querySelector('button.add-to-cart');
      const ajaxCart = new theme.AjaxProduct(addBtn);
      
      addBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        if (addBtn.disabled || addBtn.classList.contains('btn--loading')) {
          return;
        }
        const currentVariantId = getCurrentVariantId();
        if (!currentVariantId) {
          console.warn('Unable to determine the selected variant');
          return;
        }
        const mainQtyInput = document.querySelector('.product__quantity input[name="quantity"]') || document.querySelector('input[name="quantity"]');
        const mainQty = mainQtyInput ? Math.max(1, parseInt(mainQtyInput.value, 10) || 1) : 1;
        const rawItems = [
          { id: currentVariantId, quantity: mainQty }
        ];
        const appendVariantIds = getAppendVariantIds();
        if(appendVariantIds) {
          rawItems.push(...appendVariantIds);
        }

        // 预聚合：相同 variantId 且属性（properties）完全相同的商品预先合并数量，确保提交时就是单条累加数量
        const items = [];
        rawItems.forEach(item => {
          const itemPropsStr = JSON.stringify(item.properties || {});
          const existing = items.find(m => String(m.id) === String(item.id) && JSON.stringify(m.properties || {}) === itemPropsStr);
          if (existing) {
            existing.quantity = (existing.quantity || 1) + (item.quantity || 1);
          } else {
            items.push({ ...item });
          }
        });

        ajaxCart.MoreProductAddToCart(addBtn, items);
      });
    }
    function initSetup1KeycapSelection() {
      const setup1List = document.querySelector('.bundle-product-list--1');
      if (!setup1List) return;

      const cards = setup1List.querySelectorAll('.bundle-keycap-card');
      if (!cards.length) return;

      const isKeyboardProduct = {{ is_keyboard | json }};

      let defaultSlideIndex = 0;
      let previewOverlay = null;
      let previewImg = null;
      const mainSlider = document.querySelector('[data-product-photos]');

      if (isKeyboardProduct) {
        if (mainSlider) {
          const activeSlide = mainSlider.querySelector('.product-main-slide.is-selected');
          if (activeSlide && activeSlide.dataset.index) {
            defaultSlideIndex = parseInt(activeSlide.dataset.index, 10) || 0;
          }
        }

        previewOverlay = document.querySelector('.bundle-combo-preview');
        if (!previewOverlay) {
          const mainPhotos = document.querySelector('.product__main-photos');
          if (mainPhotos) {
            previewOverlay = document.createElement('div');
            previewOverlay.className = 'bundle-combo-preview';
            previewOverlay.innerHTML = '<div class="bundle-combo-preview-wrap"><img class="bundle-combo-preview-img" src="" alt="Keyboard + Keycap Combo"></div>';
            mainPhotos.appendChild(previewOverlay);
          }
        }
        previewImg = previewOverlay ? previewOverlay.querySelector('.bundle-combo-preview-img') : null;
      }

      function findMatchingSlideIndex(card) {
        const keycapTitle = (card.dataset.keycapTitle || '').toLowerCase().trim();
        const productTitle = (card.dataset.productTitle || '').toLowerCase().trim();
        const keycapHandle = (card.dataset.keycapHandle || '').toLowerCase().trim();
        const keycapSku = (card.dataset.keycapSku || '').toLowerCase().trim();
        const variantId = (card.dataset.variantId || '').trim();

        const slides = document.querySelectorAll('[data-product-photos] .product-main-slide');
        for (let i = 0; i < slides.length; i++) {
          const slide = slides[i];
          const rawAlt = (slide.dataset.rawAlt || slide.getAttribute('data-raw-alt') || '').toLowerCase();
          const img = slide.querySelector('img');
          const imgAlt = ((img && (img.alt || img.getAttribute('data-alt'))) || '').toLowerCase();
          const altText = (rawAlt + ' ' + imgAlt).trim();
          if (!altText) continue;

          if (
            (keycapTitle && altText.includes(keycapTitle)) ||
            (productTitle && altText.includes(productTitle)) ||
            (keycapHandle && altText.includes(keycapHandle)) ||
            (keycapSku && altText.includes(keycapSku)) ||
            (variantId && altText.includes(variantId)) ||
            (keycapTitle && altText.includes('#keycap_' + keycapTitle.replace(/[^a-z0-9]+/g, '-'))) ||
            (keycapTitle && altText.includes('#keycap:' + keycapTitle))
          ) {
            const idx = parseInt(slide.dataset.index, 10);
            return isNaN(idx) ? i : idx;
          }
        }
        return -1;
      }

      // 优先取当前可见的缩略图（图片分组功能会给部分缩略图加 .hide，且主题会重写可见缩略图的 data-index，
      // 导致 data-index 重复；隐藏的缩略图没有绑定主题的 preventDefault，点击会跳转到大图链接）
      function findThumb(index) {
        return document.querySelector(`.product__thumb-item:not(.hide) .product__thumb[data-index="${index}"]`)
          || document.querySelector(`.product__thumb[data-index="${index}"]`);
      }

      function showKeycapImage(card) {
        const matchingIndex = findMatchingSlideIndex(card);
        const comboImageUrl = card.dataset.comboImage;

        if (matchingIndex >= 0) {
          const thumbLink = findThumb(matchingIndex);
          if (thumbLink) {
            thumbLink.click();
          } else if (window.Flickity && mainSlider) {
            const flkty = Flickity.data(mainSlider);
            if (flkty) flkty.select(matchingIndex);
          }
          if (previewOverlay) {
            previewOverlay.classList.remove('is-visible');
          }
          return;
        }

        if (comboImageUrl && previewOverlay && previewImg) {
          previewImg.src = comboImageUrl;
          previewOverlay.classList.add('is-visible');
          return;
        }

        if (previewOverlay) {
          previewOverlay.classList.remove('is-visible');
        }
      }

      function restoreDefaultImage() {
        if (previewOverlay) {
          previewOverlay.classList.remove('is-visible');
        }
        const defaultThumb = findThumb(defaultSlideIndex);
        if (defaultThumb) {
          defaultThumb.click();
        } else if (window.Flickity && mainSlider) {
          const flkty = Flickity.data(mainSlider);
          if (flkty) flkty.select(defaultSlideIndex);
        }
      }

      if (isKeyboardProduct) {
        document.querySelectorAll('.product__thumb').forEach(thumb => {
          thumb.addEventListener('click', (e) => {
            // 缩略图是 <a href="大图地址">，主题的切换监听未绑定时会直接跳转打开大图，这里统一阻止
            e.preventDefault();
            if (previewOverlay) previewOverlay.classList.remove('is-visible');
          });
        });
      }

      // 记录键帽勾选先后顺序，供安装服务按顺序预填下拉框
      let keycapSelectSeq = 0;

      cards.forEach(card => {
        card.addEventListener('click', function() {
          if (this.classList.contains('sold-out')) return;

          const checkbox = this.querySelector('.bundle-product-checkbox');
          const isSelected = this.classList.contains('is-selected');

          if (isSelected) {
            // 取消勾选当前卡片（支持多选）
            this.classList.remove('is-selected');
            this.setAttribute('aria-pressed', 'false');
            if (checkbox) {
              checkbox.checked = false;
              checkbox.dispatchEvent(new Event('change', { bubbles: true }));
            }
            delete this.dataset.selectedOrder;

            // 键盘商品：检查是否还有其他选中的键帽以切换搭配图
            if (isKeyboardProduct) {
              const remainingSelected = setup1List.querySelectorAll('.bundle-keycap-card.is-selected');
              if (remainingSelected.length > 0) {
                showKeycapImage(remainingSelected[remainingSelected.length - 1]);
              } else {
                restoreDefaultImage();
              }
            }
          } else {
            // 勾选当前卡片（不影响其他卡片的勾选，支持多选）
            this.classList.add('is-selected');
            this.setAttribute('aria-pressed', 'true');
            if (checkbox) {
              checkbox.checked = true;
              checkbox.dispatchEvent(new Event('change', { bubbles: true }));
            }
            this.dataset.selectedOrder = String(++keycapSelectSeq);

            // 仅键盘商品左侧切换为当前点击键帽的搭配图
            if (isKeyboardProduct) {
              showKeycapImage(this);
            }
          }
        });

        card.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            this.click();
          }
        });
      });
    }

    function initAddonCardsSelection() {
