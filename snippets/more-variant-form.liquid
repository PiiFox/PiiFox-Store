        function openModalForCard(card) {
          if (!card) return;

          // 1. 解析产品图片列表
          let imgs = [];
          if (card.dataset.keycapImages) {
            try {
              const parsed = JSON.parse(card.dataset.keycapImages);
              if (Array.isArray(parsed)) {
                imgs = parsed.filter(Boolean);
              }
            } catch (err) {
              imgs = [];
            }
          }
          if (!imgs.length && card.dataset.keycapImage) {
            imgs = [card.dataset.keycapImage];
