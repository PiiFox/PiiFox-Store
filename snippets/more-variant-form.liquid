<script>
  $(function () {
    $('.custom-shopify-buy-btn').click(() => {
      console.log('click');
      $('.shopify-payment-button button.shopify-payment-button__more-options').click();
    });
  });
</script>
<div class="bundle-list">
  <label class="bundle-list-title">Complete Your Setup</label>
  <div class="bundle-tab-list">
    {% assign bundle_list_labels = product.metafields.custom.bundle_list_labels.value %}
    {% for label in bundle_list_labels %}
      <div class="bundle-tab-item" data-bundle-product-list="{{ label }}">
        Setup {{ forloop.index }}
      </div>
    {% endfor %}
  </div>
  <div class="bundle-product-list-container">
    <div class="bundle-product-list--wrapper">
      {% assign bundle_1_variants = product.metafields.custom.bundle_1_variants.value %}
      {% assign bundle_2_variants = product.metafields.custom.bundle_2_variants.value %}
      {% assign bundle_3_variants = product.metafields.custom.bundle_3_variants.value %}

      <div class="bundle-product-list bundle-product-list--1" data-bundle-product-list="{{ bundle_list_labels[0] }}">
        {% for variant in bundle_1_variants %}
          {% render 'bundle-variant-item' variant: variant %}
        {% endfor %}
      </div>

      <div class="bundle-product-list bundle-product-list--2" data-bundle-product-list="{{ bundle_list_labels[1] }}">
        {% for variant in bundle_2_variants %}
          {% render 'bundle-variant-item' variant: variant %}
        {% endfor %}
      </div>

      <div class="bundle-product-list bundle-product-list--3" data-bundle-product-list="{{ bundle_list_labels[2] }}">
        {% for variant in bundle_3_variants %}
          {% render 'bundle-variant-item' variant: variant %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{%- form 'product', product, id: form_id, class: 'product-single__form' -%}
  {%- liquid
    assign enable_dynamic_buttons = false
    if show_dynamic_checkout and template != 'product.preorder'
      assign enable_dynamic_buttons = true
    endif
  -%}

  {%- if enable_dynamic_buttons -%}
    <div class="payment-buttons">
  {%- endif -%}

  {%- liquid
    assign default_text = 'products.product.add_to_cart' | t
    assign button_text = 'products.product.add_to_cart' | t
    if template == 'product.preorder'
      assign default_text = 'products.product.preorder' | t
      assign button_text = 'products.product.preorder' | t
    endif
    unless current_variant.available
      assign button_text = 'products.product.sold_out' | t
    endunless
  -%}

  <button
    {% if product.empty? %}
      type="button"
    {% else %}
      type="submit"
    {% endif %}
    name="add"
    data-add-to-cart
    class="btn btn--full add-to-cart{% if enable_dynamic_buttons and product.selling_plan_groups == empty %} btn--secondary{% endif %}"
    {% unless current_variant.available %}
      disabled="disabled"
    {% endunless %}
  >
    <span data-add-to-cart-text data-default-text="{{ default_text }}">
      {{ button_text }}
    </span>
  </button>

  {% style %}
    .shopify-payment-button[data-shopify="payment-button"] .shopify-payment-button__more-options::after {
      content: "{{ 'general.custom.shop_now' | t }}";
    }
  {% endstyle %}
  {%- if enable_dynamic_buttons -%}
    <button class="custom-shopify-buy-btn btn shopify-payment-button" type="button" data-testid="sheet-open-button">
      {{ 'general.custom.buy_now' | t }}
    </button>
    {{ form | payment_button }}
  {%- endif -%}

  {%- if enable_dynamic_buttons -%}
    </div>
  {%- endif -%}

  <div class="shopify-payment-terms product__policies">{{ form | payment_terms }}</div>

  <select name="id" data-product-select class="product-single__variants no-js">
    {%- for variant in product.variants -%}
      {%- if variant.available -%}
        <option
          {% if variant == product.selected_or_first_available_variant %}
            selected="selected"
          {% endif %}
          value="{{ variant.id }}"
        >
          {{ variant.title }} - {{ variant.price | money_with_currency }}
        </option>
      {%- else -%}
        <option disabled="disabled">{{ variant.title }} - {{ 'products.product.sold_out' | t }}</option>
      {%- endif -%}
    {%- endfor -%}
  </select>

  <textarea id="product-json" data-variant-json class="hide" aria-hidden="true" aria-label="Product JSON">
    {{ product.variants | json }}
  </textarea>
  <textarea data-product-inventories class="hide" aria-hidden="true" aria-label="Product Inventories JSON">
    {
      {%- for variant in product.variants -%}
        "{{ variant.id }}": {
          "inventory_management": {{ variant.inventory_management | json }},
          "inventory_policy": {{ variant.inventory_policy | json }},
          "inventory_quantity": {{ variant.inventory_quantity | default: 0 }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    }
  </textarea>
  {%- if product.options.size > 1 -%}
    <textarea data-current-variant-json class="hide" aria-hidden="true" aria-label="Variant JSON">
      {{ current_variant | json }}
    </textarea>
  {%- endif -%}
{%- endform -%}

<script>
  function initMoreVariantForm() {
    function initBundleTabs() {
      const bundleTabs = document.querySelectorAll('.bundle-tab-item');
      const bundleLists = document.querySelectorAll('.bundle-product-list');

      bundleTabs.forEach(tab => tab.addEventListener('click', function(){
        bundleTabs.forEach(tab => tab.classList.remove('active'));
        this.classList.add('active');
        const currentLabel = this.dataset['bundleProductList'];
        bundleLists.forEach(list => list.classList.remove('active'));
        const targetList = document.querySelector(`.bundle-product-list[data-bundle-product-list="${currentLabel}"]`);
        if(targetList) targetList.classList.add('active');
      }));

      const firstTab = document.querySelector('.bundle-tab-item');
      if(firstTab) firstTab.classList.add('active');

      const firstList = document.querySelector('.bundle-product-list--1');
      if(firstList) firstList.classList.add('active');
    }
    function getCurrentVariantId() {
      const urlParams = new URLSearchParams(window.location.search);
      const variantId = urlParams.get('variant');
      if (variantId) {
        return variantId;
      }
      const select = document.querySelector('select.product-single__variants');
      if (select) {
        if (select.value) return select.value;
      }
      const currentVariantJson = document.querySelector('textarea[data-current-variant-json]');
      if (currentVariantJson) {
        try {
          const idInput = JSON.parse(currentVariantJson.value || currentVariantJson.textContent);
          if (idInput && idInput.id) return idInput.id;
        } catch (error) {
          console.warn('Unable to parse current variant JSON', error);
        }
      }
      const variantsJson = document.querySelector('textarea[data-variant-json]');
      if (variantsJson) {
        try {
          const variants = JSON.parse(variantsJson.value || variantsJson.textContent);
          const availableVariant = variants.find(variant => variant.available !== false);
          if (availableVariant && availableVariant.id) return availableVariant.id;
        } catch (error) {
          console.warn('Unable to parse product variants JSON', error);
        }
      }
      return null;
    }
    function getAppendVariantIds() {
      let appendVariantIds = [];
      let allVariants = document.querySelectorAll('.bundle-product-checkbox');
      for(let i = 0; i < allVariants.length; i++) {
        if(allVariants[i].checked) {
          const item = allVariants[i].closest('.bundle-product-item');
          const qtyInput = item ? item.querySelector('.js-qty__num') : document.getElementById(`Quantity-${allVariants[i].id}`);
          const quantity = qtyInput ? Math.max(1, Number(qtyInput.value)) : 1;  
          const variantId = allVariants[i].dataset.bundleProduct || allVariants[i].id;
          let selectedVariant = {id: variantId, quantity: quantity};
          appendVariantIds.push(selectedVariant);
        }
      }
      console.log('appendVariantIds', appendVariantIds);
      return appendVariantIds;
    }
    function initBundleQtySelectors() {
      document.querySelectorAll('.bundle-product-list .js-qty__wrapper').forEach(el => {
        if (!el._qtySelector && window.theme && window.theme.QtySelector) {
          new theme.QtySelector(el, { namespace: '.product' });
        }
      });
    }
    function initBundleSelection() {
      function syncItemState(item, isChecked) {
        if (!item) return;
        if (isChecked) {
          item.classList.add('is-selected');
        } else {
          item.classList.remove('is-selected');
        }
      }

      function autoCheckItem(target) {
        if (!target) return;
        const item = target.closest('.bundle-product-item');
        if (!item || item.classList.contains('sold-out')) return;

        const checkbox = item.querySelector('.bundle-product-checkbox');
        if (!checkbox || checkbox.disabled || checkbox.checked) return;

        checkbox.checked = true;
        syncItemState(item, true);
        item._clickCount = 0;
        if (item._clickTimer) clearTimeout(item._clickTimer);
        checkbox.dispatchEvent(new Event('change', { bubbles: true }));
      }

      // Initial state sync
      document.querySelectorAll('.bundle-product-checkbox').forEach(cb => {
        const item = cb.closest('.bundle-product-item');
        if (item) {
          syncItemState(item, cb.checked);
        }
      });

      // Click handling on .bundle-product-item:
      // - 未勾选时：需在卡片方块内（空白、图片、标题、价格）连续点击 3 次（每次间隔不超过 1.5 秒）才打勾
      // - 已勾选时：只有刚好点击复选框小方块才可以取消打勾
      // - 数量调节按钮（+ / -）：点击自动打勾
      document.addEventListener('click', function (e) {
        const item = e.target.closest('.bundle-product-item');
        if (!item || item.classList.contains('sold-out')) return;

        const checkbox = item.querySelector('.bundle-product-checkbox');
        if (!checkbox || checkbox.disabled) return;

        // 若点击的是数量调节按钮（+-号），自动打勾，不触发卡片3次点击逻辑
        const qtyAdjustBtn = e.target.closest('.js-qty__adjust');
        if (qtyAdjustBtn && item.contains(qtyAdjustBtn)) {
          autoCheckItem(qtyAdjustBtn);
          return;
        }

        // 若点击的是数量调节组件的其他区域（如输入框本身或库存提示），不改变勾选状态
        if (e.target.closest('.bundle-product-qty') || e.target.closest('.js-qty__wrapper')) {
          return;
        }

        const isCheckboxTarget = e.target === checkbox || !!e.target.closest('.bundle-product-checked') || !!e.target.closest('.bundle-product-checkbox');

        // 1. 单击对准左侧复选框：直接打勾或取消打勾
        if (isCheckboxTarget) {
          const willBeChecked = !checkbox.checked;
          checkbox.checked = willBeChecked;
          syncItemState(item, willBeChecked);
          item._clickCount = 0;
          if (item._clickTimer) clearTimeout(item._clickTimer);
          checkbox.dispatchEvent(new Event('change', { bubbles: true }));
          return;
        }

        // 2. 点击卡片方块内其他区域（图片、标题、价格、空白处）
        const isCurrentlySelected = item.classList.contains('is-selected') || checkbox.checked;

        if (isCurrentlySelected) {
          // 已勾选时，点击卡片其他区域保持勾选状态，不取消
          e.preventDefault();
        } else {
          // 未勾选时，卡片其他区域需要连续点击 3 次才打勾（每次间隔不超过 1.5 秒）
          e.preventDefault();

          item._clickCount = (item._clickCount || 0) + 1;
          if (item._clickTimer) clearTimeout(item._clickTimer);

          if (item._clickCount >= 3) {
            item._clickCount = 0;
            checkbox.checked = true;
            syncItemState(item, true);
            checkbox.dispatchEvent(new Event('change', { bubbles: true }));
          } else {
            item._clickTimer = setTimeout(function () {
              item._clickCount = 0;
            }, 1500);
          }
        }
      });

      // 手动输入数量时（input 事件，如键盘输入 2）自动打勾
      document.addEventListener('input', function (e) {
        if (e.target && e.target.closest && e.target.closest('.bundle-product-item .js-qty__num')) {
          autoCheckItem(e.target);
        }
      });

      // 监听复选框及数量框 change 事件以同步状态
      document.addEventListener('change', function (e) {
        if (!e.target) return;
        if (e.target.classList.contains('bundle-product-checkbox')) {
          const item = e.target.closest('.bundle-product-item');
          if (item) {
            syncItemState(item, e.target.checked);
          }
        } else if (e.target.closest && e.target.closest('.bundle-product-item .js-qty__num')) {
          autoCheckItem(e.target);
        }
      });
    }

    function initAddToCart() {
      const addBtn = document.querySelector('button.add-to-cart');
      const ajaxCart = new theme.AjaxProduct(addBtn);
      
      addBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        if (addBtn.disabled || addBtn.classList.contains('btn--loading')) {
          return;
        }
        const currentVariantId = getCurrentVariantId();
        if (!currentVariantId) {
          console.warn('Unable to determine the selected variant');
          return;
        }
        const mainQtyInput = document.querySelector('.product__quantity input[name="quantity"]') || document.querySelector('input[name="quantity"]');
        const mainQty = mainQtyInput ? Math.max(1, parseInt(mainQtyInput.value, 10) || 1) : 1;
        const items = [
          { id: currentVariantId, quantity: mainQty }
        ];
        const appendVariantIds = getAppendVariantIds();
        if(appendVariantIds) {
          items.push(...appendVariantIds);
        }
        ajaxCart.MoreProductAddToCart(addBtn, items);
      });
    }
    initBundleTabs();
    initBundleQtySelectors();
    initBundleSelection();
    initAddToCart();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMoreVariantForm);
  } else {
    initMoreVariantForm();
  }
</script>
