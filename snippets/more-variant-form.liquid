        <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
        <line x1="7" y1="7" x2="7.01" y2="7"></line>
      </svg>
      <span>Pair a keyboard with keycaps to get <strong>10% off</strong> keycaps.</span>
    </div>
    <div class="bundle-product-list-container">
      <div class="bundle-product-list--wrapper">
        <div class="bundle-product-list bundle-product-list--1 active">
          {% assign bundle_1_combo_images = product.metafields.custom.bundle_1_combo_images.value
            | default: product.metafields.custom.bundle_1_images.value
          %}
          {%- if is_keyboard -%}
            {% for variant in bundle_1_variants %}
              {% render 'bundle-keycap-item',
                variant: variant,
                forloop: forloop,
                product: product,
                combo_images: bundle_1_combo_images
              %}
            {% endfor %}
          {%- else -%}
            {%- assign seen_addon_ids = ',' -%}
            {% for item in bundle_1_variants %}
