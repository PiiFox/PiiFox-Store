          }

          if (counterEl) {
            counterEl.textContent = `${currentIndex + 1}/${total}`;
            counterEl.style.display = total > 0 ? 'inline-flex' : 'none';
          }

          if (prevBtn) {
            prevBtn.style.display = total > 1 ? 'inline-flex' : 'none';
            prevBtn.disabled = currentIndex <= 0;
            prevBtn.classList.toggle('is-disabled', currentIndex <= 0);
          }

          if (nextBtn) {
            nextBtn.style.display = total > 1 ? 'inline-flex' : 'none';
            nextBtn.disabled = currentIndex >= total - 1;
            nextBtn.classList.toggle('is-disabled', currentIndex >= total - 1);
          }

          if (dotsEl) {
            dotsEl.style.display = total > 1 ? 'flex' : 'none';
            const dots = dotsEl.querySelectorAll('.keycap-overview-modal__dot');
