    function formatMoney(cents) {
      let formatted = '$' + (cents / 100).toFixed(2);
      const moneyFormat = (window.theme && (theme.moneyFormat || (theme.settings && theme.settings.moneyFormat))) || null;
      if (window.theme && window.theme.Currency && typeof window.theme.Currency.formatMoney === 'function') {
        formatted = theme.Currency.formatMoney(cents, moneyFormat);
      }
      if (typeof formatted === 'string') {
        formatted = formatted.replace(/<[^>]*>/g, '').trim();
      }
      return formatted;
    }

    function getCurrentVariantId() {
      const select = document.querySelector('select.product-single__variants') || document.querySelector('select[name="id"]');
      if (select && select.value) {
        return select.value;
      }
      const urlParams = new URLSearchParams(window.location.search);
      const variantId = urlParams.get('variant');
      if (variantId) {
        return variantId;
      }
      const currentVariantJson = document.querySelector('textarea[data-current-variant-json]');
      if (currentVariantJson) {
        try {
          const idInput = JSON.parse(currentVariantJson.value || currentVariantJson.textContent);
          if (idInput && idInput.id) return idInput.id;
        } catch (error) {
          console.warn('Unable to parse current variant JSON', error);
        }
      }
      const variantsJson = document.querySelector('textarea[data-variant-json]');
      if (variantsJson) {
        try {
          const variants = JSON.parse(variantsJson.value || variantsJson.textContent);
          const availableVariant = variants.find(variant => variant.available !== false);
          if (availableVariant && availableVariant.id) return availableVariant.id;
        } catch (error) {
          console.warn('Unable to parse product variants JSON', error);
        }
      }
      return null;
    }
    function getAppendVariantIds() {
      let appendVariantIds = [];
      const serviceCheckbox = document.getElementById('ManualKeycapServiceCheckbox');
      const serviceCard = document.getElementById('ManualKeycapServiceCard');
      const isCustomKeycapsMode =
        typeof window.isKeycapModeCustom === 'function' ? window.isKeycapModeCustom() : true;
      const isServiceChecked = serviceCheckbox && serviceCheckbox.checked;
      const plan = serviceCard && typeof serviceCard._getServicePlan === 'function' ? serviceCard._getServicePlan() : null;
      const isServiceActive = isCustomKeycapsMode && isServiceChecked && plan && plan.sets > 0;

      let allVariants = document.querySelectorAll('.bundle-product-checkbox');
      for(let i = 0; i < allVariants.length; i++) {
        if(allVariants[i].checked) {
          const item = allVariants[i].closest('.bundle-product-item, .bundle-keycap-card');
          const qtyInput = item ? item.querySelector('.js-qty__num') : document.getElementById(`Quantity-${allVariants[i].id}`);
          let quantity = 1;
          if (item && item.classList.contains('bundle-keycap-card')) {
            // Setup 1 键帽：每款固定加购 1 套，不再跟随键盘数量
            quantity = 1;
          } else if (qtyInput) {
            quantity = Math.max(1, Number(qtyInput.value));
          } else {
            const mainQtyInput = document.querySelector('.product__quantity input[name="quantity"]') || document.querySelector('input[name="quantity"]');
            quantity = mainQtyInput ? Math.max(1, parseInt(mainQtyInput.value, 10) || 1) : 1;
          }
          const variantId = allVariants[i].dataset.bundleProduct || allVariants[i].id;
          let selectedVariant = {id: variantId, quantity: quantity};
          appendVariantIds.push(selectedVariant);
        }
      }

      if (isServiceActive) {
        const serviceVariantId = serviceCheckbox.dataset.variantId || '67830185656601';
        let kbDetails = {{ product.title | json }};
        const currentVariantId = getCurrentVariantId();
        const variantsJson = document.querySelector('textarea[data-variant-json]');
        if (variantsJson && currentVariantId) {
          try {
            const variants = JSON.parse(variantsJson.value || variantsJson.textContent);
            const found = variants.find(v => String(v.id) === String(currentVariantId));
            if (found && found.title && found.title !== 'Default Title') {
              const formattedPrice = found.price ? ` - ${formatMoney(found.price)}` : '';
              kbDetails += ` (${found.title}${formattedPrice})`;
            }
          } catch (e) {
            console.warn('Unable to format variant details', e);
          }
        }

        if (plan && plan.keycaps && plan.keycaps.length > 0) {
          // 每套服务包含键盘型号与分配的键帽；相同键帽自动合并，不同键帽自动分行
          plan.keycaps.forEach(k => {
            appendVariantIds.push({
              id: serviceVariantId,
              quantity: 1,
              properties: {
                'For Keyboard': kbDetails,
                'Keycaps Assigned': k.title
              }
            });
          });
        } else {
          // 未选具体键帽时的兜底
          appendVariantIds.push({
            id: serviceVariantId,
            quantity: Math.max(1, plan.sets || 1),
            properties: {
              'For Keyboard': kbDetails
            }
          });
        }
      }

      console.log('appendVariantIds', appendVariantIds);
      return appendVariantIds;
    }
    window.getBundleAppendVariants = getAppendVariantIds;
    window.getBundleCurrentVariantId = getCurrentVariantId;
    function initBundleQtySelectors() {
      document.querySelectorAll('.bundle-product-list .js-qty__wrapper').forEach(el => {
        if (!el._qtySelector && window.theme && window.theme.QtySelector) {
          new theme.QtySelector(el, { namespace: '.product' });
        }
      });
    }
    function initBundleSelection() {
      function syncItemState(item, isChecked) {
        if (!item) return;
        if (isChecked) {
          item.classList.add('is-selected');
        } else {
          item.classList.remove('is-selected');
        }
      }

      function autoCheckItem(target) {
        if (!target) return;
        const item = target.closest('.bundle-product-item');
        if (!item || item.classList.contains('sold-out')) return;

        const checkbox = item.querySelector('.bundle-product-checkbox');
        if (!checkbox || checkbox.disabled || checkbox.checked) return;

        checkbox.checked = true;
        syncItemState(item, true);
        item._clickCount = 0;
        if (item._clickTimer) clearTimeout(item._clickTimer);
        checkbox.dispatchEvent(new Event('change', { bubbles: true }));
      }

      // Initial state sync
      document.querySelectorAll('.bundle-product-checkbox').forEach(cb => {
        const item = cb.closest('.bundle-product-item');
        if (item) {
          syncItemState(item, cb.checked);
        }
      });

      // Click handling on .bundle-product-item:
      // - 未勾选时：需在卡片方块内（空白、图片、标题、价格）连续点击 3 次（每次间隔不超过 1.5 秒）才打勾
      // - 已勾选时：只有刚好点击复选框小方块才可以取消打勾
      // - 数量调节按钮（+ / -）：点击自动打勾
      document.addEventListener('click', function (e) {
        const item = e.target.closest('.bundle-product-item');
        if (!item || item.classList.contains('sold-out')) return;

        const checkbox = item.querySelector('.bundle-product-checkbox');
        if (!checkbox || checkbox.disabled) return;

        // 若点击的是数量调节按钮（+-号），自动打勾，不触发卡片3次点击逻辑
        const qtyAdjustBtn = e.target.closest('.js-qty__adjust');
        if (qtyAdjustBtn && item.contains(qtyAdjustBtn)) {
          autoCheckItem(qtyAdjustBtn);
          return;
        }

        // 若点击的是数量调节组件的其他区域（如输入框本身或库存提示），不改变勾选状态
        if (e.target.closest('.bundle-product-qty') || e.target.closest('.js-qty__wrapper')) {
          return;
        }

        const isCheckboxTarget = e.target === checkbox || !!e.target.closest('.bundle-product-checked') || !!e.target.closest('.bundle-product-checkbox');

        // 1. 单击对准左侧复选框：直接打勾或取消打勾
        if (isCheckboxTarget) {
          const willBeChecked = !checkbox.checked;
          checkbox.checked = willBeChecked;
          syncItemState(item, willBeChecked);
          item._clickCount = 0;
          if (item._clickTimer) clearTimeout(item._clickTimer);
          checkbox.dispatchEvent(new Event('change', { bubbles: true }));
          return;
        }

        // 2. 点击卡片方块内其他区域（图片、标题、价格、空白处）
        const isCurrentlySelected = item.classList.contains('is-selected') || checkbox.checked;

        if (isCurrentlySelected) {
          // 已勾选时，点击卡片其他区域保持勾选状态，不取消
          e.preventDefault();
        } else {
          // 未勾选时，卡片其他区域需要连续点击 3 次才打勾（每次间隔不超过 1.5 秒）
          e.preventDefault();

          item._clickCount = (item._clickCount || 0) + 1;
          if (item._clickTimer) clearTimeout(item._clickTimer);

          if (item._clickCount >= 3) {
            item._clickCount = 0;
            checkbox.checked = true;
            syncItemState(item, true);
            checkbox.dispatchEvent(new Event('change', { bubbles: true }));
          } else {
            item._clickTimer = setTimeout(function () {
              item._clickCount = 0;
            }, 1500);
          }
        }
      });

      // 手动输入数量时（input 事件，如键盘输入 2）自动打勾
      document.addEventListener('input', function (e) {
        if (e.target && e.target.closest && e.target.closest('.bundle-product-item .js-qty__num')) {
          autoCheckItem(e.target);
        }
      });

      // 监听复选框及数量框 change 事件以同步状态
      document.addEventListener('change', function (e) {
        if (!e.target) return;
        if (e.target.classList.contains('bundle-product-checkbox')) {
          const item = e.target.closest('.bundle-product-item');
          if (item) {
            syncItemState(item, e.target.checked);
          }
        } else if (e.target.closest && e.target.closest('.bundle-product-item .js-qty__num')) {
          autoCheckItem(e.target);
        }
      });
    }

    function initAddToCart() {
      const addBtn = document.querySelector('button.add-to-cart');
      const ajaxCart = new theme.AjaxProduct(addBtn);
      
      addBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        if (addBtn.disabled || addBtn.classList.contains('btn--loading')) {
          return;
        }
        if (typeof window.validateKeycapModeBeforePurchase === 'function' && !window.validateKeycapModeBeforePurchase()) {
          return;
        }
        const currentVariantId = getCurrentVariantId();
        if (!currentVariantId) {
          console.warn('Unable to determine the selected variant');
          return;
        }
        const mainQtyInput = document.querySelector('.product__quantity input[name="quantity"]') || document.querySelector('input[name="quantity"]');
        const mainQty = mainQtyInput ? Math.max(1, parseInt(mainQtyInput.value, 10) || 1) : 1;
        const rawItems = [
          { id: currentVariantId, quantity: mainQty }
        ];
        const appendVariantIds = getAppendVariantIds();
        if(appendVariantIds) {
          rawItems.push(...appendVariantIds);
        }

        // 预聚合：相同 variantId 且属性（properties）完全相同的商品预先合并数量，确保提交时就是单条累加数量
        const items = [];
        rawItems.forEach(item => {
          const itemPropsStr = JSON.stringify(item.properties || {});
          const existing = items.find(m => String(m.id) === String(item.id) && JSON.stringify(m.properties || {}) === itemPropsStr);
          if (existing) {
            existing.quantity = (existing.quantity || 1) + (item.quantity || 1);
          } else {
            items.push({ ...item });
          }
        });

        ajaxCart.MoreProductAddToCart(addBtn, items);
      });
    }
    function initSetup1KeycapSelection() {
      const setup1List = document.querySelector('.bundle-product-list--1');
      if (!setup1List) return;

      const cards = setup1List.querySelectorAll('.bundle-keycap-card');
      if (!cards.length) return;

      const isKeyboardProduct = {{ is_keyboard | json }};
      const colorOptionIndex = {{ color_option_index | json }};
      const colorOptionName = {{ color_option_name | json }};
      const allKnownColors = {{ all_color_values_list | split: ',' | json }}.filter(Boolean);
      const variantMediaMap = {{ variant_media_map }};
      const mediaIndexMap = {{ media_index_map }};

      let previewOverlay = null;
      let previewImg = null;
      const mainSlider = document.querySelector('[data-product-photos]');

      if (isKeyboardProduct) {
        previewOverlay = document.querySelector('.bundle-combo-preview');
        if (!previewOverlay) {
          const mainPhotos = document.querySelector('.product__main-photos');
          if (mainPhotos) {
            previewOverlay = document.createElement('div');
            previewOverlay.className = 'bundle-combo-preview';
            previewOverlay.innerHTML = '<div class="bundle-combo-preview-wrap"><img class="bundle-combo-preview-img" src="" alt="Keyboard + Keycap Combo"></div>';
            mainPhotos.appendChild(previewOverlay);
          }
        }
        previewImg = previewOverlay ? previewOverlay.querySelector('.bundle-combo-preview-img') : null;
      }

      function getCurrentColorValue() {
        if (colorOptionIndex > 0) {
          const wrap = document.querySelector(
            `.variant-input-wrap[data-index="option${colorOptionIndex}"], fieldset[name="${colorOptionName}" i], .variant-input-wrap[data-handle="${(colorOptionName || '').toLowerCase()}"]`
          );
          if (wrap) {
            const checked = wrap.querySelector('input[type="radio"]:checked');
            if (checked && checked.value) return checked.value.trim();
            const sel = wrap.querySelector('select');
            if (sel && sel.value) return sel.value.trim();
          }
        }

        const genericWrap = document.querySelector(
          '.variant-input-wrap[data-handle="color"], .variant-input-wrap[data-handle="colour"], .variant-input-wrap[data-handle*="color"], .variant-input-wrap[data-handle*="colour"], .variant-input-wrap[data-handle*="base"], fieldset[name="Color" i], fieldset[name="Colour" i]'
        );
        if (genericWrap) {
          const checked = genericWrap.querySelector('input[type="radio"]:checked');
          if (checked && checked.value) return checked.value.trim();
          const sel = genericWrap.querySelector('select');
          if (sel && sel.value) return sel.value.trim();
        }

        const variant = (typeof getCurrentVariantData === 'function') ? getCurrentVariantData() : null;
        if (variant) {
          if (colorOptionIndex > 0 && variant['option' + colorOptionIndex]) {
            return String(variant['option' + colorOptionIndex]).trim();
          }
          if (Array.isArray(variant.options) && allKnownColors.length) {
            for (const val of variant.options) {
              if (allKnownColors.includes(String(val).toLowerCase().trim())) {
                return String(val).trim();
              }
            }
          }
        }

        return '';
      }

      function normalizeText(str) {
        return String(str || '')
          .toLowerCase()
          .replace(/[\-_/#|,()+:：]/g, ' ')
          .replace(/\s+/g, ' ')
          .trim();
      }

      function extractShortTitle(raw) {
        if (!raw) return '';
        return String(raw)
          .toLowerCase()
          .replace(/\s+(cherry|oem|xda|moa|mda|dsa|kda|asa)?\s*(profile\s*)?keycaps?(\s*set)?$/i, '')
          .trim();
      }

      function findMatchingSlideIndex(card, targetColor) {
        const keycapTitle = (card.dataset.keycapTitle || '').toLowerCase().trim();
        const productTitle = (card.dataset.productTitle || '').toLowerCase().trim();
        const keycapHandle = (card.dataset.keycapHandle || '').toLowerCase().trim();
        const keycapSku = (card.dataset.keycapSku || '').toLowerCase().trim();
        const variantId = (card.dataset.variantId || '').trim();
        const shortTitle = extractShortTitle(keycapTitle || productTitle);
        const fullTitle = normalizeText(productTitle || keycapTitle);

        const currentColor = String(targetColor !== undefined ? targetColor : getCurrentColorValue()).toLowerCase().trim();
        const normalizedCurrentColor = normalizeText(currentColor);

        const currentColorTokens = [];
        if (currentColor) {
          currentColorTokens.push(currentColor);
          if (normalizedCurrentColor && normalizedCurrentColor !== currentColor) {
            currentColorTokens.push(normalizedCurrentColor);
          }
          if (currentColor === 'white' || currentColor.includes('white')) {
            currentColorTokens.push('white', '白色', 'color_white');
          }
          if (currentColor === 'black' || currentColor.includes('black')) {
            currentColorTokens.push('black', '黑色', 'color_black');
          }
        }

        const otherColors = (allKnownColors || [])
          .map(c => c.toLowerCase().trim())
          .filter(c => c && c !== currentColor && !currentColor.includes(c) && !c.includes(currentColor));

        const slides = document.querySelectorAll('[data-product-photos] .product-main-slide');
        let bestIndex = -1;
        let bestScore = -1;

        for (let i = 0; i < slides.length; i++) {
          const slide = slides[i];
          const rawAlt = (slide.dataset.rawAlt || slide.getAttribute('data-raw-alt') || '').toLowerCase();
          const img = slide.querySelector('img');
          const imgAlt = ((img && (img.alt || img.getAttribute('data-alt'))) || '').toLowerCase();
          const altText = (rawAlt + ' ' + imgAlt).trim();
          if (!altText) continue;

          const normalizedAlt = normalizeText(altText);

          // 1. Check if altText matches this keycap
          let matchesKeycap = false;
          let isFullTitleMatch = false;

          if (fullTitle && (normalizedAlt.includes(fullTitle) || altText.includes(keycapTitle) || altText.includes(productTitle))) {
            matchesKeycap = true;
            isFullTitleMatch = true;
          } else if (shortTitle && shortTitle.length >= 2 && (altText.includes(shortTitle) || normalizedAlt.includes(normalizeText(shortTitle)))) {
            matchesKeycap = true;
          } else if (keycapHandle && keycapHandle.length >= 2 && (altText.includes(keycapHandle) || normalizedAlt.includes(keycapHandle.replace(/[^a-z0-9]+/g, ' ')))) {
            matchesKeycap = true;
          } else if (keycapSku && keycapSku.length >= 3 && altText.includes(keycapSku)) {
            matchesKeycap = true;
          } else if (variantId && altText.includes(variantId)) {
            matchesKeycap = true;
          } else if (shortTitle && (
            altText.includes('#keycap_' + shortTitle.replace(/[^a-z0-9]+/g, '-')) ||
            altText.includes('#keycap:' + shortTitle)
          )) {
            matchesKeycap = true;
          }

          if (!matchesKeycap && shortTitle) {
            const words = shortTitle.split(/\s+/).filter(w => w.length >= 3 && !['set', 'profile', 'custom'].includes(w));
            if (words.length && words.every(w => normalizedAlt.includes(w))) {
              matchesKeycap = true;
            }
          }

          if (!matchesKeycap) continue;

          // 2. Score based on color match
          let score = 0;
          if (!currentColor) {
            score = isFullTitleMatch ? 200 : 100;
          } else {
            const hasCurrentColor = currentColorTokens.some(tok => altText.includes(tok) || normalizedAlt.includes(tok));
            const hasOtherColor = otherColors.some(other => altText.includes(other) || normalizedAlt.includes(other));

            // Check direct combination: [Color] + [Full Title] or [Full Title] + [Color]
            const isExactColorFullTitleCombo = fullTitle && (
              normalizedAlt.includes(normalizedCurrentColor + ' ' + fullTitle) ||
              normalizedAlt.includes(fullTitle + ' ' + normalizedCurrentColor)
            );

            if (isExactColorFullTitleCombo && !hasOtherColor) {
              score = 200; // Top Match: 颜色 + 键帽完整Title
            } else if (hasCurrentColor && !hasOtherColor) {
              score = isFullTitleMatch ? 150 : 100; // Matches color and full/short title
            } else if (hasCurrentColor && hasOtherColor) {
              score = 80;  // Matches current color, but mentions another color
            } else if (!hasCurrentColor && !hasOtherColor) {
              score = 50;  // Generic keycap image (no color specified in alt)
            } else {
              score = 10;  // Belongs to another color variant
            }
          }

          if (score > bestScore) {
            bestScore = score;
            const idx = parseInt(slide.dataset.index, 10);
            bestIndex = isNaN(idx) ? i : idx;
          }
        }

        return bestScore >= 50 ? bestIndex : -1;
      }

      // 优先取当前可见的缩略图（图片分组功能会给部分缩略图加 .hide，且主题会重写可见缩略图的 data-index，
      // 导致 data-index 重复；隐藏的缩略图没有绑定主题的 preventDefault，点击会跳转到大图链接）
      function findThumb(index) {
        return document.querySelector(`.product__thumb-item:not(.hide) .product__thumb[data-index="${index}"]`)
          || document.querySelector(`.product__thumb[data-index="${index}"]`);
      }

      function showKeycapImage(card) {
        const matchingIndex = findMatchingSlideIndex(card);
        const comboImageUrl = card.dataset.comboImage;

        if (matchingIndex >= 0) {
          const thumbLink = findThumb(matchingIndex);
          if (thumbLink) {
            thumbLink.click();
          } else if (window.Flickity && mainSlider) {
            const flkty = Flickity.data(mainSlider);
            if (flkty) flkty.select(matchingIndex);
          }
          if (previewOverlay) {
            previewOverlay.classList.remove('is-visible');
          }
          return;
        }

        if (comboImageUrl && previewOverlay && previewImg) {
          previewImg.src = comboImageUrl;
          previewOverlay.classList.add('is-visible');
          return;
        }

        if (previewOverlay) {
          previewOverlay.classList.remove('is-visible');
        }
      }

      function restoreDefaultImage() {
        if (previewOverlay) {
          previewOverlay.classList.remove('is-visible');
        }

        const currentVarId = (typeof getCurrentVariantId === 'function') ? getCurrentVariantId() : null;
        let mediaId = null;
        let targetIndex = -1;

        if (currentVarId && variantMediaMap) {
          mediaId = variantMediaMap[String(currentVarId)];
          if (mediaId && mediaIndexMap && mediaIndexMap[String(mediaId)] !== undefined) {
            targetIndex = mediaIndexMap[String(mediaId)];
          }
        }

        if (mediaId) {
          const thumbByMedia = document.querySelector(`.product__thumb[data-id="${mediaId}"]`);
          if (thumbByMedia) {
            thumbByMedia.click();
            return;
          }
        }

        if (targetIndex >= 0) {
          const thumbByIndex = findThumb(targetIndex);
          if (thumbByIndex) {
            thumbByIndex.click();
            return;
          } else if (window.Flickity && mainSlider) {
            const flkty = Flickity.data(mainSlider);
            if (flkty) {
              flkty.select(targetIndex);
              return;
            }
          }
        }
      }

      if (isKeyboardProduct) {
        document.querySelectorAll('.product__thumb').forEach(thumb => {
          thumb.addEventListener('click', (e) => {
            // 缩略图是 <a href="大图地址">，主题的切换监听未绑定时会直接跳转打开大图，这里统一阻止
            e.preventDefault();
            if (previewOverlay) previewOverlay.classList.remove('is-visible');
          });
        });
      }

      // 记录键帽勾选先后顺序，供安装服务按顺序预填下拉框
      let keycapSelectSeq = 0;

      cards.forEach(card => {
        card.addEventListener('click', function() {
          if (this.classList.contains('sold-out')) return;

          const checkbox = this.querySelector('.bundle-product-checkbox');
          const isSelected = this.classList.contains('is-selected');

          if (isSelected) {
            // 取消勾选当前卡片（支持多选）
            this.classList.remove('is-selected');
            this.setAttribute('aria-pressed', 'false');
            if (checkbox) {
              checkbox.checked = false;
              checkbox.dispatchEvent(new Event('change', { bubbles: true }));
            }
            delete this.dataset.selectedOrder;

            // 键盘商品：检查是否还有其他选中的键帽以切换搭配图
            if (isKeyboardProduct) {
                            const remainingSelected = setup1List.querySelectorAll('.bundle-keycap-card.is-selected');
              if (remainingSelected.length > 0) {
                showKeycapImage(remainingSelected[remainingSelected.length - 1]);
              } else {
                restoreDefaultImage();
              }
            }
          } else {
            // 勾选当前卡片（不影响其他卡片的勾选，支持多选）
            this.classList.add('is-selected');
            this.setAttribute('aria-pressed', 'true');
            if (checkbox) {
              checkbox.checked = true;
              checkbox.dispatchEvent(new Event('change', { bubbles: true }));
            }
            this.dataset.selectedOrder = String(++keycapSelectSeq);

            // 仅键盘商品左侧切换为当前点击键帽的搭配图
            if (isKeyboardProduct) {
              showKeycapImage(this);
            }
          }

          // 同步地址栏 p 参数（勾选加入，取消移除）
          if (typeof window.__syncBundleAnchor === 'function') {
            window.__syncBundleAnchor();
          }
        });

        card.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            this.click();
          }
        });
      });

      function handleVariantColorSwitch(variant) {
        if (!isKeyboardProduct) return;

        const remainingSelected = setup1List.querySelectorAll('.bundle-keycap-card.is-selected');
        if (remainingSelected.length > 0) {
          // 仅当键盘已勾选 STYLE YOUR BOARD 中的键帽时，底座颜色切换后才自动切换到对应新颜色的键帽搭配图
          const currentCard = remainingSelected[remainingSelected.length - 1];
          setTimeout(() => {
            showKeycapImage(currentCard);
          }, 60);
          setTimeout(() => {
            showKeycapImage(currentCard);
          }, 180);
        }
        // 未勾选键帽时：不做任何干涉，主题原生的变体切图逻辑会自动且流畅生效！
      }

      ['variant:change', 'variantChange'].forEach(eventName => {
        document.addEventListener(eventName, function (e) {
          const variant = (e.detail && e.detail.variant) || null;
          handleVariantColorSwitch(variant);
        });
      });

      document.addEventListener('change', function (e) {
        if (!e.target || !e.target.closest) return;
        if (e.target.closest('.variant-input-wrap, [data-variant-input]')) {
          setTimeout(() => {
            const currentVariant = (typeof getCurrentVariantData === 'function') ? getCurrentVariantData() : null;
            handleVariantColorSwitch(currentVariant);
          }, 60);
        }
      });
    }

    function initAddonCardsSelection() {
      const addonsList = document.querySelector('.bundle-product-list--addons');
      if (!addonsList) return;

            const cards = addonsList.querySelectorAll('.bundle-keycap-card');
      cards.forEach(card => {
        card.addEventListener('click', function () {
          if (this.classList.contains('sold-out')) return;

          const checkbox = this.querySelector('.bundle-product-checkbox');
