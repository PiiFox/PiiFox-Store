      or p_cat_name contains 'keycap'
      or p_handle contains 'keycap'
      or p_title contains 'keycap'
      or product.tags contains 'keycaps'
      or product.tags contains 'Keycaps'
      or product.tags contains 'keycap'
      or product.tags contains 'Keycap'
      or p_type contains 'switch'
      or p_cat_name contains 'switch'
      or p_handle contains 'switch'
      or p_type contains 'mouse'
      or p_type contains 'mice'
      or p_cat_name contains 'mouse'
      or p_cat_name contains 'mice'
      or p_handle contains 'mouse'
      or p_type contains 'accessori'
      or p_cat_name contains 'accessori'
      or p_type contains 'service'
    -%}
      {%- assign is_keyboard = true -%}
    {%- endunless -%}
  {%- endif -%}

  {%- comment -%} 2. 判断是否为键帽商品 {%- endcomment -%}
  {%- if p_type contains 'keycap'
    or p_cat_name contains 'keycap'
    or p_handle contains 'keycap'
    or p_title contains 'keycap'
    or product.tags contains 'keycaps'
    or product.tags contains 'Keycaps'
    or product.tags contains 'keycap'
    or product.tags contains 'Keycap'
  -%}
    {%- unless p_type contains 'switch'
      or p_cat_name contains 'switch'
      or p_handle contains 'switch'
      or p_type contains 'mouse'
      or p_type contains 'mice'
      or p_cat_name contains 'mouse'
      or p_cat_name contains 'mice'
      or p_handle contains 'mouse'
      or p_type contains 'accessori'
      or p_cat_name contains 'accessori'
      or p_type contains 'service'
    -%}
      {%- assign is_keycap = true -%}
    {%- endunless -%}
  {%- endif -%}

  {%- assign bundle_1_variants = product.metafields.custom.bundle_1_variants.value -%}
  {%- assign bundle_2_variants = product.metafields.custom.bundle_2_variants.value -%}
  {%- assign bundle_3_variants = product.metafields.custom.bundle_3_variants.value -%}
  {%- assign bundle_1_count = bundle_1_variants.size | default: 0 -%}
  {%- assign bundle_2_count = bundle_2_variants.size | default: 0 -%}
  {%- assign bundle_3_count = bundle_3_variants.size | default: 0 -%}
  {%- assign bundle_total_count = bundle_1_count | plus: bundle_2_count | plus: bundle_3_count -%}

  {%- comment -%} 加购组（原 Setup 2 / Setup 3）：键盘默认折叠，键帽等默认展开 {%- endcomment -%}
  {%- if is_keyboard -%}
    {%- assign bundle_addons_open = false -%}
  {%- else -%}
    {%- assign bundle_addons_open = true -%}
  {%- endif -%}

  {%- comment -%} 仅键盘和键帽展示搭配区域，轴、鼠标、配件等不展示 {%- endcomment -%}
