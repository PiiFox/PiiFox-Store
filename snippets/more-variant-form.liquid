    <div class="product__stock-status-wrap">
      <span data-product-quantity-status class="product-quantity-status {% if current_variant.available %}product-quantity-status--in-stock{% else %}product-quantity-status--out-of-stock{% endif %}">
        {% if current_variant.available %}In Stock{% else %}Out of Stock{% endif %}
      </span>
    </div>

    <div class="payment-buttons product__actions-row">
      <div class="product__quantity">
        {% assign qty_id = section_id | default: section.id | default: product.id | append: product.id %}
        {%- assign current_variant_has_inventory_limit = false -%}
        {%- if current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny' -%}
          {%- assign current_variant_has_inventory_limit = true -%}
          {%- assign current_variant_max_qty = current_variant.inventory_quantity | at_least: 0 -%}
        {%- endif -%}
        {%- render 'quantity-input',
          form_id: form_id,
          id: qty_id,
          qty: 1,
          min: 1,
          max: current_variant_max_qty,
          has_limit: current_variant_has_inventory_limit
        -%}
      </div>

      {%- liquid
        assign default_text = 'products.product.add_to_cart' | t
        assign button_text = 'products.product.add_to_cart' | t
        if template == 'product.preorder'
          assign default_text = 'products.product.preorder' | t
          assign button_text = 'products.product.preorder' | t
        endif
        unless current_variant.available
          assign button_text = 'products.product.sold_out' | t
        endunless
      -%}

      <button
        {% if product.empty? %}
          type="button"
        {% else %}
          type="submit"
        {% endif %}
        name="add"
        data-add-to-cart
        class="btn btn--full add-to-cart"
        {% unless current_variant.available %}
          disabled="disabled"
        {% endunless %}
      >
        <span data-add-to-cart-text data-default-text="{{ default_text }}">
          {{ button_text }}
        </span>
      </button>
    </div>
  </div>

  <div class="shopify-payment-terms product__policies">{{ form | payment_terms }}</div>

  <select name="id" data-product-select class="product-single__variants no-js">
    {%- for variant in product.variants -%}
      {%- if variant.available -%}
        <option
          {% if variant == product.selected_or_first_available_variant %}
            selected="selected"
          {% endif %}
          value="{{ variant.id }}"
        >
          {{ variant.title }} - {{ variant.price | money_with_currency }}
        </option>
      {%- else -%}
        <option disabled="disabled">{{ variant.title }} - {{ 'products.product.sold_out' | t }}</option>
      {%- endif -%}
    {%- endfor -%}
  </select>

  <textarea id="product-json" data-variant-json class="hide" aria-hidden="true" aria-label="Product JSON">
    {{ product.variants | json }}
  </textarea>
  <textarea data-product-inventories class="hide" aria-hidden="true" aria-label="Product Inventories JSON">
    {
      {%- for variant in product.variants -%}
        "{{ variant.id }}": {
          "inventory_management": {{ variant.inventory_management | json }},
          "inventory_policy": {{ variant.inventory_policy | json }},
          "inventory_quantity": {{ variant.inventory_quantity | default: 0 }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    }
  </textarea>
  {%- if product.options.size > 1 -%}
    <textarea data-current-variant-json class="hide" aria-hidden="true" aria-label="Variant JSON">
      {{ current_variant | json }}
    </textarea>
  {%- endif -%}
{%- endform -%}

<script>
  function initMoreVariantForm() {
    function updateBundleListScroll(target) {
      const lists = target ? [target] : document.querySelectorAll('.bundle-product-list.active');
      lists.forEach(list => {
        if (!list) return;
        if (list.classList.contains('bundle-product-list--1')) return;
        // More Add-ons 列表全部展示，不限制高度、不出滚动条
        if (list.classList.contains('bundle-product-list--addons')) return;
        const items = list.querySelectorAll('.bundle-product-item');
        if (items.length >= 4) {
          const item0 = items[0];
          const item1 = items[1];
          const item2 = items[2];
          const item3 = items[3];

          if (item0 && item1 && item2 && item3) {
            const style = window.getComputedStyle(list);
            const gap = parseFloat(style.rowGap || style.gap) || 12;
            const paddingTop = parseFloat(style.paddingTop) || 0;

            const h0 = item0.offsetHeight;
            const h1 = item1.offsetHeight;
            const h2 = item2.offsetHeight;
            const h3 = item3.offsetHeight;

            // 完整露出前3个商品 + 第4个商品露出 50%（露出三个半）
            const maxHeight = paddingTop + h0 + gap + h1 + gap + h2 + gap + (h3 * 0.5);
            list.style.maxHeight = `${Math.round(maxHeight)}px`;
            list.style.overflowY = 'auto';
            list.classList.add('has-scroll');
          }
        } else {
          list.style.maxHeight = '';
          list.style.overflowY = '';
          list.classList.remove('has-scroll');
        }
      });
    }

    // 动态计算移动端 Complete Your Setup 和 More Add-ons 滚动可视高度（精准定位到第二排卡片标题下方）
    function updateMobileCardGridScroll() {
      const isMobile = window.innerWidth <= 768;
      const cardLists = document.querySelectorAll('.bundle-product-list--1, .bundle-product-list--addons');

      cardLists.forEach(list => {
        if (!list) return;

        // 仅在移动端执行动态计算，桌面端清除内联样式恢复原有规则
        if (!isMobile) {
          list.style.removeProperty('max-height');
          list.style.removeProperty('overflow-y');
          list.style.removeProperty('-webkit-overflow-scrolling');
          return;
        }

        // 移动端列数：<= 440px 为 2 列，441px ~ 768px 为 3 列
        const cols = window.innerWidth <= 440 ? 2 : 3;
        const cards = list.querySelectorAll('.bundle-keycap-card');

        // 如果卡片数量不足以排入第二排，不需要滚动条，全部展示
        if (cards.length <= cols) {
          list.style.setProperty('max-height', 'none', 'important');
          list.style.setProperty('overflow-y', 'visible', 'important');
          return;
        }

        // 目标：第二排第一张卡片（索引为 cols）
        const targetCard = cards[cols];
        if (!targetCard) return;

        const titleEl = targetCard.querySelector('.bundle-keycap-card__title') || targetCard;
        const listRect = list.getBoundingClientRect();
        const titleRect = titleEl.getBoundingClientRect();

        // 若面板折叠不可见或尚未渲染，稍后再测
        if (listRect.width === 0 || titleRect.height === 0) return;

        const currentScrollTop = list.scrollTop || 0;
        // 目标：第二排卡片标题之上（刚好截止在第二排卡片标题上方，露出完整第一排卡片及第二排卡片图片）
        const calculatedHeight = Math.round((titleRect.top - listRect.top) + currentScrollTop - 4);

        if (calculatedHeight > 0) {
          list.style.setProperty('max-height', `${calculatedHeight}px`, 'important');
          list.style.setProperty('overflow-y', 'auto', 'important');
          list.style.setProperty('-webkit-overflow-scrolling', 'touch', 'important');
        }
      });
    }

    // 加购组（原 Setup 2 / Setup 3）折叠面板：默认展开/折叠状态由 Liquid 输出（键盘默认折叠，其余默认展开）
    function initBundleAddonGroups() {
      const groups = document.querySelectorAll('[data-bundle-addon-group]');

      groups.forEach(group => {
        const toggle = group.querySelector('[data-bundle-addon-toggle]');
        if (!toggle) return;

        toggle.addEventListener('click', function () {
          const willOpen = !group.classList.contains('is-open');
          group.classList.toggle('is-open', willOpen);
          toggle.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
          if (willOpen) {
            requestAnimationFrame(() => {
              updateMobileCardGridScroll();
            });
          }
        });
      });
    }
    function formatMoney(cents) {
      let formatted = '$' + (cents / 100).toFixed(2);
      const moneyFormat = (window.theme && (theme.moneyFormat || (theme.settings && theme.settings.moneyFormat))) || null;
      if (window.theme && window.theme.Currency && typeof window.theme.Currency.formatMoney === 'function') {
        formatted = theme.Currency.formatMoney(cents, moneyFormat);
      }
      if (typeof formatted === 'string') {
        formatted = formatted.replace(/<[^>]*>/g, '').trim();
      }
      return formatted;
    }

    function getCurrentVariantId() {
      const select = document.querySelector('select.product-single__variants') || document.querySelector('select[name="id"]');
      if (select && select.value) {
        return select.value;
      }
      const urlParams = new URLSearchParams(window.location.search);
      const variantId = urlParams.get('variant');
      if (variantId) {
        return variantId;
      }
      const currentVariantJson = document.querySelector('textarea[data-current-variant-json]');
      if (currentVariantJson) {
        try {
          const idInput = JSON.parse(currentVariantJson.value || currentVariantJson.textContent);
          if (idInput && idInput.id) return idInput.id;
        } catch (error) {
          console.warn('Unable to parse current variant JSON', error);
        }
      }
      const variantsJson = document.querySelector('textarea[data-variant-json]');
      if (variantsJson) {
        try {
          const variants = JSON.parse(variantsJson.value || variantsJson.textContent);
          const availableVariant = variants.find(variant => variant.available !== false);
          if (availableVariant && availableVariant.id) return availableVariant.id;
        } catch (error) {
          console.warn('Unable to parse product variants JSON', error);
        }
      }
      return null;
    }
    function getAppendVariantIds() {
      let appendVariantIds = [];
      const serviceCheckbox = document.getElementById('ManualKeycapServiceCheckbox');
      const serviceCard = document.getElementById('ManualKeycapServiceCard');
      const isServiceChecked = serviceCheckbox && serviceCheckbox.checked;
      const plan = serviceCard && typeof serviceCard._getServicePlan === 'function' ? serviceCard._getServicePlan() : null;
      const isServiceActive = isServiceChecked && plan && plan.sets > 0;

      let allVariants = document.querySelectorAll('.bundle-product-checkbox');
      for(let i = 0; i < allVariants.length; i++) {
        if(allVariants[i].checked) {
          const item = allVariants[i].closest('.bundle-product-item, .bundle-keycap-card');
          const qtyInput = item ? item.querySelector('.js-qty__num') : document.getElementById(`Quantity-${allVariants[i].id}`);
          let quantity = 1;
          if (item && item.classList.contains('bundle-keycap-card')) {
            // Setup 1 键帽：每款固定加购 1 套，不再跟随键盘数量
            quantity = 1;
          } else if (qtyInput) {
            quantity = Math.max(1, Number(qtyInput.value));
          } else {
            const mainQtyInput = document.querySelector('.product__quantity input[name="quantity"]') || document.querySelector('input[name="quantity"]');
            quantity = mainQtyInput ? Math.max(1, parseInt(mainQtyInput.value, 10) || 1) : 1;
          }
          const variantId = allVariants[i].dataset.bundleProduct || allVariants[i].id;
          let selectedVariant = {id: variantId, quantity: quantity};
          appendVariantIds.push(selectedVariant);
        }
      }

      if (isServiceActive) {
        const serviceVariantId = serviceCheckbox.dataset.variantId || '67830185656601';
        let kbDetails = {{ product.title | json }};
        const currentVariantId = getCurrentVariantId();
        const variantsJson = document.querySelector('textarea[data-variant-json]');
        if (variantsJson && currentVariantId) {
          try {
            const variants = JSON.parse(variantsJson.value || variantsJson.textContent);
            const found = variants.find(v => String(v.id) === String(currentVariantId));
            if (found && found.title && found.title !== 'Default Title') {
              const formattedPrice = found.price ? ` - ${formatMoney(found.price)}` : '';
              kbDetails += ` (${found.title}${formattedPrice})`;
            }
          } catch (e) {
            console.warn('Unable to format variant details', e);
          }
        }

        if (plan && plan.keycaps && plan.keycaps.length > 0) {
          // 每套服务包含键盘型号与分配的键帽；相同键帽自动合并，不同键帽自动分行
          plan.keycaps.forEach(k => {
            appendVariantIds.push({
              id: serviceVariantId,
              quantity: 1,
              properties: {
                'For Keyboard': kbDetails,
                'Keycaps Assigned': k.title
              }
            });
          });
        } else {
          // 未选具体键帽时的兜底
          appendVariantIds.push({
            id: serviceVariantId,
            quantity: Math.max(1, plan.sets || 1),
            properties: {
              'For Keyboard': kbDetails
            }
          });
        }
      }

      console.log('appendVariantIds', appendVariantIds);
      return appendVariantIds;
    }
