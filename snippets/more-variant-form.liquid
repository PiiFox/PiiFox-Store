<script>
  $(function () {
    $('.custom-shopify-buy-btn').click(async function (e) {
      if (typeof window.validateKeycapModeBeforePurchase === 'function' && !window.validateKeycapModeBeforePurchase()) {
        e.preventDefault();
        e.stopPropagation();
        return;
      }
      const appendVariants =
        typeof window.getBundleAppendVariants === 'function' ? window.getBundleAppendVariants() : [];
      if (appendVariants && appendVariants.length > 0) {
        e.preventDefault();
        e.stopPropagation();
        const currentVariantId =
          typeof window.getBundleCurrentVariantId === 'function' ? window.getBundleCurrentVariantId() : null;
        if (!currentVariantId) return;
        const mainQtyInput =
          document.querySelector('.product__quantity input[name="quantity"]') ||
          document.querySelector('input[name="quantity"]');
        const mainQty = mainQtyInput ? Math.max(1, parseInt(mainQtyInput.value, 10) || 1) : 1;
        const items = [{ id: currentVariantId, quantity: mainQty }, ...appendVariants];

        const buyBtn = e.currentTarget;
        buyBtn.disabled = true;
        buyBtn.classList.add('btn--loading');
        try {
          await fetch((window.theme && window.theme.routes && window.theme.routes.cartAdd) || '/cart/add.js', {
            method: 'POST',
            body: JSON.stringify({ items: items }),
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          });
          window.location.href = '/checkout';
        } catch (err) {
          console.error('Buy Now bundle failed', err);
          window.location.href = '/checkout';
        }
        return;
      }
      $('.shopify-payment-button button.shopify-payment-button__more-options').click();
    });
  });
</script>
{%- assign is_keyboard = is_keyboard | default: false -%}
{%- assign is_keycap = is_keycap | default: false -%}
{%- assign keycaps_option_index = 0 -%}
{%- assign initial_keycaps_is_non_original = false -%}
{%- for opt in product.options_with_values -%}
  {%- assign opt_name_down = opt.name | downcase | strip -%}
  {%- assign is_keycaps_opt = false -%}
  {%- if opt_name_down contains 'keycap' or opt_name_down contains '键帽' -%}
    {%- assign is_keycaps_opt = true -%}
  {%- else -%}
    {%- for val in opt.values -%}
      {%- assign val_down = val | downcase | strip -%}
      {%- if val_down contains 'non-original' or val_down contains 'non original' or val_down contains 'other style' or val_down contains 'other-style' or val_down contains '非原装' -%}
        {%- assign is_keycaps_opt = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if is_keycaps_opt -%}
    {%- assign keycaps_option_index = forloop.index -%}
    {%- assign selected_kc_val = opt.selected_value | downcase | strip -%}
    {%- if selected_kc_val contains 'non-original' or selected_kc_val contains 'non original' or selected_kc_val contains 'other style' or selected_kc_val contains 'other-style' or selected_kc_val == 'custom' or selected_kc_val contains '非原装' -%}
      {%- assign initial_keycaps_is_non_original = true -%}
    {%- endif -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- assign color_option_index = 0 -%}
{%- assign color_option_name = '' -%}
{%- assign all_color_values_list = '' -%}
{%- for opt in product.options_with_values -%}
  {%- assign opt_down = opt.name | downcase | strip -%}
  {%- if opt_down == 'color' or opt_down == 'colour' or opt_down contains 'color' or opt_down contains 'colour' or opt_down contains 'base' or opt_down contains 'case' or opt_down contains '颜色' or opt_down contains '底座' or opt_down contains '外壳' -%}
    {%- assign color_option_index = forloop.index -%}
    {%- assign color_option_name = opt.name -%}
    {%- capture all_color_values_list -%}{%- for v in opt.values -%}{{ v | downcase | strip }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}{%- endcapture -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- capture variant_media_map -%}
  {
    {%- for v in product.variants -%}
      "{{ v.id }}": {{ v.featured_media.id | default: v.featured_image.id | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  }
{%- endcapture -%}
{%- capture media_index_map -%}
  {
    {%- for m in product.media -%}
      "{{ m.id }}": {{ forloop.index0 }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  }
{%- endcapture -%}

{%- assign bundle_1_variants = product.metafields.custom.bundle_1_variants.value -%}
{%- assign bundle_2_variants = product.metafields.custom.bundle_2_variants.value -%}
{%- assign bundle_3_variants = product.metafields.custom.bundle_3_variants.value -%}
{%- assign bundle_1_count = bundle_1_variants.size | default: 0 -%}
{%- assign bundle_2_count = bundle_2_variants.size | default: 0 -%}
{%- assign bundle_3_count = bundle_3_variants.size | default: 0 -%}
{%- assign bundle_total_count = bundle_1_count | plus: bundle_2_count | plus: bundle_3_count -%}

{%- comment -%} 加购组（原 Setup 2 / Setup 3）：键盘默认折叠，键帽等默认展开 {%- endcomment -%}
{%- if is_keyboard -%}
  {%- assign bundle_addons_open = false -%}
{%- else -%}
  {%- assign bundle_addons_open = true -%}
{%- endif -%}

{%- comment -%} 仅键盘和键帽展示搭配区域，轴、鼠标、配件等不展示 {%- endcomment -%}
{%- assign show_complete_setup = false -%}
{%- if is_keyboard -%}
  {%- if bundle_1_count > 0 -%}
    {%- assign show_complete_setup = true -%}
  {%- endif -%}
{%- elsif is_keycap -%}
  {%- if bundle_1_count > 0 or bundle_total_count > 0 -%}
    {%- assign show_complete_setup = true -%}
  {%- endif -%}
{%- endif -%}

{%- if show_complete_setup -%}
  <div class="bundle-list" {% if is_keyboard %}id="StyleYourBoardBox"{% endif %}>
    <div class="bundle-list-header">
      {%- if is_keyboard -%}
        {%- if keycaps_option_index > 0 -%}
          <div class="bundle-list-header__top">
            <div class="bundle-list-badge bundle-list-badge--lime">
              STYLE YOUR BOARD
            </div>
            <span
              class="bundle-list-status"
              id="StyleBoardModeStatus"
              data-state="{% if initial_keycaps_is_non_original %}pending{% else %}neutral{% endif %}"
            >
              {%- if initial_keycaps_is_non_original -%}
                Pick 1+ Keycap Set
              {%- else -%}
                Optional Add-on
              {%- endif -%}
            </span>
          </div>
        {%- else -%}
          <div class="bundle-list-badge bundle-list-badge--lime">
            STYLE YOUR BOARD
          </div>
        {%- endif -%}
        <div class="bundle-list-subtitle bundle-list-subtitle--lime">
          <svg class="bundle-list-subtitle__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#70bb00" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
            <line x1="7" y1="7" x2="7.01" y2="7"></line>
          </svg>
          <span>Pair a keyboard with keycaps to get <strong>20% off keycaps.</strong></span>
        </div>
      {%- else -%}
        <div class="bundle-list-badge bundle-list-badge--pink">
          DOUBLE YOUR STYLE
        </div>
        <div class="bundle-list-subtitle bundle-list-subtitle--pink">
          <svg class="bundle-list-subtitle__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#ff007f" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
            <line x1="7" y1="7" x2="7.01" y2="7"></line>
          </svg>
          <span>Buy 2 keycap sets to get <strong>10% off keycaps.</strong></span>
        </div>
      {%- endif -%}
    </div>
    <div class="bundle-product-list-container">
      <div class="bundle-product-list--wrapper">
        <div class="bundle-product-list bundle-product-list--1 active">
          {% assign bundle_1_combo_images = product.metafields.custom.bundle_1_combo_images.value
            | default: product.metafields.custom.bundle_1_images.value
          %}
          {%- if is_keyboard -%}
            {% for variant in bundle_1_variants %}
              {% render 'bundle-keycap-item',
                variant: variant,
                forloop: forloop,
                product: product,
                combo_images: bundle_1_combo_images
              %}
            {% endfor %}
          {%- else -%}
            {%- assign seen_addon_ids = ',' -%}
            {% for item in bundle_1_variants %}
              {%- assign v = item -%}
              {%- if item.variants -%}
                {%- assign v = item.selected_or_first_available_variant | default: item.variants.first -%}
              {%- endif -%}
              {%- assign v_id = v.id | append: '' -%}
              {%- assign key = ',' | append: v_id | append: ',' -%}
              {%- unless seen_addon_ids contains key -%}
                {%- if v_id != blank -%}
                  {%- assign seen_addon_ids = seen_addon_ids | append: v_id | append: ',' -%}
                {%- endif -%}
                {% render 'bundle-variant-item', variant: item %}
              {%- endunless -%}
            {% endfor %}
            {% for item in bundle_2_variants %}
              {%- assign v = item -%}
              {%- if item.variants -%}
                {%- assign v = item.selected_or_first_available_variant | default: item.variants.first -%}
              {%- endif -%}
              {%- assign v_id = v.id | append: '' -%}
              {%- assign key = ',' | append: v_id | append: ',' -%}
              {%- unless seen_addon_ids contains key -%}
                {%- if v_id != blank -%}
                  {%- assign seen_addon_ids = seen_addon_ids | append: v_id | append: ',' -%}
                {%- endif -%}
                {% render 'bundle-variant-item', variant: item %}
              {%- endunless -%}
            {% endfor %}
            {% for item in bundle_3_variants %}
              {%- assign v = item -%}
              {%- if item.variants -%}
                {%- assign v = item.selected_or_first_available_variant | default: item.variants.first -%}
              {%- endif -%}
              {%- assign v_id = v.id | append: '' -%}
              {%- assign key = ',' | append: v_id | append: ',' -%}
              {%- unless seen_addon_ids contains key -%}
                {%- if v_id != blank -%}
                  {%- assign seen_addon_ids = seen_addon_ids | append: v_id | append: ',' -%}
                {%- endif -%}
                {% render 'bundle-variant-item', variant: item %}
              {%- endunless -%}
            {% endfor %}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{%- if is_keyboard -%}
  {%- assign service_product = all_products['manual-keycap-installation-service'] -%}
  {%- assign service_variant = service_product.selected_or_first_available_variant
    | default: service_product.variants.first
  -%}
  {%- assign service_variant_id = service_variant.id | default: 67830185656601 -%}
  {%- assign service_title = 'Custom Keycap Installation' -%}
  {%- assign service_initially_hidden = false -%}
  {%- if bundle_1_count > 0 and keycaps_option_index > 0 and initial_keycaps_is_non_original == false -%}
    {%- assign service_initially_hidden = true -%}
  {%- endif -%}

  <div
    class="manual-service-card has-sale-badge{% unless service_initially_hidden %} is-active{% endunless %}"
    id="ManualKeycapServiceCard"
    data-variant-id="{{ service_variant_id }}"
    tabindex="0"
    role="checkbox"
    aria-checked="{% if service_initially_hidden %}false{% else %}true{% endif %}"
    {% if service_initially_hidden %}
      hidden
    {% endif %}
  >
    <div class="manual-service-card__sale-badge" aria-hidden="true">
      <span class="manual-service-card__sale-text">FREE</span>
    </div>
    <div class="manual-service-card__inner">
      <div class="manual-service-card__checkbox-wrap">
        <input
          type="checkbox"
          id="ManualKeycapServiceCheckbox"
          class="manual-service-card__checkbox"
          data-variant-id="{{ service_variant_id }}"
          aria-label="{{ service_title }}"
          {% unless service_initially_hidden %}
            checked="checked"
          {% endunless %}
        >
        <span class="manual-service-card__checkbox-custom" aria-hidden="true">
          <svg viewBox="0 0 12 10" fill="none" class="manual-service-card__check-icon">
            <path d="M1 5l3.5 3.5L11 1.5" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </div>
      <div class="manual-service-card__content">
        <div class="manual-service-card__header">
          <label for="ManualKeycapServiceCheckbox" class="manual-service-card__title">
            {{ service_title }}
          </label>
        </div>
        <div class="manual-service-card__desc">
          We'll professionally install your selected keycaps before shipping, so your keyboard arrives customized to your style and ready to use right out of the box. <a href="/pages/style-studio?view=style-studio" class="manual-service-card__link">Learn more about this service.</a>
        </div>
        <div class="manual-service-card__notice">
          <svg viewBox="0 0 16 16" fill="none" class="manual-service-card__notice-icon" aria-hidden="true">
            <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.25"/>
            <path d="M8 7v4M8 4.75h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <span class="manual-service-card__notice-text">Original keycaps will not be included in the shipment.</span>
        </div>
        <div class="manual-service-card__prompt" id="ManualKeycapServicePrompt" style="display: none;">
          <svg viewBox="0 0 16 16" fill="none" class="manual-service-card__prompt-icon" aria-hidden="true">
            <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.25"/>
            <path d="M8 7v4M8 4.75h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <span class="manual-service-card__prompt-text"></span>
        </div>
        <div class="manual-service-card__assign" id="ManualKeycapServiceAssign" hidden></div>
      </div>
    </div>
  </div>
{%- endif -%}

{%- comment -%} 原 Setup 2 + Setup 3 合并为一个可折叠加购组（仅键盘展示，非键盘已整合至 Complete Your Setup） {%- endcomment -%}
{%- assign addon_count = bundle_2_count | plus: bundle_3_count -%}
{%- if is_keyboard and addon_count > 0 -%}
  {%- assign addon_panel_id = 'BundleAddonPanel-' | append: product.id -%}
  {%- assign addon_toggle_id = 'BundleAddonToggle-' | append: product.id -%}
  <div class="bundle-addons">
    <div class="bundle-addon-group{% if bundle_addons_open %} is-open{% endif %}" data-bundle-addon-group>
      <button
        type="button"
        class="bundle-addon-group__toggle"
        id="{{ addon_toggle_id }}"
        aria-expanded="{{ bundle_addons_open }}"
        aria-controls="{{ addon_panel_id }}"
        data-bundle-addon-toggle
      >
        <span class="bundle-addon-group__heading">
          <span class="bundle-addon-group__title">More Add-ons</span>
        </span>
        <svg class="bundle-addon-group__chevron" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div
        class="bundle-addon-group__panel"
        id="{{ addon_panel_id }}"
        role="region"
        aria-labelledby="{{ addon_toggle_id }}"
      >
        <div class="bundle-addon-group__panel-inner">
          <div class="bundle-product-list bundle-product-list--addons active">
            {%- assign addon_seen_ids = ',' -%}
            {% for variant in bundle_2_variants %}
              {%- assign addon_seen_ids = addon_seen_ids | append: variant.id | append: ',' -%}
              {% render 'bundle-variant-item', variant: variant %}
            {% endfor %}
            {% for variant in bundle_3_variants %}
              {%- assign addon_key = ',' | append: variant.id | append: ',' -%}
              {%- unless addon_seen_ids contains addon_key -%}
                {% render 'bundle-variant-item', variant: variant %}
              {%- endunless -%}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{%- form 'product', product, id: form_id, class: 'product-single__form' -%}
  {%- if is_keyboard and show_complete_setup and keycaps_option_index > 0 -%}
    <div
      class="keycap-validation-notice"
      id="KeycapValidationNotice"
      role="alert"
      {% unless initial_keycaps_is_non_original %}
        hidden
      {% endunless %}
    >
      <svg viewBox="0 0 16 16" fill="none" class="keycap-validation-notice__icon" aria-hidden="true">
        <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.35"/>
        <path d="M8 4.75v4M8 11.25h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <span>Please select at least 1 keycap set in <strong>STYLE YOUR BOARD</strong> for your custom build.</span>
    </div>
  {%- endif -%}
  <div class="product-form__actions-group">
    <div class="payment-buttons product__actions-row">
      <div class="product__quantity">
        {% assign qty_id = section_id | default: section.id | default: product.id | append: product.id %}
        {%- assign current_variant_has_inventory_limit = false -%}
        {%- if current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny' -%}
          {%- assign current_variant_has_inventory_limit = true -%}
          {%- assign current_variant_max_qty = current_variant.inventory_quantity | at_least: 0 -%}
        {%- endif -%}
        {%- render 'quantity-input',
          form_id: form_id,
          id: qty_id,
          qty: 1,
          min: 1,
          max: current_variant_max_qty,
          has_limit: current_variant_has_inventory_limit
        -%}
      </div>

      {%- liquid
        assign default_text = 'products.product.add_to_cart' | t
        assign button_text = 'products.product.add_to_cart' | t
        if template == 'product.preorder'
          assign default_text = 'products.product.preorder' | t
          assign button_text = 'products.product.preorder' | t
        endif
        unless current_variant.available
          assign button_text = 'products.product.sold_out' | t
        endunless
      -%}

      <button
        {% if product.empty? %}
          type="button"
        {% else %}
          type="submit"
        {% endif %}
        name="add"
        data-add-to-cart
        class="btn btn--full add-to-cart"
        {% unless current_variant.available %}
          disabled="disabled"
        {% endunless %}
      >
        <span data-add-to-cart-text data-default-text="{{ default_text }}">
          {{ button_text }}
        </span>
      </button>
    </div>
  </div>

  <div class="shopify-payment-terms product__policies">{{ form | payment_terms }}</div>

  <select name="id" data-product-select class="product-single__variants no-js">
    {%- for variant in product.variants -%}
      {%- if variant.available -%}
        <option
          {% if variant == product.selected_or_first_available_variant %}
            selected="selected"
          {% endif %}
          value="{{ variant.id }}"
        >
          {{ variant.title }} - {{ variant.price | money_with_currency }}
        </option>
      {%- else -%}
        <option disabled="disabled">{{ variant.title }} - {{ 'products.product.sold_out' | t }}</option>
      {%- endif -%}
    {%- endfor -%}
  </select>

  <textarea id="product-json" data-variant-json class="hide" aria-hidden="true" aria-label="Product JSON">
    {{ product.variants | json }}
  </textarea>
  <textarea data-product-inventories class="hide" aria-hidden="true" aria-label="Product Inventories JSON">
    {
      {%- for variant in product.variants -%}
        "{{ variant.id }}": {
          "inventory_management": {{ variant.inventory_management | json }},
          "inventory_policy": {{ variant.inventory_policy | json }},
          "inventory_quantity": {{ variant.inventory_quantity | default: 0 }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    }
  </textarea>
  {%- if product.options.size > 1 -%}
    <textarea data-current-variant-json class="hide" aria-hidden="true" aria-label="Variant JSON">
      {{ current_variant | json }}
    </textarea>
  {%- endif -%}
{%- endform -%}

<script>
  function initMoreVariantForm() {
    function updateBundleListScroll(target) {
      const lists = target ? [target] : document.querySelectorAll('.bundle-product-list.active');
      lists.forEach(list => {
        if (!list) return;
        if (list.classList.contains('bundle-product-list--1')) return;
        // More Add-ons 列表全部展示，不限制高度、不出滚动条
        if (list.classList.contains('bundle-product-list--addons')) return;
        const items = list.querySelectorAll('.bundle-product-item');
        if (items.length >= 4) {
          const item0 = items[0];
          const item1 = items[1];
          const item2 = items[2];
          const item3 = items[3];

          if (item0 && item1 && item2 && item3) {
            const style = window.getComputedStyle(list);
            const gap = parseFloat(style.rowGap || style.gap) || 12;
            const paddingTop = parseFloat(style.paddingTop) || 0;

            const h0 = item0.offsetHeight;
            const h1 = item1.offsetHeight;
            const h2 = item2.offsetHeight;
            const h3 = item3.offsetHeight;

            // 完整露出前3个商品 + 第4个商品露出 50%（露出三个半）
            const maxHeight = paddingTop + h0 + gap + h1 + gap + h2 + gap + (h3 * 0.5);
            list.style.maxHeight = `${Math.round(maxHeight)}px`;
            list.style.overflowY = 'auto';
            list.classList.add('has-scroll');
          }
        } else {
          list.style.maxHeight = '';
          list.style.overflowY = '';
          list.classList.remove('has-scroll');
        }
      });
    }

    // 动态计算移动端 Complete Your Setup 和 More Add-ons 滚动可视高度（精准定位到第二排卡片标题下方）
    function updateMobileCardGridScroll() {
      const isMobile = window.innerWidth <= 768;
      const cardLists = document.querySelectorAll('.bundle-product-list--1, .bundle-product-list--addons');

      cardLists.forEach(list => {
        if (!list) return;

        // 仅在移动端执行动态计算，桌面端清除内联样式恢复原有规则
        if (!isMobile) {
          list.style.removeProperty('max-height');
          list.style.removeProperty('overflow-y');
          list.style.removeProperty('-webkit-overflow-scrolling');
          return;
        }

        // 移动端列数：<= 440px 为 2 列，441px ~ 768px 为 3 列
        const cols = window.innerWidth <= 440 ? 2 : 3;
        const cards = list.querySelectorAll('.bundle-keycap-card');

        // 如果卡片数量不足以排入第二排，不需要滚动条，全部展示
        if (cards.length <= cols) {
          list.style.setProperty('max-height', 'none', 'important');
          list.style.setProperty('overflow-y', 'visible', 'important');
          return;
        }

        // 目标：第二排第一张卡片（索引为 cols）
        const targetCard = cards[cols];
        if (!targetCard) return;

        const titleEl = targetCard.querySelector('.bundle-keycap-card__title') || targetCard;
        const listRect = list.getBoundingClientRect();
        const titleRect = titleEl.getBoundingClientRect();

        // 若面板折叠不可见或尚未渲染，稍后再测
        if (listRect.width === 0 || titleRect.height === 0) return;

        const currentScrollTop = list.scrollTop || 0;
        // 目标：第二排卡片标题之上（刚好截止在第二排卡片标题上方，露出完整第一排卡片及第二排卡片图片）
        const calculatedHeight = Math.round((titleRect.top - listRect.top) + currentScrollTop - 4);

        if (calculatedHeight > 0) {
          list.style.setProperty('max-height', `${calculatedHeight}px`, 'important');
          list.style.setProperty('overflow-y', 'auto', 'important');
          list.style.setProperty('-webkit-overflow-scrolling', 'touch', 'important');
        }
      });
    }

