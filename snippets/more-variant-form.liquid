                // 搭配区商品卡片选中状态 <-> 地址栏 p 参数 同步（支持多选，逗号分隔；取消选中则移除）
    function initBundleAnchorUrl() {
      // 读取地址栏中的锚点数组
      function readAnchors() {
        const params = new URLSearchParams(window.location.search);
        const raw = params.get('p') || '';
        return raw
          .split(',')
          .map(s => s.trim())
          .filter(Boolean);
      }

      // 用一个或多个锚点写入地址栏（replaceState，不刷新页面）
      function writeAnchors(anchors) {
        const params = new URLSearchParams(window.location.search);
        const unique = Array.from(new Set((anchors || []).filter(Boolean)));
        if (unique.length > 0) {
          params.set('p', unique.join(','));
        } else {
          params.delete('p');
        }
                const search = '?' + params.toString();
        // 地址未变化则不重复写入（若地址里缺少 variant 则仍需补写，避免商品标识被覆盖丢失）
        if (window.location.search === search && params.has('variant')) return;
        window.history.replaceState(
          window.history.state,
          '',
          window.location.pathname + search + window.location.hash
        );
      }

      // 记录当前选中的变体，避免主题切换变体时把地址里已有的 p 参数（商品标识）覆盖掉
      function getVariantFromUrl() {
        return new URLSearchParams(window.location.search).get('variant') || '';
      }
      let lastVariantId = getVariantFromUrl();

      // 主题切换变体会用 replaceState 整体重写地址（只保留 ?variant=xxx），这里在其后再补回 p 参数
      function keepBundleAnchors() {
        const currentVariantId = getVariantFromUrl();
        if (currentVariantId === lastVariantId) return;
        lastVariantId = currentVariantId;

        const params = new URLSearchParams(window.location.search);
        const anchors = [];
        document.querySelectorAll('.bundle-product-list--1 [data-bundle-anchor], .bundle-product-list--addons [data-bundle-anchor]').forEach(card => {
          if (card.classList.contains('is-selected') && card.dataset.bundleAnchor) {
            anchors.push(card.dataset.bundleAnchor);
          }
        });
        if (!anchors.length) return;

        params.set('p', Array.from(new Set(anchors)).join(','));
        const search = '?' + params.toString();
        if (window.location.search === search) return;
        window.history.replaceState(
          window.history.state,
          '',
          window.location.pathname + search + window.location.hash
        );
            }


      // 收集当前所有已选中卡片的锚点，并同步到地址栏
      function syncAnchorFromSelection() {
        const anchors = [];
        // 注意：ANCHOR_LIST_SELECTOR 是逗号分隔的选择器组，需分别拼接锚点选择器，否则逗号会导致匹配错误
        document.querySelectorAll('.bundle-product-list--1 [data-bundle-anchor], .bundle-product-list--addons [data-bundle-anchor]').forEach(card => {
          if (card.classList.contains('is-selected') && card.dataset.bundleAnchor) {
            anchors.push(card.dataset.bundleAnchor);
          }
        });
        writeAnchors(anchors);
      }
      // 暴露给卡片点击逻辑调用（勾选/取消勾选后同步地址栏）
      window.__syncBundleAnchor = syncAnchorFromSelection;

      // 勾选锚点对应的商品卡片（已勾选或售罄则跳过）
      // 通过触发卡片点击，复用已有的选中逻辑（同步 is-selected、复选框、搭配图切换、安装服务等）
      function selectAnchorCard(el) {
        if (!el || el.classList.contains('sold-out')) return;
        const checkbox = el.querySelector('.bundle-product-checkbox');
        if (!checkbox || checkbox.disabled) return;
        if (checkbox.checked && el.classList.contains('is-selected')) return;

        el.click();
      }

      // 展开分组并将锚点卡片滚动到可视区域
      function scrollToAnchor(anchor, tries) {
        if (!anchor) return;
        const el = document.getElementById('bundle-card-' + anchor);
        if (!el) {
          if ((tries || 0) < 10) {
            setTimeout(() => scrollToAnchor(anchor, (tries || 0) + 1), 300);
          }
          return;
        }
        // 若目标位于折叠的 More Add-ons 面板内，先展开
        const addonGroup = el.closest('[data-bundle-addon-group]');
        if (addonGroup && !addonGroup.classList.contains('is-open')) {
          const toggle = addonGroup.querySelector('[data-bundle-addon-toggle]');
          if (toggle) toggle.click();
        }

        // 对应滚动容器：清单本身可能带横向或纵向滚动条，需要滚动容器使其显示
        const list = el.closest('.bundle-product-list');
        if (list) {
          if (list.scrollWidth > list.clientWidth + 4) {
            const cardLeft = el.offsetLeft - list.offsetLeft;
            list.scrollTo({ left: Math.max(0, cardLeft), behavior: 'smooth' });
          } else if (list.scrollHeight > list.clientHeight + 4) {
            const cardTop = el.offsetTop - list.offsetTop + list.scrollTop;
            list.scrollTo({ top: Math.max(0, cardTop), behavior: 'smooth' });
          }
        }
        const rect = el.getBoundingClientRect();
        const inViewport = rect.top >= 0 && rect.bottom <= (window.innerHeight || document.documentElement.clientHeight);
        if (!inViewport) {
          el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }

            // 从地址栏恢复：逐个勾选所有锚点对应商品，并滚动到第一个
      function restoreFromUrl() {
        const anchors = readAnchors();
        if (!anchors.length) return;

        // 若任一锚点商品位于 More Add-ons 面板内，则默认展开该面板
        anchors.forEach(anchor => {
          const el = document.getElementById('bundle-card-' + anchor);
          if (!el) return;
          const addonGroup = el.closest('[data-bundle-addon-group]');
          if (addonGroup && !addonGroup.classList.contains('is-open')) {
            const toggle = addonGroup.querySelector('[data-bundle-addon-toggle]');
            if (toggle) toggle.click();
          }
        });

        anchors.forEach(anchor => {
          const el = document.getElementById('bundle-card-' + anchor);
          if (el) selectAnchorCard(el);
        });

        // 滚动定位到第一个锚点（等勾选渲染完成后）
        setTimeout(() => {
          scrollToAnchor(anchors[0], 0);
          // 确保地址栏与最终选中状态一致（去除无效/售罄锚点）
          syncAnchorFromSelection();
        }, 50);
      }

            // 从地址栏恢复（例如分享链接 / 刷新）
      restoreFromUrl();

      // 包装 history.replaceState：主题切换变体后若把 p 参数覆盖掉，立即补回
      const originalReplaceState = window.history.replaceState;
      window.history.replaceState = function (state, title, url) {
        const result = originalReplaceState.apply(this, arguments);
        setTimeout(keepBundleAnchors, 0);
        return result;
      };

      // 兜底：变体选项、变体选择器变化后也检查一次（不依赖 replaceState 的调用时机）
      ['change', 'variantChange', 'shopify:section:load'].forEach(function (eventName) {
        document.addEventListener(eventName, function (e) {
          if (!e.target || !e.target.closest) return;
          if (e.target.closest('.product-single__form, .variant-input-wrap, [data-product-form], [data-section-type="product"]')) {
            setTimeout(keepBundleAnchors, 0);
          }
        }, true);
      });
    }


    function initManualInstallationService() {
      const card = document.getElementById('ManualKeycapServiceCard');
      const checkbox = document.getElementById('ManualKeycapServiceCheckbox');
      if (!card || !checkbox) return;

      const promptEl = document.getElementById('ManualKeycapServicePrompt');
      const promptText = promptEl ? promptEl.querySelector('.manual-service-card__prompt-text') : null;
      const setup1List = document.querySelector('.bundle-product-list--1');
      const hasSetup1Keycaps = !!(setup1List && setup1List.querySelector('.bundle-keycap-card'));

      // 记录用户是否手动取消勾选（默认勾选安装服务）
      let userOptedOut = false;

      function escapeHtml(str) {
        return String(str).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
      }

      function getKeyboardQty() {
        const mainQtyInput = document.querySelector('.product__quantity input[name="quantity"]') || document.querySelector('input[name="quantity"]');
        return mainQtyInput ? Math.max(1, parseInt(mainQtyInput.value, 10) || 1) : 1;
      }

      // Setup 1 中已选键帽，按勾选先后排序
      function getSelectedKeycaps() {
        if (!setup1List) return [];
        return Array.from(setup1List.querySelectorAll('.bundle-keycap-card.is-selected'))
          .map((el, domIndex) => {
            const titleEl = el.querySelector('.bundle-keycap-card__title');
            const order = parseInt(el.dataset.selectedOrder, 10);
            return {
              id: String(el.dataset.variantId || domIndex),
              title: (el.dataset.keycapTitle || (titleEl && titleEl.textContent) || 'Keycaps').trim(),
              sortKey: isNaN(order) ? 1e9 + domIndex : order
            };
          })
          .sort((a, b) => a.sortKey - b.sortKey);
      }

      // 安装方案（Other Style 模式下仅可选择 1 套键帽，无需再选择安装哪套键帽）：
      // - none：页面没有 Setup 1 键帽，按键盘数量计服务
      // - empty：未选中任何 Setup 1 键帽
      // - simple：已选 1 套键帽，直接为 1 把键盘安装该键帽
      function computePlan() {
        const keyboards = getKeyboardQty();
        const selected = getSelectedKeycaps();

        if (!hasSetup1Keycaps) {
          return { mode: 'none', sets: keyboards, keyboards, selected, keycaps: [] };
        }
        if (!selected.length) {
          return { mode: 'empty', sets: 0, keyboards, selected: [], keycaps: [] };
        }

        const keycap = selected[selected.length - 1];
        return {
          mode: 'simple',
          sets: 1,
          keyboards,
          selected: [keycap],
          keycaps: [{ ...keycap, keyboardIndex: 1 }]
        };
      }


      function setChecked(isChecked) {
        checkbox.checked = isChecked;
        card.classList.toggle('is-active', isChecked);
        card.setAttribute('aria-checked', isChecked ? 'true' : 'false');
      }

      function render() {
        const plan = computePlan();

        card.classList.remove('is-disabled');
        checkbox.disabled = false;

        if (plan.mode === 'none' || !plan.selected.length) {
          if (promptEl) promptEl.style.display = 'none';
        } else {
          if (promptEl && promptText) {
            if (checkbox.checked) {
              promptEl.classList.add('is-confirmed');
              promptText.innerHTML = `<strong>1 set</strong> of installation · Keycaps to be installed: <strong>${escapeHtml(plan.keycaps[0].title)}</strong>`;
              promptEl.style.display = 'flex';
            } else {
              promptEl.style.display = 'none';
            }
          }
        }

        return plan;
      }

      // 供加购时读取当前安装方案
      card._getServicePlan = computePlan;
      // 供键帽规格切换与搭配键帽勾选状态变化时同步显隐与勾选状态
      // 选择了键帽就勾选人工安装服务，没有选择键帽就不勾选
      card._syncKeycapsState = function (showService, hasSelectedKeycap) {
        card.hidden = !showService;
        if (!showService) {
          setChecked(false);
        } else {
          setChecked(!!hasSelectedKeycap);
        }
        render();
      };
      card._syncModeVisibility = card._syncKeycapsState;

      function toggleState(willBeChecked) {
        userOptedOut = !willBeChecked;
        setChecked(willBeChecked);
        render();
      }

      card.addEventListener('click', function (e) {
        if (e.target === checkbox) return;
        if (e.target.closest && e.target.closest('.manual-service-card__link')) return;
        e.preventDefault();
        toggleState(!checkbox.checked);
      });

      checkbox.addEventListener('change', function () {
        toggleState(checkbox.checked);
      });

      card.addEventListener('keydown', function (e) {
        if (e.target.closest && e.target.closest('.manual-service-card__link')) return;
        if (e.key === ' ' || e.key === 'Enter') {
          e.preventDefault();
          toggleState(!checkbox.checked);
        }
      });

      document.addEventListener('input', function (e) {
        if (e.target && e.target.matches && e.target.matches('input[name="quantity"], .product__quantity input')) {
          render();
        }
      });
      document.addEventListener('change', function (e) {
        if (e.target && e.target.matches && e.target.matches('input[name="quantity"], .product__quantity input')) {
          render();
        }
      });
      document.addEventListener('click', function (e) {
        if (e.target && e.target.closest && e.target.closest('.js-qty__adjust')) {
          setTimeout(render, 50);
        }
      });

      if (setup1List) {
        setup1List.addEventListener('click', function () {
          setTimeout(render, 50);
        });
      }

      const initialPlan = computePlan();
      setChecked(!card.hidden && initialPlan.selected.length > 0);
      render();
    }

    function initNativeKeycapVariantSync() {
      const isKeyboard = {{ is_keyboard | default: false | json }};
      if (!isKeyboard) return;

      const keycapsOptionIndex = {{ keycaps_option_index | default: 0 | json }};
      if (!keycapsOptionIndex || keycapsOptionIndex < 1) return;

      const keycapsWrap =
        document.querySelector('.variant-input-wrap[data-index="option' + keycapsOptionIndex + '"]') ||
        document.querySelector('.variant-input-wrap[data-handle="keycaps"], .variant-input-wrap[data-handle="keycap"]');
      const styleBox = document.getElementById('StyleYourBoardBox');
      let statusPill = document.getElementById('StyleBoardModeStatus');

      // 确保 PC 端 desktopPill 位于 Keycaps 选项容器（Original 和 Other style 选项）的水平最靠右位置
      let desktopPill = document.getElementById('StyleBoardModeStatus');
      if (keycapsWrap) {
        keycapsWrap.classList.add('has-keycap-status');
        if (!desktopPill) {
          desktopPill = document.createElement('span');
          desktopPill.className = 'bundle-list-status bundle-list-status--desktop';
          desktopPill.id = 'StyleBoardModeStatus';
          keycapsWrap.appendChild(desktopPill);
        } else if (desktopPill.parentElement !== keycapsWrap) {
          keycapsWrap.appendChild(desktopPill);
        }
      }
      const serviceCard = document.getElementById('ManualKeycapServiceCard');
      const serviceCheckbox = document.getElementById('ManualKeycapServiceCheckbox');
      const validationNotice = document.getElementById('KeycapValidationNotice');
      const addBtn =
        document.querySelector('.product-single__form button.add-to-cart') ||
        document.querySelector('button.add-to-cart');
      const addBtnText = addBtn ? addBtn.querySelector('[data-add-to-cart-text]') : null;
      const setup1List = document.querySelector('.bundle-product-list--1');
      if (!setup1List || !setup1List.querySelector('.bundle-keycap-card')) return;

      let variantsList = [];
      const variantsJsonEl = document.querySelector('textarea[data-variant-json]');
      if (variantsJsonEl) {
        try {
          variantsList = JSON.parse(variantsJsonEl.value || variantsJsonEl.textContent) || [];
        } catch (e) {
          variantsList = [];
        }
      }
      let latestVariant = null;
      let hasLatestVariantEvent = false;

      function getCurrentVariantData() {
        if (hasLatestVariantEvent) return latestVariant;
        const currentId = getCurrentVariantId();
        if (currentId && variantsList.length) {
          const found = variantsList.find(v => String(v.id) === String(currentId));
          if (found) return found;
        }
        return variantsList[0] || null;
      }

      function isNonOriginalValue(val) {
        const v = String(val || '').trim().toLowerCase();
        return (
          v.includes('non-original') ||
          v.includes('non original') ||
          v.includes('other style') ||
          v.includes('other-style') ||
          v === 'custom' ||
          v.includes('非原装')
        );
      }

      function getNativeKeycapsValue(variant) {
        if (keycapsWrap) {
          const checkedRadio = keycapsWrap.querySelector('input[type="radio"]:checked');
          if (checkedRadio && checkedRadio.value) return checkedRadio.value;
          const selectEl = keycapsWrap.querySelector('select');
          if (selectEl && selectEl.value) return selectEl.value;
        }
        if (variant && variant['option' + keycapsOptionIndex]) {
          return variant['option' + keycapsOptionIndex];
        }
        return '';
      }

      function getMode() {
        const val = getNativeKeycapsValue(getCurrentVariantData());
        return isNonOriginalValue(val) ? 'custom' : 'original';
      }

      function getSelectedKeycaps() {
        if (!setup1List) return [];
        return Array.from(setup1List.querySelectorAll('.bundle-keycap-card.is-selected'))
          .slice()
          .sort((a, b) => {
            const orderA = parseInt(a.dataset.selectedOrder || '0', 10) || 0;
            const orderB = parseInt(b.dataset.selectedOrder || '0', 10) || 0;
            return orderA - orderB;
          });
      }

      // 移动端放置在标题区域下方，PC 端悬浮到商品主图左上角
      function movePromoOverlayToImages() {
        if (typeof relocateBundlePromoOverlay === 'function') {
          relocateBundlePromoOverlay();
        }
      }
      movePromoOverlayToImages();

      function syncStatusPill(mode, selectedKeycaps) {
        const pills = document.querySelectorAll('.bundle-list-status');
        if (!pills.length) return;
        let state = 'neutral';
        let text = 'Optional Add-on';
        if (mode === 'original') {
          if (selectedKeycaps.length > 0) {
            state = 'addon';
            text =
              selectedKeycaps.length === 1
                ? '1 Keycap Set Selected'
                : `${selectedKeycaps.length} Keycap Sets Selected`;
          } else {
            state = 'neutral';
            text = 'Optional Add-on';
          }
        } else if (selectedKeycaps.length > 0) {
          state = 'ready';
          text =
            selectedKeycaps.length === 1
              ? '1 Keycap Set Selected'
              : `${selectedKeycaps.length} Keycap Sets Selected`;
        } else {
          state = 'pending';
          text = 'Pick 1 Keycap Set';
        }
        pills.forEach(pill => {
          pill.dataset.state = state;
          pill.textContent = text;
        });
      }

      function syncManualServiceVisibility(mode, selectedKeycaps) {
        if (!serviceCard) return;
        const showService = mode === 'custom';
        const hasKeycap = selectedKeycaps && selectedKeycaps.length > 0;
        if (typeof serviceCard._syncKeycapsState === 'function') {
          serviceCard._syncKeycapsState(showService, hasKeycap);
          return;
        }
        if (typeof serviceCard._syncModeVisibility === 'function') {
          serviceCard._syncModeVisibility(showService, hasKeycap);
          return;
        }
        serviceCard.hidden = !showService;
        if (!showService || !hasKeycap) {
          if (serviceCheckbox) serviceCheckbox.checked = false;
          serviceCard.classList.remove('is-active');
          serviceCard.setAttribute('aria-checked', 'false');
        } else {
          if (serviceCheckbox) serviceCheckbox.checked = true;
          serviceCard.classList.add('is-active');
          serviceCard.setAttribute('aria-checked', 'true');
        }
      }

      function syncValidationNotice(mode, selectedKeycaps) {
        if (!validationNotice) return;
        validationNotice.hidden = !(mode === 'custom' && selectedKeycaps.length === 0);
      }

      function formatMoneyCents(cents) {
        if (window.theme && window.theme.Currency && typeof window.theme.Currency.formatMoney === 'function') {
          const format = (window.theme.settings && window.theme.settings.moneyFormat) || undefined;
          return cleanPriceText(window.theme.Currency.formatMoney(cents, format));
        }
        if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
          return cleanPriceText(window.Shopify.formatMoney(cents));
        }
        return '$' + (Number(cents || 0) / 100).toFixed(2);
      }

      function syncCartButtonCTA(mode, selectedKeycaps, variant) {
        if (typeof window.__renderAddToCartPrice === 'function') {
          window.__renderAddToCartPrice(variant);
        }
      }

      function syncAll() {
        const variant = getCurrentVariantData();
        const mode = getMode();
        let selectedKeycaps = getSelectedKeycaps();

        // 当处于 Other Style (custom mode) 时，限制最多只能选一套
        if (mode === 'custom' && selectedKeycaps.length > 1) {
          const keepCard = selectedKeycaps[selectedKeycaps.length - 1];
          selectedKeycaps.forEach(card => {
            if (card !== keepCard) {
              card.classList.remove('is-selected');
              card.setAttribute('aria-pressed', 'false');
              const cb = card.querySelector('.bundle-product-checkbox');
              if (cb) cb.checked = false;
              delete card.dataset.selectedOrder;
            }
          });
          selectedKeycaps = [keepCard];
          if (typeof window.__showKeycapImage === 'function') {
            window.__showKeycapImage(keepCard);
          }
        }

        syncStatusPill(mode, selectedKeycaps);
        syncManualServiceVisibility(mode, selectedKeycaps);
        syncValidationNotice(mode, selectedKeycaps);
        syncCartButtonCTA(mode, selectedKeycaps, variant);
        if (typeof window.__syncSelectedKeycapSpecCard === 'function') {
          window.__syncSelectedKeycapSpecCard();
        }
        syncVariantOptionLabels();
      }

      function syncVariantOptionLabels() {
        const currentMode = getMode();
        document.querySelectorAll('.variant-wrapper').forEach(wrapper => {
          const inputWrap = wrapper.querySelector('.variant-input-wrap');
          const labelVal = wrapper.querySelector('.variant__label-value');
          if (!labelVal) return;

          const optName = (
            labelVal.dataset.optionName ||
            inputWrap?.getAttribute('name') ||
            ''
          ).toLowerCase().trim();
          const isKeycaps = optName.includes('keycap') || optName.includes('键帽');

          if (isKeycaps) {
            if (currentMode === 'original') {
              let origVal = 'Original';
              if (inputWrap) {
                const checkedRadio = inputWrap.querySelector('input[type="radio"]:checked');
                if (checkedRadio && checkedRadio.value) {
                  origVal = checkedRadio.value;
                }
              }
              labelVal.textContent = origVal;
            } else {
              // other style 模式：显示下方具体选中的键帽名字
              let chosenTitle = '';
              const selectedCards = getSelectedKeycaps();
              if (selectedCards.length > 0) {
                const lastCard = selectedCards[selectedCards.length - 1];
                chosenTitle = (lastCard.dataset.keycapTitle || lastCard.querySelector('.bundle-keycap-card__title')?.textContent || '').trim();
              }
              if (!chosenTitle) {
                const activeCard = document.querySelector('.bundle-product-list--1 .bundle-keycap-card.is-selected');
                if (activeCard) {
                  chosenTitle = (activeCard.dataset.keycapTitle || activeCard.querySelector('.bundle-keycap-card__title')?.textContent || '').trim();
                }
              }
              if (chosenTitle) {
                labelVal.textContent = chosenTitle;
              } else {
                let radioVal = 'Other style';
                if (inputWrap) {
                  const checkedRadio = inputWrap.querySelector('input[type="radio"]:checked');
                  if (checkedRadio && checkedRadio.value) {
                    radioVal = checkedRadio.value;
                  }
                }
                labelVal.textContent = radioVal;
              }
            }
          } else {
            // 普通变体选项（如 Base Color, Switch 等）
            let selectedVal = '';
            if (inputWrap) {
              const checkedRadio = inputWrap.querySelector('input[type="radio"]:checked');
              if (checkedRadio) {
                selectedVal = checkedRadio.value;
              } else {
                const selectEl = inputWrap.querySelector('select');
                if (selectEl) {
                  selectedVal = selectEl.value;
                }
              }
            }
            if (selectedVal) {
              labelVal.textContent = selectedVal;
            }
          }
        });
      }
      window.__syncVariantOptionLabels = syncVariantOptionLabels;

      function scrollToBoardIfNeeded() {
        if (!styleBox) return;
        const rect = styleBox.getBoundingClientRect();
        const vh = window.innerHeight || document.documentElement.clientHeight;
        if (rect.top < 24 || rect.top > vh * 0.65) {
          styleBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }

      window.isKeycapModeCustom = function () {
        return getMode() === 'custom';
      };

      window.validateKeycapModeBeforePurchase = function () {
        // 允许用户直接加购，不拦截结算
        return true;
      };

      document.addEventListener('change', function (e) {
        if (!e.target) return;
        if (
          e.target.classList.contains('bundle-product-checkbox') ||
          (keycapsWrap && keycapsWrap.contains(e.target))
        ) {
          setTimeout(syncAll, 0);
        }
      });

      document.addEventListener('click', function (e) {
        if (!e.target || !e.target.closest) return;
        if (
          e.target.closest('.variant-input-wrap[data-index="option' + keycapsOptionIndex + '"]') ||
          e.target.closest('.variant-input-wrap[data-handle="keycaps"], .variant-input-wrap[data-handle="keycap"]')
        ) {
          setTimeout(syncAll, 20);
        }
      });

      document.addEventListener('variant:change', function (e) {
        hasLatestVariantEvent = true;
        latestVariant = (e.detail && e.detail.variant) || null;
        setTimeout(syncAll, 0);
      });

      syncAll();
    }

    function initAddToCartPriceSync() {
      const addBtn =
        document.querySelector('.product-single__form button.add-to-cart') ||
        document.querySelector('button.add-to-cart');
      if (!addBtn) return;
      const addBtnText = addBtn.querySelector('[data-add-to-cart-text]');
      if (!addBtnText) return;

      let variantsList = [];
      const variantsJsonEl = document.querySelector('textarea[data-variant-json]');
      if (variantsJsonEl) {
        try {
          variantsList = JSON.parse(variantsJsonEl.value || variantsJsonEl.textContent) || [];
        } catch (e) {
          variantsList = [];
        }
      }

      let latestVariant = null;

      function getActiveVariantData() {
        if (latestVariant) return latestVariant;
        const currentId = (typeof getCurrentVariantId === 'function') ? getCurrentVariantId() : null;
        if (currentId && variantsList.length) {
          const found = variantsList.find(v => String(v.id) === String(currentId));
          if (found) return found;
        }
        return variantsList[0] || null;
      }

      function formatMoneyValue(cents) {
        if (window.theme && window.theme.Currency && typeof window.theme.Currency.formatMoney === 'function') {
          const format = (window.theme.settings && window.theme.settings.moneyFormat) || undefined;
          return cleanPriceText(window.theme.Currency.formatMoney(cents, format));
        }
        if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
          return cleanPriceText(window.Shopify.formatMoney(cents));
        }
        return '$' + (Number(cents || 0) / 100).toFixed(2);
      }

      let isUpdatingPrice = false;

      function renderPriceOnButton(variant) {
        if (isUpdatingPrice) return;
        isUpdatingPrice = true;
        try {
          const activeVar = variant || getActiveVariantData();
          const isAvailable = activeVar ? !!activeVar.available : !addBtn.disabled;
          const bottomAddBtn = document.querySelector('.device_bottominfo .m_product_addToCart');
          const bottomAddBtnText = bottomAddBtn ? bottomAddBtn.querySelector('.m_product_addToCart_text') : null;
          const bottomPriceWrap = document.querySelector('.device_bottominfo .m_product_price');

          const basePrice = (activeVar && typeof activeVar.price === 'number')
            ? activeVar.price
            : {{ current_variant.price | default: 0 }};

          const isKeyboardPage = {{ is_keyboard | json }};
          const isKeycapPage = !isKeyboardPage && {{ is_keycap | json }};
          const mainQtyInput = document.querySelector('.product__quantity input[name="quantity"]') || document.querySelector('.product-single__form input[name="quantity"]');
          const mainQty = mainQtyInput ? Math.max(1, parseInt(mainQtyInput.value, 10) || 1) : 1;

          // 收集已选中的搭配商品（Style Your Board / Complete Your Setup / More Add-ons），每款固定 1 件
          const selectedItems = [];
          document.querySelectorAll('.bundle-product-list--1 .bundle-keycap-card.is-selected, .bundle-product-list--addons .bundle-keycap-card.is-selected').forEach(card => {
            let orig = parseInt(card.dataset.priceCents || card.dataset.keycapOrigCents || '0', 10) || 0;
            if (!orig && card.dataset.keycapCents) orig = parseInt(card.dataset.keycapCents, 10) || 0;
            const isKeycap = card.hasAttribute('data-keycap-cents') || card.dataset.isKeycap === 'true';
            selectedItems.push({ orig, isKeycap });
          });

          let totalOriginal = basePrice * mainQty;
          let totalDiscounted = basePrice * mainQty;

          if (isKeyboardPage) {
            // 键盘 + 键帽：所有键帽 8 折（KEYCAP20）
            selectedItems.forEach(item => {
              totalOriginal += item.orig;
              totalDiscounted += item.isKeycap ? Math.round(item.orig * 0.8) : item.orig;
            });
          } else if (isKeycapPage) {
            // 键帽满 2 套及以上：所有键帽 9 折（KEYCAP10），包含当前键帽本身
            const keycapCount = mainQty + selectedItems.filter(i => i.isKeycap).length;
            const keycapRatio = keycapCount >= 2 ? 0.9 : 1;
            totalDiscounted = Math.round(basePrice * keycapRatio) * mainQty;
            selectedItems.forEach(item => {
              totalOriginal += item.orig;
              totalDiscounted += item.isKeycap ? Math.round(item.orig * keycapRatio) : item.orig;
            });
          } else {
            selectedItems.forEach(item => {
              totalOriginal += item.orig;
              totalDiscounted += item.orig;
            });
          }

          // 同步更新 PC 端底部吸底栏上的价格展示（选了键帽后：折后价黑色，原价划线灰色）
          if (bottomPriceWrap) {
            if (totalOriginal > totalDiscounted) {
              const formattedDisc = formatMoneyValue(totalDiscounted);
              const formattedOrig = formatMoneyValue(totalOriginal);
              bottomPriceWrap.innerHTML = `
                <span data-product-price class="product__price on-sale">${formattedDisc}</span>
                <span data-product-price-wrap>
                  <span data-compare-price class="product__price product__price--compare"><del class="add-to-cart__compare-price">${formattedOrig}</del></span>
                </span>
              `;
            } else {
              const formattedCurrent = formatMoneyValue(totalDiscounted);
              if (activeVar && activeVar.compare_at_price && activeVar.compare_at_price > activeVar.price && (!selectedItems || !selectedItems.length)) {
                const origVarPrice = formatMoneyValue(activeVar.compare_at_price * mainQty);
                bottomPriceWrap.innerHTML = `
                  <span data-product-price class="product__price on-sale">${formattedCurrent}</span>
                  <span data-product-price-wrap>
                    <span data-compare-price class="product__price product__price--compare"><del class="add-to-cart__compare-price">${origVarPrice}</del></span>
                  </span>
                `;
              } else {
                bottomPriceWrap.innerHTML = `
                  <span data-product-price class="product__price">${formattedCurrent}</span>
                `;
              }
            }
          }

          if (!isAvailable) {
            addBtn.classList.remove('is-needs-keycap');
            if (bottomAddBtn) bottomAddBtn.classList.add('disabled');
            if (bottomAddBtnText) bottomAddBtnText.textContent = 'SOLD OUT';
            return;
          }

          if (bottomAddBtn) bottomAddBtn.classList.remove('disabled');

          addBtn.classList.remove('is-needs-keycap');
          const defaultRaw = (addBtnText.dataset.defaultText || 'Add to cart').trim();
          const baseTitle = defaultRaw.toUpperCase();

          if (totalOriginal > totalDiscounted) {
            const formattedDisc = formatMoneyValue(totalDiscounted);
            const formattedOrig = formatMoneyValue(totalOriginal);
            addBtnText.innerHTML = `${baseTitle} | ${formattedDisc} <del class="add-to-cart__compare-price">${formattedOrig}</del>`;
            if (bottomAddBtnText) {
              bottomAddBtnText.innerHTML = `${baseTitle}<span class="m_bottom_price_part"> | ${formattedDisc} <del class="add-to-cart__compare-price">${formattedOrig}</del></span>`;
            }
          } else {
            const formattedCurrent = formatMoneyValue(totalDiscounted);
            addBtnText.innerHTML = `${baseTitle} | ${formattedCurrent}`;
            if (bottomAddBtnText) {
              bottomAddBtnText.innerHTML = `${baseTitle}<span class="m_bottom_price_part"> | ${formattedCurrent}</span>`;
            }
          }
        } finally {
          setTimeout(() => {
            isUpdatingPrice = false;
          }, 30);
        }
      }

      window.__renderAddToCartPrice = renderPriceOnButton;

      document.addEventListener('variant:change', function (e) {
        latestVariant = (e.detail && e.detail.variant) || null;
        setTimeout(() => {
          renderPriceOnButton(latestVariant);
        }, 10);
      });

      document.addEventListener('change', function () {
        setTimeout(() => {
          renderPriceOnButton(null);
        }, 10);
      });

      // 搭配卡片点击、主数量 +/- 按钮、手动输入数量时同步刷新总价
      document.addEventListener('click', function (e) {
        if (!e.target || !e.target.closest) return;
        if (e.target.closest('.bundle-keycap-card') || e.target.closest('.product__quantity .js-qty__adjust')) {
          setTimeout(() => renderPriceOnButton(null), 60);
        }
      });
      document.addEventListener('input', function (e) {
        if (e.target && e.target.closest && e.target.closest('.product__quantity')) {
          setTimeout(() => renderPriceOnButton(null), 10);
        }
      });

      if (window.MutationObserver) {
        const observer = new MutationObserver(function () {
          if (isUpdatingPrice) return;
          const currentText = (addBtnText.textContent || '').trim();
          if (!currentText.includes('|') && !addBtn.disabled && !currentText.toUpperCase().includes('SOLD OUT')) {
            renderPriceOnButton(null);
          }
        });
        observer.observe(addBtnText, { childList: true, characterData: true, subtree: true });
      }

      renderPriceOnButton(null);
      setTimeout(() => renderPriceOnButton(null), 50);
      setTimeout(() => renderPriceOnButton(null), 250);
      setTimeout(() => renderPriceOnButton(null), 600);
    }

    // 移动端 STYLE YOUR BOARD / DOUBLE YOUR STYLE 横向滑动左右按钮控制
    function initBundleListMobileArrows() {
      const listEl = document.querySelector('.bundle-product-list--1');
      const arrowsWrap = document.querySelector('[data-bundle-arrows]');
      if (!listEl || !arrowsWrap) return;

      const prevBtn = arrowsWrap.querySelector('[data-bundle-prev]');
      const nextBtn = arrowsWrap.querySelector('[data-bundle-next]');
      if (!prevBtn || !nextBtn) return;

      function updateArrowState() {
        const scrollLeft = Math.round(listEl.scrollLeft || 0);
        const maxScroll = Math.max(0, (listEl.scrollWidth || 0) - (listEl.clientWidth || 0));

        if (scrollLeft <= 2) {
          prevBtn.classList.add('is-disabled');
        } else {
          prevBtn.classList.remove('is-disabled');
        }

        if (maxScroll <= 2 || scrollLeft >= maxScroll - 2) {
          nextBtn.classList.add('is-disabled');
        } else {
          nextBtn.classList.remove('is-disabled');
        }
      }

      function getScrollStep() {
        const firstCard = listEl.querySelector('.bundle-keycap-card');
        if (firstCard) {
          const style = window.getComputedStyle(listEl);
          const gap = parseFloat(style.columnGap || style.gap) || 10;
          return firstCard.offsetWidth + gap;
        }
        return Math.round((listEl.clientWidth || 240) * 0.66);
      }

      prevBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        const step = getScrollStep();
        listEl.scrollBy({ left: -step, behavior: 'smooth' });
        setTimeout(updateArrowState, 350);
      });

      nextBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        const step = getScrollStep();
        listEl.scrollBy({ left: step, behavior: 'smooth' });
        setTimeout(updateArrowState, 350);
      });

      listEl.addEventListener('scroll', updateArrowState, { passive: true });
      window.addEventListener('resize', updateArrowState, { passive: true });
      window.addEventListener('load', updateArrowState, { passive: true });

      updateArrowState();
      setTimeout(updateArrowState, 150);
      setTimeout(updateArrowState, 500);
    }

    // 逐个初始化，任一模块报错不影响其他模块（尤其是加购按钮价格同步）
    [
      initBundleAddonGroups,
      initBundleQtySelectors,
      initBundleSelection,
      initSetup1KeycapSelection,
      initAddonCardsSelection,
      initManualInstallationService,
      initBundleAnchorUrl,
      initNativeKeycapVariantSync,
      initAddToCart,
      initAddToCartPriceSync,
      initBundleListMobileArrows
    ].forEach(fn => {
      try {
        fn();
      } catch (err) {
        console.error('[more-variant-form] ' + fn.name + ' failed:', err);
      }
    });

    updateMobileCardGridScroll();
    setTimeout(updateMobileCardGridScroll, 300);

    let resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        updateBundleListScroll();
        updateMobileCardGridScroll();
        if (typeof window.__syncSelectedKeycapSpecCard === 'function') {
          window.__syncSelectedKeycapSpecCard();
        }
      }, 150);
    });

    window.addEventListener('load', function () {
      if (typeof window.__relocateBundlePromoOverlay === 'function') { window.__relocateBundlePromoOverlay(); }
      updateBundleListScroll();
      updateMobileCardGridScroll();
      if (typeof window.__syncVariantOptionLabels === 'function') {
        window.__syncVariantOptionLabels();
      }
    });

    // 全局变体单选/下拉切换时，同步更新变体标题冒号后面的选项名字
    document.addEventListener('change', function (e) {
      if (!e.target || !e.target.closest) return;
      if (typeof window.__syncVariantOptionLabels === 'function') {
        window.__syncVariantOptionLabels();
      } else {
        const inputWrap = e.target.closest('.variant-input-wrap');
        if (inputWrap) {
          const wrapper = inputWrap.closest('.variant-wrapper');
          if (wrapper) {
            const labelVal = wrapper.querySelector('.variant__label-value');
            if (labelVal) {
              if (e.target.type === 'radio' && e.target.checked) {
                labelVal.textContent = e.target.value;
              } else if (e.target.tagName === 'SELECT') {
                labelVal.textContent = e.target.value;
              }
            }
          }
        }
      }
    });

    if (typeof window.__syncVariantOptionLabels === 'function') {
      window.__syncVariantOptionLabels();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMoreVariantForm);
  } else {
    initMoreVariantForm();
  }
</script>
