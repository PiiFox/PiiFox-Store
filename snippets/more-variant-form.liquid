<script>
  $(function () {
    $('.custom-shopify-buy-btn').click(async function (e) {
      const appendVariants =
        typeof window.getBundleAppendVariants === 'function' ? window.getBundleAppendVariants() : [];
      if (appendVariants && appendVariants.length > 0) {
        e.preventDefault();
        e.stopPropagation();
        const currentVariantId =
          typeof window.getBundleCurrentVariantId === 'function' ? window.getBundleCurrentVariantId() : null;
        if (!currentVariantId) return;
        const mainQtyInput =
          document.querySelector('.product__quantity input[name="quantity"]') ||
          document.querySelector('input[name="quantity"]');
        const mainQty = mainQtyInput ? Math.max(1, parseInt(mainQtyInput.value, 10) || 1) : 1;
        const items = [{ id: currentVariantId, quantity: mainQty }, ...appendVariants];

        const buyBtn = e.currentTarget;
        buyBtn.disabled = true;
        buyBtn.classList.add('btn--loading');
        try {
          await fetch((window.theme && window.theme.routes && window.theme.routes.cartAdd) || '/cart/add.js', {
            method: 'POST',
            body: JSON.stringify({ items: items }),
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          });
          window.location.href = '/checkout';
        } catch (err) {
          console.error('Buy Now bundle failed', err);
          window.location.href = '/checkout';
        }
        return;
      }
      $('.shopify-payment-button button.shopify-payment-button__more-options').click();
    });
  });
</script>
{%- assign is_keyboard = false -%}
{%- assign is_keycap = false -%}
