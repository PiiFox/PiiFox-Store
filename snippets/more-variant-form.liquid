                {%- assign v_id = v.id | append: '' -%}
                {%- assign key = ',' | append: v_id | append: ',' -%}
                {%- unless seen_addon_ids contains key -%}
                  {%- if v_id != blank -%}
                    {%- assign seen_addon_ids = seen_addon_ids | append: v_id | append: ',' -%}
