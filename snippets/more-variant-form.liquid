                // 搭配区商品卡片选中状态 <-> 地址栏 p 参数 同步（支持多选，逗号分隔；取消选中则移除）
    function initBundleAnchorUrl() {
      // 读取地址栏中的锚点数组
      function readAnchors() {
        const params = new URLSearchParams(window.location.search);
        const raw = params.get('p') || '';
        return raw
          .split(',')
          .map(s => s.trim())
          .filter(Boolean);
      }

      // 用一个或多个锚点写入地址栏（replaceState，不刷新页面）
      function writeAnchors(anchors) {
        const params = new URLSearchParams(window.location.search);
        const unique = Array.from(new Set((anchors || []).filter(Boolean)));
        if (unique.length > 0) {
          params.set('p', unique.join(','));
        } else {
          params.delete('p');
        }
                const search = '?' + params.toString();
        // 地址未变化则不重复写入（若地址里缺少 variant 则仍需补写，避免商品标识被覆盖丢失）
        if (window.location.search === search && params.has('variant')) return;
        window.history.replaceState(
          window.history.state,
          '',
          window.location.pathname + search + window.location.hash
        );
      }

      // 记录当前选中的变体，避免主题切换变体时把地址里已有的 p 参数（商品标识）覆盖掉
      function getVariantFromUrl() {
        return new URLSearchParams(window.location.search).get('variant') || '';
      }
      let lastVariantId = getVariantFromUrl();

      // 主题切换变体会用 replaceState 整体重写地址（只保留 ?variant=xxx），这里在其后再补回 p 参数
      function keepBundleAnchors() {
        const currentVariantId = getVariantFromUrl();
        if (currentVariantId === lastVariantId) return;
        lastVariantId = currentVariantId;

        const params = new URLSearchParams(window.location.search);
        const anchors = [];
        document.querySelectorAll('.bundle-product-list--1 [data-bundle-anchor], .bundle-product-list--addons [data-bundle-anchor]').forEach(card => {
          if (card.classList.contains('is-selected') && card.dataset.bundleAnchor) {
            anchors.push(card.dataset.bundleAnchor);
          }
        });
        if (!anchors.length) return;

        params.set('p', Array.from(new Set(anchors)).join(','));
        const search = '?' + params.toString();
        if (window.location.search === search) return;
        window.history.replaceState(
          window.history.state,
          '',
          window.location.pathname + search + window.location.hash
        );
            }


      // 收集当前所有已选中卡片的锚点，并同步到地址栏
      function syncAnchorFromSelection() {
        const anchors = [];
        // 注意：ANCHOR_LIST_SELECTOR 是逗号分隔的选择器组，需分别拼接锚点选择器，否则逗号会导致匹配错误
        document.querySelectorAll('.bundle-product-list--1 [data-bundle-anchor], .bundle-product-list--addons [data-bundle-anchor]').forEach(card => {
          if (card.classList.contains('is-selected') && card.dataset.bundleAnchor) {
            anchors.push(card.dataset.bundleAnchor);
          }
        });
        writeAnchors(anchors);
      }
      // 暴露给卡片点击逻辑调用（勾选/取消勾选后同步地址栏）
      window.__syncBundleAnchor = syncAnchorFromSelection;

      // 勾选锚点对应的商品卡片（已勾选或售罄则跳过）
      // 通过触发卡片点击，复用已有的选中逻辑（同步 is-selected、复选框、搭配图切换、安装服务等）
      function selectAnchorCard(el) {
        if (!el || el.classList.contains('sold-out')) return;
        const checkbox = el.querySelector('.bundle-product-checkbox');
        if (!checkbox || checkbox.disabled) return;
        if (checkbox.checked && el.classList.contains('is-selected')) return;

        el.click();
      }

      // 展开分组并将锚点卡片滚动到可视区域
      function scrollToAnchor(anchor, tries) {
        if (!anchor) return;
        const el = document.getElementById('bundle-card-' + anchor);
        if (!el) {
          if ((tries || 0) < 10) {
            setTimeout(() => scrollToAnchor(anchor, (tries || 0) + 1), 300);
          }
          return;
        }
        // 若目标位于折叠的 More Add-ons 面板内，先展开
        const addonGroup = el.closest('[data-bundle-addon-group]');
        if (addonGroup && !addonGroup.classList.contains('is-open')) {
          const toggle = addonGroup.querySelector('[data-bundle-addon-toggle]');
          if (toggle) toggle.click();
        }

        // 对应滚动容器：清单本身可能带滚动条，需要滚动容器使其显示
        const list = el.closest('.bundle-product-list');
        if (list && list.scrollHeight > list.clientHeight + 4) {
          // 卡片在滚动容器内的相对位置
          const cardTop = el.offsetTop - list.offsetTop + list.scrollTop;
          list.scrollTo({ top: Math.max(0, cardTop), behavior: 'smooth' });
        }
        const rect = el.getBoundingClientRect();
        const inViewport = rect.top >= 0 && rect.bottom <= (window.innerHeight || document.documentElement.clientHeight);
        if (!inViewport) {
          el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }

            // 从地址栏恢复：逐个勾选所有锚点对应商品，并滚动到第一个
      function restoreFromUrl() {
        const anchors = readAnchors();
        if (!anchors.length) return;

        // 若任一锚点商品位于 More Add-ons 面板内，则默认展开该面板
        anchors.forEach(anchor => {
          const el = document.getElementById('bundle-card-' + anchor);
          if (!el) return;
          const addonGroup = el.closest('[data-bundle-addon-group]');
          if (addonGroup && !addonGroup.classList.contains('is-open')) {
            const toggle = addonGroup.querySelector('[data-bundle-addon-toggle]');
            if (toggle) toggle.click();
          }
        });

        anchors.forEach(anchor => {
          const el = document.getElementById('bundle-card-' + anchor);
          if (el) selectAnchorCard(el);
        });

        // 滚动定位到第一个锚点（等勾选渲染完成后）
        setTimeout(() => {
          scrollToAnchor(anchors[0], 0);
          // 确保地址栏与最终选中状态一致（去除无效/售罄锚点）
          syncAnchorFromSelection();
        }, 50);
      }

            // 从地址栏恢复（例如分享链接 / 刷新）
      restoreFromUrl();

      // 包装 history.replaceState：主题切换变体后若把 p 参数覆盖掉，立即补回
      const originalReplaceState = window.history.replaceState;
      window.history.replaceState = function (state, title, url) {
        const result = originalReplaceState.apply(this, arguments);
        setTimeout(keepBundleAnchors, 0);
        return result;
      };

      // 兜底：变体选项、变体选择器变化后也检查一次（不依赖 replaceState 的调用时机）
      ['change', 'variantChange', 'shopify:section:load'].forEach(function (eventName) {
        document.addEventListener(eventName, function (e) {
          if (!e.target || !e.target.closest) return;
          if (e.target.closest('.product-single__form, .variant-input-wrap, [data-product-form], [data-section-type="product"]')) {
            setTimeout(keepBundleAnchors, 0);
          }
        }, true);
      });
    }


    function initManualInstallationService() {
      const card = document.getElementById('ManualKeycapServiceCard');
      const checkbox = document.getElementById('ManualKeycapServiceCheckbox');
      if (!card || !checkbox) return;

      const promptEl = document.getElementById('ManualKeycapServicePrompt');
      const promptText = promptEl ? promptEl.querySelector('.manual-service-card__prompt-text') : null;
      const assignEl = document.getElementById('ManualKeycapServiceAssign');
      const setup1List = document.querySelector('.bundle-product-list--1');
      const hasSetup1Keycaps = !!(setup1List && setup1List.querySelector('.bundle-keycap-card'));

      // 一对多时，每把键盘（按顺序）选择安装的键帽 variantId
      let assignments = [];
      // 记录用户是否手动取消勾选（默认勾选安装服务）
      let userOptedOut = false;

      function escapeHtml(str) {
        return String(str).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
      }

      // 缩减下拉选项文字长度，省略末尾的冗余规格词（如 Cherry Profile Keycap Set 等）
      function formatShortTitle(rawTitle) {
        if (!rawTitle) return '';
        let str = String(rawTitle).trim();
        str = str.replace(/\s+(Cherry|OEM|XDA|MOA|MDA|DSA|KDA|ASA)?\s*(Profile\s*)?Keycaps?(\s*Set)?$/i, '');
        str = str.replace(/\s+(Cherry|OEM|XDA|MOA|MDA|DSA|KDA|ASA)\s+Profile$/i, '');
        str = str.replace(/\s+Keycaps?(\s+Set)?$/i, '');
        str = str.trim();
        if (str.length > 18) {
          str = str.slice(0, 16).trim() + '...';
        }
        return str || rawTitle;
      }

      function getKeyboardQty() {
        const mainQtyInput = document.querySelector('.product__quantity input[name="quantity"]') || document.querySelector('input[name="quantity"]');
        return mainQtyInput ? Math.max(1, parseInt(mainQtyInput.value, 10) || 1) : 1;
      }

      // Setup 1 中已选键帽，按勾选先后排序
      function getSelectedKeycaps() {
        if (!setup1List) return [];
        return Array.from(setup1List.querySelectorAll('.bundle-keycap-card.is-selected'))
          .map((el, domIndex) => {
            const titleEl = el.querySelector('.bundle-keycap-card__title');
            const order = parseInt(el.dataset.selectedOrder, 10);
            return {
              id: String(el.dataset.variantId || domIndex),
              title: (el.dataset.keycapTitle || (titleEl && titleEl.textContent) || 'Keycaps').trim(),
              sortKey: isNaN(order) ? 1e9 + domIndex : order
            };
          })
          .sort((a, b) => a.sortKey - b.sortKey);
      }

      // 安装方案：
      // - none：页面没有 Setup 1 键帽，按键盘数量计服务
      // - empty：未选中任何 Setup 1 键帽
      // - simple：刚好 1 把键盘 + 1 款键帽，直接全量安装，无需下拉框
      // - choose：多把键盘 或 多款键帽，为每把键盘提供下拉选择框（包含“不安装”选项）
      function computePlan() {
        const keyboards = getKeyboardQty();
        const selected = getSelectedKeycaps();

        if (!hasSetup1Keycaps) {
          return { mode: 'none', sets: keyboards, keyboards, selected, keycaps: [] };
        }
        if (!selected.length) {
          return { mode: 'empty', sets: 0, keyboards, selected: [], keycaps: [] };
        }

        // 仅 1 把键盘 + 选 1 款键帽时，1:1 对齐，直接展示确认信息即可
        if (keyboards === 1 && selected.length === 1) {
          assignments = [selected[0].id];
          return {
            mode: 'simple',
            sets: 1,
            keyboards: 1,
            selected,
            keycaps: [{ ...selected[0], keyboardIndex: 1 }]
          };
        }

        const validIds = selected.map(k => k.id);
        const used = new Set();
        const next = [];

        // 1. 保留用户之前仍然有效的选择（键盘数量大于1时才允许保留显式选择的“不安装”即空字符串 ''）
        for (let i = 0; i < keyboards; i++) {
          const prev = assignments[i];
          if (prev === '') {
            if (keyboards > 1) {
              next.push('');
            } else {
              next.push(null);
            }
          } else if (prev && validIds.includes(prev) && !used.has(prev)) {
            next.push(prev);
            used.add(prev);
          } else {
            next.push(null);
          }
        }

        // 2. 空位按键帽勾选顺序预填未占用的键帽；键盘数量大于1且已无可用键帽时才预填“不安装”
        for (let i = 0; i < keyboards; i++) {
          if (next[i] === null) {
            const free = validIds.find(id => !used.has(id));
            if (free) {
              next[i] = free;
              used.add(free);
            } else {
              next[i] = keyboards > 1 ? '' : (validIds[0] || ''); // 仅键盘数量大于1时预填不安装
            }
          }
        }
        assignments = next;

        const byId = {};
        selected.forEach(k => { byId[k.id] = k; });
        const keycaps = [];
        assignments.forEach((id, idx) => {
          if (id && byId[id]) {
            keycaps.push({ ...byId[id], keyboardIndex: idx + 1 });
          }
        });

        return {
          mode: 'choose',
          sets: keycaps.length,
          keyboards,
          selected,
          keycaps
        };
      }

      function renderAssign(plan) {
        if (!assignEl) return;
        if (plan.mode !== 'choose' || !checkbox.checked) {
          assignEl.hidden = true;
          assignEl.innerHTML = '';
          return;
        }

        const isMobile = window.matchMedia && window.matchMedia('(max-width: 768px)').matches;

        let html = '';
        for (let i = 0; i < plan.keyboards; i++) {
          const current = assignments[i] || '';
          // 仅在键盘数量大于 1 时显示 None 选项（移动端 None，PC 端显示全称 None (Do not install)）
          const noneText = isMobile ? 'None' : 'None (Do not install)';
          const noneOption = plan.keyboards > 1
            ? `<option value=""${!current ? ' selected' : ''}>${noneText}</option>`
            : '';
          const keycapOptions = plan.selected.map(k => {
            // 已被其他键盘选中的键帽不可再选（排除当前键盘以及“不安装”选项）
            const takenElsewhere = assignments.some((id, j) => j !== i && id && id === k.id);
            // 移动端缩减长度，PC 端显示全名
            const displayTitle = isMobile ? formatShortTitle(k.title) : k.title;
            return `<option value="${escapeHtml(k.id)}"${k.id === current ? ' selected' : ''}${takenElsewhere ? ' disabled' : ''}>${escapeHtml(displayTitle)}</option>`;
          }).join('');
          const options = noneOption + keycapOptions;
          const label = plan.keyboards > 1 ? `Keyboard ${i + 1}` : 'Keyboard';
          html += `<label class="manual-service-card__assign-row">` +
            `<span class="manual-service-card__assign-label">${label}</span>` +
            `<select class="manual-service-card__assign-select" data-keyboard-index="${i}">${options}</select>` +
            `</label>`;
        }
        assignEl.innerHTML = html;
        assignEl.hidden = false;
      }


      function setChecked(isChecked) {
        checkbox.checked = isChecked;
        card.classList.toggle('is-active', isChecked);
        card.setAttribute('aria-checked', isChecked ? 'true' : 'false');
      }

      function render() {
        const plan = computePlan();

        card.classList.remove('is-disabled');
        checkbox.disabled = false;

        if (plan.mode === 'none' || !plan.selected.length) {
          if (promptEl) promptEl.style.display = 'none';
        } else {
          if (promptEl && promptText) {
            if (checkbox.checked) {
              promptEl.classList.add('is-confirmed');
              if (plan.sets === 0) {
                promptText.innerHTML = '<strong>0 sets</strong> selected · Please select which keycaps to install below.';
              } else if (plan.mode === 'simple') {
                promptText.innerHTML = `<strong>1 set</strong> of installation · Keycaps to be installed: <strong>${escapeHtml(plan.keycaps[0].title)}</strong>`;
              } else {
                const setsLabel = `${plan.sets} ${plan.sets > 1 ? 'sets' : 'set'}`;
                const titles = plan.keycaps.map(k => `<strong>${escapeHtml(k.title)}</strong>${plan.keyboards > 1 ? ` (KB ${k.keyboardIndex})` : ''}`).join(', ');
                promptText.innerHTML = `<strong>${setsLabel}</strong> of installation · Keycaps to be installed: ${titles}`;
              }
              promptEl.style.display = 'flex';
            } else {
              promptEl.style.display = 'none';
            }
          }
        }

        renderAssign(plan);
        return plan;
      }

      // 供加购时读取当前安装方案
      card._getServicePlan = computePlan;
      // 供键帽规格切换时同步显隐与默认勾选状态
      card._syncModeVisibility = function (showService) {
        card.hidden = !showService;
        if (!showService) {
          setChecked(false);
        } else if (!userOptedOut) {
          setChecked(true);
        }
        render();
      };

      function toggleState(willBeChecked) {
        userOptedOut = !willBeChecked;
        setChecked(willBeChecked);
        render();
      }

      card.addEventListener('click', function (e) {
        if (e.target === checkbox) return;
        if (e.target.closest && e.target.closest('.manual-service-card__link')) return;
        // 操作下拉框时不切换勾选状态
        if (e.target.closest && e.target.closest('.manual-service-card__assign')) return;
        e.preventDefault();
        toggleState(!checkbox.checked);
      });

      checkbox.addEventListener('change', function () {
        toggleState(checkbox.checked);
      });

      card.addEventListener('keydown', function (e) {
        if (e.target.closest && e.target.closest('.manual-service-card__link')) return;
        if (e.target.closest && e.target.closest('.manual-service-card__assign')) return;
        if (e.key === ' ' || e.key === 'Enter') {
          e.preventDefault();
          toggleState(!checkbox.checked);
        }
      });

      if (assignEl) {
        assignEl.addEventListener('change', function (e) {
          const select = e.target.closest('.manual-service-card__assign-select');
          if (!select) return;
          assignments[parseInt(select.dataset.keyboardIndex, 10)] = select.value;
          render();
        });
      }

      document.addEventListener('input', function (e) {
        if (e.target && e.target.matches && e.target.matches('input[name="quantity"], .product__quantity input')) {
          render();
        }
      });
      document.addEventListener('change', function (e) {
        if (e.target && e.target.matches && e.target.matches('input[name="quantity"], .product__quantity input')) {
          render();
        }
      });
      document.addEventListener('click', function (e) {
        if (e.target && e.target.closest && e.target.closest('.js-qty__adjust')) {
          setTimeout(render, 50);
        }
      });

      if (setup1List) {
        setup1List.addEventListener('click', function () {
          setTimeout(render, 50);
        });
      }

      let prevIsMobile = window.matchMedia && window.matchMedia('(max-width: 768px)').matches;
      window.addEventListener('resize', function () {
        const currentIsMobile = window.matchMedia && window.matchMedia('(max-width: 768px)').matches;
        if (currentIsMobile !== prevIsMobile) {
          prevIsMobile = currentIsMobile;
          render();
        }
      });

      setChecked(!card.hidden);
      render();
    }

    function initNativeKeycapVariantSync() {
      const keycapsOptionIndex = {{ keycaps_option_index | default: 0 | json }};
      if (!keycapsOptionIndex || keycapsOptionIndex < 1) return;

      const keycapsWrap =
        document.querySelector('.variant-input-wrap[data-index="option' + keycapsOptionIndex + '"]') ||
        document.querySelector('.variant-input-wrap[data-handle="keycaps"], .variant-input-wrap[data-handle="keycap"]');
      const styleBox = document.getElementById('StyleYourBoardBox');
      const statusPill = document.getElementById('StyleBoardModeStatus');
      const serviceCard = document.getElementById('ManualKeycapServiceCard');
      const serviceCheckbox = document.getElementById('ManualKeycapServiceCheckbox');
      const validationNotice = document.getElementById('KeycapValidationNotice');
      const addBtn =
        document.querySelector('.product-single__form button.add-to-cart') ||
        document.querySelector('button.add-to-cart');
      const addBtnText = addBtn ? addBtn.querySelector('[data-add-to-cart-text]') : null;
      const setup1List = document.querySelector('.bundle-product-list--1');
      if (!setup1List || !setup1List.querySelector('.bundle-keycap-card')) return;

      let variantsList = [];
      const variantsJsonEl = document.querySelector('textarea[data-variant-json]');
      if (variantsJsonEl) {
        try {
          variantsList = JSON.parse(variantsJsonEl.value || variantsJsonEl.textContent) || [];
        } catch (e) {
          variantsList = [];
        }
      }
      let latestVariant = null;
      let hasLatestVariantEvent = false;

      function getCurrentVariantData() {
        if (hasLatestVariantEvent) return latestVariant;
        const currentId = getCurrentVariantId();
        if (currentId && variantsList.length) {
          const found = variantsList.find(v => String(v.id) === String(currentId));
          if (found) return found;
        }
        return variantsList[0] || null;
      }

      function isNonOriginalValue(val) {
        const v = String(val || '').trim().toLowerCase();
        return (
          v.includes('non-original') ||
          v.includes('non original') ||
          v.includes('other style') ||
          v.includes('other-style') ||
          v === 'custom' ||
          v.includes('非原装')
        );
      }

      function getNativeKeycapsValue(variant) {
        if (variant && variant['option' + keycapsOptionIndex]) {
          return variant['option' + keycapsOptionIndex];
        }
        if (keycapsWrap) {
          const checkedRadio = keycapsWrap.querySelector('input[type="radio"]:checked');
          if (checkedRadio) return checkedRadio.value;
          const selectEl = keycapsWrap.querySelector('select');
          if (selectEl) return selectEl.value;
        }
        return '';
      }

      function getMode() {
        const val = getNativeKeycapsValue(getCurrentVariantData());
        return isNonOriginalValue(val) ? 'custom' : 'original';
      }

      function getSelectedKeycaps() {
        if (!setup1List) return [];
        return Array.from(setup1List.querySelectorAll('.bundle-keycap-card.is-selected'));
      }

      function syncStatusPill(mode, selectedKeycaps) {
        if (!statusPill) return;
        if (mode === 'original') {
          if (selectedKeycaps.length > 0) {
            statusPill.dataset.state = 'addon';
            statusPill.textContent = `${selectedKeycaps.length} Extra Set${selectedKeycaps.length > 1 ? 's' : ''}`;
          } else {
            statusPill.dataset.state = 'neutral';
            statusPill.textContent = 'Optional Add-on';
          }
        } else if (selectedKeycaps.length > 0) {
          statusPill.dataset.state = 'ready';
          statusPill.textContent = `${selectedKeycaps.length} Keycap Set${selectedKeycaps.length > 1 ? 's' : ''} Selected`;
        } else {
          statusPill.dataset.state = 'pending';
          statusPill.textContent = 'Pick 1+ Keycap Set';
        }
      }

      function syncManualServiceVisibility(mode) {
        if (!serviceCard) return;
        const showService = mode === 'custom';
        if (typeof serviceCard._syncModeVisibility === 'function') {
          serviceCard._syncModeVisibility(showService);
          return;
        }
        serviceCard.hidden = !showService;
        if (!showService && serviceCheckbox && serviceCheckbox.checked) {
          serviceCheckbox.checked = false;
          serviceCard.classList.remove('is-active');
          serviceCard.setAttribute('aria-checked', 'false');
        }
      }

      function syncValidationNotice(mode, selectedKeycaps) {
        if (!validationNotice) return;
        validationNotice.hidden = !(mode === 'custom' && selectedKeycaps.length === 0);
      }

      function syncCartButtonCTA(mode, selectedKeycaps, variant) {
        if (!addBtn || !addBtnText) return;
        const isAvailable = variant ? !!variant.available : !addBtn.disabled;
        if (!isAvailable) {
          addBtn.classList.remove('is-needs-keycap');
          return;
        }

        if (mode === 'custom' && selectedKeycaps.length === 0) {
          addBtnText.textContent = 'PICK KEYCAPS ABOVE';
          addBtn.classList.add('is-needs-keycap');
        } else {
          addBtnText.textContent = addBtnText.dataset.defaultText || 'Add to cart';
          addBtn.classList.remove('is-needs-keycap');
        }
      }

      function syncAll() {
        const variant = getCurrentVariantData();
        const mode = getMode();
        const selectedKeycaps = getSelectedKeycaps();

        syncStatusPill(mode, selectedKeycaps);
        syncManualServiceVisibility(mode);
        syncValidationNotice(mode, selectedKeycaps);
        syncCartButtonCTA(mode, selectedKeycaps, variant);
      }

      function scrollToBoardIfNeeded() {
        if (!styleBox) return;
        const rect = styleBox.getBoundingClientRect();
        const vh = window.innerHeight || document.documentElement.clientHeight;
        if (rect.top < 24 || rect.top > vh * 0.65) {
          styleBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }

      window.isKeycapModeCustom = function () {
        return getMode() === 'custom';
      };

      window.validateKeycapModeBeforePurchase = function () {
        const mode = getMode();
        const selectedKeycaps = getSelectedKeycaps();
        if (mode === 'custom' && selectedKeycaps.length === 0) {
          if (validationNotice) validationNotice.hidden = false;
          scrollToBoardIfNeeded();
          return false;
        }
        return true;
      };

      document.addEventListener('change', function (e) {
        if (!e.target) return;
        if (
          e.target.classList.contains('bundle-product-checkbox') ||
          (keycapsWrap && keycapsWrap.contains(e.target))
        ) {
          setTimeout(syncAll, 0);
        }
      });

      document.addEventListener('variant:change', function (e) {
        hasLatestVariantEvent = true;
        latestVariant = (e.detail && e.detail.variant) || null;
        setTimeout(syncAll, 0);
      });

      syncAll();
    }

    initBundleAddonGroups();
    initBundleQtySelectors();
    initBundleSelection();
    initSetup1KeycapSelection();
    initAddonCardsSelection();
    initManualInstallationService();
    initBundleAnchorUrl();
    initNativeKeycapVariantSync();
    initAddToCart();

    updateMobileCardGridScroll();
    setTimeout(updateMobileCardGridScroll, 300);

    let resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        updateBundleListScroll();
        updateMobileCardGridScroll();
      }, 150);
    });

    window.addEventListener('load', function () {
      updateBundleListScroll();
      updateMobileCardGridScroll();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMoreVariantForm);
  } else {
    initMoreVariantForm();
  }
</script>
