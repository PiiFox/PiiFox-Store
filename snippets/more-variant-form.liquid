          currentImages = imgs;
          currentIndex = 0;

          const pTitle = (card.dataset.productTitle || card.dataset.keycapTitle || '').trim();

          if (slidesEl) {
            slidesEl.innerHTML = currentImages
              .map((src, idx) => `<div class="keycap-overview-modal__slide${idx === 0 ? ' is-active' : ''}"><img src="${src}" alt="${pTitle.replace(/"/g, '&quot;')}" loading="eager"></div>`)
              .join('');
          }

          if (dotsEl) {
            dotsEl.innerHTML = currentImages
              .map((_, idx) => `<button type="button" class="keycap-overview-modal__dot${idx === 0 ? ' is-active' : ''}" data-slide-idx="${idx}" aria-label="Go to slide ${idx + 1}"></button>`)
              .join('');
