<script>
  $(function () {
    $('.custom-shopify-buy-btn').click(async function (e) {
      if (typeof window.validateKeycapModeBeforePurchase === 'function' && !window.validateKeycapModeBeforePurchase()) {
        e.preventDefault();
        e.stopPropagation();
        return;
      }
      const appendVariants =
        typeof window.getBundleAppendVariants === 'function' ? window.getBundleAppendVariants() : [];
      if (appendVariants && appendVariants.length > 0) {
        e.preventDefault();
        e.stopPropagation();
        const currentVariantId =
          typeof window.getBundleCurrentVariantId === 'function' ? window.getBundleCurrentVariantId() : null;
        if (!currentVariantId) return;
        const mainQtyInput =
          document.querySelector('.product__quantity input[name="quantity"]') ||
          document.querySelector('input[name="quantity"]');
        const mainQty = mainQtyInput ? Math.max(1, parseInt(mainQtyInput.value, 10) || 1) : 1;
        const items = [{ id: currentVariantId, quantity: mainQty }, ...appendVariants];

        const buyBtn = e.currentTarget;
        buyBtn.disabled = true;
        buyBtn.classList.add('btn--loading');
        try {
          await fetch((window.theme && window.theme.routes && window.theme.routes.cartAdd) || '/cart/add.js', {
            method: 'POST',
            body: JSON.stringify({ items: items }),
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          });
          window.location.href = '/checkout';
        } catch (err) {
          console.error('Buy Now bundle failed', err);
          window.location.href = '/checkout';
        }
        return;
      }
      $('.shopify-payment-button button.shopify-payment-button__more-options').click();
    });
  });
</script>
{%- assign is_keyboard = is_keyboard | default: false -%}
{%- assign current_p_title = product.title | downcase -%}
{%- assign current_p_handle = product.handle | downcase -%}
{%- assign current_p_type = product.type | downcase -%}
{%- if current_p_title contains 'keyboard'
  or current_p_handle contains 'keyboard'
  or product.tags contains 'keyboard'
  or product.tags contains 'keyboards'
  or current_p_type contains 'keyboard'
-%}
  {%- unless current_p_title contains 'keycap'
    or current_p_handle contains 'keycap'
    or current_p_type contains 'keycap'
  -%}
    {%- assign is_keyboard = true -%}
  {%- endunless -%}
{%- endif -%}
{%- assign is_keycap = is_keycap | default: false -%}
{%- assign keycaps_option_index = 0 -%}
{%- assign initial_keycaps_is_non_original = false -%}
{%- for opt in product.options_with_values -%}
  {%- assign opt_name_down = opt.name | downcase | strip -%}
  {%- assign is_keycaps_opt = false -%}
  {%- if opt_name_down contains 'keycap' or opt_name_down contains '键帽' -%}
    {%- assign is_keycaps_opt = true -%}
  {%- else -%}
    {%- for val in opt.values -%}
      {%- assign val_down = val | downcase | strip -%}
      {%- if val_down contains 'non-original'
        or val_down contains 'non original'
        or val_down contains 'other style'
        or val_down contains 'other-style'
        or val_down contains '非原装'
      -%}
        {%- assign is_keycaps_opt = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if is_keycaps_opt -%}
    {%- assign keycaps_option_index = forloop.index -%}
    {%- assign selected_kc_val = opt.selected_value | downcase | strip -%}
    {%- if selected_kc_val contains 'non-original'
      or selected_kc_val contains 'non original'
      or selected_kc_val contains 'other style'
      or selected_kc_val contains 'other-style'
      or selected_kc_val == 'custom'
      or selected_kc_val contains '非原装'
    -%}
      {%- assign initial_keycaps_is_non_original = true -%}
    {%- endif -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- assign color_option_index = 0 -%}
{%- assign color_option_name = '' -%}
{%- assign all_color_values_list = '' -%}
{%- for opt in product.options_with_values -%}
  {%- assign opt_down = opt.name | downcase | strip -%}
  {%- if opt_down == 'color'
    or opt_down == 'colour'
    or opt_down contains 'color'
    or opt_down contains 'colour'
    or opt_down contains 'base'
    or opt_down contains 'case'
    or opt_down contains '颜色'
    or opt_down contains '底座'
    or opt_down contains '外壳'
  -%}
    {%- assign color_option_index = forloop.index -%}
    {%- assign color_option_name = opt.name -%}
    {%- capture all_color_values_list -%}{%- for v in opt.values -%}{{ v | downcase | strip }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}{%- endcapture -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- capture variant_media_map -%}
  {
    {%- for v in product.variants -%}
      "{{ v.id }}": {{ v.featured_media.id | default: v.featured_image.id | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  }
{%- endcapture -%}
{%- capture media_index_map -%}
  {
    {%- for m in product.media -%}
      "{{ m.id }}": {{ forloop.index0 }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  }
{%- endcapture -%}

{%- assign bundle_1_variants = product.metafields.custom.bundle_1_variants.value -%}
{%- assign bundle_2_variants = product.metafields.custom.bundle_2_variants.value -%}
{%- assign bundle_3_variants = product.metafields.custom.bundle_3_variants.value -%}
{%- assign bundle_1_count = bundle_1_variants.size | default: 0 -%}
{%- assign bundle_2_count = bundle_2_variants.size | default: 0 -%}
{%- assign bundle_3_count = bundle_3_variants.size | default: 0 -%}
{%- assign bundle_total_count = bundle_1_count | plus: bundle_2_count | plus: bundle_3_count -%}

{%- comment -%} 加购组（原 Setup 2 / Setup 3）：键盘默认折叠，键帽等默认展开 {%- endcomment -%}
{%- if is_keyboard -%}
  {%- assign bundle_addons_open = false -%}
{%- else -%}
  {%- assign bundle_addons_open = true -%}
{%- endif -%}

{%- comment -%} 仅键盘和键帽展示搭配区域，轴、鼠标、配件等不展示 {%- endcomment -%}
{%- assign show_complete_setup = false -%}
{%- if is_keyboard -%}
  {%- if bundle_1_count > 0 -%}
    {%- assign show_complete_setup = true -%}
  {%- endif -%}
{%- elsif is_keycap -%}
  {%- if bundle_1_count > 0 or bundle_total_count > 0 -%}
    {%- assign show_complete_setup = true -%}
  {%- endif -%}
{%- endif -%}

{%- if show_complete_setup -%}
  <div
    class="bundle-list"
    {% if is_keyboard %}
      id="StyleYourBoardBox"
    {% endif %}
  >
    <div
      class="bundle-promo-overlay"
      id="BundlePromoOverlay"
      data-bundle-promo-overlay
    >
      {%- if is_keyboard -%}
        <div class="bundle-promo-overlay__badge bundle-promo-overlay__badge--lime">STYLE YOUR BOARD</div>
        <div class="bundle-promo-overlay__subtitle bundle-promo-overlay__subtitle--lime">
          <svg
            class="bundle-promo-overlay__icon"
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#70bb00"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
            <line x1="7" y1="7" x2="7.01" y2="7"></line>
          </svg>
          <span>Pair a keyboard with keycaps to get <strong>20% off keycaps.</strong></span>
        </div>
      {%- else -%}
        <div class="bundle-promo-overlay__badge bundle-promo-overlay__badge--pink">DOUBLE YOUR STYLE</div>
        <div class="bundle-promo-overlay__subtitle bundle-promo-overlay__subtitle--pink">
          <svg
            class="bundle-promo-overlay__icon"
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#ff007f"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
            <line x1="7" y1="7" x2="7.01" y2="7"></line>
          </svg>
          <span>Buy 2 keycap sets to get <strong>10% off keycaps.</strong></span>
        </div>
      {%- endif -%}
    </div>
    <div class="bundle-list-header">
      <div class="bundle-list-header__top">
        {%- if is_keyboard and keycaps_option_index > 0 -%}
          <span
            class="bundle-list-status bundle-list-status--mobile"
            id="StyleBoardModeStatusMobile"
            data-state="{% if initial_keycaps_is_non_original %}pending{% else %}neutral{% endif %}"
          >
            {%- if initial_keycaps_is_non_original -%}
              Pick 1 Keycap Set
            {%- else -%}
              Optional Add-on
            {%- endif -%}
          </span>
        {%- elsif is_keyboard == false -%}
          <div class="bundle-list-add-more variant__label">
            <span class="variant__label-title">Add One More:</span>
          </div>
        {%- endif -%}
        <div class="bundle-list-arrows" data-bundle-arrows>
          <button
            type="button"
            class="bundle-list-arrow bundle-list-arrow--prev is-disabled"
            data-bundle-prev
            aria-label="Previous"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button
            type="button"
            class="bundle-list-arrow bundle-list-arrow--next"
            data-bundle-next
            aria-label="Next"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </div>
    <div class="bundle-product-list-container">
      <div class="bundle-product-list--wrapper">
        <div class="bundle-product-list bundle-product-list--1 active">
          {% assign bundle_1_combo_images = product.metafields.custom.bundle_1_combo_images.value
            | default: product.metafields.custom.bundle_1_images.value
          %}
          {%- if is_keyboard -%}
            {% for variant in bundle_1_variants %}
              {% render 'bundle-keycap-item',
                variant: variant,
                forloop: forloop,
                product: product,
                combo_images: bundle_1_combo_images
              %}
            {% endfor %}
          {%- else -%}
            {%- assign seen_addon_ids = ',' -%}
            {% for item in bundle_1_variants %}
              {%- assign v = item -%}
              {%- if item.variants -%}
                {%- assign v = item.selected_or_first_available_variant | default: item.variants.first -%}
              {%- endif -%}
              {%- assign v_id = v.id | append: '' -%}
              {%- assign key = ',' | append: v_id | append: ',' -%}
              {%- unless seen_addon_ids contains key -%}
                {%- if v_id != blank -%}
                  {%- assign seen_addon_ids = seen_addon_ids | append: v_id | append: ',' -%}
                {%- endif -%}
                {% render 'bundle-variant-item', variant: item %}
              {%- endunless -%}
            {% endfor %}
            {% for item in bundle_2_variants %}
              {%- assign v = item -%}
              {%- if item.variants -%}
                {%- assign v = item.selected_or_first_available_variant | default: item.variants.first -%}
              {%- endif -%}
              {%- assign v_id = v.id | append: '' -%}
              {%- assign key = ',' | append: v_id | append: ',' -%}
              {%- unless seen_addon_ids contains key -%}
                {%- if v_id != blank -%}
                  {%- assign seen_addon_ids = seen_addon_ids | append: v_id | append: ',' -%}
                {%- endif -%}
                {% render 'bundle-variant-item', variant: item %}
              {%- endunless -%}
            {% endfor %}
            {% for item in bundle_3_variants %}
              {%- assign v = item -%}
              {%- if item.variants -%}
                {%- assign v = item.selected_or_first_available_variant | default: item.variants.first -%}
              {%- endif -%}
              {%- assign v_id = v.id | append: '' -%}
              {%- assign key = ',' | append: v_id | append: ',' -%}
              {%- unless seen_addon_ids contains key -%}
                {%- if v_id != blank -%}
                  {%- assign seen_addon_ids = seen_addon_ids | append: v_id | append: ',' -%}
                {%- endif -%}
                {% render 'bundle-variant-item', variant: item %}
              {%- endunless -%}
            {% endfor %}
          {%- endif -%}

          {%- if is_keyboard -%}
            <!-- Style Your Board: Selected Keycap Spec Card (单层行内展开 - 浅灰底色) -->
            <div class="bundle-keycap-spec-card" id="BundleKeycapSpecCard" hidden>
              <div class="bundle-keycap-spec-card__inner">
                <div class="bundle-keycap-spec-card__main">
                  <div class="bundle-keycap-spec-card__title" id="BundleKeycapSpecTitle">Sunset Glow Keycaps</div>
                  <div class="bundle-keycap-spec-card__specs" id="BundleKeycapSpecDesc">
                    PBT | 142 Keys | Cherry Profile
                  </div>
                </div>
                <a
                  class="bundle-keycap-spec-card__learn-more"
                  id="BundleKeycapSpecLearnMore"
                  href="#"
                  role="button"
                >
                  <span>Learn More</span>
                  <svg
                    viewBox="0 0 12 12"
                    fill="none"
                    class="bundle-keycap-spec-card__learn-more-icon"
                    aria-hidden="true"
                  >
                    <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4.5M9.5 2.5V7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </div>
            </div>

            <!-- Keycap Overview Modal (点击 Learn More 弹出) -->
            <div
              class="keycap-overview-modal"
              id="KeycapOverviewModal"
              hidden
              aria-hidden="true"
              role="dialog"
              aria-modal="true"
              aria-labelledby="KeycapOverviewModalHeader"
            >
              <div class="keycap-overview-modal__backdrop" data-overview-close></div>
              <div class="keycap-overview-modal__dialog" role="document">
                <div class="keycap-overview-modal__header">
                  <h3 class="keycap-overview-modal__heading" id="KeycapOverviewModalHeader">Overview</h3>
                  <button type="button" class="keycap-overview-modal__close" data-overview-close aria-label="Close">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <line x1="18" y1="6" x2="6" y2="18"></line>
                      <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                  </button>
                </div>

                <div class="keycap-overview-modal__body">
                  <div class="keycap-overview-modal__gallery">
                    <div class="keycap-overview-modal__counter" id="KeycapOverviewCounter">1/1</div>
                    <button
                      type="button"
                      class="keycap-overview-modal__nav keycap-overview-modal__nav--prev"
                      id="KeycapOverviewPrev"
                      aria-label="Previous image"
                    >
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <polyline points="15 18 9 12 15 6"></polyline>
                      </svg>
                    </button>
                    <div class="keycap-overview-modal__slides" id="KeycapOverviewSlides"></div>
                    <button
                      type="button"
                      class="keycap-overview-modal__nav keycap-overview-modal__nav--next"
                      id="KeycapOverviewNext"
                      aria-label="Next image"
                    >
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <polyline points="9 18 15 12 9 6"></polyline>
                      </svg>
                    </button>
                    <div class="keycap-overview-modal__dots" id="KeycapOverviewDots"></div>
                  </div>

                  <div class="keycap-overview-modal__meta">
                    <div class="keycap-overview-modal__title" id="KeycapOverviewTitle"></div>
                    <div class="keycap-overview-modal__price-row" id="KeycapOverviewPrice"></div>
                  </div>

                  <div class="keycap-overview-modal__points" id="KeycapOverviewPoints"></div>

                  <div class="keycap-overview-modal__actions">
                    <a
                      href="#"
                      class="keycap-overview-modal__btn keycap-overview-modal__btn--learn-more"
                      id="KeycapOverviewProductLink"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Learn more
                    </a>
                    <button
                      type="button"
                      class="keycap-overview-modal__btn keycap-overview-modal__btn--customize"
                      id="KeycapOverviewContinueBtn"
                      data-overview-close
                    >
                      Continue to customize
                    </button>
                  </div>
                </div>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{%- if is_keyboard -%}
  {%- assign service_product = all_products['manual-keycap-installation-service'] -%}
  {%- assign service_variant = service_product.selected_or_first_available_variant
    | default: service_product.variants.first
  -%}
  {%- assign service_variant_id = service_variant.id | default: 67830185656601 -%}
  {%- assign service_title = 'Custom Keycap Installation' -%}
  {%- assign service_initially_hidden = false -%}
  {%- if bundle_1_count > 0 and keycaps_option_index > 0 and initial_keycaps_is_non_original == false -%}
    {%- assign service_initially_hidden = true -%}
  {%- endif -%}

  <div
    class="manual-service-card has-sale-badge"
    id="ManualKeycapServiceCard"
    data-variant-id="{{ service_variant_id }}"
    tabindex="0"
    role="checkbox"
    aria-checked="false"
    {% if service_initially_hidden %}
      hidden
    {% endif %}
  >
    <div class="manual-service-card__sale-badge" aria-hidden="true">
      <span class="manual-service-card__sale-text">FREE</span>
    </div>
    <div class="manual-service-card__inner">
      <div class="manual-service-card__checkbox-wrap">
        <input
          type="checkbox"
          id="ManualKeycapServiceCheckbox"
          class="manual-service-card__checkbox"
          data-variant-id="{{ service_variant_id }}"
          aria-label="{{ service_title }}"
        >
        <span class="manual-service-card__checkbox-custom" aria-hidden="true">
          <svg viewBox="0 0 12 10" fill="none" class="manual-service-card__check-icon">
            <path d="M1 5l3.5 3.5L11 1.5" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </div>
      <div class="manual-service-card__content">
        <div class="manual-service-card__header">
          <label for="ManualKeycapServiceCheckbox" class="manual-service-card__title">
            {{ service_title }}
          </label>
        </div>
        <div class="manual-service-card__desc">
          We'll professionally install your selected keycaps before shipping, so your keyboard arrives customized to
          your style and ready to use right out of the box.
          <a href="/pages/style-studio?view=style-studio" class="manual-service-card__link"
            >Learn more about this service.</a
          >
        </div>
        <div class="manual-service-card__notice">
          <svg viewBox="0 0 16 16" fill="none" class="manual-service-card__notice-icon" aria-hidden="true">
            <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.25"/>
            <path d="M8 7v4M8 4.75h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <span class="manual-service-card__notice-text">Original keycaps will not be included in the shipment.</span>
        </div>
        <div class="manual-service-card__prompt" id="ManualKeycapServicePrompt" style="display: none;">
          <svg viewBox="0 0 16 16" fill="none" class="manual-service-card__prompt-icon" aria-hidden="true">
            <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.25"/>
            <path d="M8 7v4M8 4.75h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <span class="manual-service-card__prompt-text"></span>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{%- comment -%} 键盘商品 More Add-ons 模块已根据需求移除 {%- endcomment -%}

{%- form 'product', product, id: form_id, class: 'product-single__form' -%}
  {%- if is_keyboard and show_complete_setup and keycaps_option_index > 0 -%}
    <div
      class="keycap-validation-notice"
      id="KeycapValidationNotice"
      role="alert"
      {% unless initial_keycaps_is_non_original %}
        hidden
      {% endunless %}
    >
      <svg viewBox="0 0 16 16" fill="none" class="keycap-validation-notice__icon" aria-hidden="true">
        <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.35"/>
        <path d="M8 4.75v4M8 11.25h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <span>Please select 1 keycap set above for your custom build.</span>
    </div>
  {%- endif -%}
  <div class="product-form__actions-group">
    <div class="payment-buttons product__actions-row">
      <div class="product__quantity">
        {% assign qty_id = section_id | default: section.id | default: product.id | append: product.id %}
        {%- assign current_variant_has_inventory_limit = false -%}
        {%- if current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny' -%}
          {%- assign current_variant_has_inventory_limit = true -%}
          {%- assign current_variant_max_qty = current_variant.inventory_quantity | at_least: 0 -%}
        {%- endif -%}
        {%- render 'quantity-input',
          form_id: form_id,
          id: qty_id,
          qty: 1,
          min: 1,
          max: current_variant_max_qty,
          has_limit: current_variant_has_inventory_limit
        -%}
      </div>

      {%- liquid
        assign default_text = 'products.product.add_to_cart' | t
        assign button_text = 'products.product.add_to_cart' | t
        if template == 'product.preorder'
          assign default_text = 'products.product.preorder' | t
          assign button_text = 'products.product.preorder' | t
        endif
        unless current_variant.available
          assign button_text = 'products.product.sold_out' | t
        endunless
      -%}

      <button
        {% if product.empty? %}
          type="button"
        {% else %}
          type="submit"
        {% endif %}
        name="add"
        data-add-to-cart
        class="btn btn--full add-to-cart"
        {% unless current_variant.available %}
          disabled="disabled"
        {% endunless %}
      >
        <span data-add-to-cart-text data-default-text="{{ default_text }}">
          {%- if current_variant.available -%}
            {{ button_text | upcase }} | {{ current_variant.price | money | strip_html }}
          {%- else -%}
            {{ button_text }}
          {%- endif -%}
        </span>
      </button>
    </div>
  </div>

  <div class="shopify-payment-terms product__policies">{{ form | payment_terms }}</div>

  <select name="id" data-product-select class="product-single__variants no-js">
    {%- for variant in product.variants -%}
      {%- if variant.available -%}
        <option
          {% if variant == product.selected_or_first_available_variant %}
            selected="selected"
          {% endif %}
          value="{{ variant.id }}"
        >
          {{ variant.title }} - {{ variant.price | money_with_currency }}
        </option>
      {%- else -%}
        <option disabled="disabled">{{ variant.title }} - {{ 'products.product.sold_out' | t }}</option>
      {%- endif -%}
    {%- endfor -%}
  </select>

  <textarea id="product-json" data-variant-json class="hide" aria-hidden="true" aria-label="Product JSON">
    {{ product.variants | json }}
  </textarea>
  <textarea data-product-inventories class="hide" aria-hidden="true" aria-label="Product Inventories JSON">
    {
      {%- for variant in product.variants -%}
        "{{ variant.id }}": {
          "inventory_management": {{ variant.inventory_management | json }},
          "inventory_policy": {{ variant.inventory_policy | json }},
          "inventory_quantity": {{ variant.inventory_quantity | default: 0 }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    }
  </textarea>
  {%- if product.options.size > 1 -%}
    <textarea data-current-variant-json class="hide" aria-hidden="true" aria-label="Variant JSON">
      {{ current_variant | json }}
    </textarea>
  {%- endif -%}
{%- endform -%}

<script>
  function initMoreVariantForm() {
    function cleanPriceText(str) {
      if (!str) return '';
      return String(str).replace(/<[^>]*>/g, '').trim();
    }

    function relocateBundlePromoOverlay() {
      const overlay = document.getElementById('BundlePromoOverlay');
      if (!overlay) return;
      const isMobile = window.innerWidth <= 768;
      if (isMobile) {
        const mobileHeader = document.querySelector('.product-mobile-header') ||
                             document.querySelector('.product-single__meta .product-block--header') ||
                             document.querySelector('.product-single__meta');
        if (mobileHeader && overlay.parentNode !== mobileHeader) {
          overlay.classList.remove('is-floating');
          overlay.classList.add('is-mobile-header');
          mobileHeader.appendChild(overlay);
        }
      } else {
        const mainPhotos = document.querySelector('.product__main-photos');
        if (mainPhotos && overlay.parentNode !== mainPhotos) {
          overlay.classList.remove('is-mobile-header');
          overlay.classList.add('is-floating');
          mainPhotos.appendChild(overlay);
        }
      }
    }
    window.__relocateBundlePromoOverlay = relocateBundlePromoOverlay;
    relocateBundlePromoOverlay();
    window.addEventListener('resize', relocateBundlePromoOverlay);

    function updateBundleListScroll(target) {
      const lists = target ? [target] : document.querySelectorAll('.bundle-product-list.active');
      lists.forEach(list => {
        if (!list) return;
        if (list.classList.contains('bundle-product-list--1')) return;
        // More Add-ons 列表全部展示，不限制高度、不出滚动条
        if (list.classList.contains('bundle-product-list--addons')) return;
        const items = list.querySelectorAll('.bundle-product-item');
        if (items.length >= 4) {
          const item0 = items[0];
          const item1 = items[1];
          const item2 = items[2];
          const item3 = items[3];

          if (item0 && item1 && item2 && item3) {
            const style = window.getComputedStyle(list);
            const gap = parseFloat(style.rowGap || style.gap) || 12;
            const paddingTop = parseFloat(style.paddingTop) || 0;

            const h0 = item0.offsetHeight;
            const h1 = item1.offsetHeight;
            const h2 = item2.offsetHeight;
            const h3 = item3.offsetHeight;

            // 完整露出前3个商品 + 第4个商品露出 50%（露出三个半）
            const maxHeight = paddingTop + h0 + gap + h1 + gap + h2 + gap + (h3 * 0.5);
            list.style.maxHeight = `${Math.round(maxHeight)}px`;
            list.style.overflowY = 'auto';
            list.classList.add('has-scroll');
          }
        } else {
          list.style.maxHeight = '';
          list.style.overflowY = '';
          list.classList.remove('has-scroll');
        }
      });
    }

    // 动态计算移动端 More Add-ons 滚动可视高度（STYLE YOUR BOARD / DOUBLE YOUR STYLE 移动端已改为单行横向滑动）
    function updateMobileCardGridScroll() {
      const isMobile = window.innerWidth <= 768;
      document.querySelectorAll('.bundle-product-list--1').forEach(list => {
        list.style.removeProperty('max-height');
        list.style.removeProperty('overflow-y');
        list.style.removeProperty('-webkit-overflow-scrolling');
      });

      const cardLists = document.querySelectorAll('.bundle-product-list--addons');

      cardLists.forEach(list => {
        if (!list) return;

        // 仅在移动端执行动态计算，桌面端清除内联样式恢复原有规则
        if (!isMobile) {
          list.style.removeProperty('max-height');
          list.style.removeProperty('overflow-y');
          list.style.removeProperty('-webkit-overflow-scrolling');
          return;
        }

        // 移动端列数：<= 440px 为 2 列，441px ~ 768px 为 3 列
        const cols = window.innerWidth <= 440 ? 2 : 3;
        const cards = list.querySelectorAll('.bundle-keycap-card');

        // 如果卡片数量不足以排入第二排，不需要滚动条，全部展示
        if (cards.length <= cols) {
          list.style.setProperty('max-height', 'none', 'important');
          list.style.setProperty('overflow-y', 'visible', 'important');
          return;
        }

        // 目标：第二排第一张卡片（索引为 cols）
        const targetCard = cards[cols];
        if (!targetCard) return;

        const titleEl = targetCard.querySelector('.bundle-keycap-card__title') || targetCard;
        const listRect = list.getBoundingClientRect();
        const titleRect = titleEl.getBoundingClientRect();

        // 若面板折叠不可见或尚未渲染，稍后再测
        if (listRect.width === 0 || titleRect.height === 0) return;

        const currentScrollTop = list.scrollTop || 0;
        // 目标：第二排卡片标题之上（刚好截止在第二排卡片标题上方，露出完整第一排卡片及第二排卡片图片）
        const calculatedHeight = Math.round((titleRect.top - listRect.top) + currentScrollTop - 4);

        if (calculatedHeight > 0) {
          list.style.setProperty('max-height', `${calculatedHeight}px`, 'important');
          list.style.setProperty('overflow-y', 'auto', 'important');
          list.style.setProperty('-webkit-overflow-scrolling', 'touch', 'important');
        }
      });
    }

    // 加购组（原 Setup 2 / Setup 3）折叠面板：默认展开/折叠状态由 Liquid 输出（键盘默认折叠，其余默认展开）
    function initBundleAddonGroups() {
      const groups = document.querySelectorAll('[data-bundle-addon-group]');

      groups.forEach(group => {
        const toggle = group.querySelector('[data-bundle-addon-toggle]');
        if (!toggle) return;

        toggle.addEventListener('click', function () {
          const willOpen = !group.classList.contains('is-open');
          group.classList.toggle('is-open', willOpen);
          toggle.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
          if (willOpen) {
            requestAnimationFrame(() => {
              updateMobileCardGridScroll();
            });
          }
        });
      });
    }
    function formatMoney(cents) {
      let formatted = '$' + (cents / 100).toFixed(2);
      const moneyFormat = (window.theme && (theme.moneyFormat || (theme.settings && theme.settings.moneyFormat))) || null;
      if (window.theme && window.theme.Currency && typeof window.theme.Currency.formatMoney === 'function') {
        formatted = theme.Currency.formatMoney(cents, moneyFormat);
      }
      if (typeof formatted === 'string') {
        formatted = formatted.replace(/<[^>]*>/g, '').trim();
      }
      return formatted;
    }

    function getCurrentVariantId() {
      const select = document.querySelector('select.product-single__variants') || document.querySelector('select[name="id"]');
      if (select && select.value) {
        return select.value;
      }
      const urlParams = new URLSearchParams(window.location.search);
      const variantId = urlParams.get('variant');
      if (variantId) {
        return variantId;
      }
      const currentVariantJson = document.querySelector('textarea[data-current-variant-json]');
      if (currentVariantJson) {
        try {
          const idInput = JSON.parse(currentVariantJson.value || currentVariantJson.textContent);
          if (idInput && idInput.id) return idInput.id;
        } catch (error) {
          console.warn('Unable to parse current variant JSON', error);
        }
      }
      const variantsJson = document.querySelector('textarea[data-variant-json]');
      if (variantsJson) {
        try {
          const variants = JSON.parse(variantsJson.value || variantsJson.textContent);
          const availableVariant = variants.find(variant => variant.available !== false);
          if (availableVariant && availableVariant.id) return availableVariant.id;
        } catch (error) {
          console.warn('Unable to parse product variants JSON', error);
        }
      }
      return null;
    }
    function getAppendVariantIds() {
      let appendVariantIds = [];
      const serviceCheckbox = document.getElementById('ManualKeycapServiceCheckbox');
      const serviceCard = document.getElementById('ManualKeycapServiceCard');
      const isCustomKeycapsMode =
        typeof window.isKeycapModeCustom === 'function' ? window.isKeycapModeCustom() : true;
      const isServiceChecked = serviceCheckbox && serviceCheckbox.checked;
      const plan = serviceCard && typeof serviceCard._getServicePlan === 'function' ? serviceCard._getServicePlan() : null;
      const isServiceActive = isCustomKeycapsMode && isServiceChecked && plan && plan.sets > 0;

      let allVariants = document.querySelectorAll('.bundle-product-checkbox');
      for(let i = 0; i < allVariants.length; i++) {
        if(allVariants[i].checked) {
          const item = allVariants[i].closest('.bundle-product-item, .bundle-keycap-card');
          const qtyInput = item ? item.querySelector('.js-qty__num') : document.getElementById(`Quantity-${allVariants[i].id}`);
          let quantity = 1;
          if (item && item.classList.contains('bundle-keycap-card')) {
            // Setup 1 键帽：每款固定加购 1 套，不再跟随键盘数量
            quantity = 1;
          } else if (qtyInput) {
            quantity = Math.max(1, Number(qtyInput.value));
          } else {
            const mainQtyInput = document.querySelector('.product__quantity input[name="quantity"]') || document.querySelector('input[name="quantity"]');
            quantity = mainQtyInput ? Math.max(1, parseInt(mainQtyInput.value, 10) || 1) : 1;
          }
          const variantId = allVariants[i].dataset.bundleProduct || allVariants[i].id;
          let selectedVariant = {id: variantId, quantity: quantity};
          appendVariantIds.push(selectedVariant);
        }
      }

      if (isServiceActive) {
        const serviceVariantId = serviceCheckbox.dataset.variantId || '67830185656601';
        let kbDetails = {{ product.title | json }};
        const currentVariantId = getCurrentVariantId();
        const variantsJson = document.querySelector('textarea[data-variant-json]');
        if (variantsJson && currentVariantId) {
          try {
            const variants = JSON.parse(variantsJson.value || variantsJson.textContent);
            const found = variants.find(v => String(v.id) === String(currentVariantId));
            if (found && found.title && found.title !== 'Default Title') {
              const formattedPrice = found.price ? ` - ${formatMoney(found.price)}` : '';
              kbDetails += ` (${found.title}${formattedPrice})`;
            }
          } catch (e) {
            console.warn('Unable to format variant details', e);
          }
        }

        if (plan && plan.keycaps && plan.keycaps.length > 0) {
          // 每套服务包含键盘型号与分配的键帽；相同键帽自动合并，不同键帽自动分行
          plan.keycaps.forEach(k => {
            appendVariantIds.push({
              id: serviceVariantId,
              quantity: 1,
              properties: {
                'For Keyboard': kbDetails,
                'Keycaps Assigned': k.title
              }
            });
          });
        } else {
          // 未选具体键帽时的兜底
          appendVariantIds.push({
            id: serviceVariantId,
            quantity: Math.max(1, plan.sets || 1),
            properties: {
              'For Keyboard': kbDetails
            }
          });
        }
      }

      console.log('appendVariantIds', appendVariantIds);
      return appendVariantIds;
    }
    window.getBundleAppendVariants = getAppendVariantIds;
    window.getBundleCurrentVariantId = getCurrentVariantId;
    function initBundleQtySelectors() {
      document.querySelectorAll('.bundle-product-list .js-qty__wrapper').forEach(el => {
        if (!el._qtySelector && window.theme && window.theme.QtySelector) {
          new theme.QtySelector(el, { namespace: '.product' });
        }
      });
    }
    function initBundleSelection() {
      function syncItemState(item, isChecked) {
        if (!item) return;
        if (isChecked) {
          item.classList.add('is-selected');
        } else {
          item.classList.remove('is-selected');
        }
      }

      function autoCheckItem(target) {
        if (!target) return;
        const item = target.closest('.bundle-product-item');
        if (!item || item.classList.contains('sold-out')) return;

        const checkbox = item.querySelector('.bundle-product-checkbox');
        if (!checkbox || checkbox.disabled || checkbox.checked) return;

        checkbox.checked = true;
        syncItemState(item, true);
        item._clickCount = 0;
        if (item._clickTimer) clearTimeout(item._clickTimer);
        checkbox.dispatchEvent(new Event('change', { bubbles: true }));
      }

      // Initial state sync
      document.querySelectorAll('.bundle-product-checkbox').forEach(cb => {
        const item = cb.closest('.bundle-product-item');
        if (item) {
          syncItemState(item, cb.checked);
        }
      });

      // Click handling on .bundle-product-item:
      // - 未勾选时：需在卡片方块内（空白、图片、标题、价格）连续点击 3 次（每次间隔不超过 1.5 秒）才打勾
      // - 已勾选时：只有刚好点击复选框小方块才可以取消打勾
      // - 数量调节按钮（+ / -）：点击自动打勾
      document.addEventListener('click', function (e) {
        const item = e.target.closest('.bundle-product-item');
        if (!item || item.classList.contains('sold-out')) return;

        const checkbox = item.querySelector('.bundle-product-checkbox');
        if (!checkbox || checkbox.disabled) return;

        // 若点击的是数量调节按钮（+-号），自动打勾，不触发卡片3次点击逻辑
        const qtyAdjustBtn = e.target.closest('.js-qty__adjust');
        if (qtyAdjustBtn && item.contains(qtyAdjustBtn)) {
          autoCheckItem(qtyAdjustBtn);
          return;
        }

        // 若点击的是数量调节组件的其他区域（如输入框本身或库存提示），不改变勾选状态
        if (e.target.closest('.bundle-product-qty') || e.target.closest('.js-qty__wrapper')) {
          return;
        }

        const isCheckboxTarget = e.target === checkbox || !!e.target.closest('.bundle-product-checked') || !!e.target.closest('.bundle-product-checkbox');

        // 1. 单击对准左侧复选框：直接打勾或取消打勾
        if (isCheckboxTarget) {
          const willBeChecked = !checkbox.checked;
          checkbox.checked = willBeChecked;
          syncItemState(item, willBeChecked);
          item._clickCount = 0;
          if (item._clickTimer) clearTimeout(item._clickTimer);
          checkbox.dispatchEvent(new Event('change', { bubbles: true }));
          return;
        }

        // 2. 点击卡片方块内其他区域（图片、标题、价格、空白处）
        const isCurrentlySelected = item.classList.contains('is-selected') || checkbox.checked;

        if (isCurrentlySelected) {
          // 已勾选时，点击卡片其他区域保持勾选状态，不取消
          e.preventDefault();
        } else {
          // 未勾选时，卡片其他区域需要连续点击 3 次才打勾（每次间隔不超过 1.5 秒）
          e.preventDefault();

          item._clickCount = (item._clickCount || 0) + 1;
          if (item._clickTimer) clearTimeout(item._clickTimer);

          if (item._clickCount >= 3) {
            item._clickCount = 0;
            checkbox.checked = true;
            syncItemState(item, true);
            checkbox.dispatchEvent(new Event('change', { bubbles: true }));
          } else {
            item._clickTimer = setTimeout(function () {
              item._clickCount = 0;
            }, 1500);
          }
        }
      });

      // 手动输入数量时（input 事件，如键盘输入 2）自动打勾
      document.addEventListener('input', function (e) {
        if (e.target && e.target.closest && e.target.closest('.bundle-product-item .js-qty__num')) {
          autoCheckItem(e.target);
        }
      });

      // 监听复选框及数量框 change 事件以同步状态
      document.addEventListener('change', function (e) {
        if (!e.target) return;
        if (e.target.classList.contains('bundle-product-checkbox')) {
          const item = e.target.closest('.bundle-product-item');
          if (item) {
            syncItemState(item, e.target.checked);
          }
        } else if (e.target.closest && e.target.closest('.bundle-product-item .js-qty__num')) {
          autoCheckItem(e.target);
        }
      });
    }

    function initAddToCart() {
      const addBtn = document.querySelector('button.add-to-cart');
      const ajaxCart = new theme.AjaxProduct(addBtn);
      
      addBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        if (addBtn.disabled || addBtn.classList.contains('btn--loading')) {
          return;
        }
        if (typeof window.validateKeycapModeBeforePurchase === 'function' && !window.validateKeycapModeBeforePurchase()) {
          return;
        }
        const currentVariantId = getCurrentVariantId();
        if (!currentVariantId) {
          console.warn('Unable to determine the selected variant');
          return;
        }
        const mainQtyInput = document.querySelector('.product__quantity input[name="quantity"]') || document.querySelector('input[name="quantity"]');
        const mainQty = mainQtyInput ? Math.max(1, parseInt(mainQtyInput.value, 10) || 1) : 1;
        const rawItems = [
          { id: currentVariantId, quantity: mainQty }
        ];
        const appendVariantIds = getAppendVariantIds();
        if(appendVariantIds) {
          rawItems.push(...appendVariantIds);
        }

        // 预聚合：相同 variantId 且属性（properties）完全相同的商品预先合并数量，确保提交时就是单条累加数量
        const items = [];
        rawItems.forEach(item => {
          const itemPropsStr = JSON.stringify(item.properties || {});
          const existing = items.find(m => String(m.id) === String(item.id) && JSON.stringify(m.properties || {}) === itemPropsStr);
          if (existing) {
            existing.quantity = (existing.quantity || 1) + (item.quantity || 1);
          } else {
            items.push({ ...item });
          }
        });

        ajaxCart.MoreProductAddToCart(addBtn, items);
      });
    }
    function initSetup1KeycapSelection() {
      const setup1List = document.querySelector('.bundle-product-list--1');
      if (!setup1List) return;

      const cards = setup1List.querySelectorAll('.bundle-keycap-card');
      if (!cards.length) return;

      const isKeyboardProduct = {{ is_keyboard | json }};
      const colorOptionIndex = {{ color_option_index | json }};
      const colorOptionName = {{ color_option_name | json }};
      const allKnownColors = {{ all_color_values_list | split: ',' | json }}.filter(Boolean);
      const variantMediaMap = {{ variant_media_map }};
      const mediaIndexMap = {{ media_index_map }};

      let previewOverlay = null;
      let previewImg = null;
      const mainSlider = document.querySelector('[data-product-photos]');

      if (isKeyboardProduct) {
        previewOverlay = document.querySelector('.bundle-combo-preview');
        if (!previewOverlay) {
          const mainPhotos = document.querySelector('.product__main-photos');
          if (mainPhotos) {
            previewOverlay = document.createElement('div');
            previewOverlay.className = 'bundle-combo-preview';
            previewOverlay.innerHTML = '<div class="bundle-combo-preview-wrap"><img class="bundle-combo-preview-img" src="" alt="Keyboard + Keycap Combo"></div>';
            mainPhotos.appendChild(previewOverlay);
          }
        }
        previewImg = previewOverlay ? previewOverlay.querySelector('.bundle-combo-preview-img') : null;
      }

      function getCurrentColorValue() {
        if (colorOptionIndex > 0) {
          const wrap = document.querySelector(
            `.variant-input-wrap[data-index="option${colorOptionIndex}"], fieldset[name="${colorOptionName}" i], .variant-input-wrap[data-handle="${(colorOptionName || '').toLowerCase()}"]`
          );
          if (wrap) {
            const checked = wrap.querySelector('input[type="radio"]:checked');
            if (checked && checked.value) return checked.value.trim();
            const sel = wrap.querySelector('select');
            if (sel && sel.value) return sel.value.trim();
          }
        }

        const genericWrap = document.querySelector(
          '.variant-input-wrap[data-handle="color"], .variant-input-wrap[data-handle="colour"], .variant-input-wrap[data-handle*="color"], .variant-input-wrap[data-handle*="colour"], .variant-input-wrap[data-handle*="base"], fieldset[name="Color" i], fieldset[name="Colour" i]'
        );
        if (genericWrap) {
          const checked = genericWrap.querySelector('input[type="radio"]:checked');
          if (checked && checked.value) return checked.value.trim();
          const sel = genericWrap.querySelector('select');
          if (sel && sel.value) return sel.value.trim();
        }

        const variant = (typeof getCurrentVariantData === 'function') ? getCurrentVariantData() : null;
        if (variant) {
          if (colorOptionIndex > 0 && variant['option' + colorOptionIndex]) {
            return String(variant['option' + colorOptionIndex]).trim();
          }
          if (Array.isArray(variant.options) && allKnownColors.length) {
            for (const val of variant.options) {
              if (allKnownColors.includes(String(val).toLowerCase().trim())) {
                return String(val).trim();
              }
            }
          }
        }

        return '';
      }

      function normalizeText(str) {
        return String(str || '')
          .toLowerCase()
          .replace(/[\-_/#|,()+:：]/g, ' ')
          .replace(/\s+/g, ' ')
          .trim();
      }

      function extractShortTitle(raw) {
        if (!raw) return '';
        return String(raw)
          .toLowerCase()
          .replace(/\s+(cherry|oem|xda|moa|mda|dsa|kda|asa)?\s*(profile\s*)?keycaps?(\s*set)?$/i, '')
          .trim();
      }

      function findMatchingSlideIndex(card, targetColor) {
        const keycapTitle = (card.dataset.keycapTitle || '').toLowerCase().trim();
        const productTitle = (card.dataset.productTitle || '').toLowerCase().trim();
        const keycapHandle = (card.dataset.keycapHandle || '').toLowerCase().trim();
        const keycapSku = (card.dataset.keycapSku || '').toLowerCase().trim();
        const variantId = (card.dataset.variantId || '').trim();
        const shortTitle = extractShortTitle(keycapTitle || productTitle);
        const fullTitle = normalizeText(productTitle || keycapTitle);

        const currentColor = String(targetColor !== undefined ? targetColor : getCurrentColorValue()).toLowerCase().trim();
        const normalizedCurrentColor = normalizeText(currentColor);

        const currentColorTokens = [];
        if (currentColor) {
          currentColorTokens.push(currentColor);
          if (normalizedCurrentColor && normalizedCurrentColor !== currentColor) {
            currentColorTokens.push(normalizedCurrentColor);
          }
          if (currentColor === 'white' || currentColor.includes('white')) {
            currentColorTokens.push('white', '白色', 'color_white');
          }
          if (currentColor === 'black' || currentColor.includes('black')) {
            currentColorTokens.push('black', '黑色', 'color_black');
          }
        }

        const otherColors = (allKnownColors || [])
          .map(c => c.toLowerCase().trim())
          .filter(c => c && c !== currentColor && !currentColor.includes(c) && !c.includes(currentColor));

        const slides = document.querySelectorAll('[data-product-photos] .product-main-slide');
        let bestIndex = -1;
        let bestScore = -1;

        for (let i = 0; i < slides.length; i++) {
          const slide = slides[i];
          const rawAlt = (slide.dataset.rawAlt || slide.getAttribute('data-raw-alt') || '').toLowerCase();
          const img = slide.querySelector('img');
          const imgAlt = ((img && (img.alt || img.getAttribute('data-alt'))) || '').toLowerCase();
          const altText = (rawAlt + ' ' + imgAlt).trim();
          if (!altText) continue;

          const normalizedAlt = normalizeText(altText);

          // 1. Check if altText matches this keycap
          let matchesKeycap = false;
          let isFullTitleMatch = false;

          if (fullTitle && (normalizedAlt.includes(fullTitle) || altText.includes(keycapTitle) || altText.includes(productTitle))) {
            matchesKeycap = true;
            isFullTitleMatch = true;
          } else if (shortTitle && shortTitle.length >= 2 && (altText.includes(shortTitle) || normalizedAlt.includes(normalizeText(shortTitle)))) {
            matchesKeycap = true;
          } else if (keycapHandle && keycapHandle.length >= 2 && (altText.includes(keycapHandle) || normalizedAlt.includes(keycapHandle.replace(/[^a-z0-9]+/g, ' ')))) {
            matchesKeycap = true;
          } else if (keycapSku && keycapSku.length >= 3 && altText.includes(keycapSku)) {
            matchesKeycap = true;
          } else if (variantId && altText.includes(variantId)) {
            matchesKeycap = true;
          } else if (shortTitle && (
            altText.includes('#keycap_' + shortTitle.replace(/[^a-z0-9]+/g, '-')) ||
            altText.includes('#keycap:' + shortTitle)
          )) {
            matchesKeycap = true;
          }

          if (!matchesKeycap && shortTitle) {
            const words = shortTitle.split(/\s+/).filter(w => w.length >= 3 && !['set', 'profile', 'custom'].includes(w));
            if (words.length && words.every(w => normalizedAlt.includes(w))) {
              matchesKeycap = true;
            }
          }

          if (!matchesKeycap) continue;

          // 2. Score based on color match
          let score = 0;
          if (!currentColor) {
            score = isFullTitleMatch ? 200 : 100;
          } else {
            const hasCurrentColor = currentColorTokens.some(tok => altText.includes(tok) || normalizedAlt.includes(tok));
            const hasOtherColor = otherColors.some(other => altText.includes(other) || normalizedAlt.includes(other));

            // Check direct combination: [Color] + [Full Title] or [Full Title] + [Color]
            const isExactColorFullTitleCombo = fullTitle && (
              normalizedAlt.includes(normalizedCurrentColor + ' ' + fullTitle) ||
              normalizedAlt.includes(fullTitle + ' ' + normalizedCurrentColor)
            );

            if (isExactColorFullTitleCombo && !hasOtherColor) {
              score = 200; // Top Match: 颜色 + 键帽完整Title
            } else if (hasCurrentColor && !hasOtherColor) {
              score = isFullTitleMatch ? 150 : 100; // Matches color and full/short title
            } else if (hasCurrentColor && hasOtherColor) {
              score = 80;  // Matches current color, but mentions another color
            } else if (!hasCurrentColor && !hasOtherColor) {
              score = 50;  // Generic keycap image (no color specified in alt)
            } else {
              score = 10;  // Belongs to another color variant
            }
          }

          if (score > bestScore) {
            bestScore = score;
            const idx = parseInt(slide.dataset.index, 10);
            bestIndex = isNaN(idx) ? i : idx;
          }
        }

        return bestScore >= 50 ? bestIndex : -1;
      }

      // 优先取当前可见的缩略图（图片分组功能会给部分缩略图加 .hide，且主题会重写可见缩略图的 data-index，
