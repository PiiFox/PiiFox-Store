      function positionSpecCardUnderRow(card, specCard) {
        if (!card || !specCard || !setup1List) return;

        // 移动端为单行横向滑动：将规格卡放置在横向列表容器正下方，避免混入横向 flex 行中
        if (window.innerWidth <= 768) {
          if (specCard.previousElementSibling !== setup1List) {
            setup1List.after(specCard);
          }
          return;
        }

        const allCards = Array.from(setup1List.querySelectorAll('.bundle-keycap-card'));
        const cardIndex = allCards.indexOf(card);
        if (cardIndex < 0) return;

        // 获取当前容器列数 (4, 3, 或 2)
        let cols = 4;
        const style = window.getComputedStyle(setup1List);
        const tmpl = style.gridTemplateColumns;
        if (tmpl && tmpl !== 'none') {
          const count = tmpl.trim().split(/\s+/).length;
          if (count > 0) cols = count;
        } else {
          cols = window.innerWidth <= 440 ? 2 : (window.innerWidth <= 768 ? 3 : 4);
        }

        // 计算当前卡片所在行的最后一张卡片索引
        const rowIndex = Math.floor(cardIndex / cols);
        const lastIndexInRow = Math.min((rowIndex + 1) * cols - 1, allCards.length - 1);
        const targetEndCard = allCards[lastIndexInRow];

        if (targetEndCard && targetEndCard !== specCard.previousElementSibling) {
          targetEndCard.after(specCard);
        }
      }

      window.__syncSelectedKeycapSpecCard = syncSelectedKeycapSpecCard;
      syncSelectedKeycapSpecCard();

      function handleVariantColorSwitch(variant) {
        if (!isKeyboardProduct) return;

        const remainingSelected = getSelectedCardsByOrder();
        if (remainingSelected.length > 0) {
          // 仅当键盘已勾选 STYLE YOUR BOARD 中的键帽时，底座颜色切换后才自动切换到对应新颜色的键帽搭配图
          const currentCard = remainingSelected[remainingSelected.length - 1];
          setTimeout(() => {
            showKeycapImage(currentCard);
          }, 60);
          setTimeout(() => {
            showKeycapImage(currentCard);
          }, 180);
        }
        // 未勾选键帽时：不做任何干涉，主题原生的变体切图逻辑会自动且流畅生效！
      }

      ['variant:change', 'variantChange'].forEach(eventName => {
        document.addEventListener(eventName, function (e) {
          const variant = (e.detail && e.detail.variant) || null;
          handleVariantColorSwitch(variant);
        });
      });

      document.addEventListener('change', function (e) {
        if (!e.target || !e.target.closest) return;
        if (e.target.closest('.variant-input-wrap, [data-variant-input]')) {
          setTimeout(() => {
            const currentVariant = (typeof getCurrentVariantData === 'function') ? getCurrentVariantData() : null;
            handleVariantColorSwitch(currentVariant);
          }, 60);
        }
      });
