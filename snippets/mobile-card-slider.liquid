{% comment %}
  Mobile Product Card 2-Image Slider & Indicator Script
  Provides smooth horizontal swipe and 2-segment indicator bar for mobile product cards.
{% endcomment %}
<script>
  (function() {
    function initMobileCardSliders() {
      // Find all cards with mobile slider that haven't been initialized
      var sliders = document.querySelectorAll('.js-card-mobile-slider:not(.js-slider-ready)');
      if (!sliders.length) return;

      sliders.forEach(function(slider) {
        var card = slider.closest('.grid-product');
        if (!card) return;
        var indicator = card.querySelector('.js-card-indicator');
        var link = card.querySelector('.grid-product__link');

        slider.classList.add('js-slider-ready');

        var bars = indicator ? indicator.querySelectorAll('.indicator-bar') : [];

        var isSwiping = false;
        var startX = 0;
        var startY = 0;
        var scrollStartX = 0;

        // Preload/unveil secondary lazyload image on initial touch or interaction
        function unveilImages() {
          var lazyImages = slider.querySelectorAll('img.lazyload');
          lazyImages.forEach(function(img) {
            if (window.lazySizes && window.lazySizes.loader) {
              window.lazySizes.loader.unveil(img);
            } else if (img.dataset.src && !img.src) {
              img.src = img.dataset.src;
              img.classList.add('lazyloaded');
            }
          });
        }

        // Touch events for smooth native gesture handling
        slider.addEventListener('touchstart', function(e) {
          if (!e.touches || !e.touches[0]) return;
          startX = e.touches[0].clientX;
          startY = e.touches[0].clientY;
          isSwiping = false;
          unveilImages();
        }, { passive: true });

        slider.addEventListener('touchmove', function(e) {
          if (!e.touches || !e.touches[0]) return;
          var diffX = Math.abs(e.touches[0].clientX - startX);
          var diffY = Math.abs(e.touches[0].clientY - startY);
          if (diffX > 8 && diffX > diffY) {
            isSwiping = true;
          }
        }, { passive: true });

        // Prevent accidental link click if the user swiped horizontally
        if (link) {
          link.addEventListener('click', function(e) {
            if (isSwiping) {
              e.preventDefault();
              e.stopPropagation();
              isSwiping = false;
            }
          }, true);
        }

        // Update indicator bar on scroll
        var scrollTimeout;
        slider.addEventListener('scroll', function() {
          clearTimeout(scrollTimeout);
          scrollTimeout = setTimeout(function() {
            var scrollLeft = slider.scrollLeft;
            var width = slider.clientWidth || 1;
            var activeIdx = Math.round(scrollLeft / width);
            if (activeIdx < 0) activeIdx = 0;
            if (activeIdx > 1) activeIdx = 1;

            if (bars.length) {
              bars.forEach(function(bar, idx) {
                if (idx === activeIdx) {
                  bar.classList.add('is-active');
                } else {
                  bar.classList.remove('is-active');
                }
              });
            }
          }, 35);
        }, { passive: true });

        // Indicator bar click/tap to switch image
        if (bars.length) {
          bars.forEach(function(bar) {
            bar.addEventListener('click', function(e) {
              e.preventDefault();
              e.stopPropagation();
              unveilImages();
              var targetIdx = parseInt(this.getAttribute('data-index') || '0', 10);
              var targetScroll = targetIdx * slider.clientWidth;
              slider.scrollTo({
                left: targetScroll,
                behavior: 'smooth'
              });
              bars.forEach(function(b, idx) {
                if (idx === targetIdx) {
                  b.classList.add('is-active');
                } else {
                  b.classList.remove('is-active');
                }
              });
            });
          });
        }

        // Mouse drag simulation for testing on desktop / devtools emulator
        var isMouseDown = false;
        var mouseStartX = 0;
        var mouseMoved = false;

        slider.addEventListener('mousedown', function(e) {
          if (e.button !== 0) return;
          isMouseDown = true;
          mouseMoved = false;
          mouseStartX = e.pageX;
          scrollStartX = slider.scrollLeft;
          unveilImages();
        });

        window.addEventListener('mouseup', function(e) {
          if (!isMouseDown) return;
          isMouseDown = false;
          if (mouseMoved) {
            var activeIdx = Math.round(slider.scrollLeft / (slider.clientWidth || 1));
            slider.scrollTo({
              left: activeIdx * slider.clientWidth,
              behavior: 'smooth'
            });
          }
        });

        slider.addEventListener('mousemove', function(e) {
          if (!isMouseDown) return;
          var diffX = Math.abs(e.pageX - mouseStartX);
          if (diffX > 6) {
            mouseMoved = true;
            isSwiping = true;
            e.preventDefault();
            slider.scrollLeft = scrollStartX - (e.pageX - mouseStartX);
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMobileCardSliders);
    } else {
      initMobileCardSliders();
    }

    // Auto-init on dynamic DOM changes (collection filter, infinite scroll, ajax)
    if (window.MutationObserver) {
      var debounceTimer;
      var observer = new MutationObserver(function() {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(initMobileCardSliders, 120);
      });
      observer.observe(document.body, { childList: true, subtree: true });
    }
  })();
</script>
