{%- if settings.cart_type == 'drawer' -%}
  <div id="CartDrawer" class="drawer drawer--right{% if cart.item_count == 0 %} is-empty{% endif %}">
    <form id="CartDrawerForm" action="{{ routes.cart_url }}" method="post" novalidate class="drawer__contents">
      <!-- 统一通栏顶部 Header (参考 NuPhy 设计：左侧 My Cart · X items，右侧独立关闭按钮 [X]) -->
      <div class="drawer__fixed-header cart-drawer__unified-header">
        <div class="cart-drawer__header-left">
          <span class="cart-drawer__title">{{ 'cart.general.title' | t }}</span>
          <span class="cart-drawer__count-wrap" data-cart-count-wrap>
            <span class="cart-drawer__count-sep">·</span>
            <span class="cart-drawer__count" data-cart-count-display>
              {{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }}
            </span>
          </span>
        </div>
        <div class="cart-drawer__header-right">
          <button type="button" class="cart-drawer__close-btn js-drawer-close" aria-label="{{ 'cart.general.close_cart' | t }}">
            <svg class="cart-drawer__close-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
            <span class="icon__fallback-text visually-hidden">{{ 'cart.general.close_cart' | t }}</span>
          </button>
        </div>
      </div>

      <div class="cart-drawer__layout">
        <!-- 主购物车列 (PC端左侧约 480px，移动端占 100%) -->
        <div class="cart-drawer__main-col">
          <div class="drawer__inner">
            <div class="drawer__scrollable">
              <div data-products class="appear-animation appear-delay-2"></div>

              {% if settings.cart_notes_enable %}
                <div class="appear-animation appear-delay-3">
                  <label for="CartNoteDrawer">{{ 'cart.general.note' | t }}</label>
                  <textarea name="note" class="input-full cart-notes" id="CartNoteDrawer">{{ cart.note }}</textarea>
                </div>
              {% endif %}

              <!-- 移动端插槽：放置在 Why buy from us 前面 -->
              <div class="cart-drawer__recommendations-mobile-slot"></div>

              {% render 'cart-policy-list' %}
            </div>

            <div class="drawer__footer appear-animation appear-delay-4">
              {% style %}
                #CartDrawerForm .drawer__footer {
                  color: #777;
                }
                #CartDrawerForm .drawer__footer .ajaxcart__subtotal + div {
                  color: #000;
                }
              {% endstyle %}
              <div data-discounts>
                {% if cart.cart_level_discount_applications != blank %}
                  <div class="cart__discounts cart__item-sub cart__item-row">
                    <div>{{ 'cart.general.discounts' | t }}</div>
                    <div class="text-right">
                      {% for cart_discount in cart.cart_level_discount_applications %}
                        <div class="cart__discount">
                          {{ cart_discount.title }} (-{{ cart_discount.total_allocated_amount | money }})
                        </div>
                      {% endfor %}
                    </div>
                  </div>
                {% endif %}
              </div>

              {%- assign cart_has_keyboard = false -%}
              {%- assign keycaps_count = 0 -%}
              {%- assign keycaps_total_price = 0 -%}
              {%- assign keycaps_discount_total = 0 -%}
              {%- for ci in cart.items -%}
                {%- assign ci_t = ci.product.type | downcase -%}
                {%- assign ci_title = ci.product.title | downcase -%}
                {%- assign ci_h = ci.product.handle | downcase -%}
                {%- if ci_t contains 'keyboard' or ci_title contains 'keyboard' or ci.product.tags contains 'keyboards' or ci.product.tags contains 'Keyboards' or ci.product.tags contains 'keyboard' or ci.product.tags contains 'Keyboard' -%}
                  {%- unless ci_title contains 'keycap' or ci_title contains 'switch' or ci_t contains 'keycap' or ci_t contains 'switch' or ci_title contains 'desk mat' or ci_title contains 'holder' -%}
                    {%- assign cart_has_keyboard = true -%}
                  {%- endunless -%}
                {%- endif -%}
                {%- if ci_t == 'keycaps' or ci_t == 'keycap' or ci_title contains 'keycap' or ci.product.tags contains 'keycaps' or ci.product.tags contains 'Keycaps' -%}
                  {%- unless ci_title contains 'puller' or ci_title contains 'installation' or ci_title contains 'service' or ci_h contains 'puller' or ci_h contains 'installation' -%}
                    {%- assign keycaps_count = keycaps_count | plus: ci.quantity -%}
                    {%- assign item_lp = ci.original_line_price | default: ci.final_line_price -%}
                    {%- assign keycaps_total_price = keycaps_total_price | plus: item_lp -%}
                  {%- endunless -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if cart_has_keyboard and keycaps_count > 0 -%}
                {%- assign keycaps_discount_total = keycaps_total_price | times: 0.2 | round -%}
              {%- elsif cart_has_keyboard == false and keycaps_count >= 2 -%}
                {%- assign keycaps_discount_total = keycaps_total_price | times: 0.1 | round -%}
              {%- endif -%}

              <div class="cart__item-sub cart__item-row">
                <div class="ajaxcart__subtotal">{{ 'cart.general.total' | t }}</div>
                <div data-subtotal>
                  {%- if keycaps_discount_total > 0 -%}
                    <small style="text-decoration: line-through; color: #888; font-size: 13px; font-weight: 400; margin-right: 6px;">
                      {{ cart.total_price | money }}
                    </small>
                    <span style="color: #0A6830; font-weight: 700; font-size: 16px;">
                      {{ cart.total_price | minus: keycaps_discount_total | money }}
                    </span>
                  {%- else -%}
                    {{ cart.total_price | money }}
                  {%- endif -%}
                </div>
              </div>

              {% if settings.cart_terms_conditions_enable %}
                <div class="cart__item-row cart__terms">
                  <input type="checkbox" id="CartTermsDrawer" class="cart__terms-checkbox">
                  <label for="CartTermsDrawer">
                    {% if settings.cart_terms_conditions_page != blank %}
                      {{ 'cart.general.terms_html' | t: url: settings.cart_terms_conditions_page.url }}
                    {% else %}
                      {{ 'cart.general.terms' | t }}
                    {% endif %}
                  </label>
                </div>
              {% endif %}

              <div class="cart__checkout-wrapper">
                {% style %}
                  .btn.cart__checkout {
                    border-radius: 20em;
                  }
                {% endstyle %}
                <button
                  type="submit"
                  name="checkout"
                  data-terms-required="{{ settings.cart_terms_conditions_enable }}"
                  class="btn cart__checkout"
                >
                  {{ 'cart.general.checkout' | t }}
                </button>

                {% if additional_checkout_buttons and settings.cart_additional_buttons %}
                  <div class="additional-checkout-buttons additional-checkout-buttons--vertical">
                    {{ content_for_additional_checkout_buttons }}
                  </div>
                {% endif %}

                <div class="cart__shipping-note">
                  {{ 'cart.general.shipping_at_checkout' | t }}
                </div>
              </div>
            </div>
          </div>

          <!-- 空购物车提示：放置在主列内 -->
          <div class="drawer__cart-empty appear-animation appear-delay-2 empty_info">
            <div class="drawer__scrollable">
              <img
                class="cart-empty-image"
                src="{{ 'empty_cart_icon.png' | asset_url }}"
                alt="{{ 'cart.general.empty' | t }}"
                width="120"
                height="120"
                loading="lazy"
              >
              <p class="cart-empty-text">{{ 'cart.general.empty' | t }}</p>
              <p class="cart-empty-btn-wrap">{{ 'cart.general.continue_browsing_html' | t: url: routes.root_url }}</p>

              <!-- 移动端空购物车推荐插槽：在移动端购物车为空时展示在空标识下方 -->
              <div class="cart-drawer__recommendations-empty-slot"></div>
            </div>
          </div>
        </div>

        <!-- PC端专属插槽：放置在右侧专属栏 -->
        <div class="cart-drawer__recommendations-desktop-slot"></div>
      </div>
    </form>

    {% render 'cart-recommendations' %}

    <script>
      (function() {
        let isRedirecting = false;

        function formatMoney(cents) {
          if (window.theme && window.theme.Currency && typeof window.theme.Currency.formatMoney === 'function') {
            const format = window.theme.settings?.moneyFormat || '${{amount}}';
            return window.theme.Currency.formatMoney(cents, format);
          }
          return '$' + (cents / 100).toFixed(2);
        }

        function classifyCartItem(el) {
          const isKb = el.getAttribute('data-is-keyboard') === 'true';
          const isKc = el.getAttribute('data-is-keycap') === 'true';
          const isServiceAttr = el.getAttribute('data-is-service') === 'true';
          const pType = (el.getAttribute('data-product-type') || '').toLowerCase();
          const pTitle = (el.getAttribute('data-product-title') || el.querySelector('.cart__item-name')?.textContent || '').toLowerCase();
          const pHandle = (el.getAttribute('data-product-handle') || '').toLowerCase();
          const isService = isServiceAttr || pTitle.includes('installation') || pTitle.includes('service') || pHandle.includes('installation') || pHandle.includes('service');

          const matchesKb = !isService && (
            isKb ||
            pType.includes('keyboard') ||
            pTitle.includes('keyboard') ||
            pTitle.includes('defender68') ||
            pTitle.includes('swift60') ||
            pTitle.includes('swift68') ||
            pTitle.includes('haze68') ||
            pTitle.includes('grid98') ||
            pTitle.includes('final75') ||
            pTitle.includes('muse65') ||
            pTitle.includes('muse75')
          );

          const matchesKc = !isService && (
            isKc ||
            pType === 'keycaps' ||
            pType === 'keycap' ||
            (pTitle.includes('keycap') && !matchesKb && !pTitle.includes('puller') && !pHandle.includes('puller'))
          );

          return { matchesKb, matchesKc, isService };
        }

        function scanCartBundle() {
          const itemEls = document.querySelectorAll('.cart__item');
          let hasKeyboard = false;
          let hasKeycap = false;
          let keycapsTotalPriceCents = 0;
          let keycapsCount = 0;
          let totalItems = 0;

          itemEls.forEach(el => {
            totalItems++;
            const { matchesKb, matchesKc } = classifyCartItem(el);

            // 获取商品行价格 (cents)
            let linePrice = parseFloat(el.getAttribute('data-line-price'));
            if (isNaN(linePrice) || linePrice <= 0) {
              const priceText = el.querySelector('.cart__price, .cart__item-price')?.textContent || '';
              const match = priceText.match(/[\d,.]+/);
              if (match) {
                linePrice = parseFloat(match[0].replace(/,/g, '')) * 100;
              }
            }
            if (isNaN(linePrice)) linePrice = 0;

            // 获取商品数量
            let itemQty = parseInt(el.getAttribute('data-item-quantity'), 10);
            if (isNaN(itemQty) || itemQty <= 0) {
              const qtyInput = el.querySelector('.js-qty__num, input[name="updates[]"]');
              if (qtyInput) {
                itemQty = parseInt(qtyInput.value, 10);
              }
            }
            if (isNaN(itemQty) || itemQty <= 0) itemQty = 1;

            if (matchesKb) hasKeyboard = true;
            if (matchesKc) {
              hasKeycap = true;
              keycapsCount += itemQty;
              keycapsTotalPriceCents += linePrice;
            }
          });

          // 规则 1 & 4: 有键盘（无论有无键帽），搭配键帽最高力度 8 折优先 (KEYCAP20)
          // 规则 2: 无键盘，满 2 把及以上键帽 9 折 (KEYCAP10)；单单只有 1 把键帽不打折
          // 规则 3: 无键盘无键帽，不打折
          let discountMode = 'none';
          let discountRatio = 1.0;
          let discountCode = '';
          let discountAmountCents = 0;

          if (hasKeyboard) {
            discountMode = 'keyboard';
            discountRatio = 0.8;
            discountCode = 'KEYCAP20';
            if (hasKeycap) {
              discountAmountCents = Math.round(keycapsTotalPriceCents * 0.2);
            }
          } else if (hasKeycap && keycapsCount >= 2) {
            discountMode = 'keycap';
            discountRatio = 0.9;
            discountCode = 'KEYCAP10';
            discountAmountCents = Math.round(keycapsTotalPriceCents * 0.1);
          }

          return {
            hasKeyboard,
            hasKeycap,
            keycapsCount,
            keycapsTotalPriceCents,
            discountMode,
            discountRatio,
            discountCode,
            discountAmountCents,
            totalItems
          };
        }

        function updateBundleUI() {
          const bundleState = scanCartBundle();
          const { hasKeyboard, hasKeycap, discountMode, discountRatio, discountCode, discountAmountCents } = bundleState;
          const itemEls = document.querySelectorAll('.cart__item');
          const subtotalEls = document.querySelectorAll('[data-subtotal]');

          // A. 推荐区折扣提示横幅切换 (Rule 1, 2, 3)
          if (typeof window.updateRecBanners === 'function') {
            window.updateRecBanners();
          } else {
            const wrapper = document.getElementById('CartRecBannerWrapper');
            const kbBanner = document.getElementById('CartRecBannerKeyboard');
            const kcBanner = document.getElementById('CartRecBannerKeycap');
            if (wrapper && kbBanner && kcBanner) {
              if (discountMode === 'keyboard') {
                wrapper.style.display = '';
                kbBanner.style.display = '';
                kcBanner.style.display = 'none';
              } else if (discountMode === 'keycap' || hasKeycap) {
                wrapper.style.display = '';
                kbBanner.style.display = 'none';
                kcBanner.style.display = '';
              } else {
                wrapper.style.display = 'none';
                kbBanner.style.display = 'none';
                kcBanner.style.display = 'none';
              }
            }
          }

          // B. 控制推荐区卡片价格：有键盘时 8 折，有键帽无键盘时 9 折，无键盘无键帽原价
          const recItems = document.querySelectorAll('#CartRecommendationsList .cart-rec-item');
          recItems.forEach(card => {
            const priceRow = card.querySelector('.cart-rec-item__price-row');
            if (!priceRow) return;

            let basePrice = parseFloat(priceRow.getAttribute('data-price'));
            if (isNaN(basePrice) || basePrice <= 0) {
              const compEl = priceRow.querySelector('.cart-rec-item__compare-price');
              const priceEl = priceRow.querySelector('.cart-rec-item__price');
              const text = (compEl ? compEl.textContent : (priceEl ? priceEl.textContent : '')).trim();
              const match = text.match(/[\d,.]+/);
              if (match) basePrice = parseFloat(match[0].replace(/,/g, '')) * 100;
              if (basePrice > 0) priceRow.setAttribute('data-price', basePrice);
            }

            if (basePrice > 0) {
              if (discountMode === 'keyboard') {
                const discPrice = Math.round(basePrice * 0.8);
                priceRow.innerHTML = `
                  <span class="cart-rec-item__compare-price">${formatMoney(basePrice)}</span>
                  <span class="cart-rec-item__price">${formatMoney(discPrice)}</span>
                `;
              } else if (discountMode === 'keycap' || hasKeycap) {
                const discPrice = Math.round(basePrice * 0.9);
                priceRow.innerHTML = `
                  <span class="cart-rec-item__compare-price">${formatMoney(basePrice)}</span>
                  <span class="cart-rec-item__price">${formatMoney(discPrice)}</span>
                `;
              } else {
                priceRow.innerHTML = `
                  <span class="cart-rec-item__price">${formatMoney(basePrice)}</span>
                `;
              }
            }
          });

          // C. 购物车内部商品与总额折后计算
          if (discountAmountCents > 0) {
            // 键帽单品价格划线并展示折后价格
            itemEls.forEach(el => {
              const { matchesKc } = classifyCartItem(el);

              const priceCol = el.querySelector('.cart__item-price-col');
              if (priceCol && matchesKc) {
                let linePrice = parseFloat(el.getAttribute('data-line-price'));
                if (isNaN(linePrice) || linePrice <= 0) {
                  const priceText = priceCol.querySelector('.cart__price--strikethrough')?.textContent || priceCol.querySelector('.cart__price')?.textContent || '';
                  const match = priceText.match(/[\d,.]+/);
                  if (match) linePrice = parseFloat(match[0].replace(/,/g, '')) * 100;
                }
                if (linePrice > 0) {
                  const discPrice = Math.round(linePrice * discountRatio);
                  const discountColor = '#107a44';
                  priceCol.innerHTML = `
                    <small class="cart__price cart__price--strikethrough" style="text-decoration: line-through; color: #999; margin-right: 6px;">
                      ${formatMoney(linePrice)}
                    </small>
                    <span class="cart__price cart__discount" style="color: ${discountColor}; font-weight: 600;">
                      ${formatMoney(discPrice)}
                    </span>
                  `;
                }
                // 清理所有残留的 KEYCAP 折扣小标签
                el.querySelectorAll('.cart__discount').forEach(d => {
                  if (d.textContent.includes('KEYCAP') || d.textContent.includes('-$')) {
                    d.remove();
                  }
                });
              }
            });

            // 底部 Subtotal / Total 划线并展示折后总价
            let origTotalCents = 0;
            const cartItemsEl = document.querySelector('.cart__items');
            if (cartItemsEl && cartItemsEl.getAttribute('data-cart-subtotal')) {
              origTotalCents = parseFloat(cartItemsEl.getAttribute('data-cart-subtotal'));
            }

            subtotalEls.forEach(subtotalEl => {
              let currentOrig = origTotalCents;
              if (!currentOrig || isNaN(currentOrig)) {
                const match = subtotalEl.textContent.match(/[\d,.]+/);
                if (match) currentOrig = parseFloat(match[0].replace(/,/g, '')) * 100;
              }

              if (currentOrig && !isNaN(currentOrig)) {
                const finalTotalCents = Math.max(0, currentOrig - discountAmountCents);
                const discountColor = '#107a44';
                subtotalEl.innerHTML = `
                  <small style="text-decoration: line-through; color: #888; font-size: 13px; font-weight: 400; margin-right: 6px;">
                    ${formatMoney(currentOrig)}
                  </small>
                  <span style="color: ${discountColor}; font-weight: 700; font-size: 16px;">
                    ${formatMoney(finalTotalCents)}
                  </span>
                `;
              }
            });

          } else {
            // 无键盘或无键帽：严格恢复单品原价和 Subtotal
            itemEls.forEach(el => {
              const { matchesKc } = classifyCartItem(el);

              const priceCol = el.querySelector('.cart__item-price-col');
              if (priceCol) {
                priceCol.removeAttribute('data-original-html');
                if (matchesKc) {
                  let linePrice = parseFloat(el.getAttribute('data-line-price'));
                  if (isNaN(linePrice) || linePrice <= 0) {
                    const priceText = priceCol.querySelector('.cart__price--strikethrough')?.textContent || priceCol.querySelector('.cart__price')?.textContent || '';
                    const match = priceText.match(/[\d,.]+/);
                    if (match) linePrice = parseFloat(match[0].replace(/,/g, '')) * 100;
                  }
                  if (linePrice > 0) {
                    priceCol.innerHTML = `<span class="cart__price">${formatMoney(linePrice)}</span>`;
                  }
                }
              }
              // 清理任何残留的 KEYCAP 折扣标签
              el.querySelectorAll('.cart__discount').forEach(d => {
                if (d.textContent.includes('KEYCAP') || d.textContent.includes('-$')) {
                  d.remove();
                }
              });
            });

            // 隐藏全局 discounts 中的 KEYCAP 折扣
            document.querySelectorAll('.cart__discounts').forEach(d => {
              if (d.textContent.includes('KEYCAP')) {
                d.classList.add('hide');
              }
            });

            let origTotalCents = 0;
            const cartItemsEl = document.querySelector('.cart__items');
            if (cartItemsEl && cartItemsEl.getAttribute('data-cart-subtotal')) {
              origTotalCents = parseFloat(cartItemsEl.getAttribute('data-cart-subtotal'));
            }
            subtotalEls.forEach(subtotalEl => {
              subtotalEl.removeAttribute('data-original-html');
              if (origTotalCents > 0) {
                subtotalEl.innerHTML = formatMoney(origTotalCents);
              } else {
                const compEl = subtotalEl.querySelector('small');
                if (compEl) {
                  subtotalEl.innerHTML = compEl.textContent.trim();
                }
              }
            });
          }
        }

        function handleCheckoutClick(e) {
          const checkoutBtn = e.target.closest('button[name="checkout"], .cart__checkout');
          if (!checkoutBtn) return;

          const bundleState = scanCartBundle();
          const discountCodeToApply = bundleState.discountCode;

          if (discountCodeToApply && bundleState.discountAmountCents > 0) {
            e.preventDefault();
            e.stopPropagation();

            if (isRedirecting) return;
            isRedirecting = true;

            const termsCheckbox = document.querySelector('#CartTermsDrawer, #CartTerms');
            if (termsCheckbox && !termsCheckbox.checked && termsCheckbox.offsetParent !== null) {
              alert((window.theme && window.theme.strings && window.theme.strings.cartTermsConfirmation) || 'Please accept the terms and conditions');
              isRedirecting = false;
              return;
            }

            checkoutBtn.classList.add('btn--loading');
            checkoutBtn.disabled = true;

            const noteInput = document.querySelector('#CartNoteDrawer, #CartNote');
            const saveNotePromise = (noteInput && noteInput.value && window.theme && window.theme.cart && window.theme.cart.updateNote)
              ? window.theme.cart.updateNote(noteInput.value)
              : Promise.resolve();

            saveNotePromise.finally(() => {
              window.location.href = '/checkout?discount=' + encodeURIComponent(discountCodeToApply);
            });
          }
        }

        function debouncedUpdateUI() {
          updateBundleUI();
        }

        ['cart:build', 'cart:updated', 'cart:rendered', 'ajaxProduct:added', 'drawerOpen', 'cart:open'].forEach(evtName => {
          document.addEventListener(evtName, debouncedUpdateUI);
        });

        // 绑定结账拦截事件（仅监听 checkout 按钮，不影响删除等其他按钮）
        document.addEventListener('click', handleCheckoutClick);

        document.addEventListener('submit', function(e) {
          const form = e.target;
          if (form && (form.id === 'CartDrawerForm' || form.id === 'CartPageForm')) {
            const bundleState = scanCartBundle();
            if (bundleState.discountCode && bundleState.discountAmountCents > 0) {
              e.preventDefault();
              e.stopPropagation();
              window.location.href = '/checkout?discount=' + encodeURIComponent(bundleState.discountCode);
            }
          }
        });

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', debouncedUpdateUI);
        } else {
          debouncedUpdateUI();
        }
      })();
    </script>
  </div>
{%- endif -%}
