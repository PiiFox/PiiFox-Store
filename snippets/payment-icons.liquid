{%- assign payment_types = 'paypal,visa,master,maestro,american_express,jcb,discover,diners_club,unionpay,apple_pay,google_pay,klarna' | split: ',' -%}

<ul class="inline-list payment-icons footer__section">
  {%- for type in payment_types -%}
    <li class="icon--payment">
      {{ type | payment_type_svg_tag }}
    </li>
  {%- endfor -%}
</ul>
