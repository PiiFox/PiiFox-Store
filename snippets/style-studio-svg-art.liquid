{% comment %}
  Inline SVG artwork library for the Style Studio page.
  These are generated, product-related illustrations so the modules work
  without relying on external image assets.

  Usage:
  {% render 'style-studio-svg-art', name: 'step-keycap', color: '#286633' %}

  name options:
    - step-product    (keyboard product page with a keycap)
    - step-keycap     (select a keycap set)
    - step-assembly   (choose assembly service)
    - step-cart       (add to cart)
    - theme-nature
    - theme-retro
    - theme-mono
    - theme-cute
    - board-base      (empty keyboard base)
  color: accent color used by the artwork
{% endcomment %}

{%- assign accent = color | default: '#286633' -%}

{%- case name -%}
  {%- when 'step-product' -%}
    <svg viewBox="0 0 320 220" role="img" aria-label="Open a keyboard product page" xmlns="http://www.w3.org/2000/svg">
      <rect x="8" y="8" width="304" height="204" rx="14" fill="#f4efe6"/>
      <rect x="8" y="8" width="304" height="30" rx="14" fill="#e7dfd2"/>
      <circle cx="26" cy="23" r="5" fill="{{ accent }}"/>
      <circle cx="44" cy="23" r="5" fill="#cfc6b6"/>
      <circle cx="62" cy="23" r="5" fill="#cfc6b6"/>
      <rect x="26" y="54" width="150" height="96" rx="10" fill="#ffffff"/>
      <g fill="{{ accent }}" opacity="0.9">
        <rect x="40" y="72" width="18" height="18" rx="3"/>
        <rect x="64" y="72" width="18" height="18" rx="3"/>
        <rect x="88" y="72" width="18" height="18" rx="3"/>
        <rect x="112" y="72" width="18" height="18" rx="3"/>
        <rect x="136" y="72" width="18" height="18" rx="3"/>
        <rect x="40" y="96" width="18" height="18" rx="3"/>
        <rect x="64" y="96" width="18" height="18" rx="3"/>
        <rect x="88" y="96" width="18" height="18" rx="3"/>
        <rect x="112" y="96" width="18" height="18" rx="3"/>
        <rect x="136" y="96" width="18" height="18" rx="3"/>
        <rect x="52" y="120" width="90" height="14" rx="4"/>
      </g>
      <rect x="192" y="54" width="96" height="12" rx="6" fill="#cfc6b6"/>
      <rect x="192" y="74" width="72" height="12" rx="6" fill="#cfc6b6"/>
      <rect x="192" y="98" width="96" height="30" rx="8" fill="{{ accent }}"/>
      <text x="240" y="118" font-family="Arial, Helvetica, sans-serif" font-size="12" font-weight="700" fill="#ffffff" text-anchor="middle">PRODUCT</text>
      <rect x="26" y="164" width="262" height="34" rx="8" fill="#ffffff"/>
      <rect x="38" y="176" width="120" height="10" rx="5" fill="#e0d8ca"/>
      <rect x="212" y="170" width="66" height="22" rx="11" fill="{{ accent }}"/>
    </svg>

  {%- when 'step-keycap' -%}
    <svg viewBox="0 0 320 220" role="img" aria-label="Choose a keycap set" xmlns="http://www.w3.org/2000/svg">
      <rect x="8" y="8" width="304" height="204" rx="14" fill="#f4efe6"/>
      <g>
        <g transform="translate(34 40)">
          <rect x="0" y="10" width="52" height="46" rx="10" fill="{{ accent }}"/>
          <rect x="4" y="4" width="44" height="40" rx="9" fill="#ffffff" stroke="{{ accent }}" stroke-width="3"/>
          <text x="26" y="31" font-family="Arial, Helvetica, sans-serif" font-size="15" font-weight="700" fill="{{ accent }}" text-anchor="middle">A</text>
        </g>
        <g transform="translate(100 40)" opacity="0.55">
          <rect x="0" y="10" width="52" height="46" rx="10" fill="#b98b4a"/>
          <rect x="4" y="4" width="44" height="40" rx="9" fill="#ffffff" stroke="#b98b4a" stroke-width="3"/>
          <text x="26" y="31" font-family="Arial, Helvetica, sans-serif" font-size="15" font-weight="700" fill="#b98b4a" text-anchor="middle">B</text>
        </g>
        <g transform="translate(166 40)" opacity="0.55">
          <rect x="0" y="10" width="52" height="46" rx="10" fill="#d76f9c"/>
          <rect x="4" y="4" width="44" height="40" rx="9" fill="#ffffff" stroke="#d76f9c" stroke-width="3"/>
          <text x="26" y="31" font-family="Arial, Helvetica, sans-serif" font-size="15" font-weight="700" fill="#d76f9c" text-anchor="middle">C</text>
        </g>
        <g transform="translate(232 40)" opacity="0.55">
          <rect x="0" y="10" width="52" height="46" rx="10" fill="#4a7bd7"/>
          <rect x="4" y="4" width="44" height="40" rx="9" fill="#ffffff" stroke="#4a7bd7" stroke-width="3"/>
          <text x="26" y="31" font-family="Arial, Helvetica, sans-serif" font-size="15" font-weight="700" fill="#4a7bd7" text-anchor="middle">D</text>
        </g>
      </g>
      <rect x="34" y="112" width="52" height="8" rx="4" fill="{{ accent }}"/>
      <rect x="100" y="112" width="52" height="8" rx="4" fill="#e0d8ca"/>
      <rect x="166" y="112" width="52" height="8" rx="4" fill="#e0d8ca"/>
      <rect x="232" y="112" width="52" height="8" rx="4" fill="#e0d8ca"/>
      <rect x="34" y="136" width="250" height="16" rx="8" fill="#ffffff"/>
      <rect x="34" y="162" width="180" height="16" rx="8" fill="#ffffff"/>
      <circle cx="292" cy="144" r="10" fill="{{ accent }}"/>
      <path d="M287 144l4 4 7-8" stroke="#fff" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {%- when 'step-assembly' -%}
    <svg viewBox="0 0 320 220" role="img" aria-label="Select the assembly service" xmlns="http://www.w3.org/2000/svg">
      <rect x="8" y="8" width="304" height="204" rx="14" fill="#f4efe6"/>
      <rect x="26" y="28" width="268" height="58" rx="10" fill="#ffffff" stroke="#e0d8ca" stroke-width="2"/>
      <rect x="40" y="42" width="30" height="30" rx="8" fill="#eef3ea"/>
      <path d="M47 57l6 6 10-12" stroke="#9aa894" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
      <rect x="84" y="45" width="120" height="10" rx="5" fill="#dcd4c6"/>
      <rect x="84" y="62" width="80" height="8" rx="4" fill="#e8e2d6"/>
      <rect x="26" y="96" width="268" height="58" rx="10" fill="#ffffff" stroke="{{ accent }}" stroke-width="3"/>
      <rect x="40" y="110" width="30" height="30" rx="8" fill="{{ accent }}"/>
      <path d="M47 125l6 6 10-12" stroke="#ffffff" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
      <rect x="84" y="113" width="140" height="10" rx="5" fill="{{ accent }}"/>
      <rect x="84" y="130" width="96" height="8" rx="4" fill="#cddcc7"/>
      <rect x="26" y="164" width="268" height="34" rx="10" fill="{{ accent }}"/>
      <text x="160" y="186" font-family="Arial, Helvetica, sans-serif" font-size="13" font-weight="700" fill="#ffffff" text-anchor="middle">ASSEMBLY SERVICE</text>
    </svg>

  {%- when 'step-cart' -%}
    <svg viewBox="0 0 320 220" role="img" aria-label="Add to cart" xmlns="http://www.w3.org/2000/svg">
      <rect x="8" y="8" width="304" height="204" rx="14" fill="#f4efe6"/>
      <g transform="translate(58 34)">
        <rect x="0" y="0" width="204" height="86" rx="12" fill="#ffffff"/>
        <rect x="14" y="16" width="58" height="54" rx="8" fill="#eef3ea"/>
        <g fill="{{ accent }}">
          <rect x="60" y="40" width="10" height="10" rx="2"/>
          <rect x="72" y="40" width="10" height="10" rx="2"/>
          <rect x="84" y="40" width="10" height="10" rx="2"/>
          <rect x="96" y="40" width="10" height="10" rx="2"/>
          <rect x="108" y="40" width="10" height="10" rx="2"/>
        </g>
        <rect x="86" y="22" width="100" height="10" rx="5" fill="#3a3a3a"/>
        <rect x="86" y="58" width="52" height="12" rx="6" fill="{{ accent }}"/>
        <rect x="146" y="58" width="40" height="12" rx="6" fill="#e0d8ca"/>
      </g>
      <g transform="translate(200 126)">
        <circle cx="0" cy="0" r="30" fill="{{ accent }}"/>
        <path d="M-12 -6h4l4 14h16l4 -10h-20" stroke="#ffffff" stroke-width="2.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="-4" cy="12" r="2.6" fill="#ffffff"/>
        <circle cx="10" cy="12" r="2.6" fill="#ffffff"/>
      </g>
      <rect x="34" y="150" width="150" height="14" rx="7" fill="#e0d8ca"/>
      <rect x="34" y="176" width="110" height="14" rx="7" fill="#e0d8ca"/>
    </svg>

  {%- when 'theme-nature' -%}
    <svg viewBox="0 0 400 300" role="img" aria-label="Nature and soft keycap theme" xmlns="http://www.w3.org/2000/svg">
      <rect width="400" height="300" rx="16" fill="#eaf3e4"/>
      <circle cx="330" cy="60" r="70" fill="#d6e8c8" opacity="0.7"/>
      <g transform="translate(40 90)">
        <rect x="0" y="0" width="320" height="120" rx="14" fill="#cfdcc7"/>
        <!-- keyboard body -->
        <g fill="#a8c194">
          <rect x="18" y="20" width="34" height="34" rx="7"/>
          <rect x="58" y="20" width="34" height="34" rx="7"/>
          <rect x="98" y="20" width="34" height="34" rx="7"/>
          <rect x="138" y="20" width="34" height="34" rx="7"/>
          <rect x="178" y="20" width="34" height="34" rx="7"/>
          <rect x="218" y="20" width="34" height="34" rx="7"/>
          <rect x="258" y="20" width="44" height="34" rx="7"/>
          <rect x="18" y="62" width="44" height="34" rx="7"/>
          <rect x="68" y="62" width="196" height="34" rx="7"/>
          <rect x="270" y="62" width="32" height="34" rx="7"/>
        </g>
        <g fill="#ffffff" opacity="0.85">
          <rect x="26" y="28" width="18" height="18" rx="4"/>
          <rect x="66" y="28" width="18" height="18" rx="4"/>
          <rect x="106" y="28" width="18" height="18" rx="4"/>
          <rect x="146" y="28" width="18" height="18" rx="4"/>
          <rect x="186" y="28" width="18" height="18" rx="4"/>
        </g>
      </g>
      <circle cx="64" cy="250" r="22" fill="#b7d3a0"/>
    </svg>

  {%- when 'theme-retro' -%}
    <svg viewBox="0 0 400 300" role="img" aria-label="Retro and daily keycap theme" xmlns="http://www.w3.org/2000/svg">
      <rect width="400" height="300" rx="16" fill="#efe7d8"/>
      <rect x="0" y="0" width="400" height="300" rx="16" fill="none" stroke="#d9cbb2" stroke-width="10"/>
      <g transform="translate(40 90)">
        <rect x="0" y="0" width="320" height="120" rx="14" fill="#d8c6a6"/>
        <g fill="#b99a6b">
          <rect x="18" y="20" width="34" height="34" rx="7"/>
          <rect x="58" y="20" width="34" height="34" rx="7"/>
          <rect x="98" y="20" width="34" height="34" rx="7"/>
          <rect x="138" y="20" width="34" height="34" rx="7"/>
          <rect x="178" y="20" width="34" height="34" rx="7"/>
          <rect x="218" y="20" width="34" height="34" rx="7"/>
          <rect x="258" y="20" width="44" height="34" rx="7"/>
          <rect x="18" y="62" width="44" height="34" rx="7"/>
          <rect x="68" y="62" width="196" height="34" rx="7"/>
          <rect x="270" y="62" width="32" height="34" rx="7"/>
        </g>
        <g fill="#f3e9d6">
          <rect x="26" y="28" width="18" height="18" rx="4"/>
          <rect x="66" y="28" width="18" height="18" rx="4"/>
          <rect x="106" y="28" width="18" height="18" rx="4"/>
          <rect x="146" y="28" width="18" height="18" rx="4"/>
        </g>
      </g>
      <circle cx="340" cy="56" r="30" fill="#c9a97a" opacity="0.5"/>
    </svg>

  {%- when 'theme-mono' -%}
    <svg viewBox="0 0 400 300" role="img" aria-label="Clean and minimal keycap theme" xmlns="http://www.w3.org/2000/svg">
      <rect width="400" height="300" rx="16" fill="#f3f4f6"/>
      <g transform="translate(40 90)">
        <rect x="0" y="0" width="320" height="120" rx="14" fill="#e2e5ea"/>
        <g fill="#c8ccd4">
          <rect x="18" y="20" width="34" height="34" rx="7"/>
          <rect x="58" y="20" width="34" height="34" rx="7"/>
          <rect x="98" y="20" width="34" height="34" rx="7"/>
          <rect x="138" y="20" width="34" height="34" rx="7"/>
          <rect x="178" y="20" width="34" height="34" rx="7"/>
          <rect x="218" y="20" width="34" height="34" rx="7"/>
          <rect x="258" y="20" width="44" height="34" rx="7"/>
          <rect x="18" y="62" width="44" height="34" rx="7"/>
          <rect x="68" y="62" width="196" height="34" rx="7"/>
          <rect x="270" y="62" width="32" height="34" rx="7"/>
        </g>
        <g fill="#ffffff">
          <rect x="26" y="28" width="18" height="18" rx="4"/>
          <rect x="66" y="28" width="18" height="18" rx="4"/>
        </g>
      </g>
      <rect x="60" y="40" width="120" height="12" rx="6" fill="#d7dae0"/>
    </svg>

  {%- when 'theme-cute' -%}
    <svg viewBox="0 0 400 300" role="img" aria-label="Cute and colorful keycap theme" xmlns="http://www.w3.org/2000/svg">
      <rect width="400" height="300" rx="16" fill="#fdeaf2"/>
      <circle cx="70" cy="62" r="40" fill="#fbd0e0"/>
      <circle cx="350" cy="240" r="52" fill="#fbd0e0"/>
      <g transform="translate(40 90)">
        <rect x="0" y="0" width="320" height="120" rx="14" fill="#f6d4e2"/>
        <g fill="#ef9fc3">
          <rect x="18" y="20" width="34" height="34" rx="7"/>
          <rect x="58" y="20" width="34" height="34" rx="7"/>
          <rect x="98" y="20" width="34" height="34" rx="7"/>
          <rect x="138" y="20" width="34" height="34" rx="7"/>
          <rect x="178" y="20" width="34" height="34" rx="7"/>
          <rect x="218" y="20" width="34" height="34" rx="7"/>
          <rect x="258" y="20" width="44" height="34" rx="7"/>
          <rect x="18" y="62" width="44" height="34" rx="7"/>
          <rect x="68" y="62" width="196" height="34" rx="7"/>
          <rect x="270" y="62" width="32" height="34" rx="7"/>
        </g>
        <g fill="#fff3f8">
          <rect x="26" y="28" width="18" height="18" rx="4"/>
          <rect x="66" y="28" width="18" height="18" rx="4"/>
          <rect x="106" y="28" width="18" height="18" rx="4"/>
        </g>
      </g>
    </svg>

  {%- when 'board-base' -%}
    <svg viewBox="0 0 520 220" role="img" aria-label="Keyboard base with keycaps" xmlns="http://www.w3.org/2000/svg">
      <rect x="6" y="6" width="508" height="208" rx="20" fill="none"/>
      <rect x="20" y="46" width="480" height="132" rx="18" fill="#3a3d42"/>
      <rect x="20" y="46" width="480" height="132" rx="18" fill="{{ accent }}" opacity="0.15"/>
      <g fill="{{ accent }}" opacity="0.95">
        <rect x="42" y="70" width="38" height="34" rx="7"/>
        <rect x="86" y="70" width="38" height="34" rx="7"/>
        <rect x="130" y="70" width="38" height="34" rx="7"/>
        <rect x="174" y="70" width="38" height="34" rx="7"/>
        <rect x="218" y="70" width="38" height="34" rx="7"/>
        <rect x="262" y="70" width="38" height="34" rx="7"/>
        <rect x="306" y="70" width="38" height="34" rx="7"/>
        <rect x="350" y="70" width="38" height="34" rx="7"/>
        <rect x="394" y="70" width="38" height="34" rx="7"/>
        <rect x="438" y="70" width="38" height="34" rx="7"/>
        <rect x="42" y="110" width="52" height="34" rx="7"/>
        <rect x="100" y="110" width="280" height="34" rx="7"/>
        <rect x="386" y="110" width="90" height="34" rx="7"/>
      </g>
      <g fill="#ffffff" opacity="0.55">
        <rect x="50" y="78" width="20" height="18" rx="4"/>
        <rect x="94" y="78" width="20" height="18" rx="4"/>
        <rect x="138" y="78" width="20" height="18" rx="4"/>
        <rect x="182" y="78" width="20" height="18" rx="4"/>
        <rect x="226" y="78" width="20" height="18" rx="4"/>
      </g>
    </svg>

  {%- else -%}
    <svg viewBox="0 0 320 220" xmlns="http://www.w3.org/2000/svg"><rect width="320" height="220" rx="14" fill="#f4efe6"/></svg>
{%- endcase -%}
