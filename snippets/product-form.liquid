<script>
$(function() {
  $('.custom-shopify-buy-btn').click(() => {
    console.log('click');
    $('.shopify-payment-button button.shopify-payment-button__more-options').click();
  })
})
</script>
{%- form 'product', product, id: form_id, class: 'product-single__form' -%}

  <div class="product-form__actions-group">
    <div class="product__stock-status-wrap">
      <span data-product-quantity-status class="product-quantity-status {% if current_variant.available %}product-quantity-status--in-stock{% else %}product-quantity-status--out-of-stock{% endif %}">
        {% if current_variant.available %}In Stock{% else %}Out of Stock{% endif %}
      </span>
    </div>

    <div class="payment-buttons product__actions-row">
      <div class="product__quantity">
        {% assign qty_id = section_id | default: section.id | default: product.id | append: product.id %}
        {%- assign current_variant_has_inventory_limit = false -%}
        {%- if current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny' -%}
          {%- assign current_variant_has_inventory_limit = true -%}
          {%- assign current_variant_max_qty = current_variant.inventory_quantity | at_least: 0 -%}
        {%- endif -%}
        {%- render 'quantity-input',
          form_id: form_id,
          id: qty_id,
          qty: 1,
          min: 1,
          max: current_variant_max_qty,
          has_limit: current_variant_has_inventory_limit
        -%}
      </div>

    {%- liquid
      assign default_text = 'products.product.add_to_cart' | t
      assign button_text = 'products.product.add_to_cart' | t
      if template == 'product.preorder'
        assign default_text = 'products.product.preorder' | t
        assign button_text = 'products.product.preorder' | t
      endif
      unless current_variant.available
        assign button_text = 'products.product.sold_out' | t
      endunless
    -%}

    <button
      {% if product.empty? %}type="button"{% else %}type="submit"{% endif %}
      name="add"
      data-add-to-cart
      onclick="
      {% assign shopify_store_country  = 'US' %}
      dataLayer.push({ 'ecommerce': null });dataLayer.push({
        'event': 'add_to_cart',
        'ecommerce': {
	        'currency': '{{ shop.currency }}',
    		  'value':{{ product.price  | times: 0.01}},                        
    		  'items': [{
          		'item_id':{{ product.id }},
          		'id': 'shopify_{{shopify_store_country}}_{{ product.id }}_{{ product.selected_or_first_available_variant.id }}',
          		'google_business_vertical': 'retail',
          		'item_name': '{{ product.title | remove: "'" | remove: '"' }}',
                  'item_brand': '{{ product.vendor }}',
                  'item_category': '{{ product.type }}',
                  'item_variant': '{{ current_variant.title }}',
    		  }]
    	  }
      });"
      class="btn btn--full add-to-cart"
      {% unless current_variant.available %} disabled="disabled"{% endunless %}>
      <span data-add-to-cart-text data-default-text="{{ default_text }}">
        {{ button_text }}
      </span>
    </button>

    {% style %}
        .payment-buttons {
          width: 100%;
        }
        .payment-buttons .add-to-cart,
        .payment-buttons .add-to-cart.btn--secondary {
          width: 100%;
          border-radius: 20em;
          font-weight: 700;
          font-size: 16px;
          font-family: 'PF_Semibold', 'Manrope', sans-serif;
          letter-spacing: 0.1em;
          height: 3.5em;
          background-color: var(--colorLightLink);
          border: 1.5px solid var(--colorLightLink);
          color: #fff;
          position: relative;
          cursor: pointer;
          overflow: hidden;
          display: flex;
          align-items: center;
          justify-content: center;
          text-transform: uppercase;
          transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, transform 0.15s ease !important;
        }
        .payment-buttons .add-to-cart span,
        .payment-buttons .add-to-cart.btn--secondary span {
          position: relative;
          z-index: 1;
          transition: color 0.25s ease;
        }
        .payment-buttons .add-to-cart::after,
        .payment-buttons .add-to-cart.btn--secondary::after,
        .payment-buttons .add-to-cart::before,
        .payment-buttons .add-to-cart.btn--secondary::before {
          display: none !important;
        }
        .payment-buttons .add-to-cart:hover,
        .payment-buttons .add-to-cart.btn--secondary:hover {
          color: var(--colorLightLink) !important;
          border-color: var(--colorLightLink) !important;
          background-color: #ffffff !important;
          box-shadow: 0 4px 16px rgba(10, 104, 48, 0.12);
        }
        .payment-buttons .add-to-cart:hover span,
        .payment-buttons .add-to-cart.btn--secondary:hover span {
          color: var(--colorLightLink) !important;
        }
        .payment-buttons .add-to-cart:active,
        .payment-buttons .add-to-cart.btn--secondary:active {
          transform: scale(0.985);
          background-color: #f2f8f4 !important;
          box-shadow: 0 2px 8px rgba(10, 104, 48, 0.15);
        }
        .payment-buttons .add-to-cart[disabled="disabled"],
        .payment-buttons .add-to-cart.btn--secondary[disabled="disabled"],
        .payment-buttons .add-to-cart:disabled {
          background-color: var(--colorBtnDisable) !important;
          border: 1px solid var(--colorBtnDisable) !important;
          color: var(--colorBtnPrimaryText) !important;
          cursor: not-allowed;
          box-shadow: none !important;
          transform: none !important;
        }
        .payment-buttons .add-to-cart[disabled="disabled"]:hover,
        .payment-buttons .add-to-cart.btn--secondary[disabled="disabled"]:hover,
        .payment-buttons .add-to-cart:disabled:hover {
          color: var(--colorBtnPrimaryText) !important;
          border-color: var(--colorBtnDisable) !important;
          background-color: var(--colorBtnDisable) !important;
          box-shadow: none !important;
          transform: none !important;
        }
        .custom-shopify-buy-btn,
        .shopify-payment-button,
        [data-shopify="payment-button"] {
          display: none !important;
        }
    {% endstyle %}
  </div>
  </div>

  <div class="shopify-payment-terms product__policies">{{ form | payment_terms }}</div>

  <select name="id" data-product-select class="product-single__variants no-js">
    {%- for variant in product.variants -%}
      {%- if variant.available -%}
        <option {% if variant == product.selected_or_first_available_variant %}
          selected="selected"{% endif %}
          value="{{ variant.id }}">
          {{ variant.title }} - {{ variant.price | money_with_currency }}
        </option>
      {%- else -%}
        <option disabled="disabled">
          {{ variant.title }} - {{ 'products.product.sold_out' | t }}
        </option>
      {%- endif -%}
    {%- endfor -%}
  </select>

  <textarea data-variant-json class="hide" aria-hidden="true" aria-label="Product JSON">
    {{ product.variants | json }}
  </textarea>
  <textarea data-product-inventories class="hide" aria-hidden="true" aria-label="Product Inventories JSON">
    {
      {%- for variant in product.variants -%}
        "{{ variant.id }}": {
          "inventory_management": {{ variant.inventory_management | json }},
          "inventory_policy": {{ variant.inventory_policy | json }},
          "inventory_quantity": {{ variant.inventory_quantity | default: 0 }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    }
  </textarea>
  {%- if product.options.size > 1 -%}
    <textarea data-current-variant-json class="hide" aria-hidden="true" aria-label="Variant JSON">
      {{ current_variant | json }}
    </textarea>
  {%- endif -%}
{%- endform -%}
