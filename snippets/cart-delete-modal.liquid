<div id="CartDeleteModal" class="cart-delete-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="CartDeleteModalTitle">
  <div class="cart-delete-modal__backdrop js-cart-delete-cancel"></div>
  <div class="cart-delete-modal__dialog">
    <button type="button" class="cart-delete-modal__close js-cart-delete-cancel" aria-label="Close">
      <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="cart-delete-modal__header">
      <div class="cart-delete-modal__icon-wrap">
        <svg class="cart-delete-modal__warn-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 6h18m-2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          <line x1="10" y1="11" x2="10" y2="17"></line>
          <line x1="14" y1="11" x2="14" y2="17"></line>
        </svg>
      </div>
      <h3 id="CartDeleteModalTitle" class="cart-delete-modal__title">Are you sure you want to delete this item?</h3>
    </div>

    <div class="cart-delete-modal__product">
      <div class="cart-delete-modal__img-wrap">
        <img id="CartDeleteModalImg" src="" alt="Product image" class="cart-delete-modal__img">
      </div>
      <div class="cart-delete-modal__info">
        <div id="CartDeleteModalProdTitle" class="cart-delete-modal__prod-title"></div>
        <div id="CartDeleteModalVariant" class="cart-delete-modal__variant"></div>
        <div class="cart-delete-modal__meta">
          <span id="CartDeleteModalQty" class="cart-delete-modal__qty"></span>
          <span class="cart-delete-modal__divider">&bull;</span>
          <span id="CartDeleteModalPrice" class="cart-delete-modal__price"></span>
        </div>
      </div>
    </div>

    <div class="cart-delete-modal__actions">
      <button type="button" class="btn cart-delete-modal__btn cart-delete-modal__btn--cancel js-cart-delete-cancel">
        Cancel
      </button>
      <button type="button" id="CartDeleteModalConfirmBtn" class="btn cart-delete-modal__btn cart-delete-modal__btn--confirm js-cart-delete-confirm">
        Confirm
      </button>
    </div>
  </div>
</div>
