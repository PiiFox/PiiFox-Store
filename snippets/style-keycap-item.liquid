{% comment %}
 collection
 current_tab
{% endcomment %}

{% assign section_collection = collection %}
{% assign product_count = section_collection.products | size %}

<div class="keycap-section-item-wrapper">
    <div class="keycap-section-header">
      <h2 class="keycap-section-title">
        {{ section_collection.title }}
        <span>({{ product_count }})</span>
      </h2>
      <a href="{{ section_collection.url }}" class="keycap-view-all-btn">
        {{- 'collections.general.all_of_collection' | t -}}
      </a>
    </div>

    <div class="keycap-carousel" id="keycap-{{ current_tab }}-{{ section_collection.handle }}">
      {% for product in section_collection.products %}
        <div class="keycap-product-card">
          <a
            href="{{ product.url }}"
            class="keycap-card-image-link"
            aria-label="View {{ product.title | escape }}"
          >
            <div class="keycap-card-img-wrap">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 680 }}"
                  alt="{{ product.title | escape }}"
                  class="keycap-card-img"
                  loading="lazy"
                  width="680"
                  height="auto"
                >
              {% else %}
                <div style="width:100%;height:100%;background:#f7f7f7;display:flex;align-items:center;justify-content:center;">
                  No Image
                </div>
              {% endif %}
            </div>
          </a>
          <div class="keycap-card-info">
            <h3 class="keycap-product-name">{{ product.title }}</h3>
            <a
              href="{{ product.url }}"
              class="keycap-shopnow-btn"
              aria-label="Shop {{ product.title | escape }}"
            >Shop Now</a>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="carousel-arrow-wrap">
      <button class="carousel-arrow prev-arrow" data-target="keycap-{{ current_tab }}-{{ section_collection.handle }}">←</button>
      <button class="carousel-arrow next-arrow" data-target="keycap-{{ current_tab }}-{{ section_collection.handle }}">→</button>
    </div>
</div>

<script>
  (() => {
    const initKeycapCarousels = () => {
      document.querySelectorAll('.carousel-arrow').forEach((button) => {
        if (button.dataset.keycapArrowReady === 'true') return;
        button.dataset.keycapArrowReady = 'true';

        button.addEventListener('click', () => {
          const carousel = document.getElementById(button.dataset.target);
          if (!carousel) return;

          const direction = button.classList.contains('prev-arrow') ? -1 : 1;
          const scrollStep = Math.max(carousel.clientWidth * 0.85, 280);
          carousel.scrollBy({ left: direction * scrollStep, behavior: 'smooth' });
        });
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initKeycapCarousels, { once: true });
    } else {
      initKeycapCarousels();
    }
  })();
</script>
