<!-- fixed bottom info (desktop & mobile) -->
<div class="device_bottominfo">
  <div class="device_bottominfo--wrapper page-width">
    <div class="m_product_info">
      <img class="m_product_img" src="{{ product.featured_image | img_url:"400x400" }}" alt="{{ product.title | escape }}">
      <h2 class="m_product_title small--hide">{{ product.title }}</h2>
    </div>
    <div class="m_product_option">
      <div class="m_product_price">
        {%- assign hide_sale_price = true -%}

        <span
          data-product-price
          class="product__price{% if current_variant.compare_at_price > current_variant.price %} on-sale{% endif %}"
        >
          {%- unless product.empty? -%}
            {{ current_variant.price | money }}
          {%- else -%}
            {{ 1999 | money }}
          {%- endunless -%}
        </span>
        {%- if product.compare_at_price_max > product.price -%}
          {%- if current_variant.compare_at_price > current_variant.price -%}
            {%- assign hide_sale_price = false -%}
          {%- endif -%}
          <span data-a11y-price class="visually-hidden" aria-hidden="{{ hide_sale_price }}" >
            {{ 'products.general.regular_price' | t }}
          </span>
          <span data-product-price-wrap class="{% if hide_sale_price %} hide{% endif %}">
            <span data-compare-price class="product__price product__price--compare">
              {%- if current_variant.compare_at_price > current_variant.price -%}
                {{ current_variant.compare_at_price | money }}
              {%- endif -%}
            </span>
          </span>
          <span data-compare-price-a11y class="visually-hidden">{{ 'products.general.sale_price' | t }}</span>
        {%- else -%}
          <span data-a11y-price class="visually-hidden">{{ 'products.general.regular_price' | t }}</span>
        {%- endif -%}
      </div>
      <a href="javascript:;" class="m_product_addToCart btn add-to-cart">
        <span class="m_product_addToCart_text">
          {%- if current_variant.available -%}
            ADD TO CART
          {%- else -%}
            SOLD OUT
          {%- endif -%}
        </span>
        <div class="m_bottom_cart_status medium-up--hide" aria-hidden="true">
          <div class="m_bottom_cart_icon_wrap">
            <svg class="m_bottom_bag_icon" width="26" height="26" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <path d="M16 11V7C16 4.79086 14.2091 3 12 3C9.79086 3 8 4.79086 8 7V11M5 9H19L20 21H4L5 9Z" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="m_bottom_cart_bubble cart-link__bubble cart-link__bubble--visible">
              <span class="cart-link__bubble-num">{{ cart.item_count | default: 0 }}</span>
            </span>
          </div>
        </div>
      </a>
    </div>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    // 监听 ADD TO CART 视口可见性
    function updateDeviceBottomInfo() {
      const mobileBottomInfo = document.querySelector('.device_bottominfo');
      if (!mobileBottomInfo) return;
      const paymentButtons = document.querySelector('.product-single__form [data-add-to-cart]') ||
                             document.querySelector('[data-add-to-cart]') ||
                             document.querySelector('.product-block .payment-buttons') ||
                             document.querySelector('.payment-buttons');
      if (!paymentButtons) {
        mobileBottomInfo.style.display = 'none';
        return;
      }
      const rect = paymentButtons.getBoundingClientRect();
      const stickyHeader = document.querySelector('.site-header--stuck, .header-wrapper--sticky .site-header');
      const topThreshold = stickyHeader ? stickyHeader.getBoundingClientRect().bottom : 0;

      if (window.innerWidth > 768) {
        // PC端：向下滚动直到页面里的 ADD TO CART 向上滑出视口（消失在顶部/吸顶导航后）才显示吸底栏
        const hasScrolledPast = rect.bottom <= topThreshold;
        mobileBottomInfo.style.display = hasScrolledPast ? 'block' : 'none';
      } else {
        // 移动端保持原逻辑不变：视口内没有 ADD TO CART 时显示
        const inViewport = rect.top < window.innerHeight && rect.bottom > topThreshold;
        mobileBottomInfo.style.display = inViewport ? 'none' : 'block';
      }
    }

    let ticking = false;
    function requestUpdate() {
      if (!ticking) {
        requestAnimationFrame(function () {
          updateDeviceBottomInfo();
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
    window.addEventListener('load', requestUpdate);
    updateDeviceBottomInfo();

    // 变体切换时同步更新吸底栏主图与状态
    $(document).on('variantChange', function (e, variant) {
      if (variant && variant.featured_image && variant.featured_image.src) {
        const bottomImg = document.querySelector('.device_bottominfo .m_product_img');
        if (bottomImg) {
          bottomImg.src = variant.featured_image.src;
        }
      }
      const bottomAddBtn = document.querySelector('.device_bottominfo .m_product_addToCart');
      if (bottomAddBtn && variant) {
        const textSpan = bottomAddBtn.querySelector('.m_product_addToCart_text');
        if (!variant.available) {
          bottomAddBtn.classList.add('disabled');
          if (textSpan) {
            textSpan.textContent = 'SOLD OUT';
          } else {
            bottomAddBtn.textContent = 'SOLD OUT';
          }
        } else {
          bottomAddBtn.classList.remove('disabled');
          if (textSpan) {
            textSpan.textContent = 'ADD TO CART';
          } else {
            bottomAddBtn.textContent = 'ADD TO CART';
          }
        }
      }
    });

    // 移动端点击底部栏图片平滑滚动回顶部
    $(document).on('click', '.device_bottominfo .m_product_info', function (e) {
      if (window.innerWidth <= 768) {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });

    // 点击切换 active 类
    const describeContainer = document.querySelector('.product-block.custom-point-describe-container');
    if (describeContainer) {
      describeContainer.addEventListener('click', function () {
        if (describeContainer.classList.contains('active')) {
          describeContainer.classList.remove('active');
        } else {
          describeContainer.classList.add('active');
        }
      });
    }
  });
</script>

{%- render 'filter' -%}
<div
  id="descs"
  class="page-width{% if section.settings.max_width %} page-width--{% endif %} Features filter-item"
  data-snippet="Features"
>
  {% render 'product-description', product: product %}
</div>
{%- assign show_product_specs = false -%}
{%- if product.category == 'Keyboards' -%}
  {%- assign show_product_specs = true -%}
{%- elsif product.category == 'Keyboard Keycaps' or product.category == 'Keyboard Switches' -%}
  {%- assign product_spec_data = product.metafields.custom.product_spec.value -%}
  {%- if product_spec_data.system.type != blank -%}
    {%- assign show_product_specs = true -%}
  {%- endif -%}
{%- endif -%}
{%- if show_product_specs -%}
  <div
    id="product-space"
    class="page-width page-width--narrow Specs filter-item"
    data-snippet="Specs"
  >
    {% render 'product-specs', product: product %}
  </div>
{%- endif -%}
{% if product.category == 'Keyboards' %}
  <div
    id="product-switches"
    class="page-width page-width--narrow Switches-Compare"
    data-snippet="Switches-Compare"
  >
    {% render 'switches-compare', product: product %}
  </div>
{% endif %}
<div
  id="product-whats-in-the-box"
  class="page-width Whats-in-the-box"
  data-snippet="whats-in-the-box"
>
  {% render 'whats_in_the_box', product: product %}
</div>
<div
  id="product-faq"
  class="page-width page-width--narrow FAQ filter-item"
  data-snippet="FAQ"
>
  {% render 'product-faq-list', product: product %}
</div>
{%- if product.metafields.custom.downloads_list != blank -%}
  <div
    id="product-download"
    class="page-width Downloads filter-item"
    data-snippet="Downloads"
  >
    {% render 'product-downloads-list', product: product %}
  </div>
{%- endif -%}

{% style %}
  .product-faq-list--wrapper .collapsible-trigger-btn {
    text-transform: none;
    letter-spacing: 0.1em;
  }
{% endstyle %}
