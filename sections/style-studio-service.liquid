<section class="style-studio-service style-studio-service-{{ section.id }}">
  <div class="style-studio-service__inner">
    {% if section.settings.heading != blank %}
      <div class="style-studio-service__header">
        {% if section.settings.eyebrow != blank %}
          <p class="style-studio-service__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        <h2>{{ section.settings.heading | escape }}</h2>
        {% if section.settings.subheading != blank %}
          <p>{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="style-studio-service__grid">
      {% for block in section.blocks %}
        {% assign item = block.settings %}
        <article class="style-studio-service__item" {{ block.shopify_attributes }}>
          {% if item.icon != blank %}
            <div class="style-studio-service__icon" style="background: {{ item.accent_color | default: '#1f5b2f' }};">
              <img src="{{ item.icon | image_url: width: 240 }}" alt="" loading="lazy">
            </div>
          {% else %}
            <div class="style-studio-service__icon" style="background: {{ item.accent_color | default: '#1f5b2f' }};">
              <span aria-hidden="true">✦</span>
            </div>
          {% endif %}

          {% if item.title != blank %}
            <h3>{{ item.title | escape }}</h3>
          {% endif %}

          {% if item.description != blank %}
            <p>{{ item.description | escape }}</p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
  .style-studio-service-{{ section.id }} {
    background: #ffffff;
    color: #111111;
    padding: 5rem 0;
  }

  .style-studio-service-{{ section.id }}__inner {
    width: min(100% - 2rem, 1200px);
    margin: 0 auto;
  }

  .style-studio-service-{{ section.id }}__header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .style-studio-service-{{ section.id }}__eyebrow {
    margin: 0 0 0.75rem;
    color: #1f5b2f;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .style-studio-service-{{ section.id }}__header h2 {
    margin: 0;
    font-size: clamp(2.2rem, 3vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  .style-studio-service-{{ section.id }}__header p {
    max-width: 46rem;
    margin: 1rem auto 0;
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(17, 17, 17, 0.72);
  }

  .style-studio-service-{{ section.id }}__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .style-studio-service-{{ section.id }}__item {
    padding: 2rem 1.5rem;
    border-radius: 1.5rem;
    background: #f6f3ee;
    border: 1px solid rgba(17, 17, 17, 0.06);
    text-align: center;
  }

  .style-studio-service-{{ section.id }}__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 5rem;
    height: 5rem;
    margin: 0 auto 1.25rem;
    border-radius: 50%;
    color: #ffffff;
    overflow: hidden;
  }

  .style-studio-service-{{ section.id }}__icon img {
    display: block;
    width: 58%;
    height: 58%;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  .style-studio-service-{{ section.id }}__icon span {
    font-size: 2rem;
    line-height: 1;
  }

  .style-studio-service-{{ section.id }}__item h3 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.4rem, 1.8vw, 2rem);
    line-height: 1.2;
  }

  .style-studio-service-{{ section.id }}__item p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.75;
    color: rgba(17, 17, 17, 0.72);
  }

  @media screen and (max-width: 767px) {
    .style-studio-service-{{ section.id }} {
      padding: 4rem 0;
    }

    .style-studio-service-{{ section.id }}__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Style Studio Service",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Approach"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Style your setup your way"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Bring personality to every key with thoughtful themes, premium finishes, and fresh community inspiration."
    }
  ],
  "blocks": [
    {
      "type": "service_item",
      "name": "Service item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "color",
          "id": "accent_color",
          "label": "Accent color",
          "default": "#1f5b2f"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Design led"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Choose colors and themes that fit your desk, mood, and setup style."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Style Studio Service",
      "blocks": [
        { "type": "service_item", "settings": { "title": "Design led", "description": "Choose colors and themes that fit your desk, mood, and setup style." } },
        { "type": "service_item", "settings": { "title": "Curated quality", "description": "Premium keycaps with thoughtful materials and consistent finishing." } },
        { "type": "service_item", "settings": { "title": "Built for setup joy", "description": "Enjoy a keyboard that feels like it was made for your workspace and routine." } }
      ]
    }
  ]
}
{% endschema %}
