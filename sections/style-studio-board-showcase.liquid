<section class="style-studio-board-showcase style-studio-board-showcase-{{ section.id }}">
  <div class="style-studio-board-showcase__inner">
    {% if section.settings.heading != blank %}
      <div class="style-studio-board-showcase__header">
        <p class="style-studio-board-showcase__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2>{{ section.settings.heading | escape }}</h2>
        {% if section.settings.subheading != blank %}
          <p>{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="style-studio-board-showcase__grid">
      {% for block in section.blocks %}
        {% assign card = block.settings %}
        <article class="style-studio-board-showcase__card" {{ block.shopify_attributes }}>
          {% if card.image != blank %}
            <div class="style-studio-board-showcase__media">
              <img
                src="{{ card.image | image_url: width: 900 }}"
                alt="{{ card.title | escape }}"
                loading="lazy"
                width="{{ card.image.width | default: 900 }}"
                height="{{ card.image.height | default: 900 }}"
              >
            </div>
          {% endif %}

          <div class="style-studio-board-showcase__content">
            {% if card.eyebrow != blank %}
              <p class="style-studio-board-showcase__content-eyebrow">{{ card.eyebrow | escape }}</p>
            {% endif %}

            {% if card.title != blank %}
              <h3>{{ card.title | escape }}</h3>
            {% endif %}

            {% if card.content != blank %}
              <p>{{ card.content | escape }}</p>
            {% endif %}

            {% if card.button_label != blank and card.button_link != blank %}
              <a href="{{ card.button_link }}" class="style-studio-board-showcase__button">
                {{ card.button_label | escape }}
              </a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
  .style-studio-board-showcase-{{ section.id }} {
    background: #f7f5ef;
    color: #151515;
    padding: 5rem 0;
  }

  .style-studio-board-showcase-{{ section.id }}__inner {
    width: min(100% - 2rem, 1400px);
    margin: 0 auto;
  }

  .style-studio-board-showcase-{{ section.id }}__header {
    text-align: center;
    margin-bottom: 2.75rem;
  }

  .style-studio-board-showcase-{{ section.id }}__eyebrow {
    margin: 0 0 0.75rem;
    color: #1f5b2f;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .style-studio-board-showcase-{{ section.id }}__header h2 {
    margin: 0;
    font-size: clamp(2.2rem, 3vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .style-studio-board-showcase-{{ section.id }}__header p {
    max-width: 48rem;
    margin: 1rem auto 0;
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(21, 21, 21, 0.75);
  }

  .style-studio-board-showcase-{{ section.id }}__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .style-studio-board-showcase-{{ section.id }}__card {
    background: #ffffff;
    border-radius: 1.5rem;
    overflow: hidden;
    border: 1px solid rgba(21, 21, 21, 0.08);
    box-shadow: 0 12px 32px rgba(17, 17, 17, 0.05);
  }

  .style-studio-board-showcase-{{ section.id }}__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #eae5dc;
  }

  .style-studio-board-showcase-{{ section.id }}__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .style-studio-board-showcase-{{ section.id }}__content {
    padding: 1.5rem 1.4rem 1.7rem;
  }

  .style-studio-board-showcase-{{ section.id }}__content-eyebrow {
    margin: 0 0 0.5rem;
    color: #1f5b2f;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .style-studio-board-showcase-{{ section.id }}__content h3 {
    margin: 0;
    font-size: clamp(1.4rem, 1.8vw, 2rem);
    line-height: 1.2;
  }

  .style-studio-board-showcase-{{ section.id }}__content p {
    margin: 0.8rem 0 1.2rem;
    color: rgba(21, 21, 21, 0.75);
    line-height: 1.7;
  }

  .style-studio-board-showcase-{{ section.id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.2rem;
    border-radius: 999px;
    background: #111111;
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    transition: opacity 0.2s ease;
  }

  .style-studio-board-showcase-{{ section.id }}__button:hover {
    opacity: 0.9;
  }

  @media screen and (max-width: 767px) {
    .style-studio-board-showcase-{{ section.id }} {
      padding: 4rem 0;
    }

    .style-studio-board-showcase-{{ section.id }}__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Style Studio Board Showcase",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Style Studio"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Board showcase"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Browse keyboard stories that bring art, color, and comfort together in one beautifully built desk setup."
    }
  ],
  "blocks": [
    {
      "type": "theme",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Featured"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Clean & Minimal"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Content",
          "default": "A refined palette made for calm focus and high-end desk setups."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Explore"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Style Studio Board Showcase",
      "blocks": [
        { "type": "theme", "settings": { "title": "Clean & Minimal", "content": "A refined palette made for calm focus and high-end desk setups." } },
        { "type": "theme", "settings": { "title": "Retro & Playful", "content": "Bold colors and nostalgic details that keep every keystroke expressive." } },
        { "type": "theme", "settings": { "title": "Nature & Soft", "content": "Organic neutrals and muted greens for a calm, modern desk mood." } }
      ]
    }
  ]
}
{% endschema %}
