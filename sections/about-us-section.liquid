{% style %}
  #shopify-section-{{ section.id }} {
      margin-bottom: 0 !important;
      padding-bottom: 0 !important;
  }

  /* 方案一：1:1 复刻 Anker 官方 Sticky 视窗长轨道架构 */
  .about-us-section-{{ section.id }}.about-us-anker-sticky-mode {
      background-color: #0b0b0b;
      padding: 0 !important;
      margin-bottom: 0 !important;
      width: 100%;
      /* 核心高度：100vh 视口高度 + 950px 的滚动轨道行程 */
      height: calc(100vh + 950px);
      height: calc(100svh + 950px);
      box-sizing: border-box;
      position: relative;
      cursor: default;
  }

  /* 粘性视窗容器：当滚动到页面视口顶部时吸附停留 (position: sticky; top: 0) */
  .about-us-section-{{ section.id }}.about-us-anker-sticky-mode .about-us-sticky-window {
      position: -webkit-sticky;
      position: sticky;
      top: 0;
      left: 0;
      width: 100%;
      height: 100vh;
      height: 100svh;
      overflow: hidden;
      z-index: 2;
  }

  .about-us-section-{{ section.id }}.about-us-anker-sticky-mode .about-us-sticky-inner {
      position: relative;
      width: 100%;
      height: 100%;
      overflow: hidden;
  }

  /* 柔和暗角与通透黑色微遮罩，确保文字极致高阶易读 */
  .about-us-section-{{ section.id }}.about-us-anker-sticky-mode .about-us-sticky-inner::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: radial-gradient(circle at center, rgba(0, 0, 0, 0.08) 0%, rgba(0, 0, 0, 0.42) 100%), linear-gradient(180deg, rgba(0, 0, 0, 0.08) 0%, rgba(0, 0, 0, 0.32) 100%);
      z-index: 2;
      pointer-events: none;
  }

  /* 视频容器：超高画幅 (150% 高)，基准定位 top: -25%，在视口内平滑垂直下滑 */
  .about-us-section-{{ section.id }}.about-us-anker-sticky-mode .con2-video {
      position: absolute;
      top: -25%;
      left: -10%;
      width: 120%;
      height: 150%;
      z-index: 1;
      overflow: hidden;
      transform-origin: center center;
      will-change: transform;
  }
  .about-us-section-{{ section.id }}.about-us-anker-sticky-mode .con2-video video,
  .about-us-section-{{ section.id }}.about-us-anker-sticky-mode .con2-video img.con2-video-thumbnail {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center center;
      display: block;
      transform: translate3d(0, -200px, 0) scale(1.15);
      transform-origin: center center;
      will-change: transform;
      -webkit-backface-visibility: hidden;
      backface-visibility: hidden;
      transform-style: preserve-3d;
      image-rendering: -webkit-optimize-contrast;
      border-radius: 0 !important;
      border: none !important;
      outline: none !important;
      box-shadow: none !important;
  }

  /* 文案层：跟随视频向下滑动流动 */
  .about-us-section-{{ section.id }}.about-us-anker-sticky-mode .about-us-banner-overlay {
      position: absolute;
      top: 0;
      left: 0;
