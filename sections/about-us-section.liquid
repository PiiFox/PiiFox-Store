<script src="{{ 'ScrollTrigger.min.js' | asset_url }}" defer></script>
<script>
  (function() {
    const sectionId = '{{ section.id }}';

    function initStickyScrollAnimation() {
      const sectionEl = document.querySelector('.about-us-section-' + sectionId + '.about-us-anker-sticky-mode');
      if (!sectionEl) return;

      const videoEl = sectionEl.querySelector('.con2-video video');
      const targetAnimEl = sectionEl.querySelector('.con2-video video') || sectionEl.querySelector('.con2-video');
      const overlayEl = sectionEl.querySelector('.about-us-banner-overlay');

      if (videoEl) {
        videoEl.muted = true;
        videoEl.setAttribute('playsinline', '');
        videoEl.setAttribute('webkit-playsinline', '');
        videoEl.play().catch(() => {});
      }

      const isMobile = window.innerWidth <= 768;
      // Anker 1:1 Sticky 视窗长行程滑动参数：
      // 视频位移：PC 端从 -200px 一路顺滑下移至 +200px（总行程达 400px！移动端 -130px 至 +130px，总行程 260px！）
      // 缩放比例：1.15 -> 1.0 (全画幅细腻展开)
      // 文案位移：文案跟随视频从 -75px 向下推移至 +75px (移动端 -45px 至 +45px)
      const startScale = 1.15;
      const endScale = 1.0;
      const videoTravel = isMobile ? 130 : 200;
      const overlayTravel = isMobile ? 45 : 75;

      function applyGsapAnimation() {
        if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
          return false;
        }

        gsap.registerPlugin(ScrollTrigger);

        ScrollTrigger.getAll().forEach(function(st) {
          if (st.trigger === sectionEl) st.kill();
        });

        // 绑定整个 950px 轨道的滚动进度
        // start: 'top top' -> 当 section 顶部到达屏幕顶部时，sticky 锁定，动画开始
        // end: 'bottom bottom' -> 当 950px 轨道滚完时，动画达到 100%，sticky 释放向下走
        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: sectionEl,
            start: 'top top',
            end: 'bottom bottom',
            scrub: 1.2,
            invalidateOnRefresh: true
          }
        });

        tl.fromTo(targetAnimEl,
          {
            scale: startScale,
            y: -videoTravel,
            transformOrigin: 'center center',
            force3D: true
          },
          {
            scale: endScale,
            y: videoTravel,
            ease: 'none'
          },
          0
        );

        if (overlayEl) {
          tl.fromTo(overlayEl,
            {
              y: -overlayTravel,
              opacity: 0.85,
              force3D: true
            },
            {
              y: overlayTravel,
              opacity: 1,
              ease: 'none'
            },
            0
          );
        }

        return true;
      }

      if (!applyGsapAnimation()) {
        let attempts = 0;
        const checkInterval = setInterval(function() {
          attempts++;
          if (applyGsapAnimation() || attempts > 20) {
            clearInterval(checkInterval);
          }
        }, 100);

        // 高性能 requestAnimationFrame 弹性插值备用方案
        let targetScale = startScale;
        let currentScale = startScale;
        let targetVideoY = -videoTravel;
        let currentVideoY = -videoTravel;
        let targetOverlayY = -overlayTravel;
        let currentOverlayY = -overlayTravel;
        let isTicking = false;

        function onScroll() {
          if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') return;
          const rect = sectionEl.getBoundingClientRect();
          const winH = window.innerHeight || document.documentElement.clientHeight;
          const totalDist = sectionEl.offsetHeight - winH;
          if (totalDist > 0) {
            const currentDist = -rect.top;
            const progress = Math.max(0, Math.min(1, currentDist / totalDist));
            targetScale = startScale - (progress * (startScale - endScale));
            targetVideoY = -videoTravel + (progress * (videoTravel * 2));
            targetOverlayY = -overlayTravel + (progress * (overlayTravel * 2));

            if (!isTicking) {
              isTicking = true;
              requestAnimationFrame(renderFallback);
            }
          }
        }

        function renderFallback() {
          if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
            isTicking = false;
            return;
          }
          currentScale += (targetScale - currentScale) * 0.1;
          currentVideoY += (targetVideoY - currentVideoY) * 0.1;
          currentOverlayY += (targetOverlayY - currentOverlayY) * 0.1;
          if (targetAnimEl) {
            targetAnimEl.style.transform = 'translate3d(0, ' + currentVideoY.toFixed(2) + 'px, 0) scale(' + currentScale.toFixed(4) + ')';
          }
          if (overlayEl) {
            overlayEl.style.transform = 'translate3d(0, ' + currentOverlayY.toFixed(2) + 'px, 0)';
          }
          if (Math.abs(currentVideoY - targetVideoY) > 0.1 || Math.abs(currentScale - targetScale) > 0.0005) {
            requestAnimationFrame(renderFallback);
          } else {
            isTicking = false;
          }
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initStickyScrollAnimation);
    } else {
      initStickyScrollAnimation();
    }
    window.addEventListener('load', initStickyScrollAnimation);

    let resizeTimer;
    let lastWidth = window.innerWidth;
    window.addEventListener('resize', function() {
      if (window.innerWidth === lastWidth) return;
      lastWidth = window.innerWidth;
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(initStickyScrollAnimation, 150);
    });

    document.addEventListener('shopify:section:load', function(e) {
      if (e.target && (e.target.id === 'shopify-section-' + sectionId || e.target.querySelector('.about-us-section-' + sectionId))) {
        initStickyScrollAnimation();
      }
    });
    document.addEventListener('shopify:section:select', function(e) {
      if (e.target && (e.target.id === 'shopify-section-' + sectionId || e.target.querySelector('.about-us-section-' + sectionId))) {
        initStickyScrollAnimation();
      }
    });
  })();
</script>
