{%- liquid
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign border_color = section.settings.border_color | default: '#ebebeb'
  assign show_border = section.settings.show_border
  assign show_bottom_border = section.settings.show_bottom_border
  assign show_vertical_divider = section.settings.show_vertical_divider
  assign full_width = section.settings.full_width
  assign left_title = section.settings.title | default: 'Type your style'
  assign title_color = section.settings.title_color | default: '#000000'
  assign title_size = section.settings.title_font_size | default: 32
  assign m_title_size = section.settings.mobile_title_font_size | default: 20
  assign default_prefix_color = section.settings.prefix_color | default: '#0A6830'
  assign default_suffix_color = section.settings.suffix_color | default: '#000000'
  assign speed = section.settings.speed | default: 28
  assign direction = section.settings.direction | default: 'left'
  assign pause_on_hover = section.settings.pause_on_hover
  assign gap = section.settings.gap | default: 48
  assign padding_v = section.settings.padding_vertical | default: 36
  assign prefix_size = section.settings.prefix_font_size | default: 20
  assign suffix_size = section.settings.suffix_font_size | default: 15
  assign m_prefix_size = section.settings.mobile_prefix_font_size | default: 16
  assign m_suffix_size = section.settings.mobile_suffix_font_size | default: 13
  assign mobile_layout = section.settings.mobile_layout | default: 'side_by_side'
  
  # Duplication factor to guarantee seamless infinite loop without blank gaps
  assign block_count = section.blocks.size
  if block_count == 0
    assign inner_repeats = 4
  elsif block_count <= 2
    assign inner_repeats = 6
  elsif block_count <= 4
    assign inner_repeats = 4
  else
    assign inner_repeats = 3
  endif
-%}

{% style %}
  .col-txt-section-{{ section.id }}.col2-txt-section-container {
    width: 100%;
    background-color: {{ bg_color }};
    {% if show_border %}
      border-top: 1px solid {{ border_color }};
    {% else %}
      border-top: none;
    {% endif %}
    {% if show_bottom_border %}
      border-bottom: 1px solid {{ border_color }};
    {% else %}
      border-bottom: none;
    {% endif %}
    padding: {{ padding_v }}px 0;
    min-height: 84px;
    display: flex;
    align-items: center;
    position: relative;
    z-index: 4;
    box-sizing: border-box;
    overflow: hidden;
  }

  .col-txt-section-{{ section.id }} .col2-txt-inner {
    width: 100%;
    display: flex;
    align-items: center;
    box-sizing: border-box;
  }

  /* Left 1/3 section */
  .col-txt-section-{{ section.id }} .col2-txt-left {
    flex: 0 0 33.333%;
    width: 33.333%;
    max-width: 33.333%;
    box-sizing: border-box;
    padding-right: 28px;
    display: flex;
    align-items: center;
    {% if show_vertical_divider %}
      border-right: 1px solid {{ border_color }};
    {% endif %}
    position: relative;
    z-index: 2;
    background-color: inherit;
    flex-shrink: 0;
  }

  .col-txt-section-{{ section.id }} .col2-txt-title-link {
    text-decoration: none;
    color: inherit;
    display: inline-block;
    max-width: 100%;
  }

  .col-txt-section-{{ section.id }} .col2-txt-title {
    margin: 0;
    font-family: "PF_Bold", "Manrope", inherit, sans-serif;
    font-size: {{ title_size }}px;
    font-weight: 700;
    color: {{ title_color }};
    line-height: 1.2;
    letter-spacing: -0.015em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Right 2/3 marquee section */
  .col-txt-section-{{ section.id }} .col2-txt-right {
    flex: 0 0 66.667%;
    width: 66.667%;
    max-width: 66.667%;
    box-sizing: border-box;
    overflow: hidden;
    position: relative;
    padding-left: 28px;
    display: flex;
    align-items: center;
    -webkit-mask-image: linear-gradient(to right, transparent 0, black 24px, black calc(100% - 24px), transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, black 24px, black calc(100% - 24px), transparent 100%);
  }

  .col-txt-section-{{ section.id }} .marquee-ticker-bar {
    display: flex;
    width: 100%;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
  }

  .col-txt-section-{{ section.id }} .marquee-ticker-track {
    display: flex;
    width: max-content;
    flex-shrink: 0;
    will-change: transform;
  }

  .col-txt-section-{{ section.id }} .marquee-ticker-track--left {
    animation: marquee-scroll-left-{{ section.id }} {{ speed }}s linear infinite;
  }

  .col-txt-section-{{ section.id }} .marquee-ticker-track--right {
    animation: marquee-scroll-right-{{ section.id }} {{ speed }}s linear infinite;
  }

  {% if pause_on_hover %}
  .col-txt-section-{{ section.id }}[data-pause-on-hover="true"]:hover .marquee-ticker-track {
    animation-play-state: paused;
  }
  {% endif %}

  .col-txt-section-{{ section.id }} .marquee-ticker-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .col-txt-section-{{ section.id }} .marquee-ticker-item {
    display: inline-flex;
    align-items: baseline;
    flex-shrink: 0;
    white-space: nowrap;
    padding-right: {{ gap }}px;
    text-decoration: none;
    line-height: 1.35;
  }

  a.marquee-ticker-item {
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  a.marquee-ticker-item:hover {
    opacity: 0.8;
  }

  /* Prefix text: System font, larger font size, default green */
  .col-txt-section-{{ section.id }} .marquee-item-prefix {
    font-size: {{ prefix_size }}px;
    margin-right: 8px;
    display: inline-block;
    font-family: "PF_Bold", "Manrope", inherit, sans-serif;
    font-weight: 700;
    font-style: normal;
    letter-spacing: -0.01em;
  }

  /* Suffix text: System font, smaller font size, default black */
  .col-txt-section-{{ section.id }} .marquee-item-suffix {
    font-size: {{ suffix_size }}px;
    font-family: "PF_Normal", "Manrope", inherit, sans-serif;
    font-weight: 400;
    font-style: normal;
    letter-spacing: 0;
    display: inline-block;
  }

  @keyframes marquee-scroll-left-{{ section.id }} {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @keyframes marquee-scroll-right-{{ section.id }} {
    0% {
      transform: translate3d(-50%, 0, 0);
    }
    100% {
      transform: translate3d(0, 0, 0);
    }
  }

  @media screen and (max-width: 768px) {
    .col-txt-section-{{ section.id }}.col2-txt-section-container {
      padding: {{ padding_v | times: 0.75 | round }}px 0;
      min-height: 60px;
    }

    {% if mobile_layout == 'stacked' %}
      .col-txt-section-{{ section.id }} .col2-txt-inner {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
      }
      .col-txt-section-{{ section.id }} .col2-txt-left {
        width: 100%;
        max-width: 100%;
        flex: 1 1 auto;
        padding-right: 0;
        border-right: none;
        {% if show_vertical_divider %}
          border-bottom: 1px solid {{ border_color }};
          padding-bottom: 6px;
        {% endif %}
      }
      .col-txt-section-{{ section.id }} .col2-txt-right {
        width: 100%;
        max-width: 100%;
        flex: 1 1 auto;
        padding-left: 0;
      }
    {% else %}
      .col-txt-section-{{ section.id }} .col2-txt-left {
        flex: 0 0 auto;
        width: auto;
        max-width: 40%;
        padding-right: 14px;
      }
      .col-txt-section-{{ section.id }} .col2-txt-right {
        flex: 1 1 0;
        width: auto;
        max-width: none;
        padding-left: 14px;
        -webkit-mask-image: linear-gradient(to right, transparent 0, black 12px, black calc(100% - 14px), transparent 100%);
        mask-image: linear-gradient(to right, transparent 0, black 12px, black calc(100% - 14px), transparent 100%);
      }
    {% endif %}

    .col-txt-section-{{ section.id }} .col2-txt-title {
      font-size: {{ m_title_size }}px;
      white-space: normal;
      word-break: break-word;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      line-height: 1.18;
    }

    .col-txt-section-{{ section.id }} .marquee-ticker-item {
      padding-right: {{ gap | times: 0.65 | round }}px;
    }
    .col-txt-section-{{ section.id }} .marquee-item-prefix {
      font-size: {{ m_prefix_size }}px;
      margin-right: 6px;
    }
    .col-txt-section-{{ section.id }} .marquee-item-suffix {
      font-size: {{ m_suffix_size }}px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .col-txt-section-{{ section.id }} .marquee-ticker-track--left,
    .col-txt-section-{{ section.id }} .marquee-ticker-track--right {
      animation-duration: 120s;
    }
  }
{% endstyle %}

<div class="col-txt-section-{{ section.id }} col2-txt-section-container" 
     id="col2-txt-section-{{ section.id }}" 
     data-pause-on-hover="{{ pause_on_hover }}"
     data-section-id="{{ section.id }}"
     data-section-type="col2-txt-marquee">
  
  <div class="col2-txt-inner {% unless full_width %}page-width{% endunless %}">
    <div class="col2-txt-left">
      {%- if section.settings.title_link != blank -%}
        <a href="{{ section.settings.title_link }}" class="col2-txt-title-link">
      {%- endif -%}
        <h2 class="col2-txt-title custom-txt-bold">
          {{ left_title }}
        </h2>
      {%- if section.settings.title_link != blank -%}
        </a>
      {%- endif -%}
    </div>

    <div class="col2-txt-right">
      <div class="marquee-ticker-bar">
        <div class="marquee-ticker-track marquee-ticker-track--{{ direction }}">
          {%- for group_idx in (1..2) -%}
            <div class="marquee-ticker-group{% if group_idx == 2 %} marquee-ticker-group--clone{% endif %}" 
                 {% if group_idx == 2 %}aria-hidden="true"{% endif %}>
              {%- for r in (1..inner_repeats) -%}
                {%- if section.blocks.size > 0 -%}
                  {%- for block in section.blocks -%}
                    {%- liquid
                      assign prefix = block.settings.prefix_text
                      if prefix == blank
                        assign prefix = block.settings.feature_item_title
                      endif
                      assign suffix = block.settings.suffix_text
                      if suffix == blank
                        assign suffix = block.settings.feature_item_context
                      endif
                      assign item_link = block.settings.link
                      assign item_p_color = block.settings.prefix_color
                      if item_p_color == blank or item_p_color == 'rgba(0,0,0,0)'
                        assign item_p_color = default_prefix_color
                      endif
                      assign item_s_color = block.settings.suffix_color
                      if item_s_color == blank or item_s_color == 'rgba(0,0,0,0)'
                        assign item_s_color = default_suffix_color
                      endif
                    -%}
                    {%- if prefix != blank or suffix != blank -%}
                      {%- if item_link != blank -%}
                        <a href="{{ item_link }}" class="marquee-ticker-item" {{ block.shopify_attributes }}>
                      {%- else -%}
                        <div class="marquee-ticker-item" {{ block.shopify_attributes }}>
                      {%- endif -%}
                        {%- if prefix != blank -%}
                          <span class="marquee-item-prefix" style="color: {{ item_p_color }};">{{ prefix }}</span>
                        {%- endif -%}
                        {%- if suffix != blank -%}
                          <span class="marquee-item-suffix" style="color: {{ item_s_color }};">{{ suffix }}</span>
                        {%- endif -%}
                      {%- if item_link != blank -%}
                        </a>
                      {%- else -%}
                        </div>
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- else -%}
                  <!-- Default fallback demo items -->
                  <div class="marquee-ticker-item">
                    <span class="marquee-item-prefix" style="color: {{ default_prefix_color }};">Type your style</span>
                    <span class="marquee-item-suffix" style="color: {{ default_suffix_color }};">Make every setup feel like yours.</span>
                  </div>
                  <div class="marquee-ticker-item">
                    <span class="marquee-item-prefix" style="color: {{ default_prefix_color }};">Free standard shipping</span>
                    <span class="marquee-item-suffix" style="color: {{ default_suffix_color }};">On all orders over $75</span>
                  </div>
                  <div class="marquee-ticker-item">
                    <span class="marquee-item-prefix" style="color: {{ default_prefix_color }};">Feel the performance</span>
                    <span class="marquee-item-suffix" style="color: {{ default_suffix_color }};">Smooth. Fast. Comfortable.</span>
                  </div>
                  <div class="marquee-ticker-item">
                    <span class="marquee-item-prefix" style="color: {{ default_prefix_color }};">Make it personal</span>
                    <span class="marquee-item-suffix" style="color: {{ default_suffix_color }};">Custom crafted keyboards & switches</span>
                  </div>
                  <div class="marquee-ticker-item">
                    <span class="marquee-item-prefix" style="color: {{ default_prefix_color }};">Quality you can trust</span>
                    <span class="marquee-item-suffix" style="color: {{ default_suffix_color }};">Tested for everyday use.</span>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Col2 Txt Section",
  "class": "col2-txt-section",
  "settings": [
    {
      "type": "header",
      "content": "Left Section (左侧文案设置)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Left Title (左侧文案内容)",
      "default": "Type your style"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Left Title Color (左侧文案颜色)",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Desktop Title Font Size (电脑端左侧字号)",
      "min": 16,
      "max": 54,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_title_font_size",
      "label": "Mobile Title Font Size (移动端左侧字号)",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "url",
      "id": "title_link",
      "label": "Left Title Link (左侧链接，可选)"
    },
    {
      "type": "header",
      "content": "Marquee Typography (跑马灯字体与颜色)"
    },
    {
      "type": "color",
      "id": "prefix_color",
      "label": "Default Prefix Color (前缀字体颜色 - 绿色)",
      "default": "#0A6830"
    },
    {
      "type": "range",
      "id": "prefix_font_size",
      "label": "Desktop Prefix Font Size (电脑端前缀字号)",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_prefix_font_size",
      "label": "Mobile Prefix Font Size (移动端前缀字号)",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "suffix_color",
      "label": "Default Suffix Color (后缀字体颜色 - 黑色)",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "suffix_font_size",
      "label": "Desktop Suffix Font Size (电脑端后缀字号)",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "mobile_suffix_font_size",
      "label": "Mobile Suffix Font Size (移动端后缀字号)",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "header",
      "content": "Layout & Style (布局与样式)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color (背景颜色)",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show Top Border (显示顶部边框)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_bottom_border",
      "label": "Show Bottom Border (显示底部边框)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_vertical_divider",
      "label": "Show Divider Between Left & Right (显示左右分隔线)",
      "default": false
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border / Divider Color (边框与分隔线颜色)",
      "default": "#ebebeb"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical Padding (上下内边距 / 控制整体高度)",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width (全宽展示，不限制在页面宽度内)",
      "default": false
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile Layout (移动端排列方式)",
      "options": [
        {
          "value": "side_by_side",
          "label": "Side by Side (左右排列)"
        },
        {
          "value": "stacked",
          "label": "Stacked (上下排列)"
        }
      ],
      "default": "side_by_side"
    },
    {
      "type": "header",
      "content": "Animation & Scrolling (跑马灯动效)"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll Speed (滚动周期/秒，越小越快)",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "s",
      "default": 28
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Scroll Direction (滚动方向)",
      "options": [
        {
          "value": "left",
          "label": "Left (从右往左)"
        },
        {
          "value": "right",
          "label": "Right (从左往右)"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause On Hover (鼠标悬停时暂停)",
      "default": false
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap Between Items (项目之间间距)",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "ticker_item",
      "name": "Ticker Item (跑马灯项目)",
      "settings": [
        {
          "type": "text",
          "id": "prefix_text",
          "label": "Prefix Text (前缀文字 - 默认绿色系统字体)",
          "default": "Type your style"
        },
        {
          "type": "text",
          "id": "suffix_text",
          "label": "Suffix Text (后缀文字 - 默认黑色系统字体)",
          "default": "Make every setup feel like yours."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (跳转链接，可选)"
        },
        {
          "type": "color",
          "id": "prefix_color",
          "label": "Custom Prefix Color (自定义前缀颜色，留空继承全局)"
        },
        {
          "type": "color",
          "id": "suffix_color",
          "label": "Custom Suffix Color (自定义后缀颜色，留空继承全局)"
        }
      ]
    },
    {
      "type": "feature_item",
      "name": "Feature Item (兼容旧版)",
      "settings": [
        {
          "type": "text",
          "id": "prefix_text",
          "label": "Prefix Text (前缀文字)"
        },
        {
          "type": "text",
          "id": "suffix_text",
          "label": "Suffix Text (后缀文字)"
        },
        {
          "type": "html",
          "id": "feature_item_title",
          "label": "Title (旧版标题)"
        },
        {
          "type": "html",
          "id": "feature_item_context",
          "label": "Context (旧版内容)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (链接)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Col2 Txt Section",
      "settings": {
        "title": "Type your style"
      },
      "blocks": [
        {
          "type": "ticker_item",
          "settings": {
            "prefix_text": "Type your style",
            "suffix_text": "Make every setup feel like yours."
          }
        },
        {
          "type": "ticker_item",
          "settings": {
            "prefix_text": "Free standard shipping",
            "suffix_text": "On all orders over $75"
          }
        },
        {
          "type": "ticker_item",
          "settings": {
            "prefix_text": "Feel the performance",
            "suffix_text": "Smooth. Fast. Comfortable."
          }
        },
        {
          "type": "ticker_item",
          "settings": {
            "prefix_text": "Make it personal",
            "suffix_text": "Custom crafted keyboards & switches"
          }
        },
        {
          "type": "ticker_item",
          "settings": {
            "prefix_text": "Quality you can trust",
            "suffix_text": "Tested for everyday use."
          }
        }
      ]
    }
  ]
}
{% endschema %}
