{% style %}
  .keycap-style-section-title {
    padding: 4em 0 0em 0;
  }
  /* Tab 容器 */
  .keycap-section-tab {
    margin-bottom: 2em;
    padding: 0.5em 0 1em 0;
  }

  .keycap-section-tab > .page-width {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 1em;
  }

  .keycap-section-tab-item {
    font-size: 1.2rem;
    font-weight: 400;
    color: #000;
    border-radius: 25em;
    border: 2px solid #000;
    cursor: pointer;
    padding: 0.5em 2em;
    background: none;
    position: relative;
    transition: color 0.25s ease;
    letter-spacing: 0.8px;
    text-decoration: none;
    outline: none;
  }

  .keycap-section-tab-item:hover {
    background: #000;
    color: #fff;
    font-weight: 700;
  }

  .keycap-section-tab-item.active {
    background: #000;
    color: #fff;
    font-weight: 700;
  }

  @media screen and (max-width: 768px) {
    .keycap-style-section-title h1 {
      font-size: 2em;
    }
    .keycap-section-tab {
      gap: 1.5em;
      overflow-x: auto;
      white-space: nowrap;
      -webkit-overflow-scrolling: touch;
    }
    .keycap-section-tab-item {
      font-size: 1em;
      padding: 0.5em 1em;
    }
  }

  .keycap-section-wrapper {
    display: none; /* 默认隐藏 */
  }

  .keycap-section-wrapper.active {
    display: block;
  }
{% endstyle %}

{% style %}
  .keycap-section-item-wrapper {
    width: 100%;
    padding: 2em 1em;
    box-sizing: border-box;
    position: relative;
  }
  .keycap-section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.2em;
    flex-wrap: wrap;
  }
  .keycap-section-title {
    font-size: 2em;
    font-weight: 600;
    margin: 0;
  }
  .keycap-view-all-btn {
    padding: 0.6em 1.4em;
    border: 1px solid #000;
    border-radius: 20em;
    text-decoration: none;
    color: #000;
    font-size: 1em;
    transition: all 0.2s ease;
  }
  .keycap-view-all-btn:hover {
    background: #000;
    color: #fff;
  }
  .keycap-carousel {
    display: flex;
    gap: 1.4em;
    overflow-x: auto;
    scroll-behavior: smooth;
    padding-bottom: 1em;
    /* scrollbar-width: thin; */
    touch-action: pan-x;
  }
  .keycap-carousel::-webkit-scrollbar {
    width: 0;
    height: 0;
    visibility: hidden;
  }
  .keycap-carousel-scrollbar {
    display: none;
  }
  .keycap-product-card {
    min-width: 340px;
    max-width: 340px;
    border-radius: 1em;
    overflow: hidden;
    background: #fff;
    flex-shrink: 0;
    cursor: pointer;
  }
  .keycap-card-image-link {
    display: block;
    color: inherit;
    text-decoration: none;
    -webkit-user-drag: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  .keycap-card-img-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #f7f7f7;
  }
  .keycap-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    -webkit-user-drag: none;
    user-select: none;
    transition: transform 0.25s ease, filter 0.25s ease;
  }
  .keycap-card-image-link:hover .keycap-card-img,
  .keycap-card-image-link:focus-visible .keycap-card-img,
  .keycap-card-image-link:active .keycap-card-img {
    transform: scale(1.04);
    filter: brightness(0.94);
  }
  .keycap-card-image-link:focus-visible {
    outline: 2px solid #000;
    outline-offset: 3px;
  }
  .keycap-card-info {
    padding: 1em;
  }
  .keycap-product-name {
    font-size: 1.4em;
    font-weight: 500;
    margin: 0 0 12px 0;
  }
  .keycap-shopnow-btn {
    display: inline-block;
    padding: 0.5em 1.2em;
    border: 1px solid #000;
    border-radius: 20em;
    text-decoration: none;
    color: #000;
    font-size: 0.9em;
    cursor: pointer;
    transition: all 0.2s ease;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    position: relative;
    z-index: 1;
  }
  .keycap-shopnow-btn:hover,
  .keycap-shopnow-btn:focus-visible,
  .keycap-shopnow-btn:active {
    background: #000;
    color: #fff;
    transform: translateY(-1px);
  }
  .keycap-shopnow-btn:focus-visible {
    outline: 2px solid #000;
    outline-offset: 3px;
  }
  @media screen and (max-width: 768px) {
    .keycap-carousel {
      gap: 12px;
      padding-bottom: 0.75em;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 0;
      scrollbar-width: none;
      overscroll-behavior-inline: contain;
    }
    .keycap-carousel::after {
      content: '';
      flex: 0 0 calc(33.3333% - 4px);
    }
    .keycap-product-card {
      flex-basis: calc(66.6667% - 8px);
      min-width: calc(66.6667% - 8px);
      max-width: calc(66.6667% - 8px);
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }
    .keycap-section-title {
      font-size: 1.35em;
      line-height: 1.2;
    }
    .keycap-view-all-btn {
      padding: 0.45em 1em;
      font-size: 0.8em;
    }
    .keycap-product-name {
      font-size: 0.9em;
      line-height: 1.3;
      margin-bottom: 8px;
    }
    .keycap-shopnow-btn {
      padding: 0.4em 1em;
      font-size: 0.8em;
    }
    .keycap-carousel-scrollbar {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin: 8px auto 0;
    }
    .keycap-carousel-scrollbar.is-disabled {
      display: none;
    }
    .keycap-carousel-scrollbar__page {
      display: block;
      flex: 0 0 22px;
      width: 22px;
      height: 5px;
      min-width: 0;
      margin: 0;
      padding: 0;
      border: 0;
      border-radius: 999px;
      background: #e7ddd5;
      cursor: pointer;
      transition: background-color 0.2s ease;
    }
    .keycap-carousel-scrollbar__page.is-active {
      background: #171717;
    }
    .keycap-carousel-scrollbar__page:focus-visible {
      outline: 2px solid #171717;
      outline-offset: 3px;
    }
    .keycap-carousel-scrollbar.is-compact {
      gap: 5px;
    }
    .keycap-carousel-scrollbar.is-compact .keycap-carousel-scrollbar__page {
      flex-basis: 15px;
      width: 15px;
    }
  }
  .carousel-arrow-wrap {
    display: flex;
    gap: 0.5em;
    position: relative;
    top: -4.5em;
    justify-content: flex-end;
    margin-right: 0.5em;
    z-index: 20;
    pointer-events: none;
  }
  .carousel-arrow {
    width: 3em;
    height: 3em;
    border-radius: 50%;
    border: none;
    background: #cfcfcf;
    color: #111;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    position: relative;
    z-index: 21;
    pointer-events: auto;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .carousel-arrow:hover,
  .carousel-arrow:focus-visible {
    background: #b5b5b5;
  }
  .carousel-arrow:active {
    background: #9f9f9f;
    transform: scale(0.96);
  }
  .carousel-arrow:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }
  @media screen and (max-width: 768px) {
    .carousel-arrow-wrap {
      display: none;
    }
  }

{% endstyle %}

{% comment %} 收集有效的 Tab 标签 {% endcomment %}
{% assign has_current = false %}
{% assign has_coming = false %}
{% assign has_popular = false %}

{% for block in section.blocks %}
  {% if block.type == 'style_item' %}
    {% if block.settings.is_current_themes and block.settings.collection.products.size > 0 %}
      {% assign has_current = true %}
    {% endif %}
    {% if block.settings.is_coming_soon and block.settings.collection.products.size > 0 %}
      {% assign has_coming = true %}
    {% endif %}
    {% if block.settings.is_current_popular_themes and block.settings.collection.products.size > 0 %}
      {% assign has_popular = true %}
    {% endif %}
  {% endif %}
{% endfor %}

<div class="keycap-style-section-title">
  <div class="page-width">
    <h1 class="custom-txt-extrabold">{{ section.settings.title }}</h1>
  </div>
</div>

<div class="keycap-section-tab">
  <div class="page-width">
    {% if has_current %}
      <button class="keycap-section-tab-item active" data-tab="current_themes">{{ section.settings.tab1_title }}</button>
    {% endif %}
    {% if has_coming %}
      <button class="keycap-section-tab-item" data-tab="coming_soon">{{ section.settings.tab2_title }}</button>
    {% endif %}
    {% if has_popular %}
      <button class="keycap-section-tab-item" data-tab="current_popular_themes">{{ section.settings.tab3_title }}</button>
    {% endif %}
  </div>
</div>

{% comment %} 面板内容 {% endcomment %}
{% if has_current %}
  <div class="keycap-section-wrapper keycap-section-wrapper-current_themes active">
    <div class="page-width">
      {% for block in section.blocks %}
        {% if block.type == 'style_item' and block.settings.is_current_themes %}
          {% render 'style-keycap-item', collection: block.settings.collection, current_tab: 'current_themes' %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
{% endif %}

{% if has_coming %}
  <div class="keycap-section-wrapper keycap-section-wrapper-coming_soon">
    <div class="page-width">
      {% for block in section.blocks %}
        {% if block.type == 'style_item' and block.settings.is_coming_soon %}
          {% render 'style-keycap-item', collection: block.settings.collection, current_tab: 'coming_soon' %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
{% endif %}

{% if has_popular %}
  <div class="keycap-section-wrapper keycap-section-wrapper-current_popular_themes">
    <div class="page-width">
      {% for block in section.blocks %}
        {% if block.type == 'style_item' and block.settings.is_current_popular_themes %}
          {% render 'style-keycap-item', collection: block.settings.collection, current_tab: 'current_popular_themes' %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
{% endif %}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const tabs = document.querySelectorAll('.keycap-section-tab-item');
    const panels = document.querySelectorAll('.keycap-section-wrapper');

    if (!tabs.length) return;

    const activeTab = document.querySelector('.keycap-section-tab-item.active');
    if (!activeTab) {
      tabs[0].classList.add('active');
      const firstPanel = document.querySelector('.keycap-section-wrapper.' + tabs[0].dataset.tab);
      if (firstPanel) firstPanel.classList.add('active');
    } else {
      const firstPanel = document.querySelector('.keycap-section-wrapper.' + activeTab.dataset.tab);
      if (firstPanel) firstPanel.classList.add('active');
    }

    // 点击切换
    tabs.forEach((tab) => {
      tab.addEventListener('click', function (e) {
        // 移除所有激活状态
        tabs.forEach((t) => t.classList.remove('active'));
        panels.forEach((p) => p.classList.remove('active'));

        // 激活当前 Tab
        this.classList.add('active');
        const target = this.dataset.tab;
        const targetPanel = document.querySelector('.keycap-section-wrapper-' + target);
        if (targetPanel) {
          targetPanel.classList.add('active');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Style Keycap Section",
  "tag": "section",
  "class": "keycap-style-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Explore PIIFOX Keycaps Themes"
    },
    {
      "type": "text",
      "id": "tab1_title",
      "label": "Tab 1 Title",
      "default": "Current Themes"
    },
    {
      "type": "text",
      "id": "tab2_title",
      "label": "Tab 2 Title",
      "default": "Coming Soon"
    },
    {
      "type": "text",
      "id": "tab3_title",
      "label": "Tab 3 Title",
      "default": "Current Popular Themes"
    }
  ],
  "blocks": [
    {
      "type": "style_item",
      "name": "Style Item",
      "settings": [
        {
          "type": "checkbox",
          "id": "is_current_themes",
          "label": "Is Current Themes",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "is_coming_soon",
          "label": "Is Coming Soon",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "is_current_popular_themes",
          "label": "Is Current Popular Themes",
          "default": false
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Style Keycap Section"
    }
  ]
}
{% endschema %}
