{%- assign form_id = 'contact-' | append: section.id -%}

<div class="piifox-contact-page-wrapper">
  <div class="piifox-contact-grid">
    <div class="contact-form-column">
      {%- if section.settings.form_title != blank -%}
        <div class="form-header-line">
          <h2 class="form-title">{{ section.settings.form_title }}</h2>
        </div>
      {%- endif -%}

      {%- form 'contact', id: form_id -%}
        {%- if form.posted_successfully? -%}
          <div class="form-status form-status--success"><p>{{ section.settings.success_message }}</p></div>
        {%- elsif form.errors -%}
          <div class="form-status form-status--error">
            <p>{{ section.settings.error_message }}</p>
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- assign field_key = block.settings.field_key | default: block.id | handleize -%}
          {%- if block.settings.field_type == 'email' -%}{%- assign field_key = 'email' -%}{%- endif -%}
          {%- assign field_value = form[field_key] -%}
          {%- if field_key == 'email' and field_value == blank and customer -%}{%- assign field_value = customer.email -%}{%- endif -%}
          <div class="form-group" {{ block.shopify_attributes }}>
            <label for="ContactForm-{{ section.id }}-{{ block.id }}">
              {{ block.settings.label }}{%- if block.settings.required -%} <span class="required-indicator" aria-hidden="true">*</span>{%- endif -%}
            </label>
            {%- if block.settings.field_type == 'textarea' -%}
              <textarea rows="6" id="ContactForm-{{ section.id }}-{{ block.id }}" name="contact[{{ field_key }}]" placeholder="{{ block.settings.placeholder | escape }}"{% if block.settings.required %} required aria-required="true"{% endif %}>{{ field_value }}</textarea>
            {%- else -%}
              <input type="{{ block.settings.field_type }}" id="ContactForm-{{ section.id }}-{{ block.id }}" name="contact[{{ field_key }}]" placeholder="{{ block.settings.placeholder | escape }}" value="{{ field_value | escape }}"{% if block.settings.required %} required aria-required="true"{% endif %}{% if block.settings.field_type == 'email' %} autocorrect="off" autocapitalize="off" spellcheck="false" autocomplete="email"{% endif %}>
            {%- endif -%}
          </div>
        {%- endfor -%}

        {%- if section.settings.show_privacy -%}
          <div class="privacy-agreement-text">
            <label class="consent-checkbox-label" for="ContactForm-consent-{{ section.id }}">
              <input type="checkbox" id="ContactForm-consent-{{ section.id }}" name="contact[consent]" value="true" required aria-required="true">
              <span>{{ section.settings.privacy_text }}</span>
            </label>
          </div>
        {%- endif -%}
        <div class="form-action"><button type="submit" class="contact-submit-btn">{{ section.settings.submit_label }}</button></div>
      {%- endform -%}
    </div>

    <div class="contact-info-column">
      {%- if section.settings.business_hours != blank -%}
        <div class="info-block"><h4 class="info-block-title">{{ section.settings.business_hours_title }}</h4><p class="business-hours">{{ section.settings.business_hours }}</p></div>
      {%- endif -%}

      {%- if section.settings.official_email != blank or section.settings.marketing_email != blank or section.settings.support_email != blank -%}
        <div class="info-divider"></div>
        <div class="info-block">
          <h4 class="info-block-title">{{ section.settings.email_title }}</h4>
          <ul class="email-list">
            {%- if section.settings.official_email != blank -%}<li><span>{{ section.settings.official_email_label }}:</span> <a href="mailto:{{ section.settings.official_email }}" class="info-link">{{ section.settings.official_email }}</a></li>{%- endif -%}
            {%- if section.settings.marketing_email != blank -%}<li><span>{{ section.settings.marketing_email_label }}:</span> <a href="mailto:{{ section.settings.marketing_email }}" class="info-link">{{ section.settings.marketing_email }}</a></li>{%- endif -%}
            {%- if section.settings.support_email != blank -%}<li><span>{{ section.settings.support_email_label }}:</span> <a href="mailto:{{ section.settings.support_email }}" class="info-link">{{ section.settings.support_email }}</a></li>{%- endif -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if section.settings.show_social -%}
        <div class="info-divider"></div><div class="info-block"><h4 class="info-block-title">{{ section.settings.social_title }}</h4>{% render 'social-icons', additional_classes: 'footer__social' %}</div>
      {%- endif -%}

      {%- if section.settings.show_discord and section.settings.discord_url != blank -%}
        <div class="info-divider"></div><div class="info-block">
          <h4 class="info-block-title">{{ section.settings.discord_title }}</h4>
          <a target="_blank" rel="noopener" href="{{ section.settings.discord_url }}" class="discord-badge-link"><span class="discord-circle-icon" aria-hidden="true">Discord</span><span class="discord-text">{{ section.settings.discord_label }}</span></a>
        </div>
      {%- endif -%}

      {%- if section.settings.company_name != blank or section.settings.company_address != blank -%}
        <div class="info-divider"></div><div class="info-block">
          <h4 class="info-block-title">{{ section.settings.company_title }}</h4>
          {%- if section.settings.company_name != blank -%}<p class="company-intro">{{ section.settings.company_name }}</p>{%- endif -%}
          {%- if section.settings.company_address != blank -%}<p class="address-detail">{{ section.settings.company_address | newline_to_br }}</p>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
.piifox-contact-page-wrapper{max-width:1200px;margin:40px auto;padding:0 24px;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;color:#222}.piifox-contact-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:60px;align-items:start}.form-header-line{display:flex;align-items:center;margin-bottom:24px}.form-title{font-size:32px;font-weight:800;margin:0;white-space:nowrap}.form-group{margin-bottom:20px}.form-group label{display:block;font-size:14px;font-weight:700;color:#444;margin-bottom:6px;letter-spacing:.8px}.form-group input,.form-group textarea{width:100%;padding:12px 14px;border:1px solid #e0e0e0;border-radius:4px;font-size:14px;color:#333;outline:none;box-sizing:border-box;background:#fff}.form-group input:focus,.form-group textarea:focus{border-color:#111;box-shadow:0 0 0 1px #111}.privacy-agreement-text{font-size:13px;color:#666;line-height:1.5;margin-bottom:20px}.consent-checkbox-label{display:flex;align-items:flex-start;gap:8px;cursor:pointer}.consent-checkbox-label input{flex:0 0 auto;width:16px;height:16px;margin:2px 0 0}.consent-checkbox-label span{flex:1}.privacy-agreement-text p{margin:0}.privacy-agreement-text a{color:#0b6623;text-decoration:underline}.required-indicator{color:#b42318;font-weight:700}.contact-submit-btn{background:#111;color:#fff;border:0;padding:10px 32px;font-size:14px;font-weight:700;border-radius:4px;cursor:pointer}.contact-submit-btn:hover{opacity:.85}.form-status{padding:12px 16px;border-radius:4px;margin-bottom:20px;font-size:14px}.form-status--success{background:#f0fdf4;color:#166534;border:1px solid #bbf7d0}.form-status--error{background:#fef2f2;color:#991b1b;border:1px solid #fecaca}.contact-info-column{padding-left:50px;border-left:1px solid #f0f0f0;display:flex;flex-direction:column;justify-content:center;height:100%}.info-block-title{font-size:20px;font-weight:700;margin:0 0 8px;color:#111}.company-intro,.address-detail,.business-hours{font-size:14px;line-height:1.6;color:#555;margin:0}.company-intro{margin-bottom:8px}.info-divider{height:1px;background:#f0f0f0;margin:20px 0}.email-list{list-style:none;padding:0;margin:0}.email-list li{font-size:14px;line-height:1.8;color:#444}.info-link{color:#0b6623;text-decoration:underline}.discord-badge-link{display:inline-flex;align-items:center;gap:10px;text-decoration:none;margin-top:4px}.discord-circle-icon{display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;background:#5865F2;border-radius:50%;color:#fff;font-size:8px;font-weight:700}.discord-text{font-size:13px;color:#444;font-weight:500}@media(max-width:768px){.piifox-contact-grid{grid-template-columns:1fr;gap:40px}.contact-info-column{padding-left:0;border-left:0;border-top:1px solid #f0f0f0;padding-top:30px}}
</style>

{% schema %}
{
  "name":"Contact Us",
  "settings":[
    {"type":"text","id":"form_title","label":"Form title","default":"Submit a Contact Form:"},
    {"type":"text","id":"submit_label","label":"Submit button label","default":"Send"},
    {"type":"text","id":"success_message","label":"Success message","default":"Thanks for contacting us! We have received your message and will get back to you as soon as possible."},
    {"type":"text","id":"error_message","label":"Error message","default":"Please check the following errors:"},
    {"type":"checkbox","id":"show_privacy","label":"Show privacy consent","default":true},
    {"type":"richtext","id":"privacy_text","label":"Privacy consent text","default":"<p>By submitting this form, I agree to the privacy policy.</p>"},
    {"type":"header","content":"Contact information"},
    {"type":"text","id":"business_hours_title","label":"Business hours title","default":"Business Hours:"},
    {"type":"text","id":"business_hours","label":"Business hours","default":"Mon - Sat: 8 AM - 7 PM (PDT)"},
    {"type":"text","id":"email_title","label":"Email section title","default":"Email Us:"},
    {"type":"text","id":"official_email_label","label":"Official email label","default":"Official Email"},
    {"type":"text","id":"official_email","label":"Official email","default":"store@piifox.com"},
    {"type":"text","id":"marketing_email_label","label":"Marketing email label","default":"Marketing Email"},
    {"type":"text","id":"marketing_email","label":"Marketing email","default":"marketing@piifox.com"},
    {"type":"text","id":"support_email_label","label":"Support email label","default":"Support Email"},
    {"type":"text","id":"support_email","label":"Support email","default":"service@piifox.com"},
    {"type":"checkbox","id":"show_social","label":"Show social media","default":true},
    {"type":"text","id":"social_title","label":"Social media title","default":"Social Media:"},
    {"type":"checkbox","id":"show_discord","label":"Show Discord","default":true},
    {"type":"text","id":"discord_title","label":"Discord title","default":"Discord Group:"},
    {"type":"text","id":"discord_label","label":"Discord link label","default":"Join Discord"},
    {"type":"url","id":"discord_url","label":"Discord link","default":"https://discord.gg/xPd7mmjj6D"},
    {"type":"text","id":"company_title","label":"Company information title","default":"Our Address:"},
    {"type":"textarea","id":"company_name","label":"Company legal name","default":"PIIFOX is operated by Shenzhen Paishifu Technology Co, Ltd."},
    {"type":"textarea","id":"company_address","label":"Company detailed address","default":"Room 1210, Gangxinda Henggang Building, No. 5008 Longgang Avenue (Henggang Section), Songbai Community, Henggang Subdistrict, Longgang District, Shenzhen, Guangdong 518115, China"}
  ],
  "blocks":[{"type":"field","name":"Form field","settings":[
    {"type":"text","id":"label","label":"Field label","default":"Subject"},
    {"type":"text","id":"placeholder","label":"Placeholder","default":"Subject"},
    {"type":"text","id":"field_key","label":"Field name","default":"subject","info":"Use a unique name. The email field always uses contact[email]."},
    {"type":"select","id":"field_type","label":"Field type","default":"text","options":[{"value":"text","label":"Text"},{"value":"email","label":"Email"},{"value":"tel","label":"Phone"},{"value":"textarea","label":"Multiline text"}]},
    {"type":"checkbox","id":"required","label":"Required","default":false}
  ]}],
  "presets":[{"name":"Contact Us","blocks":[
    {"type":"field","settings":{"label":"Subject","placeholder":"Subject","field_key":"subject","field_type":"text","required":false}},
    {"type":"field","settings":{"label":"Email","placeholder":"your@email.com","field_key":"email","field_type":"email","required":true}},
    {"type":"field","settings":{"label":"Phone Number","placeholder":"Your phone number","field_key":"phone","field_type":"tel","required":false}},
    {"type":"field","settings":{"label":"Description","placeholder":"Please write your description or inquiry here","field_key":"body","field_type":"textarea","required":true}}
  ]}]
}
{% endschema %}
