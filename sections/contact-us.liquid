<div class="piifox-contact-page-wrapper">
  <div class="piifox-contact-grid">
    
    <!-- 左侧：表单区域 -->
    <div class="contact-form-column">
      <div class="form-header-line">
        <h2 class="form-title">Contact PIIFOX:</h2>
      </div>

      {% form 'contact' %}
        {%- if form.posted_successfully? -%}
          <div class="form-status form-status--success">
            <p>Thanks for contacting us! We have received your message and will get back to you as soon as possible.</p>
          </div>
        {%- elsif form.errors -%}
          <div class="form-status form-status--error">
            <p>Please check the following errors:</p>
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="form-group">
          <label for="ContactForm-name">NAME</label>
          <input 
            type="text" 
            id="ContactForm-name" 
            name="contact[Name]" 
            placeholder="Your name"
          >
        </div>

        <div class="form-group">
          <label for="ContactForm-email">EMAIL</label>
          <input 
            type="email" 
            id="ContactForm-email" 
            name="contact[email]" 
            placeholder="your@email.com" 
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            spellcheck="false"
            autocomplete="email"
            autocapitalize="off"
          >
        </div>

        <div class="form-group">
          <label for="ContactForm-phone">PHONE NUMBER</label>
          <input 
            type="tel" 
            id="ContactForm-phone" 
            name="contact[Phone]" 
            placeholder="Your phone number" 
            pattern="[0-9\-+() ]*"
          >
        </div>

        <div class="form-group">
          <label for="ContactForm-body">COMMENT</label>
          <textarea 
            rows="6" 
            id="ContactForm-body" 
            name="contact[body]" 
            placeholder="Please write your comment or inquiry here"
          >{% if form.body %}{{ form.body }}{% endif %}</textarea>
        </div>

        <!-- 隐私政策提示 -->
        <div class="privacy-agreement-text">
          By submitting this form, you agree to our 
          <a href="/pages/privacy-policy" class="privacy-link" target="_blank">Privacy Policy</a>.
        </div>

        <div class="form-action">
          <button type="submit" class="contact-submit-btn">Send</button>
        </div>
      {% endform %}
    </div>

    <!-- 右侧：企业与联系信息区域 -->
    <div class="contact-info-column">
      
      <!-- 公司主体与地址 -->
      <div class="info-block">
        <h4 class="info-block-title">Our Address:</h4>
        <p class="company-intro">PIIFOX is operated by <strong>Shenzhen Paishifu Technology Co, Ltd.</strong></p>
        <p class="address-detail">
          Room 1210, Gangxinda Henggang Building, No. 5008 Longgang Avenue (Henggang Section), Songbai Community, Henggang Subdistrict, Longgang District, Shenzhen, Guangdong 518115, China
        </p>
      </div>

      <div class="info-divider"></div>

      <!-- 营业时间 -->
      <div class="info-block">
        <h4 class="info-block-title">Customer Support Hours:</h4>
        <p class="business-hours">Mon - Sat: <strong>8 AM - 7 PM (PDT)</strong></p>
      </div>

      <div class="info-divider"></div>

      <!-- 官方邮箱列表 -->
      <div class="info-block">
        <h4 class="info-block-title">Email Us:</h4>
        <ul class="email-list">
          <li>
            <span>Official Email:</span>
            <a href="mailto:store@piifox.com" class="info-link">store@piifox.com</a>
          </li>
          <li>
            <span>Marketing Email:</span>
            <a href="mailto:marketing@piifox.com" class="info-link">marketing@piifox.com</a>
          </li>
          <li>
            <span>Support Email:</span>
            <a href="mailto:service@piifox.com" class="info-link">service@piifox.com</a>
          </li>
        </ul>
      </div>

    </div>

  </div>
</div>

<style>
/* 容器与网格布局 */
.piifox-contact-page-wrapper {
  max-width: 1200px;
  margin: 40px auto;
  padding: 0 24px;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  color: #222;
}

.piifox-contact-grid {
  display: grid;
  grid-template-columns: 1.25fr 0.75fr;
  gap: 60px;
  align-items: start;
}

/* 左侧标题 */
.form-header-line {
  display: flex;
  align-items: center;
  margin-bottom: 24px;
}
.form-title {
  font-size: 32px;
  font-weight: 800;
  margin: 0;
  white-space: nowrap;
  letter-spacing: -0.5px;
}

/* 表单输入控件 */
.form-group {
  margin-bottom: 20px;
}
.form-group label {
  display: block;
  font-size: 14px;
  font-weight: 700;
  color: #444;
  margin-bottom: 6px;
  letter-spacing: 0.8px;
}
.form-group input,
.form-group textarea {
  width: 100%;
  padding: 12px 14px;
  border: 1px solid #e0e0e0;
  border-radius: 4px;
  font-size: 14px;
  color: #333;
  outline: none;
  box-sizing: border-box;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
  background: #fff;
}
.form-group input:focus,
.form-group textarea:focus {
  border-color: #111;
  box-shadow: 0 0 0 1px #111;
}

/* 隐私政策提示语与高亮跳转 */
.privacy-agreement-text {
  font-size: 13px;
  color: #666;
  line-height: 1.5;
  margin-bottom: 20px;
}
.privacy-link {
  color: #0b6623; /* 品牌绿或强调色 */
  text-decoration: underline;
  text-underline-offset: 3px;
  font-weight: 600;
  transition: all 0.2s ease;
}
.privacy-link:hover {
  color: #000;
  background-color: #e8f5e9;
  padding: 2px 4px;
  border-radius: 3px;
  text-decoration: none;
}
.privacy-link:active {
  color: #054116;
}

/* 提交按钮 */
.contact-submit-btn {
  background-color: #111;
  color: #fff;
  border: none;
  padding: 10px 32px;
  font-size: 14px;
  font-weight: 700;
  border-radius: 4px;
  cursor: pointer;
  transition: opacity 0.2s ease, transform 0.1s ease;
}
.contact-submit-btn:hover {
  opacity: 0.85;
}
.contact-submit-btn:active {
  transform: scale(0.98);
}

/* 状态提示 */
.form-status {
  padding: 12px 16px;
  border-radius: 4px;
  margin-bottom: 20px;
  font-size: 14px;
}
.form-status--success {
  background-color: #f0fdf4;
  color: #166534;
  border: 1px solid #bbf7d0;
}
.form-status--error {
  background-color: #fef2f2;
  color: #991b1b;
  border: 1px solid #fecaca;
}

/* 右侧信息栏 */
.contact-info-column {
  padding-left: 50px;
  border-left: 1px solid #f0f0f0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 100%;
}
.info-block-title {
  font-size: 22px;
  font-weight: 700;
  margin: 0 0 10px 0;
  color: #111;
}
.company-intro {
  font-size: 16px;
  line-height: 1.5;
  margin: 0 0 8px 0;
  color: #444;
}
.address-detail,
.business-hours {
  font-size: 16px;
  line-height: 1.6;
  color: #555;
  margin: 0;
}
.info-divider {
  height: 1px;
  background-color: #f0f0f0;
  margin: 20px 0;
}

/* 邮箱列表 */
.email-list {
  list-style: none;
  padding: 0;
  margin: 0;
}
.email-list li {
  font-size: 16px;
  line-height: 1.8;
  color: #444;
}
.info-link {
  color: #0b6623;
  text-decoration: underline;
  text-underline-offset: 2px;
  font-weight: 500;
  transition: all 0.2s ease;
}
.info-link:hover {
  color: #000;
  background-color: #e8f5e9;
  padding: 1px 3px;
  border-radius: 2px;
  text-decoration: none;
}

/* 移动端自适应 */
@media (max-width: 768px) {
  .piifox-contact-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .contact-info-column {
    padding-left: 0;
    border-left: none;
    border-top: 1px solid #f0f0f0;
    padding-top: 30px;
  }
}
</style>