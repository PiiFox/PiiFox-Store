<div class="piifox-contact-page-wrapper">
  <div class="piifox-contact-grid">
    
    <!-- 左侧：表单区域 -->
    <div class="contact-form-column">
      <div class="form-header-line">
        <h2 class="form-title">Submit a Contact Form:</h2>
      </div>

      {% form 'contact' %}
        {%- if form.posted_successfully? -%}
          <div class="form-status form-status--success">
            <p>Thanks for contacting us! We have received your message and will get back to you as soon as possible.</p>
          </div>
        {%- elsif form.errors -%}
          <div class="form-status form-status--error">
            <p>Please check the following errors:</p>
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="form-group">
          <label for="ContactForm-subject">SUBJECT</label>
          <input 
            type="text" 
            id="ContactForm-subject"
            name="contact[subject]"
            placeholder="Subject"
            value="{% if form.subject %}{{ form.subject }}{% endif %}"
          >
        </div>

        <div class="form-group">
          <label for="ContactForm-email">EMAIL <span class="required-indicator" aria-hidden="true">*</span></label>
          <input 
            type="email" 
            id="ContactForm-email" 
            name="contact[email]" 
            placeholder="your@email.com" 
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            required
            aria-required="true"
            spellcheck="false"
            autocomplete="email"
            autocapitalize="off"
          >
        </div>

        <div class="form-group">
          <label for="ContactForm-phone">PHONE NUMBER</label>
          <input 
            type="tel" 
            id="ContactForm-phone" 
            name="contact[Phone]" 
            placeholder="Your phone number" 
            pattern="[0-9\-+() ]*"
          >
        </div>

        <div class="form-group">
          <label for="ContactForm-body">DESCRIPTION <span class="required-indicator" aria-hidden="true">*</span></label>
          <textarea 
            rows="6" 
            id="ContactForm-body" 
            name="contact[body]" 
            placeholder="Please write your description or inquiry here"
            required
            aria-required="true"
          >{% if form.body %}{{ form.body }}{% endif %}</textarea>
        </div>

        <!-- 隐私政策提示 -->
        <div class="privacy-agreement-text">
          <label class="consent-checkbox-label" for="ContactForm-consent">
            <input type="checkbox" id="ContactForm-consent" name="contact[consent]" value="true" required aria-required="true">
            <span>By submitting this form I agree to the <a href="https://www.bluettipower.com/pages/terms-conditions" class="privacy-link" target="_blank" rel="noopener">terms</a> of <a href="https://www.bluettipower.com/pages/privacy-policy" class="privacy-link" target="_blank" rel="noopener">privacy policy</a>. I am giving express written consent to receive emails and/or telephone calls including mobile from or on behalf of <a href="http://piifox.com" class="privacy-link" target="_blank" rel="noopener">piifox.com</a>. <span class="required-indicator" aria-hidden="true">*</span></span>
          </label>
        </div>

        <div class="form-action">
          <button type="submit" class="contact-submit-btn">Send</button>
        </div>
      {% endform %}
    </div>

    <!-- 右侧：企业与联系信息区域 -->
    <div class="contact-info-column">

      <!-- 营业时间 -->
      <div class="info-block">
        <h4 class="info-block-title">Business Hours:</h4>
        <p class="business-hours">Mon - Sat: <strong>8 AM - 7 PM (PDT)</strong></p>
      </div>

      <div class="info-divider"></div>

      <!-- 官方邮箱列表 -->
      <div class="info-block">
        <h4 class="info-block-title">Email Us:</h4>
        <ul class="email-list">
          <li>
            <span>Official Email:</span>
            <a href="mailto:store@piifox.com" class="info-link">store@piifox.com</a>
          </li>
          <li>
            <span>Marketing Email:</span>
            <a href="mailto:marketing@piifox.com" class="info-link">marketing@piifox.com</a>
          </li>
          <li>
            <span>Support Email:</span>
            <a href="mailto:service@piifox.com" class="info-link">service@piifox.com</a>
          </li>
        </ul>
      </div>

      <!-- 社交媒体 -->
      <div class="info-divider"></div>

      <div class="info-block">
        <h4 class="info-block-title">Social Media:</h4>
        {% render 'social-icons', additional_classes: 'footer__social' %}
      </div>

      <!-- discord -->
      <div class="info-divider"></div>

      <div class="info-block">
        <h4 class="info-block-title">Discord Group:</h4>
        <a target="_blank" rel="noopener" href="https://discord.gg/xPd7mmjj6D" title="{{ 'layout.footer.social_platform' | t: name: shop.name, platform: 'Discord' }}" class="discord-badge-link">
          <span class="discord-circle-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#ffffff" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" role="presentation">
              <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
            </svg>
          </span>
          <span class="discord-text">Join Discord</span>
        </a>
      </div>

      <div class="info-divider"></div>
      
      <!-- 公司主体与地址 -->
      <div class="info-block">
        <h4 class="info-block-title">Our Address:</h4>
        <p class="company-intro">PIIFOX is operated by <strong>Shenzhen Paishifu Technology Co, Ltd.</strong></p>
        <p class="address-detail">
          Room 1210, Gangxinda Henggang Building, No. 5008 Longgang Avenue (Henggang Section), Songbai Community, Henggang Subdistrict, Longgang District, Shenzhen, Guangdong 518115, China
        </p>
      </div>

    </div>

  </div>
</div>

<style>
/* 容器与网格布局 */
.piifox-contact-page-wrapper {
  max-width: 1200px;
  margin: 40px auto;
  padding: 0 24px;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  color: #222;
}

.piifox-contact-grid {
  display: grid;
  grid-template-columns: 1.25fr 0.75fr;
  gap: 60px;
  align-items: start;
}

/* 左侧标题 */
.form-header-line {
  display: flex;
  align-items: center;
  margin-bottom: 24px;
}
.form-title {
  font-size: 32px;
  font-weight: 800;
  margin: 0;
  white-space: nowrap;
  letter-spacing: -0.5px;
}

/* 表单输入控件 */
.form-group {
  margin-bottom: 20px;
}
.form-group label {
  display: block;
  font-size: 14px;
  font-weight: 700;
  color: #444;
  margin-bottom: 6px;
  letter-spacing: 0.8px;
}
.form-group input,
.form-group textarea {
  width: 100%;
  padding: 12px 14px;
  border: 1px solid #e0e0e0;
  border-radius: 4px;
  font-size: 14px;
  color: #333;
  outline: none;
  box-sizing: border-box;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
  background: #fff;
}
.form-group input:focus,
.form-group textarea:focus {
  border-color: #111;
  box-shadow: 0 0 0 1px #111;
}

/* 隐私政策提示语与高亮跳转 */
.privacy-agreement-text {
  font-size: 13px;
  color: #666;
  line-height: 1.5;
  margin-bottom: 20px;
}
.consent-checkbox-label {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  cursor: pointer;
}
.consent-checkbox-label input[type="checkbox"] {
  flex: 0 0 auto;
  width: 16px;
  height: 16px;
  margin: 2px 0 0;
}
.consent-checkbox-label span {
  flex: 1;
}
.required-indicator {
  color: #b42318;
  font-weight: 700;
}
.privacy-link {
  color: #0b6623; /* 品牌绿或强调色 */
  text-decoration: underline;
  text-underline-offset: 3px;
  font-weight: 600;
  transition: all 0.2s ease;
}
.privacy-link:hover {
  color: #000;
  background-color: #e8f5e9;
  padding: 2px 4px;
  border-radius: 3px;
  text-decoration: none;
}
.privacy-link:active {
  color: #054116;
}

/* 提交按钮 */
.contact-submit-btn {
  background-color: #111;
  color: #fff;
  border: none;
  padding: 10px 32px;
  font-size: 14px;
  font-weight: 700;
  border-radius: 4px;
  cursor: pointer;
  transition: opacity 0.2s ease, transform 0.1s ease;
}
.contact-submit-btn:hover {
  opacity: 0.85;
}
.contact-submit-btn:active {
  transform: scale(0.98);
}

/* 状态提示 */
.form-status {
  padding: 12px 16px;
  border-radius: 4px;
  margin-bottom: 20px;
  font-size: 14px;
}
.form-status--success {
  background-color: #f0fdf4;
  color: #166534;
  border: 1px solid #bbf7d0;
}
.form-status--error {
  background-color: #fef2f2;
  color: #991b1b;
  border: 1px solid #fecaca;
}

/* 右侧信息栏 */
.contact-info-column {
  padding-left: 50px;
  border-left: 1px solid #f0f0f0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 100%;
}
.info-block-title {
  font-size: 20px;
  font-weight: 700;
  margin: 0 0 8px 0;
  color: #111;
}
.company-intro {
  font-size: 14px;
  line-height: 1.5;
  margin: 0 0 8px 0;
  color: #444;
}
.address-detail,
.business-hours {
  font-size: 14px;
  line-height: 1.6;
  color: #555;
  margin: 0;
}
.info-divider {
  height: 1px;
  background-color: #f0f0f0;
  margin: 20px 0;
}

/* 邮箱列表 */
.email-list {
  list-style: none;
  padding: 0;
  margin: 0;
}
.email-list li {
  font-size: 14px;
  line-height: 1.8;
  color: #444;
}
.info-link {
  color: #0b6623;
  text-decoration: underline;
  text-underline-offset: 2px;
  font-weight: 500;
  transition: all 0.2s ease;
}
.info-link:hover {
  color: #000;
  background-color: #e8f5e9;
  padding: 1px 3px;
  border-radius: 2px;
  text-decoration: none;
}

.discord-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #444;
  transition: color 0.2s ease;
}

.discord-badge-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  margin-top: 4px;
}

.discord-circle-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  background-color: #5865F2;
  border-radius: 50%;
  transition: all 0.2s ease;
  box-shadow: 0 2px 5px rgba(88, 101, 242, 0.3);
}

.discord-text {
  font-size: 13px;
  color: #444;
  font-weight: 500;
  transition: color 0.2s ease;
}

.piifox-contact-page-wrapper .item-discord {
  display: none !important;
}

/* 移动端自适应 */
@media (max-width: 768px) {
  .piifox-contact-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .contact-info-column {
    padding-left: 0;
    border-left: none;
    border-top: 1px solid #f0f0f0;
    padding-top: 30px;
  }
}
</style>
