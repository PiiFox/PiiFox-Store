<div class="custom-contact-form-wrapper">
  <div class="custom-contact-container">
    <h2 class="form-title">Contact Us</h2>

    {% form 'contact' %}
      {%- if form.posted_successfully? -%}
        <div class="form-status form-status--success">
          <p>Thanks for contacting us! We have received your message and will get back to you as soon as possible.</p>
        </div>
      {%- elsif form.errors -%}
        <div class="form-status form-status--error">
          <p>Please fix the following errors before submitting:</p>
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="form-fields">
        <!-- Full Name -->
        <div class="field-item">
          <label for="ContactForm-name">Full Name</label>
          <input 
            type="text" 
            id="ContactForm-name" 
            name="contact[Name]" 
            placeholder="Your full name"
          >
        </div>

        <!-- Email -->
        <div class="field-item">
          <label for="ContactForm-email">Email <span class="required">*</span></label>
          <input 
            type="email" 
            id="ContactForm-email" 
            name="contact[email]" 
            placeholder="your@email.com" 
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            spellcheck="false"
            autocomplete="email"
            autocapitalize="off"
            required
          >
        </div>

        <!-- Phone Number -->
        <div class="field-item">
          <label for="ContactForm-phone">Phone Number</label>
          <input 
            type="tel" 
            id="ContactForm-phone" 
            name="contact[Phone]" 
            placeholder="Your phone number" 
            pattern="[0-9\-+() ]*"
          >
        </div>

        <!-- Message -->
        <div class="field-item">
          <label for="ContactForm-body">Message</label>
          <textarea 
            rows="6" 
            id="ContactForm-body" 
            name="contact[body]" 
            placeholder="How can we help you? Please provide as much detail as possible..."
          >{% if form.body %}{{ form.body }}{% endif %}</textarea>
        </div>

        <!-- Submit Button -->
        <div class="field-item">
          <button type="submit" class="submit-btn">Send Message</button>
        </div>
      </div>
    {% endform %}
  </div>
</div>

<style>
.custom-contact-form-wrapper {
  max-width: 700px;
  margin: 40px auto;
  padding: 0 20px;
}
.custom-contact-container .form-title {
  font-size: 28px;
  font-weight: 700;
  margin-bottom: 24px;
  text-align: center;
  color: #111;
}
.form-fields {
  display: flex;
  flex-direction: column;
  gap: 18px;
}
.field-item {
  display: flex;
  flex-direction: column;
}
.field-item label {
  font-size: 14px;
  font-weight: 500;
  margin-bottom: 6px;
  color: #333;
}
.field-item label .required {
  color: #e53e3e;
}
.field-item input,
.field-item textarea {
  width: 100%;
  padding: 12px 16px;
  border: 1px solid #e2e8f0;
  border-radius: 6px;
  font-size: 14px;
  outline: none;
  box-sizing: border-box;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.field-item input:focus,
.field-item textarea:focus {
  border-color: #111;
}
.submit-btn {
  background-color: #111;
  color: #fff;
  border: none;
  padding: 14px 28px;
  font-size: 16px;
  font-weight: 600;
  border-radius: 6px;
  cursor: pointer;
  transition: background-color 0.2s, opacity 0.2s;
  width: 100%;
}
.submit-btn:hover {
  background-color: #333;
}
.form-status {
  padding: 14px 18px;
  border-radius: 6px;
  margin-bottom: 20px;
  font-size: 14px;
  line-height: 1.5;
}
.form-status--success {
  background-color: #f0fdf4;
  color: #166534;
  border: 1px solid #bbf7d0;
}
.form-status--error {
  background-color: #fef2f2;
  color: #991b1b;
  border: 1px solid #fecaca;
}
.form-status ul {
  margin: 8px 0 0 0;
  padding-left: 20px;
}
</style>