{%- style -%}
  #product-review {
    margin-top: 0;
    padding-top: 0;
    margin-bottom: 3em;
  }
  .product-faq-list--wrapper {
    padding-bottom: 1.5em;
  }
{%- endstyle -%}

<div id="product-review" class="Reviews filter-item" data-snippet="Reviews">
  {%- unless section.settings.full_width -%}
    <div class="page-width">
  {%- endunless -%}

  {%- for block in section.blocks -%}
    {% render block %}
  {%- endfor -%}

  {%- unless section.settings.full_width -%}
    </div>
  {%- endunless -%}
</div>

{% schema %}
{
  "name": "t:sections.apps.name",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.apps.settings.full_width.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "space_around",
      "label": "t:sections.apps.settings.space_around.label",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.apps.presets.apps.name"
    }
  ]
}
{% endschema %}
