{%- liquid
  assign show_section = false
  if section.settings.show_on_all
    assign show_section = true
  elsif template contains 'collection' or request.page_type == 'collection'
    if section.settings.show_on_collection
      assign show_section = true
    endif
  elsif template contains 'product' or request.page_type == 'product'
    if section.settings.show_on_product
      assign show_section = true
    endif
  elsif template == 'index' or request.page_type == 'index'
    if section.settings.show_on_home
      assign show_section = true
    endif
  else
    if section.settings.show_on_other
      assign show_section = true
    endif
  endif
-%}

{%- if show_section -%}
<div class="shop-confidence-section-{{ section.id }}">
  <div class="shop-confidence-section--wrapper page-width wow bounceInUp">
    <div class="shop-confidence-section-header">
        <h2 class="shop-confidence-section-title custom-txt-bold appear-delay{% cycle '','-1','-2','-3','-4' %}">
          {{ section.settings.shop_confidence_title | default: 'Shop With Confidence' }}
        </h2>
        <div class="shop-confidence-section-description appear-delay{% cycle '','-1','-2','-3','-4' %}">
          {{ section.settings.shop_confidence_description | default: 'Premium quality. Reliable service. Every step of the way.' }}
        </div>
    </div>
    
    <div class="shop-confidence-section-content swiper-container">
      <div class="swiper-wrapper">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            <div class="swiper-slide swiper-slide-{{ block.id }}" {{ block.shopify_attributes }}>
              <div class="service-item {% if forloop.last %}last-item{% endif %}">
                {% if block.settings.service_img %}
                  <img
                    src="{{ block.settings.service_img | image_url: width: 200 }}"
                    alt="{{ block.settings.service_title | escape }}"
                    width="200"
                    height="200"
                    loading="lazy"
                  >
                {% else %}
                  {%- capture current -%}{% cycle 1, 2, 3, 4, 5, 6 %}{%- endcapture -%}
                  {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
                <h3 class="service-item-title custom-txt-semibold appear-delay{% cycle '','-1','-2','-3','-4' %}">
                  {{ block.settings.service_title | escape | newline_to_br }}
                </h3>
                <div class="service-item-description custom-txt-light appear-delay{% cycle '','-1','-2','-3','-4' %}">
                  {{ block.settings.service_description }}
                </div>
              </div>
            </div>
          {% endfor %}
        {% else %}
          {%- comment -%} 兜底保障：当后台尚未添加 blocks 时默认渲染设计稿 4 大服务承诺 {%- endcomment -%}
          <div class="swiper-slide swiper-slide-fallback-1">
            <div class="service-item">
              <img src="{{ 'footer-icon1_1c7e0e71-312c-45ba-841d-143686c63e07.png' | file_img_url: '200x' }}" alt="Secure & Fast Delivery" width="200" height="200" loading="lazy">
              <h3 class="service-item-title custom-txt-semibold">Secure &amp; Fast<br>Delivery</h3>
              <div class="service-item-description custom-txt-light">Fast, secure shipping you can count on.</div>
            </div>
          </div>
          <div class="swiper-slide swiper-slide-fallback-2">
            <div class="service-item">
              <img src="{{ 'footer-icon2_ae165278-8567-4f3a-ad49-e2c526c8498b.png' | file_img_url: '200x' }}" alt="1-Year Free Warranty" width="200" height="200" loading="lazy">
              <h3 class="service-item-title custom-txt-semibold">1-Year Free<br>Warranty</h3>
              <div class="service-item-description custom-txt-light">All PIIFOX keyboards come with a 1-year limited warranty.</div>
            </div>
          </div>
          <div class="swiper-slide swiper-slide-fallback-3">
            <div class="service-item">
              <img src="{{ 'footer-icon3_8076622e-27c0-49a3-aa04-a93ddb8e6477.png' | file_img_url: '200x' }}" alt="Hassle-Free Returns" width="200" height="200" loading="lazy">
              <h3 class="service-item-title custom-txt-semibold">Hassle-Free<br>Returns</h3>
              <div class="service-item-description custom-txt-light">Simple &amp; Transparent Return Process</div>
            </div>
          </div>
          <div class="swiper-slide swiper-slide-fallback-4">
            <div class="service-item last-item">
              <img src="{{ 'footer-icon4_ec25736e-ddc5-4aee-9832-defeb336309e.png' | file_img_url: '200x' }}" alt="Customer Support" width="200" height="200" loading="lazy">
              <h3 class="service-item-title custom-txt-semibold">Customer<br>Support</h3>
              <div class="service-item-description custom-txt-light">Multiple Support Options &amp; Fast Response.</div>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
<script>
(function() {
  function initServiceSwiper() {
    const swiperSelector = '.shop-confidence-section-{{ section.id }} .swiper-container';
    const container = document.querySelector(swiperSelector);
    if (!container || typeof Swiper === 'undefined') return;

    if (container.swiper) {
      try { container.swiper.destroy(true, true); } catch(e) {}
    }

    let isScroll = window.innerWidth < 1600;
    new Swiper(swiperSelector, {
      loop: isScroll,
      autoplay: isScroll ? { delay: 3500, disableOnInteraction: false } : false,
      allowTouchMove: isScroll,
      centeredSlides: isScroll,
      spaceBetween: isScroll ? 40 : 0,
      breakpoints: {
        0: { slidesPerView: 1.2 },
        768: { slidesPerView: 2 },
        1200: { slidesPerView: 3 },
        1600: { slidesPerView: 4 }
      }
    });
  }

  let resizeTimer;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(initServiceSwiper, 400);
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initServiceSwiper);
  } else {
    initServiceSwiper();
  }

  document.addEventListener('shopify:section:load', function(e) {
    if (e.target && e.target.querySelector && e.target.querySelector('.shop-confidence-section-{{ section.id }}')) {
      initServiceSwiper();
    }
  });
})();
</script>
{% style %}
  .shop-confidence-section-{{ section.id }} {
      background-color: #fff;
      padding: 4em 0;
  }
  .shop-confidence-section-{{ section.id }} .shop-confidence-section--wrapper {
      padding: 2em;
      display: grid;
      grid-template-columns: 1fr 4fr;
      grid-gap: 2em;
      border-radius: 1em;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
  }
  .shop-confidence-section-{{ section.id }} .shop-confidence-section--wrapper .shop-confidence-section-header {
      display: flex;
      flex-direction: column;
      justify-content: center;
      text-align: left;
  }
  .shop-confidence-section-{{ section.id }} .shop-confidence-section--wrapper .shop-confidence-section-title {
      font-size: 2em;
      font-weight: bold;
      padding-bottom: 0.5em;
      position: relative;
  }
  .shop-confidence-section-{{ section.id }} .shop-confidence-section--wrapper .shop-confidence-section-title::before {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 2em;
      height: 0.2em;
      background: var(--colorThemePrimary);
      border-radius: 1em;
  }
  .shop-confidence-section-{{ section.id }} .shop-confidence-section--wrapper .shop-confidence-section-title::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 2.5em;
      width: 0.2em;
      height: 0.2em;
      background: var(--colorThemePrimary);
      border-radius: 1em;
  }
  .shop-confidence-section-{{ section.id }} .shop-confidence-section--wrapper .shop-confidence-section-description {
      font-size: 1.2em;
      margin-bottom: 2em;
      color: #95979b;
  }
  .shop-confidence-section-{{ section.id }} .shop-confidence-section--wrapper .shop-confidence-section-content {
      width: 100%;
      margin: 0 auto;
      overflow: hidden;
      position: relative;
  }
  .shop-confidence-section-{{ section.id }} .swiper-container {
      height: 100%;
      position: relative;
  }
  .shop-confidence-section-{{ section.id }} .swiper-wrapper{
      height: 100%;
      position: relative;
      align-items: stretch;
  }
  .shop-confidence-section-{{ section.id }} .shop-confidence-section--wrapper .swiper-slide {
      height: 100%;
      display: flex;
      padding: 1em 0;
  }
  .shop-confidence-section-{{ section.id }} .swiper-slide .service-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 0 1em;
      border-right: 1px solid #f5f5f5;
  }
  .shop-confidence-section-{{ section.id }} .swiper-slide .service-item.last-item {
      border-right: 0;
  }
  .shop-confidence-section-{{ section.id }} .swiper-slide .service-item img,
  .shop-confidence-section-{{ section.id }} .swiper-slide .service-item svg {
      width: unset;
      height: 5em;
      /* aspect-ratio: 1/1; */
      object-fit: contain;
      margin-bottom: 1em;
  }
  .shop-confidence-section-{{ section.id }} .swiper-slide .service-item .service-title {
      font-size: 1.6em;
      font-weight: 500;
      margin-bottom: 1em;
  }
  .shop-confidence-section-{{ section.id }} .swiper-slide .service-item .service-description {
      font-size: 1em;
      color: #95979b;
  }

  /* 初始状态：所有 Swiper 容器隐藏，避免出现未格式化布局 */
  .shop-confidence-section-{{ section.id }} .swiper-container {
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  /* Swiper 初始化完成后显示 */
  .shop-confidence-section-{{ section.id }} .swiper-container.swiper-initialized {
    visibility: visible;
    opacity: 1;
  }

  @media screen and (max-width: 1700px) {
    .shop-confidence-section-{{ section.id }} .shop-confidence-section--wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        border-radius: 0;
        box-shadow: none;
    }
    .shop-confidence-section-{{ section.id }} .shop-confidence-section--wrapper .shop-confidence-section-header  {
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .shop-confidence-section-{{ section.id }} .shop-confidence-section--wrapper .shop-confidence-section-title {
        width: max-content;
    }
    .shop-confidence-section-{{ section.id }} .shop-confidence-section--wrapper .shop-confidence-section-title::before {
        left: calc(50% - 0.8em);
        transform: translateX(-50%);
    }
    .shop-confidence-section-{{ section.id }} .shop-confidence-section--wrapper .shop-confidence-section-title::after {
        left: calc(50% + 0.8em);
        transform: translateX(-50%);
    }
    .shop-confidence-section-{{ section.id }} .shop-confidence-section--wrapper .shop-confidence-section-content {}
    .shop-confidence-section-{{ section.id }} .shop-confidence-section--wrapper .swiper-slide {
        position: relative;
        width: 100%;
        height: 20em;
    }
    .shop-confidence-section-{{ section.id }} .swiper-slide .service-item {
        width: 100%;
        height: 100%;
        padding: 4em 2em ;
        border-radius: 1em;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .shop-confidence-section-{{ section.id }} .swiper-slide-active .service-item {
        transform: scale(1.08);
    }
    
  }

  @media screen and (max-width: 768px) {
      .shop-confidence-section-{{ section.id }} {
          font-size: 0.9em;
      }
  }
{% endstyle %}
{%- endif -%}

{% schema %}
{
  "name": "Shop With Confidence",
  "class": "shop-confidence-section",
  "settings": [
    {
      "type": "text",
      "id": "shop_confidence_title",
      "label": "Title",
      "default": "Shop With Confidence"
    },
    {
      "type": "text",
      "id": "shop_confidence_description",
      "label": "Description",
      "default": "Premium quality. Reliable service. Every step of the way."
    },
    {
      "type": "header",
      "content": "Page Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_on_all",
      "label": "Show on All Pages",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_on_collection",
      "label": "Show on Collection Pages",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_product",
      "label": "Show on Product Pages",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_home",
      "label": "Show on Homepage",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_on_other",
      "label": "Show on Other Pages",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "service_item",
      "name": "Service Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "service_img",
          "label": "Service Image"
        },
        {
          "type": "textarea",
          "id": "service_title",
          "label": "Service Title"
        },
        {
          "type": "text",
          "id": "service_description",
          "label": "Service Description"
        }
      ]
    }
  ]
}
{% endschema %}
