<div class="policy-page policy-page-{{ section.id }}">
    <div class="policy-page-content page-width page-width--narrow">
        {%- capture policy_body -%}
            {% case page.handle %}
                {% when 'privacy-policy' %}
                    {{ shop.privacy_policy.body }}
                {% when 'shipping-policy' %}
                    {{ shop.shipping_policy.body }}
                {% when 'warranty-return-policy', 'return-refund-policy', 'refund-policy', 'return-and-refund-policy' %}
                    {{ shop.refund_policy.body }}
                {% when 'terms-of-service' %}
                    {{ shop.terms_of_service.body }}
            {% endcase %}   
        {%- endcapture -%}

        {%- if policy_body contains '.warranty-container {' and policy_body contains '<div class="warranty-container">' and policy_body contains '<style>' == false -%}
            {%- assign parts = policy_body | split: '<div class="warranty-container">' -%}
            <style>
                {{ parts[0] }}
            </style>
            <div class="warranty-container">
                {{ parts[1] }}
            </div>
        {%- else -%}
            {{ policy_body }}
        {%- endif -%}
    </div>
</div>

{% if page.handle == 'shipping-policy' %}
    <style>
        body.template-page {
            padding: 0;
        }

        .policy-page-{{ section.id }} .policy-page-content {
            padding: 37px;
        }
    </style>
{% endif %}
