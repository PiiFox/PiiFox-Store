<div class="join-us-section-{{ section.id }} wow bounceInLeft">
  <div class="join-us-section--wrapper page-width">
    <h2 class="join-us-section-title custom-txt-bold appear-delay{% cycle '','-1','-2','-3','-4' %}"></h2>
    <div class="join-us-section--content">
      <div class="join-us-section--content--left">
        <img
          src="{{ section.settings.joinus_image | image_url }}"
          width="{{ section.settings.joinus_image.width }}"
          height="{{ section.settings.joinus_image.height }}"
          alt="{{ section.settings.joinus_image.alt | escape }}"
          loading="lazy"
        >
      </div>
      <div class="join-us-section--content--right">
        <p class="join-us-section--content--right-subtitle custom-txt-Oxanium appear-delay{% cycle '','-1','-2','-3','-4' %}">
          {{ section.settings.sub_title }}
        </p>
        <h3 class="join-us-section--content--right-title custom-txt-Oxanium appear-delay{% cycle '','-1','-2','-3','-4' %}">
          {{ section.settings.banner_title }}
        </h3>
        <p class="join-us-section--content--right-context custom-txt-normal appear-delay{% cycle '','-1','-2','-3','-4' %}">
          {{ section.settings.context }}
        </p>
        {% if section.settings.btn_label != blank %}
          {%- assign btn_label_down = section.settings.btn_label | downcase -%}
          {%- assign btn_link_down = section.settings.btn_link | downcase -%}
          <a
            href="{{ section.settings.btn_link }}"
            class="join-us-section--content--right-btn custom-txt-Oxanium appear-delay{% cycle '','-1','-2','-3','-4' %}"
          >
            <span>{{ section.settings.btn_label }}</span>
            {%- if btn_label_down contains 'discord' or btn_link_down contains 'discord' -%}
              <svg class="join-us-section__btn-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" role="presentation">
                <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z" fill="currentColor"></path>
              </svg>
            {%- endif -%}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% style %}
    .join-us-section-{{ section.id }} {
        background-color: #fff;
        padding: 0 0 4em 0;
    }
    .join-us-section-{{ section.id }} .join-us-section--content {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        align-items: center;
        border-radius: 1em;
    }
    .join-us-section-{{ section.id }} .join-us-section--content--left {
        padding-right: 1em;
        border-right: 1px solid #eee;
    }
    .join-us-section-{{ section.id }} .join-us-section--content--left img {
        width: 100%;
        height: auto;
        border-radius: 1em 0 0 1em;
    }
    .join-us-section-{{ section.id }} .join-us-section--content--right {
        padding-left: 1em;
    }
    .join-us-section-{{ section.id }} .join-us-section--content--right-title {
        font-size: 3.5em;
        font-weight: 900;
        margin-bottom: 0em;
    }
    .join-us-section-{{ section.id }} .join-us-section--content--right-subtitle {
        font-size: 2em;
        color: #888;
        margin-bottom: 0.5em;
    }
    .join-us-section-{{ section.id }} .join-us-section--content--right-context {
        font-size: 1.2em;
        color: #555;
        margin-bottom: 2em;
    }
    .join-us-section-{{ section.id }} .join-us-section--content--right-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6em;
        font-size: 1.4em;
        font-weight: 600;
        line-height: 1.2;
        padding: 0.7em 1.75em;
        color: {{ section.settings.btn_text_color | default: '#ffffff' }};
        background-color: {{ section.settings.btn_bg_color | default: '#000000' }};
        border-radius: 9999px;
        text-decoration: none;
        transition: all 0.3s ease-in-out;
    }
    .join-us-section-{{ section.id }} .join-us-section--content--right-btn:hover,
    .join-us-section-{{ section.id }} .join-us-section--content--right-btn:focus-visible {
        color: {{ section.settings.btn_text_color | default: '#ffffff' }};
        background-color: #1f1f1f;
        transform: translateY(-5px);
        box-shadow: 0px 10px 20px rgba(0,0,0,0.2);
    }
    .join-us-section-{{ section.id }} .join-us-section__btn-icon {
        width: 1.35em;
        height: 1.35em;
        flex-shrink: 0;
        display: block;
    }
    @media screen and (min-width: 769px) and (max-width: 1550px) {
        .join-us-section-{{ section.id }} {
            padding: 0 0 clamp(2.2em, 3vw, 3.5em) 0;
        }
        .join-us-section-{{ section.id }} .join-us-section--content--right {
            padding-left: clamp(1em, 1.8vw, 1.5em);
        }
        .join-us-section-{{ section.id }} .join-us-section--content--right-subtitle {
            font-size: clamp(1.05em, 1.7vw, 1.85em);
            line-height: 1.3;
            margin-bottom: 0.35em;
        }
        .join-us-section-{{ section.id }} .join-us-section--content--right-title {
            font-size: clamp(1.75em, 3.2vw, 3.1em);
            line-height: 1.15;
            margin-bottom: 0.25em;
        }
        .join-us-section-{{ section.id }} .join-us-section--content--right-context {
            font-size: clamp(0.875em, 1.15vw, 1.15em);
            line-height: 1.45;
            margin-bottom: clamp(1.1em, 1.8vw, 1.8em);
        }
        .join-us-section-{{ section.id }} .join-us-section--content--right-btn {
            font-size: clamp(0.95em, 1.25vw, 1.3em);
            padding: 0.65em 1.6em;
        }
    }
    @media screen and (max-width: 768px) {
        .join-us-section-{{ section.id }} {
            padding: 0 0 2em 0 !important;
        }
        .join-us-section-{{ section.id }} .join-us-section--content {
            display: block;
        }
        .join-us-section-{{ section.id }} .join-us-section--content--left,
        .join-us-section-{{ section.id }} .join-us-section--content--right {
            width: 100%;
            padding: 0;
        }
        .join-us-section-{{ section.id }} .join-us-section--content--left {
            border-right: none;
        }
        .join-us-section-{{ section.id }} .join-us-section--content--left img {
            border-radius: 0.8em;
            margin-bottom: 1.25em;
        }
        .join-us-section-{{ section.id }} .join-us-section--content--right-subtitle {
            font-size: clamp(0.92em, 2.8vw, 1.1em);
            line-height: 1.3;
            margin-bottom: 0.3em;
        }
        .join-us-section-{{ section.id }} .join-us-section--content--right-title {
            font-size: clamp(1.4em, 5vw, 1.85em);
            line-height: 1.15;
            margin-bottom: 0.45em;
        }
        .join-us-section-{{ section.id }} .join-us-section--content--right-context {
            font-size: clamp(0.88em, 2.4vw, 0.98em);
            line-height: 1.45;
            margin-bottom: 1.2em;
        }
        .join-us-section-{{ section.id }} .join-us-section--content--right-btn {
            font-size: clamp(0.88em, 2.5vw, 0.98em);
            padding: 0.6em 1.4em;
            gap: 0.55em;
        }
    }
{% endstyle %}

{% schema %}
{
  "name": "Join Us Section",
  "class": "join-us-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "joinus_image",
      "label": "Join Us Image"
    },
    {
      "type": "text",
      "id": "banner_title",
      "label": "Banner Title"
    },
    {
      "type": "text",
      "id": "sub_title",
      "label": "Sub Title"
    },
    {
      "type": "text",
      "id": "context",
      "label": "Context"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "btn_bg",
      "label": "Button Background"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label"
    }
  ],
  "presets": [
    {
      "name": "Join Us Section",
      "settings": {}
    }
  ]
}
{% endschema %}
