<div class="keycaps-custom-section" id="keycaps-custom-section-{{ section.id }}">
  <div class="page-width">
    {%- comment -%} 1. 顶部左对齐标题 {%- endcomment -%}
    <div class="keycaps-page-header">
      <h1 class="keycaps-page-title custom-txt-extrabold">{{ section.settings.title | default: collection.title }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="keycaps-page-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} 2. 核心商品网格（PC 4列，Mobile 2列，穿插自定义营销卡片） {%- endcomment -%}
    {%- liquid
      assign products_limit = section.settings.products_limit | default: 24
      assign per_row = section.settings.per_row | default: 4
      assign total_products = collection.products.size
      assign product_index = 0
      assign max_slots = products_limit | plus: section.blocks.size
    -%}

    <div class="grid grid--uniform keycaps-collection-grid">
      {%- for slot in (1..max_slots) -%}
        {%- assign promo_block = nil -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'promo_card' or block.type == 'image_card' -%}
            {%- assign block_pos = block.settings.position | plus: 0 -%}
            {%- if block_pos == slot -%}
              {%- assign promo_block = block -%}
              {%- break -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if promo_block != nil -%}
          {%- render 'promo-grid-card',
            block: promo_block,
            per_row: per_row,
            card_extra_class: 'small--one-halfs'
          -%}
        {%- else -%}
          {%- comment -%} 渲染标准商品卡片 {%- endcomment -%}
          {%- if product_index < total_products and product_index < products_limit -%}
            {%- assign current_prod = collection.products[product_index] -%}
            {%- render 'product-grid-item',
              product: current_prod,
              per_row: per_row,
              quick_shop_enable: settings.quick_shop_enable,
              short_introduction_enable: false,
              short_point_desc_enable: false,
              extra_class: 'small--one-halfs'
            -%}
            {%- assign product_index = product_index | plus: 1 -%}
          {%- else -%}
            {%- break -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- style -%}
  /* 隐藏底部不需要的通用板块（如 Shop With Confidence、走马灯） */
  #shopify-section-shop-with-confidence-section,
  #shopify-section-icon-list-marquee-section {
    display: none !important;
  }

  /* 基础容器 */
  .keycaps-custom-section {
    padding: 30px 0 90px;
    background: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  /* 顶部左对齐大标题 */
  .keycaps-page-header {
    text-align: left;
    margin-bottom: 28px;
    padding-bottom: 8px;
  }
  .keycaps-page-title {
    font-size: 36px;
    font-weight: 800;
    color: #111111;
    margin: 0 0 8px;
    letter-spacing: -0.5px;
    line-height: 1.2;
    text-transform: none;
  }
  .keycaps-page-subtitle {
    font-size: 15px;
    color: #666666;
    margin: 0;
    line-height: 1.5;
  }

  /* 商品网格（PC 4列，Mobile 2列，支持卡片混排） */
  .keycaps-collection-grid.grid--uniform {
    display: flex !important;
    flex-wrap: wrap !important;
    margin-left: -20px;
  }
  .keycaps-collection-grid.grid--uniform::before,
  .keycaps-collection-grid.grid--uniform::after {
    display: none !important;
  }
  .keycaps-collection-grid .grid__item {
    float: none !important;
    clear: none !important;
    box-sizing: border-box;
    padding-left: 20px;
    margin-bottom: 30px;
  }

  /* 自定义广告卡片样式 */
  .promo-grid-card {
    display: flex !important;
    flex-direction: column !important;
    height: auto !important;
  }
  .promo-card__inner {
    position: relative;
    width: 100%;
    height: 100% !important;
    min-height: 0 !important;
    border-radius: 12px;
    padding: 30px 24px;
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
    box-sizing: border-box;
    overflow: hidden;
    flex: 1 1 auto !important;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .promo-card__inner:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
  }

  /* 背景图模式 */
  .promo-card--has-bg {
    color: #ffffff !important;
  }
  .promo-card__bg-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  .promo-card__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.75) 100%);
    z-index: 2;
  }
  .promo-card--has-bg .promo-card__body,
  .promo-card--has-bg .promo-card__footer {
    position: relative;
    z-index: 3;
  }

  /* 样式一：浅灰极简风（第 1 格默认） */
  .promo-card--light {
    background: #f4f4f6;
    color: #111111;
    border: 1px solid #e8e8ea;
  }
  .promo-card--light .promo-card__tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
    color: #0A6830;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .promo-card--light .promo-card__title {
    font-size: 26px;
    font-weight: 800;
    line-height: 1.18;
    color: #111111;
    margin: 0 0 16px;
    letter-spacing: -0.5px;
  }
  .promo-card--light .promo-card__desc {
    font-size: 14px;
    line-height: 1.7;
    color: #444444;
  }
  .promo-card--light .promo-card__action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #111111;
    font-size: 14px;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .promo-card--light .promo-card__action:hover {
    color: #0A6830;
  }

  /* 样式二：深色高质感渐变风（第 8 格默认） */
  .promo-card--dark {
    background: linear-gradient(145deg, #182e20 0%, #0d1a12 100%);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .promo-card--dark .promo-card__tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: #72d572;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .promo-card--dark .promo-card__title {
    font-size: 26px;
    font-weight: 800;
    line-height: 1.18;
    color: #ffffff;
    margin: 0 0 14px;
    letter-spacing: -0.5px;
  }
  .promo-card--dark .promo-card__desc {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
  }
  .promo-card--dark .promo-card__action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 22px;
    background: #ffffff;
    color: #111111;
    font-size: 13px;
    font-weight: 700;
    border-radius: 30px;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .promo-card--dark .promo-card__action:hover {
    background: #0A6830;
    color: #ffffff;
  }

  /* 隐藏卡片左上角 New / Sale 标记 */
  .keycaps-custom-section .grid-product__tag,
  .keycaps-custom-section .grid-product__tag--sale,
  .keycaps-custom-section .grid-product__tag--custom {
    display: none !important;
  }

  /* 移动端响应式布局 */
  @media screen and (max-width: 768px) {
    .keycaps-custom-section {
      padding: 16px 0 40px;
    }
    .keycaps-custom-section .page-width {
      padding-left: 8px !important;
      padding-right: 8px !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
    }
    .keycaps-page-header {
      margin-bottom: 16px;
      padding-left: 4px;
    }
    .keycaps-page-title {
      font-size: 22px;
      margin-bottom: 4px;
    }
    .keycaps-page-subtitle {
      font-size: 13px;
      line-height: 1.4;
    }
    .keycaps-collection-grid.grid--uniform {
      margin-left: 0 !important;
      margin-right: 0 !important;
      display: flex !important;
      flex-wrap: wrap !important;
      box-sizing: border-box !important;
    }
    .keycaps-collection-grid .grid__item {
      padding: 3px 4px !important;
      margin-bottom: 0 !important;
      width: 50% !important;
      max-width: 50% !important;
      flex: 0 0 50% !important;
      box-sizing: border-box !important;
      float: none !important;
    }
    .keycaps-collection-grid .small--one-half {
      width: 50% !important;
    }

    .promo-grid-card {
      padding: 3px 4px !important;
      margin-bottom: 0 !important;
    }
    .promo-card__inner {
      min-height: 0 !important;
      height: 100% !important;
      padding: 14px 12px !important;
      border-radius: 6px !important;
      box-sizing: border-box !important;
      justify-content: space-between !important;
    }
    .promo-card--light .promo-card__tag,
    .promo-card--dark .promo-card__tag {
      font-size: 9px !important;
      letter-spacing: 0.8px !important;
      margin-bottom: 6px !important;
    }
    .promo-card--light .promo-card__title,
    .promo-card--dark .promo-card__title {
      font-size: 14px !important;
      margin-bottom: 6px !important;
      line-height: 1.25 !important;
    }
    .promo-card--light .promo-card__desc,
    .promo-card--dark .promo-card__desc {
      font-size: 11px !important;
      line-height: 1.4 !important;
    }
    .promo-card--light .promo-card__action,
    .promo-card--dark .promo-card__action {
      font-size: 11px !important;
      padding: 5px 12px !important;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Keycaps Custom Page",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Page Title (Optional, defaults to collection title)"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Page Subtitle"
    },
    {
      "type": "range",
      "id": "per_row",
      "label": "Products per row",
      "default": 4,
      "min": 2,
      "max": 5,
      "step": 1
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products to Show in Grid",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "image_card",
      "name": "In-Grid Image Card",
      "settings": [
        {
          "type": "number",
          "id": "position",
          "label": "Slot Position in Grid (1, 8, etc.)",
          "default": 1
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile Card Image (Optional)"
        },
        {
          "type": "select",
          "id": "image_fit",
          "label": "Image Fit",
          "options": [
            { "value": "cover", "label": "Fill / Cover Card (Recommended)" },
            { "value": "contain", "label": "Contain (Keep Full Image Visible)" }
          ],
          "default": "cover"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image Link (Optional)"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open link in new tab",
          "default": false
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Image Alt Text (Optional)"
        }
      ]
    },
    {
      "type": "promo_card",
      "name": "In-Grid Promo Card",
      "settings": [
        {
          "type": "number",
          "id": "position",
          "label": "Slot Position in Grid (1, 8, etc.)",
          "default": 1
        },
        {
          "type": "select",
          "id": "card_theme",
          "label": "Card Visual Style",
          "options": [
            { "value": "light", "label": "Light Minimal (Grey)" },
            { "value": "dark", "label": "Dark Aesthetic (Emerald/Black)" }
          ],
          "default": "light"
        },
        {
          "type": "image_picker",
          "id": "bg_image",
          "label": "Background Image (Optional)"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Top Badge / Small Tag",
          "default": "MEMBER EXCLUSIVE"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Save on Every Order — Join PIIFOX Club"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Card Description / Perks",
          "default": "Unlock members-only savings:\nSpend $65, Save 15%\nSpend $125, Save 20%\nSpend $175, Save 25%"
        },
        {
          "type": "text",
          "id": "btn_label",
          "label": "Button / Link Text",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "btn_url",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Keycaps Custom Page"
    }
  ]
}
{% endschema %}
