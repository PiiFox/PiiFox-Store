<div class="keycaps-custom-section" id="keycaps-custom-section-{{ section.id }}">
  <div class="page-width">
    {%- comment -%} 1. 顶部左对齐标题 {%- endcomment -%}
    <div class="keycaps-page-header">
      <h1 class="keycaps-page-title custom-txt-extrabold">{{ section.settings.title | default: collection.title }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="keycaps-page-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} 2. 核心商品网格（PC 4列，Mobile 2列，穿插自定义营销卡片） {%- endcomment -%}
    {%- liquid
      assign products_limit = section.settings.products_limit | default: 24
      assign total_products = collection.products.size
      assign product_index = 0
      assign max_slots = products_limit | plus: section.blocks.size
    -%}

    <div class="grid grid--uniform keycaps-collection-grid">
      {%- for slot in (1..max_slots) -%}
        {%- assign promo_block = nil -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'promo_card' and block.settings.position == slot -%}
            {%- assign promo_block = block -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if promo_block != nil -%}
          {%- comment -%} 渲染自定义卡片（支持第 1 格、第 8 格等任意位置） {%- endcomment -%}
          <div
            class="grid__item grid-product small--one-half medium-up--one-quarter promo-grid-card promo-grid-card-{{ promo_block.id }}"
            {{ promo_block.shopify_attributes }}
          >
            <div class="promo-card__inner promo-card--{{ promo_block.settings.card_theme }}{% if promo_block.settings.bg_image != blank %} promo-card--has-bg{% endif %}">
              {%- if promo_block.settings.bg_image != blank -%}
                <img
                  src="{{ promo_block.settings.bg_image | image_url: width: 800 }}"
                  alt="{{ promo_block.settings.title | escape }}"
                  class="promo-card__bg-img"
                  loading="lazy"
                  width="800"
                  height="800"
                >
                <div class="promo-card__overlay"></div>
              {%- endif -%}

              <div class="promo-card__body">
                {%- if promo_block.settings.tag != blank -%}
                  <div class="promo-card__tag">{{ promo_block.settings.tag }}</div>
                {%- endif -%}
                {%- if promo_block.settings.title != blank -%}
                  <h3 class="promo-card__title">{{ promo_block.settings.title }}</h3>
                {%- endif -%}
                {%- if promo_block.settings.description != blank -%}
                  <div class="promo-card__desc">{{ promo_block.settings.description | newline_to_br }}</div>
                {%- endif -%}
              </div>

              {%- if promo_block.settings.btn_label != blank -%}
                <div class="promo-card__footer">
                  <a
                    href="{{ promo_block.settings.btn_url | default: '#' }}"
                    class="promo-card__action"
                  >
                    <span>{{ promo_block.settings.btn_label }}</span>
                    <svg class="promo-card__action-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                  </a>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- else -%}
          {%- comment -%} 渲染标准商品卡片 {%- endcomment -%}
          {%- if product_index < total_products and product_index < products_limit -%}
            {%- assign current_prod = collection.products[product_index] -%}
            {%- render 'product-grid-item',
              product: current_prod,
              per_row: 4,
              quick_shop_enable: settings.quick_shop_enable,
              short_introduction_enable: false,
              short_point_desc_enable: false,
              extra_class: 'small--one-halfs'
            -%}
            {%- assign product_index = product_index | plus: 1 -%}
          {%- else -%}
            {%- break -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- style -%}
  /* 隐藏底部不需要的通用板块（如 Shop With Confidence、走马灯） */
  #shopify-section-shop-with-confidence-section,
  #shopify-section-icon-list-marquee-section {
    display: none !important;
  }

  /* 基础容器 */
  .keycaps-custom-section {
    padding: 30px 0 90px;
    background: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  /* 顶部左对齐大标题 */
  .keycaps-page-header {
    text-align: left;
    margin-bottom: 28px;
    padding-bottom: 8px;
  }
  .keycaps-page-title {
    font-size: 36px;
    font-weight: 800;
    color: #111111;
    margin: 0 0 8px;
    letter-spacing: -0.5px;
    line-height: 1.2;
    text-transform: none;
  }
  .keycaps-page-subtitle {
    font-size: 15px;
    color: #666666;
    margin: 0;
    line-height: 1.5;
  }

  /* 商品网格（PC 4列，Mobile 2列，支持卡片混排） */
  .keycaps-collection-grid.grid--uniform {
    display: flex !important;
    flex-wrap: wrap !important;
    margin-left: -20px;
  }
  .keycaps-collection-grid.grid--uniform::before,
  .keycaps-collection-grid.grid--uniform::after {
    display: none !important;
  }
  .keycaps-collection-grid .grid__item {
    float: none !important;
    clear: none !important;
    box-sizing: border-box;
    padding-left: 20px;
    margin-bottom: 30px;
  }
  .keycaps-collection-grid .medium-up--one-quarter {
    width: 25% !important;
  }

  /* 自定义广告卡片样式 */
  .promo-grid-card {
    display: flex !important;
  }
  .promo-card__inner {
    position: relative;
    width: 100%;
    border-radius: 12px;
    padding: 30px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-sizing: border-box;
    overflow: hidden;
    min-height: 400px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .promo-card__inner:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
  }

  /* 背景图模式 */
  .promo-card--has-bg {
    color: #ffffff !important;
  }
  .promo-card__bg-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  .promo-card__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.75) 100%);
    z-index: 2;
  }
  .promo-card--has-bg .promo-card__body,
  .promo-card--has-bg .promo-card__footer {
    position: relative;
    z-index: 3;
  }

  /* 样式一：浅灰极简风（第 1 格默认） */
  .promo-card--light {
    background: #f4f4f6;
    color: #111111;
    border: 1px solid #e8e8ea;
  }
  .promo-card--light .promo-card__tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
    color: #0A6830;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .promo-card--light .promo-card__title {
    font-size: 26px;
    font-weight: 800;
    line-height: 1.18;
    color: #111111;
    margin: 0 0 16px;
    letter-spacing: -0.5px;
  }
  .promo-card--light .promo-card__desc {
    font-size: 14px;
    line-height: 1.7;
    color: #444444;
  }
  .promo-card--light .promo-card__action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #111111;
    font-size: 14px;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .promo-card--light .promo-card__action:hover {
    color: #0A6830;
  }

  /* 样式二：深色高质感渐变风（第 8 格默认） */
  .promo-card--dark {
    background: linear-gradient(145deg, #182e20 0%, #0d1a12 100%);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .promo-card--dark .promo-card__tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: #72d572;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .promo-card--dark .promo-card__title {
    font-size: 26px;
    font-weight: 800;
    line-height: 1.18;
    color: #ffffff;
    margin: 0 0 14px;
    letter-spacing: -0.5px;
  }
  .promo-card--dark .promo-card__desc {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
  }
  .promo-card--dark .promo-card__action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 22px;
    background: #ffffff;
    color: #111111;
    font-size: 13px;
    font-weight: 700;
    border-radius: 30px;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .promo-card--dark .promo-card__action:hover {
    background: #0A6830;
    color: #ffffff;
  }

  /* 隐藏卡片左上角 New / Sale 标记 */
  .keycaps-custom-section .grid-product__tag,
  .keycaps-custom-section .grid-product__tag--sale,
  .keycaps-custom-section .grid-product__tag--custom {
    display: none !important;
  }

  /* 移动端响应式布局 */
  @media screen and (max-width: 768px) {
    .keycaps-custom-section {
      padding: 16px 0 40px;
    }
    .keycaps-custom-section .page-width {
      padding-left: 8px !important;
      padding-right: 8px !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
    }
    .keycaps-page-header {
      margin-bottom: 16px;
      padding-left: 4px;
    }
    .keycaps-page-title {
      font-size: 22px;
      margin-bottom: 4px;
    }
    .keycaps-page-subtitle {
      font-size: 13px;
      line-height: 1.4;
    }
    .keycaps-collection-grid.grid--uniform {
      margin-left: 0 !important;
      margin-right: 0 !important;
      display: flex !important;
      flex-wrap: wrap !important;
      box-sizing: border-box !important;
    }
    .keycaps-collection-grid .grid__item {
      padding: 3px 4px !important;
      margin-bottom: 10px !important;
      width: 50% !important;
      max-width: 50% !important;
      flex: 0 0 50% !important;
      box-sizing: border-box !important;
      float: none !important;
    }
    .keycaps-collection-grid .small--one-half {
      width: 50% !important;
    }

    /* 商品卡片内部容器与边框 */
    .keycaps-collection-grid .grid-product__content {
      border-radius: 6px !important;
      overflow: hidden !important;
      height: 100% !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: space-between !important;
    }

    /* 放大商品图片 */
    .keycaps-collection-grid .grid-product__image-mask {
      padding: 0 !important;
      margin: 0 !important;
      width: 100% !important;
    }
    .keycaps-collection-grid .grid-product__content > .grid-product__link img,
    .keycaps-collection-grid .grid-product__mobile-slide img {
      width: 100% !important;
      aspect-ratio: 1 / 1 !important;
      object-fit: contain !important;
    }

    /* 紧凑双段滑块指示条 */
    .keycaps-collection-grid .grid-product__mobile-indicator {
      padding: 3px 6px 1px 6px !important;
      gap: 3px !important;
    }
    .keycaps-collection-grid .grid-product__mobile-indicator .indicator-bar {
      height: 2px !important;
    }

    /* 分类标签紧凑化 */
    .keycaps-collection-grid .keycap-style-label {
      font-size: 8.5px !important;
      padding: 2px 6px !important;
      right: 3% !important;
      bottom: 4% !important;
      border-width: 1px !important;
    }

    /* 卡片文本容器与间距紧凑化 */
    .keycaps-collection-grid .grid-product__meta {
      padding: 4px 6px 6px 6px !important;
      display: flex !important;
      flex-direction: column !important;
      flex: 1 !important;
      justify-content: space-between !important;
    }

    /* 标题字号减小、行高和外边距紧凑 */
    .keycaps-collection-grid .grid-product__title,
    .keycaps-collection-grid .grid-product__title.grid-product__title--body {
      font-size: 11px !important;
      line-height: 1.25 !important;
      height: 28px !important;
      font-weight: 500 !important;
      margin: 0 0 2px 0 !important;
      letter-spacing: -0.01em !important;
      display: -webkit-box !important;
      -webkit-line-clamp: 2 !important;
      -webkit-box-orient: vertical !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
    }

    /* 价格字号减小、上下间距减小 */
    .keycaps-collection-grid .grid-product__price {
      padding: 0 !important;
      margin: 1px 0 4px 0 !important;
      line-height: 1.1 !important;
      text-align: left !important;
    }
    .keycaps-collection-grid .grid-product__price > span.money,
    .keycaps-collection-grid .grid-product__price .money {
      font-size: 12.5px !important;
      font-weight: 600 !important;
      color: var(--colorThemePrimary, #107a44) !important;
    }

    /* 按钮文案减小、紧凑按钮高度 */
    .keycaps-collection-grid .bottom_btn {
      margin-top: 0 !important;
      padding-top: 0 !important;
    }
    .keycaps-collection-grid .bottom_btn a,
    .keycaps-collection-grid .bottom_btn a.lm_btn {
      font-size: 10.5px !important;
      font-weight: 500 !important;
      padding: 4.5px 0 !important;
      border-radius: 4px !important;
      letter-spacing: 0.01em !important;
      line-height: 1.2 !important;
      white-space: nowrap !important;
      width: 100% !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
    }
    .keycaps-collection-grid .bottom_btn a svg {
      display: none !important;
    }

    /* 营销卡片紧凑化，降低高度以匹配商品卡片 */
    .promo-grid-card {
      padding: 3px 4px !important;
      margin-bottom: 10px !important;
    }
    .promo-card__inner {
      min-height: unset !important;
      height: 100% !important;
      padding: 14px 12px !important;
      border-radius: 6px !important;
      box-sizing: border-box !important;
      justify-content: space-between !important;
    }
    .promo-card--light .promo-card__tag,
    .promo-card--dark .promo-card__tag {
      font-size: 9px !important;
      letter-spacing: 0.8px !important;
      margin-bottom: 6px !important;
    }
    .promo-card--light .promo-card__title,
    .promo-card--dark .promo-card__title {
      font-size: 14px !important;
      margin-bottom: 6px !important;
      line-height: 1.25 !important;
    }
    .promo-card--light .promo-card__desc,
    .promo-card--dark .promo-card__desc {
      font-size: 11px !important;
      line-height: 1.4 !important;
    }
    .promo-card--light .promo-card__action,
    .promo-card--dark .promo-card__action {
      font-size: 11px !important;
      padding: 5px 12px !important;
    }
  }

  /* Tablet layout (769px - 1000px): keep 4 columns, compact cards */
  @media screen and (min-width: 769px) and (max-width: 1000px) {
    .keycaps-custom-section {
      padding: 24px 0 60px;
    }
    .keycaps-page-title {
      font-size: 28px;
    }
    .keycaps-page-subtitle {
      font-size: 14px;
    }
    .keycaps-collection-grid.grid--uniform {
      margin-left: -12px;
    }
    .keycaps-collection-grid .grid__item,
    .keycaps-collection-grid .medium-up--one-quarter {
      width: 25% !important;
      max-width: 25% !important;
      flex: 0 0 25% !important;
      padding-left: 12px;
      margin-bottom: 18px;
    }

    /* Product card text */
    .keycaps-collection-grid .grid-product__meta {
      padding-left: 10px !important;
      padding-right: 10px !important;
    }
    .keycaps-collection-grid .grid-product__title,
    .keycaps-collection-grid .grid-product__title.grid-product__title--body {
      font-size: 13px !important;
      line-height: 1.3 !important;
      height: 2.6em !important;
      max-height: 2.6em !important;
      margin-bottom: 4px !important;
      display: -webkit-box !important;
      -webkit-line-clamp: 2 !important;
      -webkit-box-orient: vertical !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      white-space: normal !important;
    }
    .keycaps-collection-grid .grid-product__price,
    .keycaps-collection-grid .grid-product__price .money {
      font-size: 14px !important;
    }
    .keycaps-collection-grid .bottom_btn a,
    .keycaps-collection-grid .bottom_btn a.lm_btn {
      font-size: 12px !important;
      padding-top: 7px !important;
      padding-bottom: 7px !important;
      white-space: nowrap !important;
      letter-spacing: 0.01em !important;
      gap: 4px !important;
    }
    .keycaps-collection-grid .bottom_btn a svg {
      width: 14px !important;
      height: 14px !important;
    }
    .keycaps-collection-grid .keycap-style-label {
      font-size: 9px !important;
      padding: 2px 6px !important;
    }

    /* Promo card */
    .promo-card__inner {
      min-height: unset !important;
      height: 100% !important;
      padding: 16px 12px !important;
      border-radius: 8px !important;
    }
    .promo-card--light .promo-card__tag,
    .promo-card--dark .promo-card__tag {
      font-size: 9px !important;
      letter-spacing: 0.8px !important;
      margin-bottom: 6px !important;
    }
    .promo-card--light .promo-card__title,
    .promo-card--dark .promo-card__title {
      font-size: 16px !important;
      line-height: 1.22 !important;
      margin-bottom: 8px !important;
      letter-spacing: -0.2px !important;
      overflow-wrap: break-word;
    }
    .promo-card--light .promo-card__desc,
    .promo-card--dark .promo-card__desc {
      font-size: 11.5px !important;
      line-height: 1.45 !important;
    }
    .promo-card--light .promo-card__action,
    .promo-card--dark .promo-card__action {
      font-size: 12px !important;
    }
    .promo-card--dark .promo-card__action {
      padding: 7px 14px !important;
    }
    .promo-card__footer {
      margin-top: 10px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Keycaps Custom Page",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Page Title (Optional, defaults to collection title)"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Page Subtitle"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products to Show in Grid",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "promo_card",
      "name": "In-Grid Promo Card",
      "settings": [
        {
          "type": "number",
          "id": "position",
          "label": "Slot Position in Grid (1, 8, etc.)",
          "default": 1
        },
        {
          "type": "select",
          "id": "card_theme",
          "label": "Card Visual Style",
          "options": [
            { "value": "light", "label": "Light Minimal (Grey)" },
            { "value": "dark", "label": "Dark Aesthetic (Emerald/Black)" }
          ],
          "default": "light"
        },
        {
          "type": "image_picker",
          "id": "bg_image",
          "label": "Background Image (Optional)"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Top Badge / Small Tag",
          "default": "MEMBER EXCLUSIVE"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Save on Every Order — Join PIIFOX Club"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Card Description / Perks",
          "default": "Unlock members-only savings:\nSpend $65, Save 15%\nSpend $125, Save 20%\nSpend $175, Save 25%"
        },
        {
          "type": "text",
          "id": "btn_label",
          "label": "Button / Link Text",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "btn_url",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Keycaps Custom Page"
    }
  ]
}
{% endschema %}
