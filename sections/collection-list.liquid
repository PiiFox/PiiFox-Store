{% style %}
  .collection-list-section-{{ section.id }} {
    padding: 60px 0;
    background-color: {{ section.settings.section_bg_color | default: '#ffffff' }};
  }

  .collection-list-section-{{ section.id }} .best-sellers-wrapper {
    position: relative;
  }

  /* Header: Title on Left, Nav Buttons on Right (Reference Image 1) */
  .collection-list-section-{{ section.id }} .best-sellers-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
  }

  .collection-list-section-{{ section.id }} .best-sellers-title {
    font-size: 32px;
    font-weight: 700;
    color: #111111;
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .collection-list-section-{{ section.id }} .best-sellers-nav {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .collection-list-section-{{ section.id }} .best-sellers-nav-btn {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid #dcdcdc;
    background-color: #ffffff;
    color: #222222;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.25s ease;
    padding: 0;
    outline: none;
    user-select: none;
    box-sizing: border-box;
  }

  .collection-list-section-{{ section.id }} .best-sellers-nav-btn svg {
    width: 18px;
    height: 18px;
    transition: transform 0.2s ease;
  }

  .collection-list-section-{{ section.id }} .best-sellers-nav-btn:hover:not(.swiper-button-disabled) {
    border-color: #111111;
    background-color: #111111;
    color: #ffffff;
  }

  .collection-list-section-{{ section.id }} .best-sellers-nav-btn.swiper-button-disabled {
    opacity: 0.35;
    cursor: not-allowed;
    pointer-events: none;
    border-color: #ebebeb;
    color: #999999;
  }

  /* Tabs (if enabled) */
  .collection-list-section-{{ section.id }} .collection-tab-list {
    display: inline-flex;
    justify-content: flex-start;
    margin-bottom: 24px;
    background-color: #f0f0f2;
    border-radius: 20em;
    padding: 4px;
    gap: 4px;
  }

  .collection-list-section-{{ section.id }} .tab-item {
    padding: 8px 18px;
    cursor: pointer;
    border-radius: 20em;
    font-size: 14px;
    font-weight: 500;
    color: #555555;
    transition: all 0.2s ease;
  }

  .collection-list-section-{{ section.id }} .tab-item.active {
    background-color: #ffffff;
    color: #111111;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
  }

  .collection-list-section-{{ section.id }} .best-sellers-tab-panel {
    display: none;
    width: 100%;
  }

  .collection-list-section-{{ section.id }} .best-sellers-tab-panel.active {
    display: block;
  }

  /* Swiper Track */
  .collection-list-section-{{ section.id }} .best-sellers-swiper {
    width: 100%;
    overflow: hidden;
    padding: 6px 4px 16px;
    box-sizing: border-box;
  }

  .collection-list-section-{{ section.id }} .best-sellers-slide {
    height: auto;
    display: flex;
    box-sizing: border-box;
  }

  /* Prevent FOUC: Pre-layout before Swiper.js executes */
  .collection-list-section-{{ section.id }} .best-sellers-swiper:not(.swiper-initialized) .swiper-wrapper {
    display: flex;
    flex-wrap: nowrap;
    overflow: hidden;
    gap: 22px;
  }
  .collection-list-section-{{ section.id }} .best-sellers-swiper:not(.swiper-initialized) .best-sellers-slide {
    flex: 0 0 calc((100% - 3.2 * 22px) / 4.2) !important;
    width: calc((100% - 3.2 * 22px) / 4.2) !important;
    max-width: calc((100% - 3.2 * 22px) / 4.2) !important;
    box-sizing: border-box;
  }
  @media screen and (max-width: 1200px) {
    .collection-list-section-{{ section.id }} .best-sellers-swiper:not(.swiper-initialized) .swiper-wrapper {
      gap: 20px;
    }
    .collection-list-section-{{ section.id }} .best-sellers-swiper:not(.swiper-initialized) .best-sellers-slide {
      flex: 0 0 calc((100% - 2.2 * 20px) / 3.2) !important;
      width: calc((100% - 2.2 * 20px) / 3.2) !important;
      max-width: calc((100% - 2.2 * 20px) / 3.2) !important;
    }
  }
  @media screen and (max-width: 900px) {
    .collection-list-section-{{ section.id }} .best-sellers-swiper:not(.swiper-initialized) .swiper-wrapper {
      gap: 16px;
    }
    .collection-list-section-{{ section.id }} .best-sellers-swiper:not(.swiper-initialized) .best-sellers-slide {
      flex: 0 0 calc((100% - 1.3 * 16px) / 2.3) !important;
      width: calc((100% - 1.3 * 16px) / 2.3) !important;
      max-width: calc((100% - 1.3 * 16px) / 2.3) !important;
    }
  }
  @media screen and (max-width: 640px) {
    .collection-list-section-{{ section.id }} .best-sellers-swiper:not(.swiper-initialized) .swiper-wrapper {
      gap: 14px;
    }
    .collection-list-section-{{ section.id }} .best-sellers-swiper:not(.swiper-initialized) .best-sellers-slide {
      flex: 0 0 calc((100% - 0.6 * 14px) / 1.6) !important;
      width: calc((100% - 0.6 * 14px) / 1.6) !important;
      max-width: calc((100% - 0.6 * 14px) / 1.6) !important;
    }
  }
  @media screen and (max-width: 480px) {
    .collection-list-section-{{ section.id }} .best-sellers-swiper:not(.swiper-initialized) .swiper-wrapper {
      gap: 14px;
    }
    .collection-list-section-{{ section.id }} .best-sellers-swiper:not(.swiper-initialized) .best-sellers-slide {
      flex: 0 0 calc((100% - 0.25 * 14px) / 1.25) !important;
      width: calc((100% - 0.25 * 14px) / 1.25) !important;
      max-width: calc((100% - 0.25 * 14px) / 1.25) !important;
    }
  }

  /* Card Layout (Reference Image 2) */
  .collection-list-section-{{ section.id }} .best-seller-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    background-color: {{ section.settings.card_bg | default: '#ffffff' }};
    border-radius: 16px;
    padding: 16px;
    text-decoration: none;
    color: inherit;
    border: 1px solid #ebebeb;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease;
    box-sizing: border-box;
  }

  .collection-list-section-{{ section.id }} .best-seller-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
    border-color: #d8d8d8;
  }

  /* Image Wrap */
  .collection-list-section-{{ section.id }} .best-seller-card-image-wrap {
    width: 100%;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f7f7f8;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 14px;
    padding: 12px;
    box-sizing: border-box;
  }

  .collection-list-section-{{ section.id }} .best-seller-card-image {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .collection-list-section-{{ section.id }} .best-seller-card:hover .best-seller-card-image {
    transform: scale(1.06);
  }

  /* Product Title */
  .collection-list-section-{{ section.id }} .best-seller-card-title {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
    color: #111111;
    text-align: left;
    margin: 0 0 16px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    height: 2.8em;
    word-break: break-word;
  }

  /* Button Wrap & Learn More Button (Image 2) */
  .collection-list-section-{{ section.id }} .best-seller-card-btn-wrap {
    margin-top: auto;
    width: 100%;
  }

  .collection-list-section-{{ section.id }} .best-seller-card-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 10px 18px;
    border-radius: 9999px;
    background-color: {{ section.settings.btn_color | default: 'var(--colorThemePrimary, #0A6830)' }};
    color: {{ section.settings.btn_text_color | default: '#ffffff' }};
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-align: center;
    box-sizing: border-box;
    transition: all 0.25s ease;
    box-shadow: 0 2px 6px rgba(10, 104, 48, 0.15);
  }

  .collection-list-section-{{ section.id }} .best-seller-card:hover .best-seller-card-btn {
    background-color: {{ section.settings.btn_hover_color | default: '#085427' }};
    box-shadow: 0 4px 14px rgba(10, 104, 48, 0.28);
    transform: translateY(-1px);
  }

  @media screen and (max-width: 768px) {
    .collection-list-section-{{ section.id }} {
      padding: 36px 0;
    }
    .collection-list-section-{{ section.id }} .best-sellers-title {
      font-size: 24px;
    }
    .collection-list-section-{{ section.id }} .best-sellers-nav-btn {
      width: 36px;
      height: 36px;
    }
    .collection-list-section-{{ section.id }} .best-sellers-nav-btn svg {
      width: 16px;
      height: 16px;
    }
    .collection-list-section-{{ section.id }} .best-seller-card {
      padding: 12px;
      border-radius: 14px;
    }
    .collection-list-section-{{ section.id }} .best-seller-card-image-wrap {
      border-radius: 10px;
      padding: 8px;
      margin-bottom: 10px;
    }
    .collection-list-section-{{ section.id }} .best-seller-card-title {
      font-size: 13px;
      margin-bottom: 12px;
    }
    .collection-list-section-{{ section.id }} .best-seller-card-btn {
      padding: 8px 14px;
      font-size: 13px;
    }
  }
{% endstyle %}

<div class="collection-list-section-{{ section.id }} best-sellers-section">
  <div class="best-sellers-wrapper page-width">
    <!-- Header: Title on Left, Circular Nav Buttons on Right (Reference Image 1) -->
    <div class="best-sellers-header">
      <h2 class="best-sellers-title custom-txt-bold">
        {{ section.settings.title | default: 'Best Sellers' }}
      </h2>
      <div class="best-sellers-nav">
        <button
          type="button"
          class="best-sellers-nav-btn best-sellers-prev-{{ section.id }}"
          aria-label="{{ 'general.pagination.previous' | t | default: 'Previous' }}"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button
          type="button"
          class="best-sellers-nav-btn best-sellers-next-{{ section.id }}"
          aria-label="{{ 'general.pagination.next' | t | default: 'Next' }}"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>

    {% if section.settings.enable_tabs and section.blocks.size > 1 %}
      <div class="collection-tab-list">
        {% for block in section.blocks %}
          {% if block.settings.collection != blank %}
            <div class="tab-item {% if forloop.first %}active{% endif %}" data-tab-index="{{ forloop.index0 }}">
              <div class="tab-item-title">{{ block.settings.collection_title | default: block.settings.collection.title }}</div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <div class="best-sellers-slider-wrapper">
      {% if section.settings.enable_tabs and section.blocks.size > 1 %}
        {% for block in section.blocks %}
          {% if block.settings.collection != blank %}
            <div
              class="best-sellers-tab-panel best-sellers-tab-panel-{{ block.id }} {% if forloop.first %}active{% endif %}"
              data-panel-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              <div class="swiper-container best-sellers-swiper">
                <div class="swiper-wrapper">
                  {% for product in block.settings.collection.products limit: section.settings.products_limit %}
                    <div class="swiper-slide best-sellers-slide">
                      <a href="{{ product.url }}" class="best-seller-card">
                        <div class="best-seller-card-image-wrap">
                          {% if product.featured_image %}
                            <img
                              src="{{ product.featured_image | image_url: width: 600 }}"
                              alt="{{ product.featured_image.alt | default: product.title | escape }}"
                              {% if forloop.index <= 4 %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
                              width="600"
                              height="600"
                              class="best-seller-card-image"
                            >
                          {% else %}
                            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                          {% endif %}
                        </div>
                        <div class="best-seller-card-title custom-txt-semibold">
                          {{ product.title }}
                        </div>
                        <div class="best-seller-card-btn-wrap">
                          <span class="best-seller-card-btn">
                            {{ section.settings.btn_text | default: 'Learn More' }}
                          </span>
                        </div>
                      </a>
                    </div>
                  {% endfor %}
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      {% else %}
        {% liquid
          assign current_collection = section.settings.collection
          if current_collection == blank
            for block in section.blocks
              if block.settings.collection != blank
                assign current_collection = block.settings.collection
                break
              endif
            endfor
          endif
          if current_collection == blank
            assign current_collection = collections['best-sellers']
          endif
          if current_collection == blank
            assign current_collection = collections.first
          endif
          assign products_limit = section.settings.products_limit | default: 12
        %}

        <div class="best-sellers-tab-panel active">
          <div class="swiper-container best-sellers-swiper">
            <div class="swiper-wrapper">
              {% if current_collection and current_collection.products.size > 0 %}
                {% for product in current_collection.products limit: products_limit %}
                  <div class="swiper-slide best-sellers-slide">
                    <a href="{{ product.url }}" class="best-seller-card">
                      <div class="best-seller-card-image-wrap">
                        {% if product.featured_image %}
                          <img
                            src="{{ product.featured_image | image_url: width: 600 }}"
                            alt="{{ product.featured_image.alt | default: product.title | escape }}"
                            {% if forloop.index <= 4 %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
                            width="600"
                            height="600"
                            class="best-seller-card-image"
                          >
                        {% else %}
                          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                        {% endif %}
                      </div>
                      <div class="best-seller-card-title custom-txt-semibold">
                        {{ product.title }}
                      </div>
                      <div class="best-seller-card-btn-wrap">
                        <span class="best-seller-card-btn">
                          {{ section.settings.btn_text | default: 'Learn More' }}
                        </span>
                      </div>
                    </a>
                  </div>
                {% endfor %}
              {% else %}
                {% for i in (1..6) %}
                  <div class="swiper-slide best-sellers-slide">
                    <div class="best-seller-card">
                      <div class="best-seller-card-image-wrap">
                        {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
                      </div>
                      <div class="best-seller-card-title custom-txt-semibold">
                        PIIFOX Mechanical Keyboard
                      </div>
                      <div class="best-seller-card-btn-wrap">
                        <span class="best-seller-card-btn">
                          {{ section.settings.btn_text | default: 'Learn More' }}
                        </span>
                      </div>
                    </div>
                  </div>
                {% endfor %}
              {% endif %}
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<script>
  (function () {
    function initBestSellers() {
      if (typeof Swiper === 'undefined') {
        setTimeout(initBestSellers, 30);
        return;
      }

      const sectionEl = document.querySelector('.collection-list-section-{{ section.id }}');
      if (!sectionEl) return;

      const prevBtn = sectionEl.querySelector('.best-sellers-prev-{{ section.id }}');
      const nextBtn = sectionEl.querySelector('.best-sellers-next-{{ section.id }}');
      const tabItems = sectionEl.querySelectorAll('.tab-item');
      const tabPanels = sectionEl.querySelectorAll('.best-sellers-tab-panel');

      function initPanelSwiper(panel) {
        const swiperContainer = panel.querySelector('.best-sellers-swiper');
        if (!swiperContainer) return;

        if (swiperContainer.swiper) {
          swiperContainer.swiper.update();
          return;
        }

        swiperContainer.swiper = new Swiper(swiperContainer, {
          slidesPerView: 1.25,
          spaceBetween: 14,
          watchOverflow: true,
          grabCursor: true,
          navigation: {
            prevEl: prevBtn,
            nextEl: nextBtn,
            disabledClass: 'swiper-button-disabled',
          },
          breakpoints: {
            480: {
              slidesPerView: 1.6,
              spaceBetween: 14,
            },
            640: {
              slidesPerView: 2.3,
              spaceBetween: 16,
            },
            900: {
              slidesPerView: 3.2,
              spaceBetween: 20,
            },
            1200: {
              slidesPerView: 4.2,
              spaceBetween: 22,
            },
            1600: {
              slidesPerView: 4.2,
              spaceBetween: 24,
            },
          },
        });
      }

      tabPanels.forEach((panel) => {
        initPanelSwiper(panel);
      });

      tabItems.forEach((tab, index) => {
        tab.addEventListener('click', () => {
          tabItems.forEach((t) => t.classList.remove('active'));
          tabPanels.forEach((p) => p.classList.remove('active'));
          tab.classList.add('active');
          if (tabPanels[index]) {
            tabPanels[index].classList.add('active');
            const activeSwiper = tabPanels[index].querySelector('.best-sellers-swiper')?.swiper;
            if (activeSwiper) {
              activeSwiper.update();
            }
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBestSellers);
    } else {
      initBestSellers();
    }

    window.addEventListener('pageshow', function () {
      initBestSellers();
    });

    document.addEventListener('shopify:section:load', function (e) {
      if (
        e.target.classList.contains('collection-list-section-{{ section.id }}') ||
        e.target.querySelector('.collection-list-section-{{ section.id }}')
      ) {
        initBestSellers();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Best Sellers Slider",
  "class": "collection-list-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Best Sellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 12,
      "label": "Products to show"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button text",
      "default": "Learn More"
    },
    {
      "type": "color",
      "id": "btn_color",
      "label": "Button background color",
      "default": "#0A6830"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_hover_color",
      "label": "Button hover background color",
      "default": "#085427"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "enable_tabs",
      "label": "Enable collection tabs (when using blocks)",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "collection_title",
          "label": "Collection Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best Sellers Slider",
      "settings": {
        "title": "Best Sellers"
      },
      "blocks": []
    }
  ]
}
{% endschema %}
