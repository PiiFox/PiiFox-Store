{%- assign title = section.settings.title | default: 'YOUR STYLE. READY TO TYPE.' -%}
{%- assign subtitle = section.settings.subtitle | default: 'Your keyboard, your chosen keycaps — professionally installed before shipping and ready to use right out of the box.' -%}
{%- assign desktop_video_url = section.settings.video_url | default: 'https://cdn.shopify.com/videos/c/o/v/fbc3f84973e54949bb999e41160928fe.mp4' -%}
{%- assign mobile_video_url = section.settings.video_url_mobile | default: 'https://cdn.shopify.com/videos/c/o/v/1512aebe62804c178813fd38e625ec59.mp4' -%}
{%- assign show_overlay = section.settings.show_overlay -%}
{%- if show_overlay == nil -%}
  {%- assign show_overlay = true -%}
{%- endif -%}
{%- assign desktop_max_height = section.settings.desktop_max_height | default: 70 -%}
{%- assign mobile_max_height = section.settings.mobile_max_height | default: 65 -%}
{%- assign overlay_opacity = section.settings.overlay_opacity | default: 30 -%}

{%- if section.settings.video != blank -%}
  {%- assign d_source = section.settings.video.sources | first -%}
  {%- if d_source != blank -%}
    {%- assign desktop_video_url = d_source.url -%}
  {%- endif -%}
{%- endif -%}

{%- if section.settings.video_m != blank -%}
  {%- assign m_source = section.settings.video_m.sources | first -%}
  {%- if m_source != blank -%}
    {%- assign mobile_video_url = m_source.url -%}
  {%- endif -%}
{%- endif -%}

{%- assign poster_image = section.settings.video_thumbnail -%}
{%- if poster_image == blank and section.settings.video.preview_image != blank -%}
  {%- assign poster_image = section.settings.video.preview_image -%}
{%- endif -%}

<section class="style-studio-hero-section style-studio-hero-{{ section.id }}" aria-label="{{ title | default: 'Style Studio' | escape }}">
  <div class="style-studio-hero__container">
    <div class="style-studio-hero__video-box">
      <video
        class="style-studio-hero__video"
        width="100%"
        height="100%"
        muted
        autoplay
        loop
        playsinline
        webkit-playsinline
        preload="metadata"
        {% if poster_image != blank %}poster="{{ poster_image | image_url: width: 1920 }}"{% endif %}
      >
        {% if mobile_video_url != blank %}
          <source src="{{ mobile_video_url }}" type="video/mp4" media="(max-width: 768px)">
        {% endif %}
        {% if desktop_video_url != blank %}
          <source src="{{ desktop_video_url }}" type="video/mp4">
        {% endif %}
        {% if poster_image != blank %}
          <img
            width="1920"
            height="auto"
            src="{{ poster_image | image_url: width: 1920, format: 'webp' }}"
            srcset="
              {{ poster_image | image_url: width: 680, format: 'webp' }} 680w,
              {{ poster_image | image_url: width: 1920, format: 'webp' }} 1920w
            "
            sizes="(max-width: 768px) 680px, 1920px"
            alt="{{ poster_image.alt | default: title | escape }}"
            loading="lazy"
            class="style-studio-hero__thumbnail"
          >
        {% endif %}
      </video>
    </div>

    {%- if show_overlay and title != blank or subtitle != blank -%}
      <div class="style-studio-hero__overlay">
        {% if title != blank %}
          <h1 class="style-studio-hero__title banner-title custom-txt-extrabold">
            {{ title }}
          </h1>
        {% endif %}
        {% if subtitle != blank %}
          <div class="style-studio-hero__subtitle banner-subtitle custom-txt-semibold">
            {{ subtitle }}
          </div>
        {% endif %}
        {% if section.settings.button_label != blank and section.settings.button_link != blank %}
          <a href="{{ section.settings.button_link }}" class="style-studio-hero__btn banner-btn custom-txt-semibold">
            <span>{{ section.settings.button_label }}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </a>
        {% endif %}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function() {
    const sectionId = '{{ section.id }}';
    function initStyleStudioVideo() {
      const sectionEl = document.querySelector('.style-studio-hero-' + sectionId);
      if (!sectionEl) return;
      const videoEl = sectionEl.querySelector('video');
      if (videoEl) {
        videoEl.muted = true;
        videoEl.setAttribute('playsinline', '');
        videoEl.setAttribute('webkit-playsinline', '');
        const p = videoEl.play();
        if (p !== undefined) {
          p.catch(function() {});
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initStyleStudioVideo);
    } else {
      initStyleStudioVideo();
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (e.target && (e.target.id === 'shopify-section-' + sectionId || e.target.querySelector('.style-studio-hero-' + sectionId))) {
        initStyleStudioVideo();
      }
    });
  })();
</script>

{% style %}
  #shopify-section-{{ section.id }} {
    margin-bottom: 0 !important;
    padding-bottom: 0 !important;
  }

  .style-studio-hero-{{ section.id }} {
    position: relative;
    width: 100%;
    background-color: #0b0b0b;
    overflow: hidden;
  }

  .style-studio-hero-{{ section.id }} .style-studio-hero__container {
    position: relative;
    width: 100%;
    /* PC 端采用 16:9 画幅，高度上限不超过 {{ desktop_max_height }}vh，不占满全屏 */
    aspect-ratio: 16 / 9;
    max-height: {{ desktop_max_height }}vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .style-studio-hero-{{ section.id }} .style-studio-hero__video-box {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .style-studio-hero-{{ section.id }} .style-studio-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    border: none;
    outline: none;
  }

  .style-studio-hero-{{ section.id }} .style-studio-hero__thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  /* 遮罩与文案层 */
  .style-studio-hero-{{ section.id }} .style-studio-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 2.5rem 1.5rem;
    box-sizing: border-box;
    pointer-events: none;
  }

  .style-studio-hero-{{ section.id }} .style-studio-hero__overlay::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.35) 100%), linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.22) 100%);
    opacity: {{ overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
    z-index: -1;
  }

  .style-studio-hero-{{ section.id }} .banner-title,
  .style-studio-hero-{{ section.id }} .style-studio-hero__title {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 900;
    color: #ffffff;
    letter-spacing: 0.06em;
    margin: 0 0 1rem 0;
    text-transform: uppercase;
    line-height: 1.15;
    text-shadow: 0 3px 18px rgba(0, 0, 0, 0.7);
  }

  .style-studio-hero-{{ section.id }} .banner-subtitle,
  .style-studio-hero-{{ section.id }} .style-studio-hero__subtitle {
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    color: rgba(255, 255, 255, 0.92);
    margin-bottom: 1.5rem;
    letter-spacing: 0.04em;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
    max-width: 820px;
    line-height: 1.45;
  }

  .style-studio-hero-{{ section.id }} .banner-btn,
  .style-studio-hero-{{ section.id }} .style-studio-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 2.4rem;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1.5px solid rgba(255, 255, 255, 0.75);
    border-radius: 35px;
    color: #ffffff !important;
    text-decoration: none;
    font-size: 1.05rem;
    cursor: pointer;
    pointer-events: auto;
    transition: all 0.25s ease;
  }

  .style-studio-hero-{{ section.id }} .banner-btn:hover,
  .style-studio-hero-{{ section.id }} .style-studio-hero__btn:hover {
    background: #ffffff;
    color: #000000 !important;
    border-color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
  }

  .style-studio-hero-{{ section.id }} .banner-btn svg,
  .style-studio-hero-{{ section.id }} .style-studio-hero__btn svg {
    transition: transform 0.25s ease;
  }

  .style-studio-hero-{{ section.id }} .banner-btn:hover svg,
  .style-studio-hero-{{ section.id }} .style-studio-hero__btn:hover svg {
    transform: translateX(3px);
  }

  @media screen and (max-width: 768px) {
    .style-studio-hero-{{ section.id }} .style-studio-hero__container {
      /* 移动端视频为 3:4 原生比例，宽度 100% 充满，高度约 520px（约 60% 屏幕高度），不占满全屏且无裁切 */
      aspect-ratio: 3 / 4;
      max-height: {{ mobile_max_height }}vh;
    }

    .style-studio-hero-{{ section.id }} .style-studio-hero__overlay {
      padding: 1.5rem 1rem;
    }

    .style-studio-hero-{{ section.id }} .banner-title,
    .style-studio-hero-{{ section.id }} .style-studio-hero__title {
      font-size: clamp(1.2rem, 5.5vw, 1.8rem);
      margin-bottom: 0.6rem;
      letter-spacing: 0.02em;
      line-height: 1.2;
      max-width: 95%;
    }

    .style-studio-hero-{{ section.id }} .banner-subtitle,
    .style-studio-hero-{{ section.id }} .style-studio-hero__subtitle {
      font-size: clamp(0.85rem, 3.2vw, 0.95rem);
      margin-bottom: 1rem;
      line-height: 1.35;
      max-width: 92%;
    }

    .style-studio-hero-{{ section.id }} .banner-btn,
    .style-studio-hero-{{ section.id }} .style-studio-hero__btn {
      padding: 0.55rem 1.6rem;
      font-size: 0.95rem;
    }
  }

  @media screen and (max-width: 400px) {
    .style-studio-hero-{{ section.id }} .banner-title,
    .style-studio-hero-{{ section.id }} .style-studio-hero__title {
      font-size: clamp(1.05rem, 5vw, 1.4rem);
      letter-spacing: 0.01em;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Style Studio Hero",
  "class": "style-studio-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "YOUR STYLE. READY TO TYPE."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Your keyboard, your chosen keycaps — professionally installed before shipping and ready to use right out of the box."
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show Text Overlay",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Text Mask Darkness (%)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30,
      "info": "Adjust how dark the background overlay behind text is (lower = lighter/more transparent)."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Desktop Video URL (MP4)",
      "default": "https://cdn.shopify.com/videos/c/o/v/fbc3f84973e54949bb999e41160928fe.mp4"
    },
    {
      "type": "text",
      "id": "video_url_mobile",
      "label": "Mobile Video URL (MP4)",
      "default": "https://cdn.shopify.com/videos/c/o/v/1512aebe62804c178813fd38e625ec59.mp4"
    },
    {
      "type": "range",
      "id": "desktop_max_height",
      "label": "Desktop Max Height (% of screen)",
      "min": 40,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 70,
      "info": "Keeps video banner height within viewport (default 70% of screen)."
    },
    {
      "type": "range",
      "id": "mobile_max_height",
      "label": "Mobile Max Height (% of screen)",
      "min": 40,
      "max": 85,
      "step": 5,
      "unit": "%",
      "default": 65,
      "info": "Keeps video banner height within mobile viewport (default 65% of screen)."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify Desktop Video (Optional)",
      "info": "Overrides Desktop Video URL if selected."
    },
    {
      "type": "video",
      "id": "video_m",
      "label": "Shopify Mobile Video (Optional)",
      "info": "Overrides Mobile Video URL if selected."
    },
    {
      "type": "image_picker",
      "id": "video_thumbnail",
      "label": "Video Thumbnail / Poster Image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Style Studio Hero"
    }
  ]
}
{% endschema %}