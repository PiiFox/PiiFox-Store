{%- liquid
  assign show_section = false

  # 仅在 Collection（集合/列表）页面展示，其他页面（首页、隐私政策、普通页面等）均不展示
  if template contains 'collection' or request.page_type == 'collection'
    assign show_section = true
    if section.settings.enable_section == false
      assign show_section = false
    endif
  endif
-%}

{%- if show_section -%}
  <div class="icon-list-marquee-section-{{ section.id }}" data-section-id="{{ section.id }}" data-section-type="icon-list-marquee">
    <div class="icon-list-marquee--wrapper page-width">
      <div class="icon-list-marquee-section-content">
        <div class="icon-list-marquee-container">
          <div class="icon-list-marquee">
            {% if section.blocks.size > 0 %}
              {% for block in section.blocks %}
                {% render 'icon-list-marquee-item', block: block %}
              {% endfor %}
            {% else %}
              <div class="icon-item">
                {% if settings.top_service_icon_1 != blank %}
                  <img class="icon-item-icon" src="{{ settings.top_service_icon_1 | image_url: width: 40 }}" alt="{{ settings.top_service_title_1 | default: 'Hassle-Free Warranty' | escape }}" width="40" height="40" loading="lazy">
                {% else %}
                  <img class="icon-item-icon" src="{{ 'header-icon1.png' | file_img_url: '40x' }}" alt="Hassle-Free Warranty" width="40" height="40" loading="lazy">
                {% endif %}
                <div class="icon-item-context custom-txt-semibold">{{ settings.top_service_title_1 | default: 'Hassle-Free Warranty' }}</div>
              </div>
              <div class="icon-item">
                {% if settings.top_service_icon_2 != blank %}
                  <img class="icon-item-icon" src="{{ settings.top_service_icon_2 | image_url: width: 40 }}" alt="{{ settings.top_service_title_2 | default: 'Pay with Ease' | escape }}" width="40" height="40" loading="lazy">
                {% else %}
                  <img class="icon-item-icon" src="{{ 'header-icon2.png' | file_img_url: '40x' }}" alt="Pay with Ease" width="40" height="40" loading="lazy">
                {% endif %}
                <div class="icon-item-context custom-txt-semibold">{{ settings.top_service_title_2 | default: 'Pay with Ease' }}</div>
              </div>
              <div class="icon-item">
                {% if settings.top_service_icon_3 != blank %}
                  <img class="icon-item-icon" src="{{ settings.top_service_icon_3 | image_url: width: 40 }}" alt="{{ settings.top_service_title_3 | default: 'Secure-Fast Delivery' | escape }}" width="40" height="40" loading="lazy">
                {% else %}
                  <img class="icon-item-icon" src="{{ 'header-icon3.png' | file_img_url: '40x' }}" alt="Secure-Fast Delivery" width="40" height="40" loading="lazy">
                {% endif %}
                <div class="icon-item-context custom-txt-semibold">{{ settings.top_service_title_3 | default: 'Secure-Fast Delivery' }}</div>
              </div>
              <div class="icon-item">
                {% if settings.top_service_icon_4 != blank %}
                  <img class="icon-item-icon" src="{{ settings.top_service_icon_4 | image_url: width: 40 }}" alt="{{ settings.top_service_title_4 | default: 'Hassle-Free Returns' | escape }}" width="40" height="40" loading="lazy">
                {% else %}
                  <img class="icon-item-icon" src="{{ 'header-icon4.png' | file_img_url: '40x' }}" alt="Hassle-Free Returns" width="40" height="40" loading="lazy">
                {% endif %}
                <div class="icon-item-context custom-txt-semibold">{{ settings.top_service_title_4 | default: 'Hassle-Free Returns' }}</div>
              </div>
              <div class="icon-item">
                {% if settings.top_service_icon_4 != blank %}
                  <img class="icon-item-icon" src="{{ settings.top_service_icon_4 | image_url: width: 40 }}" alt="Wide Compatibility" width="40" height="40" loading="lazy">
                {% else %}
                  <img class="icon-item-icon" src="{{ 'header-icon4.png' | file_img_url: '40x' }}" alt="Wide Compatibility" width="40" height="40" loading="lazy">
                {% endif %}
                <div class="icon-item-context custom-txt-semibold">Wide Compatibility</div>
              </div>
            {% endif %}
          </div>

          <!-- 关键：复制一份，实现无缝 -->
          <div class="icon-list-marquee overflow-hidden" aria-hidden="true">
            {% if section.blocks.size > 0 %}
              {% for block in section.blocks %}
                {% render 'icon-list-marquee-item', block: block %}
              {% endfor %}
            {% else %}
              <div class="icon-item">
                {% if settings.top_service_icon_1 != blank %}
                  <img class="icon-item-icon" src="{{ settings.top_service_icon_1 | image_url: width: 40 }}" alt="{{ settings.top_service_title_1 | default: 'Hassle-Free Warranty' | escape }}" width="40" height="40" loading="lazy">
                {% else %}
                  <img class="icon-item-icon" src="{{ 'header-icon1.png' | file_img_url: '40x' }}" alt="Hassle-Free Warranty" width="40" height="40" loading="lazy">
                {% endif %}
                <div class="icon-item-context custom-txt-semibold">{{ settings.top_service_title_1 | default: 'Hassle-Free Warranty' }}</div>
              </div>
              <div class="icon-item">
                {% if settings.top_service_icon_2 != blank %}
                  <img class="icon-item-icon" src="{{ settings.top_service_icon_2 | image_url: width: 40 }}" alt="{{ settings.top_service_title_2 | default: 'Pay with Ease' | escape }}" width="40" height="40" loading="lazy">
                {% else %}
                  <img class="icon-item-icon" src="{{ 'header-icon2.png' | file_img_url: '40x' }}" alt="Pay with Ease" width="40" height="40" loading="lazy">
                {% endif %}
                <div class="icon-item-context custom-txt-semibold">{{ settings.top_service_title_2 | default: 'Pay with Ease' }}</div>
              </div>
              <div class="icon-item">
                {% if settings.top_service_icon_3 != blank %}
                  <img class="icon-item-icon" src="{{ settings.top_service_icon_3 | image_url: width: 40 }}" alt="{{ settings.top_service_title_3 | default: 'Secure-Fast Delivery' | escape }}" width="40" height="40" loading="lazy">
                {% else %}
                  <img class="icon-item-icon" src="{{ 'header-icon3.png' | file_img_url: '40x' }}" alt="Secure-Fast Delivery" width="40" height="40" loading="lazy">
                {% endif %}
                <div class="icon-item-context custom-txt-semibold">{{ settings.top_service_title_3 | default: 'Secure-Fast Delivery' }}</div>
              </div>
              <div class="icon-item">
                {% if settings.top_service_icon_4 != blank %}
                  <img class="icon-item-icon" src="{{ settings.top_service_icon_4 | image_url: width: 40 }}" alt="{{ settings.top_service_title_4 | default: 'Hassle-Free Returns' | escape }}" width="40" height="40" loading="lazy">
                {% else %}
                  <img class="icon-item-icon" src="{{ 'header-icon4.png' | file_img_url: '40x' }}" alt="Hassle-Free Returns" width="40" height="40" loading="lazy">
                {% endif %}
                <div class="icon-item-context custom-txt-semibold">{{ settings.top_service_title_4 | default: 'Hassle-Free Returns' }}</div>
              </div>
              <div class="icon-item">
                {% if settings.top_service_icon_4 != blank %}
                  <img class="icon-item-icon" src="{{ settings.top_service_icon_4 | image_url: width: 40 }}" alt="Wide Compatibility" width="40" height="40" loading="lazy">
                {% else %}
                  <img class="icon-item-icon" src="{{ 'header-icon4.png' | file_img_url: '40x' }}" alt="Wide Compatibility" width="40" height="40" loading="lazy">
                {% endif %}
                <div class="icon-item-context custom-txt-semibold">Wide Compatibility</div>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>

  {% style %}
    .icon-list-marquee-section-{{ section.id }} {
      background-color: {{ section.settings.bg_color | default: '#f5f5f7' }};
      padding: 2em 0;
    }
    .icon-list-marquee-section-{{ section.id }} .icon-list-marquee-section-title {
      font-size: 2.4em;
      font-weight: bold;
      text-align: center;
      margin-bottom: 1em;
    }
    .icon-list-marquee-section-{{ section.id }} .icon-list-marquee-section-content {
      width: 100%;
      overflow: hidden;
    }
    .icon-list-marquee-section-{{ section.id }} .icon-list-marquee-container {
      display: flex;
      width: 100%;
    }
    .icon-list-marquee-section-{{ section.id }} .icon-list-marquee {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-around;
      gap: 4em; /* 图标之间的间距 */
      padding: 0 1em;
    }
    .icon-list-marquee-section-{{ section.id }} .icon-list-marquee.overflow-hidden {
      display: none;
    }
    .icon-list-marquee-section-{{ section.id }} .icon-item {
      display: flex;
      align-items: center;
      white-space: nowrap;
    }
    .icon-list-marquee-section-{{ section.id }} .icon-item-icon {
      width: 1.2em;
      height: 1.2em;
      object-fit: cover;
    }
    .icon-list-marquee-section-{{ section.id }} .icon-item-context {
      font-size: 1em;
      margin-left: 0.5em;
      line-height: 1.2em;
    }

    @keyframes marquee {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(-50%);
      }
    }
    @media screen and (max-width: 1440px) {
      .icon-list-marquee-section-{{ section.id }} .icon-list-marquee-container {
        width: max-content;
        animation: marquee {{ section.settings.scroll_speed | default: 18 }}s linear infinite; 
      }
      .icon-list-marquee-section-{{ section.id }} .icon-list-marquee {
        width: unset;
      }
      .icon-list-marquee-section-{{ section.id }} .icon-list-marquee.overflow-hidden {
        display: flex;
      }
    }
  {% endstyle %}

  <script>
    (function() {
      function placeMarqueeUnderHero() {
        var marquee = document.getElementById('shopify-section-{{ section.id }}') || document.querySelector('.icon-list-marquee-section-{{ section.id }}');
        if (!marquee) return;
        var topLevelMarquee = marquee.closest('.shopify-section') || marquee;

        // 优先匹配 .index-section--hero，或轮播横幅组件
        var hero = document.querySelector('.index-section--hero') || document.querySelector('[class*="swiper-"]');
        if (hero) {
          var heroSection = hero.closest('.shopify-section') || hero;
          if (heroSection && heroSection.parentNode && heroSection.nextSibling !== topLevelMarquee) {
            heroSection.parentNode.insertBefore(topLevelMarquee, heroSection.nextSibling);
          }
        }
      }

      // 1. 立即执行（DOM 解析至此时通常已包含之前的 Hero 节点）
      placeMarqueeUnderHero();

      // 2. DOMContentLoaded 时再次确认
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', placeMarqueeUnderHero);
      }

      // 3. 页面加载完成时
      window.addEventListener('load', placeMarqueeUnderHero);

      // 4. 兼容 Shopify Customize 装修后台热重载事件
      document.addEventListener('shopify:section:load', function(e) {
        setTimeout(placeMarqueeUnderHero, 30);
      });
      document.addEventListener('shopify:section:reorder', function(e) {
        setTimeout(placeMarqueeUnderHero, 30);
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Icon List Marquee",
  "class": "icon-list-marquee-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable Section",
      "default": true
    },
    {
      "type": "header",
      "content": "Style & Animation"
    },
    {
      "type": "number",
      "id": "scroll_speed",
      "label": "Scroll Speed (seconds)",
      "default": 18
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f5f5f7"
    }
  ],
  "blocks": [
    {
      "type": "icon_item",
      "name": "Icon Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "context",
          "label": "Context",
          "default": "Feature highlight"
        }
      ]
    }
  ]
}
{% endschema %}
