<script>
  (function() {
    const rootSelector = '#StyleStudio-{{ section.id }}';

    const initStyleStudio = function(attempt) {
      const root = document.querySelector(rootSelector);
      if (!root) return;
      if (root.dataset.initialized === 'true') return;

      const topCarouselEl = root.querySelector('.top-theme-carousel');
      const themeCells = root.querySelectorAll('.theme-cell');
      const hasFlickity = typeof window.Flickity === 'function';
      const updateTopCardOffsets = function(selectedIndex) {
        const totalCells = themeCells.length;
        if (!totalCells || typeof selectedIndex !== 'number') return;

        themeCells.forEach(function(cell, index) {
          let relativeIndex = index - selectedIndex;
          if (relativeIndex > totalCells / 2) relativeIndex -= totalCells;
          if (relativeIndex < -totalCells / 2) relativeIndex += totalCells;

          cell.classList.toggle('is-before-selected', relativeIndex < 0);
          cell.classList.toggle('is-after-selected', relativeIndex > 0);
        });
      };

      const announceTopSelection = function(selectedIndex) {
        root.dispatchEvent(
          new CustomEvent('style-studio:theme-selected', {
            detail: { index: selectedIndex }
          })
        );
      };

      const getTopContentWidth = function() {
        if (!topCarouselEl || !themeCells.length) return 0;

        return Array.prototype.reduce.call(themeCells, function(total, cell) {
          const cellStyles = window.getComputedStyle(cell);
          const marginRight = parseFloat(cellStyles.marginRight) || 0;

          return total + cell.getBoundingClientRect().width + marginRight;
        }, 0);
      };

      const hasTopOverflow = function() {
        return Boolean(
          topCarouselEl &&
          getTopContentWidth() > topCarouselEl.clientWidth + 1
        );
      };

      if (topCarouselEl && !hasFlickity && hasTopOverflow() && attempt < 20) {
        window.setTimeout(function() {
          initStyleStudio(attempt + 1);
        }, 150);
        return;
      }

      root.dataset.initialized = 'true';

      let flktyTop = null;
      let topResizeFrame = null;

      const stopTopCarousel = function() {
        if (!flktyTop) return;

        const selectedIndex = flktyTop.selectedIndex;
        flktyTop.destroy();
        flktyTop = null;

        themeCells.forEach(function(cell) {
          cell.classList.toggle(
            'is-selected',
            Number(cell.dataset.index) === selectedIndex
          );
        });
        updateTopCardOffsets(selectedIndex);
        announceTopSelection(selectedIndex);
      };

      const startTopCarousel = function() {
        if (
          !topCarouselEl ||
          !hasFlickity ||
          flktyTop ||
          themeCells.length < 2 ||
          !hasTopOverflow()
        ) {
          return;
        }

        flktyTop = new window.Flickity(topCarouselEl, {
          cellAlign: 'center',
          wrapAround: true,
          autoPlay: 5000,
          pauseAutoPlayOnHover: false,
          draggable: true,
          dragThreshold: 8,
          prevNextButtons: false,
          pageDots: false,
          initialIndex: {{ initial_theme_index }},
          selectedAttraction: 0.018,
          friction: 0.24
        });

        const restartTopAutoplay = function() {
          if (flktyTop && typeof flktyTop.playPlayer === 'function') {
            flktyTop.playPlayer();
          }
        };

        flktyTop.on('dragEnd', restartTopAutoplay);
        flktyTop.on('select', function(selectedIndex) {
          updateTopCardOffsets(selectedIndex);
          announceTopSelection(selectedIndex);
        });
        flktyTop.on('staticClick', function(event, pointer, cellElement, cellIndex) {
          if (typeof cellIndex === 'number') {
            flktyTop.select(cellIndex);
            restartTopAutoplay();
          }
        });

        updateTopCardOffsets(flktyTop.selectedIndex);

        window.setTimeout(function() {
          if (flktyTop) {
            flktyTop.resize();
            flktyTop.reposition();
          }
        }, 150);
      };

      const syncTopCarousel = function() {
        if (!topCarouselEl) return;

        if (hasTopOverflow() && themeCells.length > 1) {
          startTopCarousel();
          if (flktyTop) {
            flktyTop.resize();
            flktyTop.reposition();
          }
        } else {
          stopTopCarousel();
        }
      };

      const handleTopResize = function() {
        if (topResizeFrame !== null) {
          window.cancelAnimationFrame(topResizeFrame);
        }

        topResizeFrame = window.requestAnimationFrame(function() {
          topResizeFrame = null;
          syncTopCarousel();
        });
      };

      if (topCarouselEl) {
        window.addEventListener('resize', handleTopResize);
        syncTopCarousel();
      }

      const bottomCarouselEl = root.querySelector('.bottom-style-carousel');
      const prevBtn = root.querySelector('.btn-prev');
      const nextBtn = root.querySelector('.btn-next');
      const dotsContainer = root.querySelector('.custom-dots');
      const styleCells = Array.from(root.querySelectorAll('.style-cell'));

      if (!bottomCarouselEl || !prevBtn || !nextBtn || !dotsContainer) return;

      let dots = [];

      const getPageCount = function() {
        const pageWidth = bottomCarouselEl.clientWidth;
        const maxScroll = Math.max(0, bottomCarouselEl.scrollWidth - pageWidth);

        if (!pageWidth) return 1;
        return Math.max(1, Math.ceil(maxScroll / pageWidth) + 1);
      };

      const getPagePositions = function(pageCount) {
        const pageWidth = bottomCarouselEl.clientWidth;
        const maxScroll = Math.max(0, bottomCarouselEl.scrollWidth - pageWidth);

        return Array.from({ length: pageCount }, function(_, index) {
          return Math.min(index * pageWidth, maxScroll);
        });
      };

      const getActivePageIndex = function(pagePositions) {
        let activeIndex = 0;
        let nearestDistance = Infinity;

        pagePositions.forEach(function(pagePosition, index) {
          const distance = Math.abs(bottomCarouselEl.scrollLeft - pagePosition);

          if (distance < nearestDistance) {
            nearestDistance = distance;
            activeIndex = index;
          }
        });

        return activeIndex;
      };

      const scrollToPage = function(pageIndex) {
        const pagePositions = getPagePositions(getPageCount());
        const targetIndex = Math.max(0, Math.min(pageIndex, pagePositions.length - 1));

        bottomCarouselEl.scrollTo({
          left: pagePositions[targetIndex],
          behavior: 'smooth'
        });
      };

      const renderDots = function() {
        const pageCount = getPageCount();

        if (dots.length !== pageCount) {
          dotsContainer.innerHTML = '';

          for (let index = 0; index < pageCount; index += 1) {
            const dot = document.createElement('button');
            dot.type = 'button';
            dot.className = 'dot';
            dot.setAttribute('aria-label', 'Go to page ' + (index + 1));
            dot.addEventListener('click', function() {
              scrollToPage(index);
            });
            dotsContainer.appendChild(dot);
          }

          dots = Array.prototype.slice.call(dotsContainer.querySelectorAll('.dot'));
        }

        return pageCount;
      };

      const updateDots = function() {
        const pageCount = renderDots();
        const pagePositions = getPagePositions(pageCount);
        const activeIndex = getActivePageIndex(pagePositions);

        dots.forEach(function(dot, index) {
          dot.classList.toggle('is-selected', index === activeIndex);
          dot.setAttribute('aria-current', index === activeIndex ? 'page' : 'false');
        });
      };

      const syncBottomCards = function(selectedIndex) {
        const selectedThemeCell = themeCells[selectedIndex] || themeCells[0];
        const collectionHandle = selectedThemeCell
          ? selectedThemeCell.getAttribute('data-collection-handle')
          : '';
        const shouldFilter = Boolean(collectionHandle);

        styleCells.forEach(function(styleCell) {
          const styleCollectionHandle = styleCell.getAttribute(
            'data-collection-handle'
          );
          const shouldShow =
            !shouldFilter || styleCollectionHandle === collectionHandle;

          styleCell.hidden = !shouldShow;
        });

        bottomCarouselEl.scrollLeft = 0;
        updateDots();
      };

      root.addEventListener('style-studio:theme-selected', function(event) {
        const selectedIndex = event.detail && Number(event.detail.index);
        if (Number.isFinite(selectedIndex)) {
          syncBottomCards(selectedIndex);
        }
      });

      syncBottomCards({{ initial_theme_index }});

      prevBtn.addEventListener('click', function() {
        const pagePositions = getPagePositions(getPageCount());
        scrollToPage(getActivePageIndex(pagePositions) - 1);
      });

      nextBtn.addEventListener('click', function() {
        const pagePositions = getPagePositions(getPageCount());
        scrollToPage(getActivePageIndex(pagePositions) + 1);
      });

      bottomCarouselEl.addEventListener('scroll', updateDots, { passive: true });
      window.addEventListener('resize', updateDots);
      updateDots();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        initStyleStudio(0);
      });
    } else {
      initStyleStudio(0);
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail.sectionId === '{{ section.id }}') {
        initStyleStudio(0);
      }
    });
  })();
</script>

