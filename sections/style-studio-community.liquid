<section class="style-studio-community style-studio-community-{{ section.id }}">
  <div class="style-studio-community__inner">
    {% if section.settings.heading != blank %}
      <div class="style-studio-community__header">
        {% if section.settings.eyebrow != blank %}
          <p class="style-studio-community__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        <h2>{{ section.settings.heading | escape }}</h2>
        {% if section.settings.subheading != blank %}
          <p>{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="style-studio-community__grid">
      {% for block in section.blocks %}
        {% assign image = block.settings.image %}
        <div class="style-studio-community__tile" {{ block.shopify_attributes }}>
          {% if image != blank %}
            <img
              src="{{ image | image_url: width: 900 }}"
              alt="{{ block.settings.alt | default: block.settings.title | default: 'Community setup' | escape }}"
              loading="lazy"
              width="{{ image.width | default: 700 }}"
              height="{{ image.height | default: 700 }}"
            >
          {% else %}
            <div class="style-studio-community__placeholder" aria-label="Community setup placeholder"></div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if section.settings.button_label != blank and section.settings.button_link != blank %}
      <div class="style-studio-community__actions">
        <a href="{{ section.settings.button_link }}" class="style-studio-community__button">
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% style %}
  .style-studio-community-{{ section.id }} {
    background: #f3efe9;
    color: #111111;
    padding: 5rem 0;
  }

  .style-studio-community-{{ section.id }}__inner {
    width: min(100% - 2rem, 1320px);
    margin: 0 auto;
  }

  .style-studio-community-{{ section.id }}__header {
    text-align: center;
    margin-bottom: 2.25rem;
  }

  .style-studio-community-{{ section.id }}__eyebrow {
    margin: 0 0 0.75rem;
    color: #1f5b2f;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .style-studio-community-{{ section.id }}__header h2 {
    margin: 0;
    font-size: clamp(2.2rem, 3vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  .style-studio-community-{{ section.id }}__header p {
    max-width: 46rem;
    margin: 1rem auto 0;
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(17, 17, 17, 0.72);
  }

  .style-studio-community-{{ section.id }}__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .style-studio-community-{{ section.id }}__tile {
    overflow: hidden;
    border-radius: 1.25rem;
    background: #e6e0d7;
    min-height: 240px;
  }

  .style-studio-community-{{ section.id }}__tile img,
  .style-studio-community-{{ section.id }}__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .style-studio-community-{{ section.id }}__placeholder {
    min-height: 240px;
    background: linear-gradient(135deg, #d8d0c2, #f2e9df);
  }

  .style-studio-community-{{ section.id }}__actions {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  .style-studio-community-{{ section.id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.7rem;
    border-radius: 999px;
    background: #111111;
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
  }

  @media screen and (max-width: 767px) {
    .style-studio-community-{{ section.id }} {
      padding: 4rem 0;
    }

    .style-studio-community-{{ section.id }}__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Style Studio Community",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Community"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built by the keyboard community"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "See how setups evolve with new style stories, favorite themes, and custom layouts from around the world."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Join the community"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "default": "Community keyboard setup"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Style Studio Community",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
