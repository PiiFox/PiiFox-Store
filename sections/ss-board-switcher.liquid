{%- comment -%}
  Style Studio Board Switcher
  Shows three keyboard bases. Clicking a color option below a base swaps the
  image to a different keycap "installed" look.

  Each block = one keyboard base.
    - base_image: image of the empty base (optional, falls back to generated art)
    - options:    repeatable options, each with a label, a color swatch and an
                  installed (keycaps on) image.
{%- endcomment -%}

<section class="ss-switch ss-switch-{{ section.id }}" data-ss-switch>
  <div class="ss-switch__inner">
    {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
      <div class="ss-switch__header">
        {%- if section.settings.title != blank -%}
          <h2 class="ss-switch__title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="ss-switch__subtitle">{{ section.settings.subtitle | escape | newline_to_br }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="ss-switch__grid">
      {%- for block in section.blocks -%}
        {%- assign base_handle = block.settings.base_handle | default: block.id -%}
        <article class="ss-switch__base" data-ss-base {{ block.shopify_attributes }}>
          <div class="ss-switch__stage">
            {%- comment -%} Installed (keycaps on) images, one per option {%- endcomment -%}
            {%- for i in (1..5) -%}
              {%- assign image_key = 'option_' | append: i | append: '_image' -%}
              {%- assign color_key = 'option_' | append: i | append: '_color' -%}
              {%- assign label_key = 'option_' | append: i | append: '_label' -%}
              {%- assign opt_image = block.settings[image_key] -%}
              {%- assign opt_color = block.settings[color_key] -%}
              {%- assign opt_label = block.settings[label_key] -%}
              {%- if opt_image != blank or opt_color != blank -%}
                <div
                  class="ss-switch__slide{% if forloop.first %} is-active{% endif %}"
                  data-ss-slide="{{ i }}"
                >
                  {%- if opt_image != blank -%}
                    <img
                      class="ss-switch__slide-img"
                      src="{{ opt_image | image_url: width: 1200 }}"
                      alt="{{ opt_label | default: block.settings.title | escape }}"
                      loading="lazy"
                      width="{{ opt_image.width }}"
                      height="{{ opt_image.height }}"
                    >
                  {%- else -%}
                    <div class="ss-switch__svg">
                      {%- render 'style-studio-svg-art', name: 'board-base', color: opt_color -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}

            {%- if block.settings.base_image != blank -%}
              <img
                class="ss-switch__base-img"
                src="{{ block.settings.base_image | image_url: width: 1200 }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                width="{{ block.settings.base_image.width }}"
                height="{{ block.settings.base_image.height }}"
              >
            {%- endif -%}
          </div>

          {%- if block.settings.title != blank -%}
            <h3 class="ss-switch__base-title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}

          <div class="ss-switch__options" role="group" aria-label="{{ block.settings.title | escape | append: ' colors' }}">
            {%- for i in (1..5) -%}
              {%- assign color_key = 'option_' | append: i | append: '_color' -%}
              {%- assign label_key = 'option_' | append: i | append: '_label' -%}
              {%- assign image_key = 'option_' | append: i | append: '_image' -%}
              {%- assign opt_color = block.settings[color_key] -%}
              {%- assign opt_label = block.settings[label_key] -%}
              {%- assign opt_image = block.settings[image_key] -%}
              {%- if opt_color != blank or opt_image != blank -%}
                <button
                  type="button"
                  class="ss-switch__option{% if forloop.first %} is-active{% endif %}"
                  data-ss-option="{{ i }}"
                  style="--ss-swatch: {{ opt_color | default: '#cccccc' }};"
                  aria-label="{{ opt_label | default: 'Color' }}"
                  aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                >
                  <span class="ss-switch__swatch" aria-hidden="true"></span>
                  {%- if opt_label != blank -%}
                    <span class="ss-switch__option-label">{{ opt_label | escape }}</span>
                  {%- endif -%}
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  .ss-switch-{{ section.id }} {
    width: 100%;
    background-color: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .ss-switch-{{ section.id }} .ss-switch__inner {
    width: min(100% - 40px, 1320px);
    margin: 0 auto;
  }

  .ss-switch-{{ section.id }} .ss-switch__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .ss-switch-{{ section.id }} .ss-switch__title {
    margin: 0;
    color: {{ section.settings.title_color }};
    font-size: 34px;
    font-weight: 700;
    line-height: 1.15;
  }

  .ss-switch-{{ section.id }} .ss-switch__subtitle {
    max-width: 46em;
    margin: 12px auto 0;
    color: {{ section.settings.subtitle_color }};
    font-size: 16px;
    line-height: 1.6;
  }

  .ss-switch-{{ section.id }} .ss-switch__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: {{ section.settings.gap }}px;
  }

  .ss-switch-{{ section.id }} .ss-switch__base {
    display: flex;
    flex-direction: column;
    background-color: {{ section.settings.card_color }};
    border: 1px solid rgba(0, 0, 0, 0.07);
    border-radius: 16px;
    padding: 18px;
  }

  .ss-switch-{{ section.id }} .ss-switch__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    overflow: hidden;
    background-color: #f6f4ef;
  }

  .ss-switch-{{ section.id }} .ss-switch__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ss-switch-{{ section.id }} .ss-switch__slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  .ss-switch-{{ section.id }} .ss-switch__slide-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ss-switch-{{ section.id }} .ss-switch__svg,
  .ss-switch-{{ section.id }} .ss-switch__svg svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ss-switch-{{ section.id }} .ss-switch__base-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    opacity: 0;
  }

  .ss-switch-{{ section.id }} .ss-switch__base-title {
    margin: 16px 0 0;
    color: {{ section.settings.card_title_color }};
    font-size: 17px;
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
  }

  .ss-switch-{{ section.id }} .ss-switch__options {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 14px;
  }

  .ss-switch-{{ section.id }} .ss-switch__option {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 8px;
    border: 1px solid #dfe3e0;
    border-radius: 999px;
    background-color: #ffffff;
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    font: inherit;
  }

  .ss-switch-{{ section.id }} .ss-switch__option:hover {
    border-color: {{ section.settings.accent_color }};
  }

  .ss-switch-{{ section.id }} .ss-switch__option.is-active {
    border-color: {{ section.settings.accent_color }};
    box-shadow: 0 0 0 2px {{ section.settings.accent_color }}33;
    background-color: #fbfdfa;
  }

  .ss-switch-{{ section.id }} .ss-switch__swatch {
    display: block;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: var(--ss-swatch);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12);
  }

  .ss-switch-{{ section.id }} .ss-switch__option-label {
    color: {{ section.settings.card_title_color }};
    font-size: 13px;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
  }

  @media screen and (max-width: 989px) {
    .ss-switch-{{ section.id }} .ss-switch__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 769px) {
    .ss-switch-{{ section.id }} {
      padding: {{ section.settings.padding_top | times: 0.65 | round }}px 0 {{ section.settings.padding_bottom | times: 0.65 | round }}px;
    }

    .ss-switch-{{ section.id }} .ss-switch__inner {
      width: calc(100% - 32px);
    }

    .ss-switch-{{ section.id }} .ss-switch__header {
      margin-bottom: 24px;
    }

    .ss-switch-{{ section.id }} .ss-switch__title {
      font-size: 24px;
    }

    .ss-switch-{{ section.id }} .ss-switch__subtitle {
      font-size: 14px;
    }

    .ss-switch-{{ section.id }} .ss-switch__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: {{ section.settings.gap | times: 0.7 | round }}px;
    }
  }
{% endstyle %}

<script>
  (function () {
    function initSection(root) {
      if (!root || root.dataset.ssSwitchInit === 'true') return;
      root.dataset.ssSwitchInit = 'true';

      root.querySelectorAll('[data-ss-base]').forEach(function (base) {
        var slides = base.querySelectorAll('[data-ss-slide]');
        var options = base.querySelectorAll('[data-ss-option]');

        options.forEach(function (option) {
          option.addEventListener('click', function () {
            var target = option.getAttribute('data-ss-option');

            options.forEach(function (o) {
              var active = o === option;
              o.classList.toggle('is-active', active);
              o.setAttribute('aria-pressed', active ? 'true' : 'false');
            });

            slides.forEach(function (slide) {
              slide.classList.toggle(
                'is-active',
                slide.getAttribute('data-ss-slide') === target
              );
            });
          });
        });
      });
    }

    function initAll() {
      document.querySelectorAll('[data-ss-switch]').forEach(initSection);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    document.addEventListener('shopify:section:load', function (event) {
      var section = event.target.querySelector
        ? event.target.querySelector('[data-ss-switch]')
        : null;
      if (section) initSection(section);
    });
  })();
</script>

{% schema %}
{
