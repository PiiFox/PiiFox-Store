{%- assign explore_background_image = blank -%}
{%- assign explore_mobile_background_image = blank -%}

{%- if section.settings.background_image != blank -%}
  {%- assign explore_background_image = section.settings.background_image | image_url: width: 2400 -%}
{%- endif -%}

{%- if section.settings.mobile_background_image != blank -%}
  {%- assign explore_mobile_background_image = section.settings.mobile_background_image | image_url: width: 1600 -%}
{%- elsif explore_background_image != blank -%}
  {%- assign explore_mobile_background_image = explore_background_image -%}
{%- endif -%}

<div class="style-studio-explore-frame style-studio-explore-frame-{{ section.id }}">
  <section
    class="style-studio-explore style-studio-explore-{{ section.id }}"
    {% if explore_background_image != blank or explore_mobile_background_image != blank %}style="--style-studio-explore-background-image: url('{{ explore_background_image }}'); --style-studio-explore-mobile-background-image: url('{{ explore_mobile_background_image }}');"{% endif %}
  >
  <div class="style-studio-explore__content">
    {%- if section.settings.title != blank -%}
      <h2 class="style-studio-explore__title">
        {{ section.settings.title | escape | newline_to_br }}
      </h2>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="style-studio-explore__subtitle">
        {{ section.settings.subtitle | escape | newline_to_br }}
      </p>
    {%- endif -%}

    {%- assign visible_button_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.label != blank -%}
        {%- assign visible_button_count = visible_button_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if visible_button_count > 0 -%}
      <div class="style-studio-explore__buttons" role="group" aria-label="Explore links">
        {%- for block in section.blocks -%}
          {%- if block.settings.label != blank -%}
            {%- assign button_tag = 'span' -%}
            {%- if block.settings.link != blank -%}
              {%- assign button_tag = 'a' -%}
            {%- endif -%}

            <{{ button_tag }}
              class="style-studio-explore__button"
              {% if button_tag == 'a' %}href="{{ block.settings.link | escape }}"{% else %}aria-disabled="true"{% endif %}
              style="--style-studio-explore-button-background: {{ block.settings.background_color }}; --style-studio-explore-button-text: {{ block.settings.text_color }};"
              {{ block.shopify_attributes }}
            >
              <span>{{ block.settings.label | escape }}</span>
              <span class="style-studio-explore__button-arrow" aria-hidden="true">→</span>
            </{{ button_tag }}>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
  </section>
</div>

{% style %}
  .style-studio-explore-frame-{{ section.id }} {
    width: 100%;
    padding: 2em 0;
    box-sizing: border-box;
  }

  .style-studio-explore-{{ section.id }} {
    --style-studio-explore-ink: #111111;
    --style-studio-explore-border: #214d0d;
    position: relative;
    display: flex;
    align-items: center;
    width: 95vw;
    margin: 0 auto;
    overflow: hidden;
    box-sizing: border-box;
    border-radius: 24px;
    box-shadow: 0 0 30px rgba(0, 0, 0, 0.2);
    background-color: #ffffff;
    background-image: var(--style-studio-explore-background-image);
    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
    color: var(--style-studio-explore-ink);
  }

  .style-studio-explore-{{ section.id }} .style-studio-explore__content {
    width: min(42%, 680px);
    margin-left: 4vw;
    padding: 4.1vw 0;
    box-sizing: border-box;
  }

  .style-studio-explore-{{ section.id }} .style-studio-explore__title {
    max-width: 12em;
    margin: 0;
    color: var(--style-studio-explore-ink);
    font-size: 3.15vw;
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: 0.03em;
  }

  .style-studio-explore-{{ section.id }} .style-studio-explore__subtitle {
    max-width: 27em;
    margin: 1.9vw 0 0;
    color: var(--style-studio-explore-ink);
    font-size: 1.4vw;
    line-height: 1.35;
  }

  .style-studio-explore-{{ section.id }} .style-studio-explore__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5vw;
    margin-top: 3vw;
  }

  .style-studio-explore-{{ section.id }} .style-studio-explore__button {
    display: inline-flex;
    flex: 0 0 clamp(230px, 18vw, 300px);
    align-items: center;
    justify-content: space-between;
    gap: 22px;
    width: clamp(230px, 18vw, 300px);
    min-width: 0;
    padding: 0.9em 1.35em;
    border: 1px solid var(--style-studio-explore-border);
    border-radius: 12px;
    box-sizing: border-box;
    background: var(--style-studio-explore-button-background);
    color: var(--style-studio-explore-button-text);
    font-size: 1.25vw;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition: filter 160ms ease, transform 160ms ease;
  }

  .style-studio-explore-{{ section.id }} .style-studio-explore__button:hover,
  .style-studio-explore-{{ section.id }} .style-studio-explore__button:focus-visible {
    filter: brightness(0.92);
    transform: translateY(-1px);
  }

  .style-studio-explore-{{ section.id }} .style-studio-explore__button:focus-visible {
    outline: 2px solid var(--style-studio-explore-ink);
    outline-offset: 3px;
  }

  .style-studio-explore-{{ section.id }} .style-studio-explore__button-arrow {
    flex: 0 0 auto;
    font-size: 1.25em;
    line-height: 1;
  }

  @media screen and (max-width: 769px) {
    .style-studio-explore-frame-{{ section.id }} {
      padding: 1.7em 0;
    }

    .style-studio-explore-{{ section.id }} {
      width: 95%;
      margin: 0 auto;
      align-items: flex-start;
      border-radius: 18px;
      background-position: 40% center;
      background-size: auto 100%;
      background-image: var(--style-studio-explore-mobile-background-image);
    }

    .style-studio-explore-{{ section.id }} .style-studio-explore__content {
      width: calc(100% - 3em);
      margin: 0 1.5em;
      padding: 3.5em 0;
    }

    .style-studio-explore-{{ section.id }} .style-studio-explore__title {
      max-width: 100%;
      font-size: 1.7em;
      line-height: 1.05;
    }

    .style-studio-explore-{{ section.id }} .style-studio-explore__subtitle {
      max-width: 28em;
      margin-top: 1.1em;
      font-size: 0.8em;
      line-height: 1.3;
    }

    .style-studio-explore-{{ section.id }} .style-studio-explore__buttons {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.75em;
      margin-top: 1.5em;
    }

    .style-studio-explore-{{ section.id }} .style-studio-explore__button {
      flex: 0 0 auto;
      width: 16em;
      min-width: 0;
      max-width: 100%;
      align-self: flex-start;
      padding: 0.8em 1.1em;
      border-radius: 10px;
      font-size: 0.7em;
      white-space: nowrap;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Style Studio Explore",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Optional background image."
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Mobile background image",
      "info": "Optional image used on screens up to 769px wide."
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "Build a Setup\nThat Feels Like You."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Change your keycaps. Build your vibe.\nOne choice at a time."
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "default": "Shop Keycaps"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background color",
          "default": "#214d0d"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#ffffff"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Style Studio Explore",
      "blocks": [
        {
          "type": "button",
          "settings": {
            "label": "Shop Keycaps",
            "background_color": "#214d0d",
            "text_color": "#ffffff"
          }
        },
        {
          "type": "button",
          "settings": {
            "label": "Explore Keyboards",
            "background_color": "#ffffff",
            "text_color": "#111111"
          }
        }
      ]
    }
  ]
}
{% endschema %}
