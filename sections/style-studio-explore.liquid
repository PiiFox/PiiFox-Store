<section class="style-studio-explore style-studio-explore-{{ section.id }}">
  <div class="style-studio-explore__inner">
    {% if section.settings.heading != blank %}
      <div class="style-studio-explore__header">
        {% if section.settings.eyebrow != blank %}
          <p class="style-studio-explore__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        <h2>{{ section.settings.heading | escape }}</h2>
        {% if section.settings.subheading != blank %}
          <p>{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="style-studio-explore__actions">
        {% for block in section.blocks %}
          {% assign cta = block.settings %}
          <a
            href="{{ cta.link | default: '/collections' }}"
            class="style-studio-explore__button"
            style="background: {{ cta.background_color | default: '#111111' }}; color: {{ cta.text_color | default: '#ffffff' }};"
            {{ block.shopify_attributes }}
          >
            {{ cta.label | default: 'Explore' | escape }}
          </a>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% style %}
  .style-studio-explore-{{ section.id }} {
    background: linear-gradient(180deg, #f5f2ea 0%, #ffffff 100%);
    color: #111111;
    padding: 5rem 0;
  }

  .style-studio-explore-{{ section.id }}__inner {
    width: min(100% - 2rem, 980px);
    margin: 0 auto;
    text-align: center;
  }

  .style-studio-explore-{{ section.id }}__eyebrow {
    margin: 0 0 0.75rem;
    color: #1f5b2f;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .style-studio-explore-{{ section.id }}__header h2 {
    margin: 0;
    font-size: clamp(2.2rem, 3vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  .style-studio-explore-{{ section.id }}__header p {
    max-width: 38rem;
    margin: 1rem auto 0;
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(17, 17, 17, 0.72);
  }

  .style-studio-explore-{{ section.id }}__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .style-studio-explore-{{ section.id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 220px;
    padding: 1rem 1.75rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 700;
    border: 1px solid rgba(17, 17, 17, 0.15);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .style-studio-explore-{{ section.id }}__button:hover {
    transform: translateY(-2px);
    opacity: 0.96;
  }

  @media screen and (max-width: 767px) {
    .style-studio-explore-{{ section.id }} {
      padding: 4rem 0;
    }

    .style-studio-explore-{{ section.id }}__button {
      width: 100%;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Style Studio Explore",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Explore"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the setup that fits your style"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Shop the collections and keyboard builds that bring your desk to life."
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop keycaps"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background color",
          "default": "#111111"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#ffffff"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Style Studio Explore",
      "blocks": [
        { "type": "button", "settings": { "label": "Shop keycaps", "background_color": "#111111", "text_color": "#ffffff" } },
        { "type": "button", "settings": { "label": "Explore keyboards", "background_color": "#ffffff", "text_color": "#111111" } }
      ]
    }
  ]
}
{% endschema %}
