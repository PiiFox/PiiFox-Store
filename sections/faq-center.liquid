{% schema %}
{
  "name": "FAQ Center",
  "class": "faq-list-section",
  "settings": [
    {
      "type": "header",
      "content": "Support Banner 设置"
    },
    {
      "type": "text",
      "id": "support_title",
      "label": "标题",
      "default": "Still need help?"
    },
    {
      "type": "text",
      "id": "support_desc",
      "label": "描述文字",
      "default": "Can't find the answer you need? Reach out to our support team."
    },
    {
      "type": "text",
      "id": "support_btn_text",
      "label": "按钮文字",
      "default": "Contact Support"
    },
    {
      "type": "text",
      "id": "support_btn_email",
      "label": "客服邮箱"
    }
  ],
  "presets": [
    {
      "name": "FAQ Center"
    }
  ]
}
{% endschema %}

{% assign faq_entries = shop.metaobjects.product_faq.values %}

{% assign faq_group_keys_string = '' %}
{% assign seen_faq_group_tokens = '|' %}
{% assign faq_group_order = 'policy-faq,keyboards,keycaps,switches,mice,accessories' | split: ',' %}

{% for item in faq_entries %}
  {% assign category_tags = item['categories'].value %}
  {% for category_tag_value in category_tags %}
    {% assign category_tag = category_tag_value %}
    {% if category_tag != blank %}
      {% assign category_tag_parts = category_tag | split: ':' %}
      {% assign category_group_title = category_tag_parts[0] | strip %}
      {% assign category_group_key = category_group_title | downcase | handleize %}

      {% if category_group_key != blank %}
        {% assign group_token = '|' | append: category_group_key | append: '|' %}
        {% unless seen_faq_group_tokens contains group_token %}
          {% assign seen_faq_group_tokens = seen_faq_group_tokens | append: category_group_key | append: '|' %}
          {% assign faq_group_keys_string = faq_group_keys_string | append: category_group_key | append: '||' %}
        {% endunless %}
      {% endif %}
    {% endif %}
  {% endfor %}
{% endfor %}
{% assign faq_group_keys_string = '' %}
{% for group_key in faq_group_order %}
  {% assign group_token = '|' | append: group_key | append: '|' %}
  {% if seen_faq_group_tokens contains group_token %}
    {% assign faq_group_keys_string = faq_group_keys_string | append: group_key | append: '||' %}
  {% endif %}
{% endfor %}
{% assign faq_group_keys = faq_group_keys_string | split: '||' %}

<div class="faq-list-{{ section.id }}">
  <button type="button" class="mobile-filter-toggle" aria-controls="FAQCategories-{{ section.id }}">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
    FAQ Categories
  </button>

  <div id="FAQCategories-{{ section.id }}" class="collection-list-block">
    <div class="filter-close" role="button" tabindex="0" aria-label="Close FAQ categories">&times;</div>

    <nav class="faq-category-navigation" aria-label="FAQ categories">
      {% for group_key in faq_group_keys %}
        {% if group_key != blank %}
          {% assign group_title = '' %}
          {% assign group_has_direct_category = false %}
          {% assign child_keys_string = '' %}
          {% assign child_titles_string = '' %}
          {% assign seen_child_tokens = '|' %}

          {% for item in faq_entries %}
            {% assign category_tags = item['categories'].value %}

            {% for category_tag_value in category_tags %}
              {% assign category_tag = category_tag_value %}
              {% if category_tag != blank %}
                {% assign category_tag_parts = category_tag | split: ':' %}
                {% assign category_group_title = category_tag_parts[0] | strip %}
                {% assign category_group_key = category_group_title | downcase | handleize %}

                {% if category_group_key == group_key %}
                  {% assign group_title = category_group_title %}
                  {% assign category_child_title = category_tag_parts[1] | strip %}

                  {% if category_child_title == blank %}
                    {% assign group_has_direct_category = true %}
                  {% else %}
                    {% assign category_child_key = category_child_title | downcase | handleize %}
                    {% assign child_token = '|' | append: category_child_key | append: '|' %}
                    {% unless seen_child_tokens contains child_token %}
                      {% assign seen_child_tokens = seen_child_tokens | append: category_child_key | append: '|' %}
                      {% assign child_keys_string = child_keys_string | append: category_child_key | append: '||' %}
                      {% assign child_titles_string = child_titles_string | append: category_child_title | append: '||' %}
                    {% endunless %}
                  {% endif %}
                {% endif %}
              {% endif %}
            {% endfor %}
          {% endfor %}

          {% capture group_icon %}
            {% case group_key %}
              {% when 'policy-faq' %}
                <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="#427347" stroke-width="2" aria-hidden="true">
                  <rect x="5" y="3" width="14" height="18" rx="2"></rect>
                  <path d="M9 8h6M9 12h6M9 16h4"></path>
                </svg>
              {% when 'keyboards' %}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#427347" stroke-width="2" aria-hidden="true">
                  <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                  <path d="M6 8h.01M10 8h.01M14 8h.01M18 8h.01M6 12h.01M10 12h.01M14 12h.01M18 12h.01M8 16h8"></path>
                </svg>
              {% when 'keycaps' %}
                <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="#427347" stroke-width="2" aria-hidden="true">
                  <rect x="4" y="4" width="16" height="16" rx="2"></rect>
                  <rect x="9" y="9" width="6" height="6" rx="1"></rect>
                </svg>
              {% when 'switches' %}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#427347" stroke-width="2" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="8" x2="12" y2="16"></line>
                  <line x1="8" y1="12" x2="16" y2="12"></line>
                </svg>
              {% when 'mice' %}
                <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="#427347" stroke-width="2" aria-hidden="true">
                  <rect x="5" y="3" width="14" height="18" rx="7"></rect>
                  <line x1="12" y1="7" x2="12" y2="11"></line>
                </svg>
              {% when 'accessories' %}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#427347" stroke-width="2" aria-hidden="true">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                  <path d="M7.5 4.21v15.58M16.5 4.21v15.58"></path>
                </svg>
            {% endcase %}
          {% endcapture %}

          {% if group_has_direct_category %}
            <button
              type="button"
              class="collection-group-title faq-category-item faq-category-item--parent"
              data-faq-category="{{ group_key }}"
            >
              {{ group_icon }}
              <span>{{ group_title | escape }}</span>
            </button>
          {% else %}
            <div class="collection-group-title">
              {{ group_icon }}
              <span>{{ group_title | escape }}</span>
            </div>
          {% endif %}

          {% assign child_keys = child_keys_string | split: '||' %}
          {% assign child_titles = child_titles_string | split: '||' %}
          {% if child_keys_string != blank %}
            <div class="faq-category-list">
              {% for child_key in child_keys %}
                {% if child_key != blank %}
                  <button
                    type="button"
                    class="faq-category-item faq-category-item--child"
                    data-faq-category="{{ group_key }}--{{ child_key }}"
                  >
                    {{ child_titles[forloop.index0] | escape }}
                  </button>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        {% endif %}
      {% endfor %}
    </nav>
  </div>

  <div class="product-faq-list-block">
    {% for group_key in faq_group_keys %}
      {% if group_key != blank %}
        {% assign category_keys_string = '' %}
        {% assign seen_category_tokens = '|' %}

        {% for item in faq_entries %}
          {% assign category_tags = item['categories'].value %}

          {% for category_tag_value in category_tags %}
            {% assign category_tag = category_tag_value %}
            {% if category_tag != blank %}
              {% assign category_tag_parts = category_tag | split: ':' %}
              {% assign category_group_title = category_tag_parts[0] | strip %}
              {% assign category_group_key = category_group_title | downcase | handleize %}

              {% if category_group_key == group_key %}
                {% assign category_child_title = category_tag_parts[1] | strip %}
                {% if category_child_title == blank %}
                  {% assign category_key = group_key %}
                {% else %}
                  {% assign category_child_key = category_child_title | downcase | handleize %}
                  {% assign category_key = group_key | append: '--' | append: category_child_key %}
                {% endif %}

                {% assign category_token = '|' | append: category_key | append: '|' %}
                {% unless seen_category_tokens contains category_token %}
                  {% assign seen_category_tokens = seen_category_tokens | append: category_key | append: '|' %}
                  {% assign category_keys_string = category_keys_string | append: category_key | append: '||' %}
                {% endunless %}
              {% endif %}
            {% endif %}
          {% endfor %}
        {% endfor %}

        {% assign category_keys = category_keys_string | split: '||' %}
        {% for category_key in category_keys %}
          {% if category_key != blank %}
            {% assign has_faqs = false %}

            <div
              class="product-faq-list--wrapper faq-category-panel"
              data-faq-category="{{ category_key }}"
            >
              {% for item in faq_entries %}
                {% assign item_matches_category = false %}
                {% assign faq_index = category_key | append: '-' | append: forloop.index0 %}
                {% assign category_tags = item['categories'].value %}

                {% for category_tag_value in category_tags %}
                  {% assign category_tag = category_tag_value %}
                  {% if category_tag != blank %}
                    {% assign category_tag_parts = category_tag | split: ':' %}
                    {% assign category_group_title = category_tag_parts[0] | strip %}
                    {% assign category_group_key = category_group_title | downcase | handleize %}

                    {% if category_group_key == group_key %}
                      {% assign category_child_title = category_tag_parts[1] | strip %}
                      {% if category_child_title == blank %}
                        {% assign item_category_key = group_key %}
                      {% else %}
                        {% assign category_child_key = category_child_title | downcase | handleize %}
                        {% assign item_category_key = group_key | append: '--' | append: category_child_key %}
                      {% endif %}

                      {% if item_category_key == category_key %}
                        {% assign item_matches_category = true %}
                      {% endif %}
                    {% endif %}
                  {% endif %}
                {% endfor %}

                {% if item_matches_category %}
                  {% assign has_faqs = true %}
                  {% render 'faq-item', item: item, index: faq_index %}
                {% endif %}
              {% endfor %}

              {% unless has_faqs %}
                <p class="faq-empty-message">No FAQs available in this category.</p>
              {% endunless %}
            </div>
          {% endif %}
        {% endfor %}
      {% endif %}
    {% endfor %}

    {% render 'support-contact-section', section: section %}
  </div>
</div>

{% style %}
  .faq-list-{{ section.id }} {
    max-width: 1100px;
    margin: 40px auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 40px;
    position: relative;
  }

  .mobile-filter-toggle {
    display: none;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    margin-bottom: 20px;
  }

  .collection-list-block {
    border-right: 1px solid #eee;
    padding-right: 20px;
    position: relative;
  }

  .filter-close {
    display: none;
  }

  .faq-category-navigation {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .collection-group-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    padding: 8px 14px;
    font-size: 20px;
    font-weight: 600;
    color: #111;
  }

  .collection-group-title:first-child {
    margin-top: 0;
  }

  .collection-group-title svg,
  .faq-category-item--parent svg {
    flex-shrink: 0;
  }

  .faq-category-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .faq-category-item {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px;
    border: 2px solid transparent;
    border-radius: 8px;
    background: transparent;
    color: #111;
    text-align: left;
    font: inherit;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .faq-category-item--child {
    padding-left: 34px;
    font-size: 16px;
  }

  .faq-category-item--parent {
    width: 100%;
    margin-top: 18px;
    padding: 8px 14px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: #111;
    font-size: 20px;
    font-weight: 600;
    text-align: left;
  }

  .faq-category-item.faq-category-item--parent:hover,
  .faq-category-item--parent.active {
    background: transparent;
    border-color: transparent;
  }

  .faq-category-item:hover {
    background: #f5f5f5;
  }

  .faq-category-item.active:not(.faq-category-item--parent) {
    background: #edf9f5;
    border-color: var(--colorThemePrimary);
  }

  .faq-category-panel {
    display: none;
  }

  .faq-category-panel.active {
    display: block;
  }

  .faq-empty-message {
    padding: 16px 20px;
    color: #666;
  }

  @media (max-width: 768px) {
    .faq-list-{{ section.id }} {
      display: block;
    }

    .mobile-filter-toggle {
      display: flex;
    }

    .collection-list-block {
      position: fixed;
      top: 0;
      left: 0;
      width: 280px;
      height: 100vh;
      background: #fff;
      z-index: 9999;
      padding: 20px;
      box-shadow: 2px 0 10px rgba(0, 0, 0, 0.1);
      transform: translateX(-100%);
      transition: transform 0.3s ease;
      overflow-y: auto;
      border-right: none;
    }

    .collection-list-block.open {
      transform: translateX(0);
    }

    .filter-close {
      display: block;
      font-size: 28px;
      line-height: 1;
      text-align: right;
      cursor: pointer;
      margin-bottom: 16px;
    }
  }
{% endstyle %}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const root = document.querySelector('.faq-list-{{ section.id }}');

    if (!root) return;

    const categoryItems = root.querySelectorAll('.faq-category-item');
    const faqPanels = root.querySelectorAll('.faq-category-panel');
    const filter = root.querySelector('.collection-list-block');
    const toggle = root.querySelector('.mobile-filter-toggle');
    const close = root.querySelector('.filter-close');

    categoryItems.forEach((item) => {
      item.addEventListener('click', function () {
        const category = this.dataset.faqCategory;

        categoryItems.forEach((categoryItem) => {
          categoryItem.classList.remove('active');
        });

        faqPanels.forEach((panel) => {
          panel.classList.toggle(
            'active',
            panel.dataset.faqCategory === category
          );
        });

        this.classList.add('active');

        if (window.innerWidth <= 768 && filter) {
          filter.classList.remove('open');
        }
      });
    });

    if (toggle && filter) {
      toggle.addEventListener('click', function () {
        filter.classList.add('open');
      });
    }

    if (close && filter) {
      close.addEventListener('click', function () {
        filter.classList.remove('open');
      });
    }

    if (categoryItems.length > 0) {
      categoryItems[0].click();
    }
  });
</script>
