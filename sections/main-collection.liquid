{%- liquid
  assign current_filter_size = 0
  for filter in collection.filters
    assign current_filter_size = current_filter_size | plus: filter.active_values.size
  endfor
-%}

<div
  class="collection-content"
  data-section-id="{{ section.id }}"
  data-section-type="collection-grid"
>
  <div id="CollectionAjaxContent" data-filters-size="{{ collection.filters.size }}">
    <div class="page-width">
      <div class="grid">
        <div class="grid__item medium-up--one-fifth grid__item--sidebar">
          {%- render 'collection-grid-filters',
            collection: collection, 
            enable_sidebar: section.settings.enable_sidebar,
            filter_style: section.settings.filter_style,
            collapsed: section.settings.collapsed,
            enable_color_swatches: section.settings.enable_color_swatches
          -%}
        </div>
        <div class="grid__item medium-up--four-fifths grid__item--content">
          {%- render 'breadcrumbs' -%}
          {%- liquid
            for block in section.blocks
              case block.type
              when 'product_grid'
                assign paginate_by = block.settings.per_row | times: block.settings.rows_per_page
              endcase
            endfor
          -%}
          {%- paginate collection.products by paginate_by -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'promo_card' or block.type == 'image_card' -%}
              {%- continue -%}
            {%- endif -%}
            <div {{ block.shopify_attributes }} {%- if block.type == 'product-grid' -%}data-scroll-to{%- endif -%}>
              {%- case block.type -%}
              {%- when 'collection_description' -%}
                {%- if collection.description != blank and current_filter_size == 0 -%}
                  <div class="rte collection__description">
                    {{ collection.description }}
                  </div>
                {%- endif -%}
              {%- when 'subcollections' -%}
                {%- if paginate.current_page == 1 and current_filter_size == 0 -%}
                  {%- render 'subcollections', per_row: block.settings.subcollections_per_row -%}
                {%- endif -%}
              {%- when 'product_grid' -%}
                <div data-scroll-to>
                  {% render 'collection-grid',
                    collection: collection,
                    items: collection.products,
                    enable_sidebar: section.settings.enable_sidebar,
                    filter_style: section.settings.filter_style,
                    enable_sort: section.settings.enable_sort,
                    enable_collection_count: block.settings.enable_collection_count,
                    per_row: block.settings.per_row,
                    mobile_flush_grid: block.settings.mobile_flush_grid,
                    quick_shop_enable: settings.quick_shop_enable,
                    short_introduction_enable: section.settings.short_introduction_enable,
                    short_point_desc_enable: section.settings.short_point_desc_enable,
                    product_card_btn_label: section.settings.product_card_btn_label,
                    section_blocks: section.blocks,
                    current_page: paginate.current_page
                  %}
                  {%- if paginate.pages > 1 -%}
                    {%- render 'pagination', paginate: paginate -%}
                  {%- endif -%}
                </div>
              {%- endcase -%}
            </div>
          {%- endfor -%}

          {%- endpaginate -%}
        </div>
      </div>
    </div>
  </div>
</div>

{%- if section.settings.enable_sidebar == false or section.settings.filter_style == 'drawer' or collection.filters.size == 0 -%}
{% comment %}
  Override grid styles if sidebar is disabled
{% endcomment %}
{% style %}
  .collection-content .grid__item--sidebar { width: 0; padding:0; }
  .collection-content .grid__item--content { width: 100%; }
  .grid__item--sidebar { position: static; overflow: hidden; }
{% endstyle %}
{%- endif -%}

{% style %}
  .image-wrap .animate-me, .image-wrap img:not([role=presentation]), .image-wrap svg {
    opacity: 1;
  }
  ul.no-bullets.tag-list.tag-list--active-tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
  }
  ul.no-bullets.tag-list.tag-list--active-tags li.tag--remove {
    margin: 0;
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  #CollectionAjaxContent .breadcrumbs {padding: 0 1em;}
  .collection-sidebar__group .collapsible-trigger-btn {
    text-transform: unset;
    letter-spacing: 0.1em;
    font-size: 1em;
    color: #121212;
    font-weight: 400;
  }
  .collection-sidebar__group .collapsible-trigger-btn .collapsible-trigger__icon {
    width: 1.2em;
    height: 1.2em;
  }

  /* Filter Options: rounded rectangle cards imitating Casetify */
  .filter-form ul.tag-list:not(.tag-list--swatches) {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 8px 0 16px;
    padding: 0;
    list-style: none;
  }

  .filter-form .tag:not(.tag--swatch) {
    margin: 0 !important;
    display: block !important;
    width: 100% !important;
  }

  /* Aggressively hide square checkbox */
  .filter-form .tag:not(.tag--swatch) .tag__checkbox,
  .tag__checkbox {
    display: none !important;
    visibility: hidden !important;
    width: 0 !important;
    height: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    border: none !important;
  }
  .tag__checkbox:before,
  .tag__checkbox:after {
    display: none !important;
    content: none !important;
  }

  /* Unselected Pill State: border-radius: 8px, strictly left-aligned text */
  .filter-form .tag:not(.tag--swatch) label.tag__checkbox-wrapper {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    text-align: left !important;
    width: 100% !important;
    min-height: 40px !important;
    padding: 9px 16px !important;
    margin: 0 !important;
    border-radius: 8px !important;
    border: 1px solid #e2e2e2 !important;
    background: #ffffff !important;
    color: #121212 !important;
    font-size: 13.5px !important;
    font-weight: 500 !important;
    letter-spacing: 0.01em !important;
    box-sizing: border-box !important;
    cursor: pointer !important;
    transition: all 0.2s cubic-bezier(0.25, 0.8, 0.25, 1) !important;
    user-select: none !important;
    text-decoration: none !important;
    position: relative !important;
  }

  .filter-form .tag:not(.tag--swatch) label.tag__checkbox-wrapper:hover {
    border-color: #181818 !important;
    background-color: #f8f8f8 !important;
    text-decoration: none !important;
  }

  .filter-form .tag:not(.tag--swatch) label.tag__checkbox-wrapper .tag__label-and-count,
  .filter-form .tag:not(.tag--swatch) label.tag__checkbox-wrapper > span {
    display: inline-flex !important;
    align-items: center !important;
    gap: 4px !important;
    color: inherit !important;
    text-decoration: none !important;
    margin-right: auto !important;
    text-align: left !important;
  }

  .filter-form .tag:not(.tag--swatch) label.tag__checkbox-wrapper .tag__text {
    text-align: left !important;
  }

  .filter-form .tag:not(.tag--swatch) label.tag__checkbox-wrapper .tag__count {
    color: inherit !important;
    opacity: 0.75 !important;
    font-size: 0.9em !important;
  }

  .filter-form .tag:not(.tag--swatch) label:hover,
  .filter-form .tag:not(.tag--swatch) label:hover * {
    text-decoration: none !important;
  }

  /* Selected / Active State: #181818, border-radius: 8px */
  .filter-form .tag:not(.tag--swatch).tag--active label.tag__checkbox-wrapper {
    background: #181818 !important;
    border-color: #181818 !important;
    color: #ffffff !important;
  }

  .filter-form .tag:not(.tag--swatch).tag--active label.tag__checkbox-wrapper:hover {
    background: #181818 !important;
    border-color: #181818 !important;
  }

  .filter-form .tag:not(.tag--swatch).tag--active label.tag__checkbox-wrapper span,
  .filter-form .tag:not(.tag--swatch).tag--active label.tag__checkbox-wrapper .tag__text,
  .filter-form .tag:not(.tag--swatch).tag--active label.tag__checkbox-wrapper .tag__count {
    color: #ffffff !important;
  }

  /* Right-side close icon (✕) when selected, pushed to the far right */
  .filter-form .tag:not(.tag--swatch).tag--active label.tag__checkbox-wrapper::after {
    content: "✕" !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin-left: auto !important;
    font-size: 11.5px !important;
    font-weight: 600 !important;
    line-height: 1 !important;
    color: #ffffff !important;
    flex-shrink: 0 !important;
    opacity: 0.9 !important;
  }

  /* Active Filter Tags at Top ("这里做成圆框。黑框白字") */
  .collection-filter-tag-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }
  .collection-filter-tag-list .tag--remove {
    margin: 0 !important;
    position: relative !important;
    display: inline-flex !important;
    align-items: center !important;
  }
  .collection-filter-tag-list .tag--remove .btn--small {
    text-transform: unset !important;
    border-radius: 9999px !important;
    background: #181818 !important;
    border: 1px solid #181818 !important;
    color: #ffffff !important;
    padding: 6px 14px 6px 14px !important;
    font-size: 13px !important;
    line-height: 1.4 !important;
    font-weight: 500 !important;
    letter-spacing: 0.02em !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 6px !important;
    transition: none !important;
    cursor: pointer !important;
    box-shadow: none !important;
  }

  /* Cross icon right on the text's right side */
  .collection-filter-tag-list .tag--remove .tag-close-x {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 11px !important;
    line-height: 1 !important;
    font-weight: 600 !important;
    color: #ffffff !important;
    opacity: 0.9 !important;
    margin-left: 2px !important;
  }

  /* Top tag hover: NO highlight effect, keep #181818 */
  .collection-filter-tag-list .tag--remove:hover .btn--small,
  .collection-filter-tag-list .tag--remove .btn--small:hover,
  [data-button_style=square] .collection-filter-tag-list .tag--remove .btn--small:hover {
    background: #181818 !important;
    border-color: #181818 !important;
    color: #ffffff !important;
    box-shadow: none !important;
    transform: none !important;
    filter: none !important;
  }
  .collection-filter-tag-list .tag--remove .icon {
    display: none !important;
  }

  .collection-filter-tag-list .tag--clear {
    display: block;
    width: 100%;
    margin-top: 6px;
    margin-bottom: 8px;
  }
  .collection-filter-tag-list .tag--clear .btn--small {
    background: none !important;
    padding: 2px 0 !important;
    min-width: unset !important;
    border: none !important;
    border-bottom: 1px solid #777777 !important;
    border-radius: 0 !important;
    font-size: 13px !important;
    color: #555555 !important;
    text-transform: none !important;
    letter-spacing: 0.02em !important;
    line-height: 1.3 !important;
    display: inline-block !important;
    transition: color 0.2s ease, border-color 0.2s ease !important;
  }
  .collection-filter-tag-list .tag--clear .btn--small:hover,
  .tag--clear .btn:not(.btn--secondary):not(.btn--tertiary):not(.btn--inverse):not(.btn--body):not(.btn--static):hover {
    background: transparent !important;
    color: #000000 !important;
    border-bottom-color: #000000 !important;
  }
  .collection-filter-tag-list .tag--clear .btn--small.tag-item--hide {
    display: none !important;
  }

  /* PC端筛选条件区域直接全展开展示，不限制高度也不内部滚动（仅PC端） */
  @media only screen and (min-width: 769px) {
    .grid__item--sidebar,
    .collection-content .grid__item--sidebar,
    .collection-sidebar,
    #CollectionSidebar {
      position: static !important;
      max-height: none !important;
      height: auto !important;
      overflow: visible !important;
      overflow-y: visible !important;
      scrollbar-width: none !important; /* Firefox */
      -ms-overflow-style: none !important; /* IE/Edge */
    }

    .grid__item--sidebar::-webkit-scrollbar,
    .collection-content .grid__item--sidebar::-webkit-scrollbar,
    .collection-sidebar::-webkit-scrollbar,
    #CollectionSidebar::-webkit-scrollbar {
      display: none !important;
      width: 0 !important;
      height: 0 !important;
      background: transparent !important;
    }
  }
  @media screen and (max-width: 1400px) {
    .grid--uniform .medium-up--one-quarter:nth-of-type(4n+1) {
      clear: unset;
    }
    .grid--uniform .medium-up--one-quarter:nth-of-type(3n+1) {
      clear: both;
    }
    .medium-up--one-quarter {
      width: 33.3%
    }
  }
  @media screen and (max-width: 1100px) {
    .grid--uniform .medium-up--one-quarter:nth-of-type(4n+1) {
      clear: unset;
    }
    .grid--uniform .medium-up--one-quarter:nth-of-type(3n+1) {
      clear: unset;
    }
    .grid--uniform .medium-up--one-quarter:nth-of-type(2n+1) {
      clear: both;
    }
    .medium-up--one-quarter {
      width: 50%
    }
  }
  @media screen and (max-width: 768px) {
    .collection-filter {
      
    }
    .collection-filter .btn:not(.btn--tertiary-active) ,
    .collection-filter__sort-container {
      background: #f5f5f7;
      border: none;
      border-radius: 0;
      font-weight: 200;
    }
    .collection-filter .btn {
      border-radius: 0;
      border: none;
    }
    .collection-filter .btn:not(.btn--tertiary-active) {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .collection-filter .btn:not(.btn--tertiary-active) img {
      width: 1em;
      height: 1em;
      margin-right: 0.4em;
    }
    .collection-filter__item--drawer {
      border-radius: 0.4em 0 0 0.4em;
      overflow: hidden;
      position: relative;
    }
    .collection-filter__item--drawer::before {
      content: '';
      position: absolute;
      top: 50%;
      right: 0;
      width: 1px;
      height: 1em;
      background: #dcdcdd;
      transform: translateY(-50%);
    }
    .collection-filter__sort-container {
      border-radius: 0 0.4em 0.4em 0;
      width: 100%;
      display: flex;
      justify-content: center;
    }
    .collection-filter__sort-container select {
      border: none;
      width: max-content;
      font-weight: 200;
    }
  }
  @media screen and (max-width: 500px) {
    .small--one-halfs .content-toggle-btn {
      display: none;
    }
    .small--one-halfs .bottom_btn a {
      font-size: 11px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "t:sections.main-collection.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.main-collection.settings.header_filtering_and_sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_sidebar",
      "label": "t:sections.main-collection.settings.enable_sidebar.label",
      "default": true,
      "info": "t:sections.main-collection.settings.enable_sidebar.info"
    },
    {
      "type": "checkbox",
      "id": "collapsed",
      "label": "t:sections.main-collection.settings.collapsed.label",
      "default": true
    },
    {
      "type": "select",
      "id": "filter_style",
      "label": "t:sections.main-collection.settings.filter_style.label",
      "default": "sidebar",
      "options": [
        {
          "value": "sidebar",
          "label": "t:sections.main-collection.settings.filter_style.options.sidebar.label"
        },
        {
          "value": "drawer",
          "label": "t:sections.main-collection.settings.filter_style.options.drawer.label"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_color_swatches",
      "label": "t:sections.main-collection.settings.enable_color_swatches.label"
    },
    {
      "type": "checkbox",
      "id": "short_introduction_enable",
      "label": "Enable Short Introduction",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "short_point_desc_enable",
      "label": "Enable Short Point Description",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_sort",
      "label": "t:sections.main-collection.settings.enable_sort.label",
      "default": true
    },
    {
      "type": "text",
      "id": "product_card_btn_label",
      "label": "Product Card Button Label"
    }
  ],
  "blocks": [
    {
      "type": "promo_card",
      "name": "In-Grid Promo Card",
      "settings": [
        {
          "type": "number",
          "id": "position",
          "label": "Slot Position in Grid (1, 8, etc.)",
          "default": 1
        },
        {
          "type": "checkbox",
          "id": "show_on_all_pages",
          "label": "Show on all paginated pages",
          "default": false,
          "info": "If unchecked, card only appears on Page 1"
        },
        {
          "type": "select",
          "id": "card_theme",
          "label": "Card Visual Style",
          "options": [
            { "value": "light", "label": "Light Minimal (Grey)" },
            { "value": "dark", "label": "Dark Aesthetic (Emerald/Black)" }
          ],
          "default": "light"
        },
        {
          "type": "image_picker",
          "id": "bg_image",
          "label": "Background Image (Optional)"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Top Badge / Small Tag",
          "default": "MEMBER EXCLUSIVE"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Save on Every Order — Join PIIFOX Club"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Card Description / Perks",
          "default": "Unlock members-only savings:\nSpend $65, Save 15%\nSpend $125, Save 20%\nSpend $175, Save 25%"
        },
        {
          "type": "text",
          "id": "btn_label",
          "label": "Button / Link Text",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "btn_url",
          "label": "Button Link"
        }
      ]
    },
    {
      "type": "image_card",
      "name": "In-Grid Image Card",
      "settings": [
        {
          "type": "number",
          "id": "position",
          "label": "Slot Position in Grid (1, 8, etc.)",
          "default": 1
        },
        {
          "type": "checkbox",
          "id": "show_on_all_pages",
          "label": "Show on all paginated pages",
          "default": false,
          "info": "If unchecked, card only appears on Page 1"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile Card Image (Optional)"
        },
        {
          "type": "select",
          "id": "image_fit",
          "label": "Image Fit",
          "options": [
            { "value": "cover", "label": "Fill / Cover Card (Recommended)" },
            { "value": "contain", "label": "Contain (Keep Full Image Visible)" }
          ],
          "default": "cover"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image Link (Optional)"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open link in new tab",
          "default": false
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Image Alt Text (Optional)"
        }
      ]
    },
    {
      "type": "collection_description",
      "name": "t:sections.main-collection.blocks.collection_description.name",
      "limit": 1
    },
    {
      "type": "product_grid",
      "name": "t:sections.main-collection.blocks.products.name",
      "settings": [
        {
          "type": "checkbox",
          "id": "enable_collection_count",
          "label": "t:sections.main-collection.blocks.products.settings.enable_collection_count.label",
          "default": true
        },
        {
          "type": "range",
          "id": "per_row",
          "label": "t:sections.main-collection.blocks.products.settings.per_row.label",
          "default": 4,
          "min": 2,
          "max": 5,
          "step": 1
        },
        {
          "type": "range",
          "id": "rows_per_page",
          "label": "t:sections.main-collection.blocks.products.settings.rows_per_page.label",
          "default": 7,
          "min": 3,
          "max": 20,
          "step": 1
        },
        {
          "type": "checkbox",
          "id": "mobile_flush_grid",
          "label": "t:sections.main-collection.blocks.products.settings.mobile_flush_grid.label",
          "default": false
        }
      ],
      "limit": 1
    },
    {
      "type": "subcollections",
      "name": "t:sections.main-collection.blocks.subcollections.name",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.main-collection.blocks.subcollections.settings.content"
        },
        {
          "type": "range",
          "id": "subcollections_per_row",
          "label": "t:sections.main-collection.blocks.subcollections.settings.subcollections_per_row.label",
          "default": 5,
          "min": 2,
          "max": 5,
          "step": 1
        }
      ],
      "limit": 1
    }
  ]
}
{% endschema %}
