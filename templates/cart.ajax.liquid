{% comment %}
  JS-load cart markup without bloat of a full layout.

  This is used in both the cart drawer and cart page.
  When a quantity is changed, this file is scraped and data-products
    is fully replaced to account for possible cart discounts changing

  The cart-wide discount div also replaces what is originally in the cart
    as it can change anytime a cart-item changes
{% endcomment %}
{% layout none %}

{%- assign cart_has_keyboard = false -%}
{%- assign keycaps_discount_total = 0 -%}
{%- for ci in cart.items -%}
  {%- assign ci_t = ci.product.type | downcase -%}
  {%- assign ci_title = ci.product.title | downcase -%}
  {%- if ci_t contains 'keyboard' or ci_title contains 'keyboard' or ci.product.tags contains 'keyboards' or ci.product.tags contains 'Keyboards' or ci.product.tags contains 'keyboard' or ci.product.tags contains 'Keyboard' -%}
    {%- unless ci_title contains 'keycap' or ci_title contains 'switch' or ci_t contains 'keycap' or ci_t contains 'switch' or ci_title contains 'desk mat' or ci_title contains 'holder' -%}
      {%- assign cart_has_keyboard = true -%}
      {%- break -%}
    {%- endunless -%}
  {%- endif -%}
{%- endfor -%}
{%- if cart_has_keyboard -%}
  {%- for ci in cart.items -%}
    {%- assign ci_t = ci.product.type | downcase -%}
    {%- assign ci_title = ci.product.title | downcase -%}
    {%- if ci_t == 'keycaps' or ci_t == 'keycap' or ci_title contains 'keycap' -%}
      {%- unless ci_title contains 'puller' or ci_title contains 'installation' or ci_title contains 'service' -%}
        {%- assign item_disc = ci.original_line_price | default: ci.final_line_price | times: 0.1 | round -%}
        {%- assign keycaps_discount_total = keycaps_discount_total | plus: item_disc -%}
      {%- endunless -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign display_subtotal = cart.original_total_price | minus: keycaps_discount_total -%}
  {%- assign display_orig = cart.original_total_price -%}
{%- else -%}
  {%- assign display_subtotal = cart.original_total_price -%}
  {%- assign display_orig = cart.original_total_price -%}
{%- endif -%}

<div class="cart__items"
  data-count="{{ cart.item_count }}"
  data-cart-subtotal="{{ display_orig }}"
  data-cart-discount-total="{{ keycaps_discount_total }}"
  data-cart-final-subtotal="{{ display_subtotal }}">
  {% for item in cart.items %}
    {%- render 'cart-item', product: item, cart_has_keyboard: cart_has_keyboard -%}
  {% endfor %}
</div>
<div class="cart__discounts cart__item-sub cart__item-row{% if cart.cart_level_discount_applications == blank or cart_has_keyboard == false %} hide{% endif %}">
  <div>{{ 'cart.general.discounts' | t }}</div>
  <div>
    {% for cart_discount in cart.cart_level_discount_applications %}
      {% if cart_has_keyboard == false and cart_discount.title contains 'KEYCAP' %}
        {% continue %}
      {% endif %}
      <div class="cart__discount">
        {{ cart_discount.title }} (-{{ cart_discount.total_allocated_amount | money }})
      </div>
    {% endfor %}
  </div>
</div>
